		echo "ProxyCache ${PROXY_CACHE_DIR} reiserfs ${FS_PROXY_CACHE_SZ}"

	    echo "ProxyDB ${PROXY_DB_DIR} ext4 ${FS_PROXY_DB_SZ}"
	    ;;
