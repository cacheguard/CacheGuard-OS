    echo "Root / ext4 ${FS_ROOT_SZ}"
    echo "Logs ${WEB_LOG_DIR} ext4 ${FS_GATEWAY_LOG_PER_DAY_SZ}"
    echo "Var /var ext4 ${FS_VAR_SZ}"

