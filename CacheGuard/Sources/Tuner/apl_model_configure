disk-index()
{
    test -n "${1}" || return 1
    local disk_name=${1}

    local disk_index=${disk_name:2}

    case ${disk_name:0:2} in
	hd|sd|nv|vd)
	    disk_index=$(printf "%d" \'${disk_index})
	    disk_index=$[${disk_index} - 97]
	    ;;
	md)
	    disk_index=$[${disk_index} - 1]
	    ;;
	*)
	    ;;
    esac

    echo ${disk_index}
    return 0
}

