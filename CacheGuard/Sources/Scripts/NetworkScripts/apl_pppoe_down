CACHEGUARD_DIR=/etc/sysconfig/cacheguard
source ${CACHEGUARD_DIR}/constant

apl-main()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    test -n "${3}" || return 3
    test -n "${4}" || return 4
    test -n "${5}" || return 5
    local ppp_dev=${1}
    local eth_dev=${2}
    local speed=${3}
    local ip=${4}
    local router=${5}

    rm -f ${RUN_DIR}/${EXTERNAL_PPPOE_DONE}
}

apl-main "${@}"
