CACHEGUARD_DIR=/etc/sysconfig/cacheguard
source ${CACHEGUARD_DIR}/constant

##################################################
# Caution: use '_' and not '-' in function names #
##################################################

apl_set_ip_configurtion()
{
    test -n "${1}" || return 1
    local event=${1}
    local code=${2}

    su - ${ADMIN_NAME} --command 'cancel' 2> /dev/null

    DHCLIENT_HOOK_EVENT=${event} DHCLIENT_HOOK_ERROR_CODE=${code} apl_apply > /dev/null 2>&1 &
}

apl_set_ip_configurtion_if_modified()
{
    if test -z "${old_ip_address}" -o -z "${old_subnet_mask}" -o -z "${old_routers}" ; then
	apl_set_ip_configurtion modified
    else
	test \
	    "${new_ip_address}" == "${old_ip_address}" -a \
	    "${new_subnet_mask}" == "${old_subnet_mask}" -a \
	    "${new_routers}" == "${old_routers}" || \
	    apl_set_ip_configurtion modified
    fi
}

apl_save_dhcp_state()
{
    test -n "${reason}" || return 11

    local tmp_dhcp_ip_configuration=/tmp/dhcp-ip-configuration.${$}

    echo ${reason} > ${RUN_DIR}/${EXTERNAL_DHCP_STATE}

    case ${reason} in
	BOUND|RENEW|REBIND|REBOOT)

	    local end

	    if test -n "${new_dhcp_lease_time}" ; then
		local now=$(date +%s 2>/dev/null)
		end=$((now + new_dhcp_lease_time))
	    fi

	    cat << EOT > ${tmp_dhcp_ip_configuration}
${interface}
${new_dhcp_server_identifier}
${new_ip_address}
${new_subnet_mask}
${new_routers}
${end}
EOT
	    mv -f ${tmp_dhcp_ip_configuration} ${RUN_DIR}/${EXTERNAL_DHCP_IP_CONFIGURATION}
	    ;;
	FAIL)
	    ;;
	*)
	    ;;
    esac
}

apl_main()
{
    if test -z "${1}" ; then
	exit_status=11
	apl_set_ip_configurtion error ${exit_status}
	return ${exit_status}
    else
	exit_status=${1}
    fi

    if test ${exit_status} -ne 0 ; then
	apl_set_ip_configurtion error ${exit_status}
	return ${exit_status}
    fi

    if test -z "${interface}" ; then
	exit_status=13
	apl_set_ip_configurtion error ${exit_status}
	return ${exit_status}
    fi

    if test -z "${reason}" ; then
	exit_status=15
	apl_set_ip_configurtion error ${exit_status}
	return ${exit_status}
    fi

    apl_save_dhcp_state

    case ${reason} in
	MEDIUM|ARPCHECK|ARPSEND|PREINIT)
            ;;
	BOUND|RENEW|REBIND|REBOOT|EXPIRE)
	    apl_set_ip_configurtion_if_modified
	    ;;
	FAIL)
	    apl_set_ip_configurtion failed
	    ;;
	RELEASE|STOP)
            ;;
	TIMEOUT)
            ;;
	PREINIT6|BOUND6|RENEW6|REBIND6|DEPREF6|EXPIRE6|RELEASE6|STOP6)
            ;;
	*)
	    ;;
    esac

    exit_status=${?}

    return ${exit_status}
}

apl_main "${@}"
