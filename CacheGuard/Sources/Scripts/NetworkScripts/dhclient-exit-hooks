CACHEGUARD_DIR=/etc/sysconfig/cacheguard
source ${CACHEGUARD_DIR}/constant
source ${ETC_DHCP_DIR}/dhclient-functions

##################################################
# Caution: use '_' and not '-' in function names #
##################################################

apl_set_ip_configurtion()
{
    test -n "${1}" || return 1
    local event=${1}
    local code=${2}

    case ${event} in
	modified)
	    setup_external_dhcp_ip_configuration
	    rm -f ${RUN_DIR}/${EXTERNAL_DHCP_IP_CONFIGURATION}.failed
	    ;;
	error|failed)
	    case ${DHCP_CONTEXT} in
		run)
		    return 31
		    ;;
		boot)
		    touch ${RUN_DIR}/${EXTERNAL_DHCP_IP_CONFIGURATION}.failed
		    ;;
		*)
		    return 33
		    ;;
	    esac
	    ;;
	*)
	    return 35
	    ;;
    esac

    case ${DHCP_CONTEXT} in
	run)
	    test ! -f ${LOCK_DIR}/apl_apply || return 0
	    su - ${ADMIN_NAME} --command 'cancel' 2> /dev/null
	    DHCLIENT_HOOK_EVENT=${event} DHCLIENT_HOOK_ERROR_CODE=${code} apl_apply > /dev/null 2>&1 &
	    ;;
	boot)
	    rm -f /var/run/${DYNAMIC_IP_BOOTING}
	    apl_network_dependent_configure
	    ;;
	*)
	    return 255
	    ;;
    esac
}

apl_set_ip_configurtion_if_modified()
{
    local doit

    if test -z "${old_ip_address}" -o -z "${old_subnet_mask}" -o -z "${old_routers}" ; then
	doit=yes
    else
	if test -f ${RUN_DIR}/${EXTERNAL_DHCP_IP_CONFIGURATION}.failed ; then
	    doit=yes
	elif test "${new_ip_address}" == "${old_ip_address}" -a \
		  "${new_subnet_mask}" == "${old_subnet_mask}" -a \
		  "${new_routers}" == "${old_routers}" ; then

	    setup_external_dhcp_ip_configuration

	else
	    doit=yes
	fi
    fi

    test -z "${doit}" || apl_set_ip_configurtion modified
}

apl_save_dhcp_state()
{
    test -n "${reason}" || return 11

    echo ${reason} > ${RUN_DIR}/${EXTERNAL_DHCP_STATE}
}

apl_main()
{
    if test -f /var/run/${DYNAMIC_IP_BOOTING} ; then
	DHCP_CONTEXT=boot
    else
	DHCP_CONTEXT=run
    fi

    if test -z "${1}" ; then
	exit_status=11
	apl_set_ip_configurtion error ${exit_status}
	return ${exit_status}
    else
	exit_status=${1}
    fi

    if test ${exit_status} -ne 0 ; then
	apl_set_ip_configurtion error ${exit_status}
	return ${exit_status}
    fi

    if test -z "${interface}" ; then
	exit_status=13
	apl_set_ip_configurtion error ${exit_status}
	return ${exit_status}
    fi

    if test -z "${reason}" ; then
	exit_status=15
	apl_set_ip_configurtion error ${exit_status}
	return ${exit_status}
    fi

    apl_save_dhcp_state

    case ${reason} in
	PREINIT)
	    rm -f ${RUN_DIR}/${EXTERNAL_DHCP_DONE}
	    ;;
	MEDIUM|ARPCHECK|ARPSEND|EXPIRE)
            ;;
	BOUND|RENEW|REBIND|REBOOT)
	    apl_set_ip_configurtion_if_modified
	    ;;
	FAIL)
	    apl_set_ip_configurtion failed
	    ;;
	RELEASE|STOP)
            ;;
	TIMEOUT)
            ;;
	PREINIT6|BOUND6|RENEW6|REBIND6|DEPREF6|EXPIRE6|RELEASE6|STOP6)
            ;;
	*)
	    ;;
    esac

    exit_status=${?}

    return ${exit_status}
}

apl_main "${@}"
