check-expr-ip()
{
    [[ "${1}" =~ (^[1-9][0-9]{0,2}|^0)[.]([1-9][0-9]{0,2}|0)[.]([1-9][0-9]{0,2}|0)[.]([1-9][0-9]{0,2}|0)$ ]]
}

sni-guard-loop()
{
    local url ip user method mode sni

    while read url ip user method sni
    do
	if test -z "${method}" ; then
            echo ERR
            continue
	fi

	if test ${url:0:7} != http:// ; then
            if test "${sni}" != - ; then
                url="http://${sni}"
            else
                if check-expr-ip "${url%:443}" -a ${method} == CONNECT ; then
                    echo OK
                    continue
                fi
            fi
	fi

	echo "${url} ${ip} ${user} ${method}"
    done
}

main()
{
    sni-guard-loop | /bin/squidGuard -c /etc/squidGuard.conf -P &
}

main
