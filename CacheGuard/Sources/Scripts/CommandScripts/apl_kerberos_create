source /usr/local/lib/apl_functions
source ${BASE_DIR}/${ADMIN_NAME}/${ENV_RDIR}/${ENV_CURRENT_NAME}

set-environment()
{
    test -n "${1}" || return 1
    local admin_login=${1}

    local base_name=${0/*\/}

    REALM=${CURRENT_DOMAIN_NAME^^}

    AD_PASSWORD_MESSAGE="Password for ${admin_login}@${REALM}"
    AD_PASSWORD_MESSAGE_LEN=${#AD_PASSWORD_MESSAGE}

    MIT_PASSWORD_MESSAGE="Authenticating as principal ${admin_login}@${REALM} with password."
    MIT_PASSWORD_MESSAGE_LEN=${#MIT_PASSWORD_MESSAGE}

    TMP_ERROR_FILE=/tmp/${base_name}.error.${$}
}

reset-kerberos-create-log()
{
    echo -n > ${KERBEROS_CREATE_LOG}
    chmod 640 ${KERBEROS_CREATE_LOG}
    chown ${ADMIN_NAME}:${GROUP_NAME} ${KERBEROS_CREATE_LOG}
}

kerberos-create-log()
{
    test -n "${1}" || return 1
    local message=${1}

    local date=$(date +"%Y/%m/%d-%T")
    echo -n "0 ${date} ${message}" >> ${KERBEROS_CREATE_LOG}
}

kerberos-create-internal-log()
{
    kerberos-create-log "Internal message: ${@}"
}

kerberos-create-log-abort()
{
    echo >> ${KERBEROS_CREATE_LOG}
}

kerberos-create-log-ret()
{
    test -n "${1}" || return 1
    local err_code=${1}

    if test ${err_code} -eq 0 ; then
	echo "[OK]" >> ${KERBEROS_CREATE_LOG}
    else
	echo " (${err_code}) [KO]" >> ${KERBEROS_CREATE_LOG}
    fi
}

clean-exit()
{
    trap "" USR1 INT QUIT TERM

    local code=${1}
    wait
    manage-appliance-unlock
    kerberos-create-log-abort
    kerberos-create-log "Aborting the Kerberos Create operation"
    kerberos-create-log-ret ${?}
    exit ${code}
}


del-kerberos-tgt()
{
    kdestroy -q -A
}

get-kerberos-tgt()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    test -n "${3}" || return 3
    local mode=${1}
    local admin_login=${2}
    local admin_password=${3}

    local kinit_options

    case ${mode} in
	ad)
	    kinit_options=" -F -P -A"
	    ;;
	mit)
	    ;;
    esac

    del-kerberos-tgt

    kerberos-create-log "Obtaining a TGT (Ticket-Granting Ticket)"
    echo "${admin_password}" | kinit${kinit_options} ${admin_login} > ${TMP_ERROR_FILE} 2>&1
    local ret=${?}
    kerberos-create-log-ret ${ret}

    if test ${ret} -ne 0 ; then
	local message i=0
	while read message
	do
	    test -n "${message}" || continue
	    test "${message:0:${AD_PASSWORD_MESSAGE_LEN}}" != "${AD_PASSWORD_MESSAGE}" || continue
	    message=${message/kinit: }
	    kerberos-create-internal-log "${message}" ; kerberos-create-log-ret $[111 + ${i}]
	    message="Getting a TGT: ${message}"
	    logger -p daemon.alert -t apl_kerberos_create -- "${message}"
	    ${LOCAL_DIR}/bin/apl_rlogger "${message}"
	    ((i++))
	done < ${TMP_ERROR_FILE}
	rm -f ${TMP_ERROR_FILE}
	return 13
    fi

    rm -f ${TMP_ERROR_FILE}
}

get-kerberos-test-token()
{
    kerberos-create-log "Getting a testing Token for '${CURRENT_KERBEROS_SERVICE_NAME}'"

    local token=$(${PROXY_DIR}/libexec/negotiate_kerberos_auth_test ${CURRENT_KERBEROS_SERVICE_NAME}.${CURRENT_DOMAIN_NAME} 2> ${TMP_ERROR_FILE})
    token=${token/Token: }
    local message=$(cat ${TMP_ERROR_FILE} 2> /dev/null) ; rm -f ${TMP_ERROR_FILE}

    test -n "${token}" -a "${token}" != NULL
    if test ${?} -eq 0 ; then
	kerberos-create-log-ret 0
	return 0
    fi

    kerberos-create-log-ret 11

    if test -n "${message}" ; then
	kerberos-create-internal-log "${message}" ; kerberos-create-log-ret 17
	message="Getting a testing token: ${message}"
	logger -p daemon.alert -t apl_kerberos_create -- "${message}"
	${LOCAL_DIR}/bin/apl_rlogger "${message}"
	return 11
    fi
}

ad-kerberos-keytab-create()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    test -n "${3}" || return 3
    test -n "${4}" || return 4
    test -n "${5}" || return 5
    local computer_name=${1}
    local full_service_name=${2}
    local kerberos_server=${3}
    local description=${4}
    local tag=${5}

    local message errors n i=0
    declare -a errors

    local password_options
    declare -a password_options

    test -z "${CURRENT_AD_WEBGATEWAY_PASSWORD}" || \
	password_options=(--dont-expire-password --password '${CURRENT_AD_WEBGATEWAY_PASSWORD}')

    local enctypes='0x1c'
    kerberos-create-log "Creating the '${computer_name}' object and its associated key table entry"

    msktutil create \
	     --user-creds-only --no-reverse-lookups --server-behind-nat \
	     --auto-update-interval ${KERBEROS_PASSWORD_VALIDITY_DAYS} \
	     --enctypes ${enctypes} \
	     --keytab ${PROXY_DIR}${KERBEROS_KEYTAB_FILE_FPROXY} \
	     --base "${CURRENT_AD_WEBGATEWAY_RDN}" \
	     --server ${kerberos_server} \
	     --service HTTP/${full_service_name} \
	     --service host/${full_service_name} \
	     --upn host/${computer_name}.${CURRENT_DOMAIN_NAME}@${REALM} \
	     --computer-name ${CURRENT_AD_WEBGATEWAY_LOGIN} \
	     --hostname ${full_service_name} \
	     --sasl-mechanisms "GSS-SPNEGO GSSAPI" \
	     --description "${description}" \
	     --check-replication \
    	     "${password_options[@]}" \
	     > ${TMP_ERROR_FILE} 2>&1

    local found=yes

    while read message
    do
	test -n "${message}" || continue
	case "${message}" in
	    "No computer account for ${computer_name} found, creating a new one.")
		unset found
		;;
	    *)
		errors[${i}]=${message}
		((i++))
		;;
	esac
    done < ${TMP_ERROR_FILE}
    rm -f ${TMP_ERROR_FILE}

    n=${#errors[@]}

    if test ${n} -eq 0 ; then
	kerberos-create-log-ret 0
	if test -z "${found}" ; then
	    local seconds=2
	    kerberos-create-log "Waiting a few seconds for the '${computer_name}' creation"
	    sleep ${seconds}
	    kerberos-create-log-ret 0
	fi
	return 0
    else
	kerberos-create-log-ret 1
	for ((i=0 ; i<n ; i++))
	do
	    message=${errors[${i}]}
	    kerberos-create-internal-log "${message}" ; kerberos-create-log-ret $[111 + ${i}]
	    message="Keytab creation (${tag}/${computer_name}): ${message}"
	    logger -p daemon.alert -t apl_kerberos_create -- "${message}"
	    ${LOCAL_DIR}/bin/apl_rlogger "${message}"
	done
	rm -f ${keytab_file}
	return 11
    fi
}

ad-kerberos-keytab-update()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    test -n "${3}" || return 3
    test -n "${4}" || return 4
    local keytab_file=${1}
    local computer_name=${2}
    local full_service_name=${3}	
    local tag=${4}

    local message
    local errors i=0 n
    declare -a errors

    kerberos-create-log "Updating the Key Table file for '${computer_name}'"
    msktutil auto-update \
	     --no-reverse-lookups --server-behind-nat \
	     --auto-update-interval ${KERBEROS_PASSWORD_VALIDITY_DAYS} \
	     --keytab ${keytab_file} \
	     --computer-name ${CURRENT_AD_WEBGATEWAY_LOGIN} \
	     --hostname ${full_service_name} \
	     --sasl-mechanisms "GSS-SPNEGO GSSAPI" \
	     > ${TMP_ERROR_FILE} 2>&1

    while read message
    do
	test -n "${message}" || continue
	errors[${i}]=${message}
	((i++))
    done < ${TMP_ERROR_FILE}
    rm -f ${TMP_ERROR_FILE}

    n=${#errors[@]}

    if test ${n} -eq 0 ; then
	kerberos-create-log-ret 0
	return 0
    else
	kerberos-create-log-ret 1
	for ((i=0 ; i<n ; i++))
	do
	    message=${errors[${i}]}
	    kerberos-create-internal-log "${message}" ; kerberos-create-log-ret $[211 + ${i}] 
	    message="Keytab updating (${tag}/${computer_name}): ${message}"
	    logger -p daemon.alert -t apl_kerberos_create -- "${message}"
	    ${LOCAL_DIR}/bin/apl_rlogger "${message}"
	done
	return 211
    fi
}

ad-kerberos-create()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    local admin_login=${1}
    local admin_password=${2}

    local kerberos_server=${CURRENT_KERBEROS_SERVER_LIST/ *}
    test -n "${kerberos_server}" || return 11

    local ret

    kerberos-create-log "Resetting Key Table files"
    rm -f \
       ${PROXY_DIR}${KERBEROS_KEYTAB_FILE_FPROXY} \
       ${WEB_SERVER_DIR}${KERBEROS_KEYTAB_FILE_RPROXY}
    kerberos-create-log-ret ${?}

    if test-current-kerberos-web-is-active ; then
	ad-kerberos-keytab-create \
	    ${CURRENT_KERBEROS_SERVICE_NAME} \
	    ${CURRENT_KERBEROS_SERVICE_NAME}.${CURRENT_DOMAIN_NAME} \
	    ${kerberos_server} \
	    "${COMMERCIAL_NAME} UTM Appliance" \
	    fProxy \
	    || return 13

	if test -f ${PROXY_DIR}${KERBEROS_KEYTAB_FILE_FPROXY} ; then
	    chgrp cache ${PROXY_DIR}${KERBEROS_KEYTAB_FILE_FPROXY}
	    chmod g+r ${PROXY_DIR}${KERBEROS_KEYTAB_FILE_FPROXY}
	else
	    return 15
	fi

	get-kerberos-test-token || return 17
    fi

    if test-current-kerberos-rweb-is-active ; then
	local computer_name site_name
	local elt range i=0

	for elt in ${CURRENT_KERBEROS_RWEB_LIST}
	do
	    range=$[${i} % 2]
	    case ${range} in
		0)
		    site_name=${elt}
		    ;;
		1)
		    computer_name=${elt}
		    ad-kerberos-keytab-create \
			${computer_name} \
			${site_name} \
			${kerberos_server} \
			"The ${site_name} Cloaked by ${COMMERCIAL_NAME}" \
			rProxy \
			|| break
		    ;;
		*)
		    return 255
		    ;;
	    esac
	    ((i++))
	done
    fi

    if test -z "${CURRENT_AD_WEBGATEWAY_PASSWORD}" ; then
	if test-current-kerberos-web-is-active ; then
	    ad-kerberos-keytab-update \
		${PROXY_DIR}${KERBEROS_KEYTAB_FILE_FPROXY} \
		${CURRENT_KERBEROS_SERVICE_NAME} \
		${CURRENT_KERBEROS_SERVICE_NAME}.${CURRENT_DOMAIN_NAME} \
		fProxy \
		|| return 21
	fi
	if test-current-kerberos-rweb-is-active ; then
	    i=0
	    for elt in ${CURRENT_KERBEROS_RWEB_LIST}
	    do
		range=$[${i} % 2]
		case ${range} in
		    0)
			site_name=${elt}
			;;
		    1)
			computer_name=${elt}
			ad-kerberos-keytab-update \
			    ${PROXY_DIR}${KERBEROS_KEYTAB_FILE_FPROXY} \
			    ${computer_name} \
			    ${site_name} \
			    rProxy \
			    || break
			;;
		    *)
			return 255
			;;
		esac
		((i++))
	    done
	fi
    fi

    if test -f ${PROXY_DIR}${KERBEROS_KEYTAB_FILE_FPROXY} ; then
	cp -f ${PROXY_DIR}${KERBEROS_KEYTAB_FILE_FPROXY} ${WEB_SERVER_DIR}${KERBEROS_KEYTAB_FILE_RPROXY}
	chgrp filter ${WEB_SERVER_DIR}${KERBEROS_KEYTAB_FILE_RPROXY}
	chmod g+r ${WEB_SERVER_DIR}${KERBEROS_KEYTAB_FILE_RPROXY}
    else
	return 31
    fi
}

mit-kerberos-keytab-create()
{
    test -n "${1}" || return 1
    local service_name=${1}

    local service_principal="HTTP/${service_name}.${CURRENT_DOMAIN_NAME}@${REALM}"
    local command_info ret
    local message i=0

    kerberos-create-log "Creating the '${service_name}' HTTP service"
    command_info=$("${KADMIN_COMMAND[@]}" -q "get_principal ${service_principal}" 2>&1)

    if grep --quiet "^Principal: ${SERVICE_PRINCIPAL}$" <<< "${command_info}" ; then
	ret=0
    else
	"${KADMIN_COMMAND[@]}" -q "add_principal -randkey ${service_principal}" > ${TMP_ERROR_FILE} 2>&1
	ret=${?}
    fi
    kerberos-create-log-ret ${ret}

    if test ${ret} -ne 0 ; then
	while read message
	do
	    test -n "${message}" || continue
	    test "${message:0:${MIT_PASSWORD_MESSAGE_LEN}}" != "${MIT_PASSWORD_MESSAGE}" || continue
	    message=${message/kadmin: }
	    kerberos-create-internal-log "${message}" ; kerberos-create-log-ret $[111 + ${i}]
	    message="Adding ${service_principal}: ${message}"
	    logger -p daemon.alert -t apl_kerberos_create -- "${message}"
	    ${LOCAL_DIR}/bin/apl_rlogger "${message}"
	    ((i++))
	done < ${TMP_ERROR_FILE}
	rm -f ${TMP_ERROR_FILE}
	return 11
    fi
    rm -f ${TMP_ERROR_FILE}

    kerberos-create-log "Adding the '${service_name}' to the key table"

    if test -f ${PROXY_DIR}${KERBEROS_KEYTAB_FILE_FPROXY} ; then
	klist -k ${PROXY_DIR}${KERBEROS_KEYTAB_FILE_FPROXY} 2> /dev/null | grep --fixed-strings --quiet "${service_principal}"
	ret=${?}
    else
	ret=1
    fi
    
    if test ${ret} -eq 0 ; then
	kerberos-create-log-ret 0
	return 0
    fi

    "${KADMIN_COMMAND[@]}" -q "ktadd -k ${PROXY_DIR}${KERBEROS_KEYTAB_FILE_FPROXY} ${service_principal}" > ${TMP_ERROR_FILE} 2>&1
    if grep --fixed-strings --quiet "added to keytab WRFILE:${PROXY_DIR}${KERBEROS_KEYTAB_FILE_FPROXY}" ${TMP_ERROR_FILE} ; then
	ret=0
    else
	ret=1
    fi

    kerberos-create-log-ret ${ret}

    if test ${ret} -ne 0 ; then
	i=0
	while read message
	do
	    test -n "${message}" || continue
	    test "${message:0:${MIT_PASSWORD_MESSAGE_LEN}}" != "${MIT_PASSWORD_MESSAGE}" || continue
	    message=${message/kadmin: }
	    kerberos-create-internal-log "${message}" ; kerberos-create-log-ret $[111 + ${i}]
	    message="Adding ${service_principal} to the key table: ${message}"
	    logger -p daemon.alert -t apl_kerberos_create -- "${message}"
	    ${LOCAL_DIR}/bin/apl_rlogger "${message}"
	done < ${TMP_ERROR_FILE}
	rm -f ${TMP_ERROR_FILE}
	return 15
    fi

    rm -f ${TMP_ERROR_FILE}
}

mit-kerberos-create()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    local admin_login=${1}
    local admin_password=${2}

    local kerberos_server=${CURRENT_KERBEROS_SERVER_LIST/ *}
    test -n "${kerberos_server}" || return 11

    export KADMIN_COMMAND=(kadmin -p "${admin_login}@${REALM}" -w "${admin_password}")

    local ret

    kerberos-create-log "Checking Kerberos administrator credentials"
    "${KADMIN_COMMAND[@]}" -q "quit" > ${TMP_ERROR_FILE} 2>&1
    ret=${?}
    kerberos-create-log-ret ${ret}

    if test ${ret} -ne 0 ; then
	local message i=0
	while read message
	do
	    test -n "${message}" || continue
	    test "${message:0:${MIT_PASSWORD_MESSAGE_LEN}}" != "${MIT_PASSWORD_MESSAGE}" || continue
	    message=${message/kadmin: }
	    kerberos-create-internal-log "${message}" ; kerberos-create-log-ret $[111 + ${i}]
	    message="Checking administrator credentials: ${message}"
	    logger -p daemon.alert -t apl_kerberos_create -- "${message}"
	    ${LOCAL_DIR}/bin/apl_rlogger "${message}"
	done < ${TMP_ERROR_FILE}
	rm -f ${TMP_ERROR_FILE}
	return 13
    fi
    rm -f ${TMP_ERROR_FILE}

    if test-current-kerberos-web-is-active ; then
	mit-kerberos-keytab-create ${CURRENT_KERBEROS_SERVICE_NAME} || return 15

	if test -f ${PROXY_DIR}${KERBEROS_KEYTAB_FILE_FPROXY} ; then
	    chgrp cache ${PROXY_DIR}${KERBEROS_KEYTAB_FILE_FPROXY}
	    chmod g+r ${PROXY_DIR}${KERBEROS_KEYTAB_FILE_FPROXY}
	else
	    return 17
	fi

	get-kerberos-test-token || return 19
    fi

    if test-current-kerberos-rweb-is-active ; then
	local service_name site_name
	local elt range i=0

	for elt in ${CURRENT_KERBEROS_RWEB_LIST}
	do
	    range=$[${i} % 2]
	    case ${range} in
		0)
		    site_name=${elt}
		    ;;
		1)
		    service_name=${elt}
		    mit-kerberos-keytab-create ${service_name} || break
		    ;;
		*)
		    return 255
		    ;;
	    esac
	    ((i++))
	done
    fi

    if test -f ${PROXY_DIR}${KERBEROS_KEYTAB_FILE_FPROXY} ; then
	cp -f ${PROXY_DIR}${KERBEROS_KEYTAB_FILE_FPROXY} ${WEB_SERVER_DIR}${KERBEROS_KEYTAB_FILE_RPROXY}
	chgrp filter ${WEB_SERVER_DIR}${KERBEROS_KEYTAB_FILE_RPROXY}
	chmod g+r ${WEB_SERVER_DIR}${KERBEROS_KEYTAB_FILE_RPROXY}
    else
	return 31
    fi
}

main()
{
    trap "clean-exit 100" USR1 INT QUIT TERM

    test -n "${1}" || return 1
    local admin_login=${1}
    local admin_password=${2}
    shift 2

    manage-appliance-lock

    if test -z "${admin_password}"; then
	echo -n "${AD_PASSWORD_MESSAGE}: "
	stty -echo
	read admin_password
	stty echo
	echo
    fi

    local mode ret

    if test ${CURRENT_AUTHENTICATE_AD_MODE} == True ; then
	mode='ad'
    else
	mode='mit'
    fi

    reset-kerberos-create-log

    kerberos-create-log "Beginig Kerberos Create operation"
    kerberos-create-log-ret ${?}

    kerberos-create-log "Checking the Kerberos authentication mode state"
    test-current-kerberos-auth-state ; ret=${?}
    kerberos-create-log-ret ${ret}

    if test ${ret} -eq 0 -a -n "${admin_password}" ; then

	kerberos-create-log "Stopping the Health Check service"
	/etc/rc.d/init.d/health stop > /dev/null 2>&1
	kerberos-create-log-ret ${?}

	if test-current-kerberos-web-is-active ; then
	    kerberos-create-log "Stopping the Proxy Cache service"
	    /etc/rc.d/init.d/squid stop > /dev/null 2>&1
	    kerberos-create-log-ret ${?}
	fi

	if test ${CURRENT_RWEB_MODE} == True ; then
	    if test-current-kerberos-rweb-is-active ; then
		kerberos-create-log "Stopping the Web Server service"
		/etc/rc.d/init.d/httpd stop > /dev/null 2>&1
		kerberos-create-log-ret ${?}
	    fi
	fi

	get-kerberos-tgt ${mode} "${admin_login}" "${admin_password}" ; ret=${?}

	if test ${ret} -eq 0 ; then
	    if test ${mode} == 'ad' ; then
		! ad-kerberos-create "${admin_login}" "${admin_password}" "${@}" || rm -f ${TMP_DIR}/${KERBEROS_CREATE_FILENAME}
	    else
		! mit-kerberos-create "${admin_login}" "${admin_password}" "${@}" || rm -f ${TMP_DIR}/${KERBEROS_CREATE_FILENAME}
	    fi
	fi

	if test ${CURRENT_RWEB_MODE} == True ; then
	    if test-current-kerberos-rweb-is-active ; then
		kerberos-create-log "Starting the Web Server service"
		/etc/rc.d/init.d/httpd start > /dev/null 2>&1
		kerberos-create-log-ret ${?}
	    fi
	fi

	if test-current-kerberos-web-is-active ; then
	    kerberos-create-log "Starting the Proxy Cache service"
	    /etc/rc.d/init.d/squid start > /dev/null 2>&1
	    kerberos-create-log-ret ${?}
	fi

	kerberos-create-log "Starting the Health Check service"
	/etc/rc.d/init.d/health start > /dev/null 2>&1
	kerberos-create-log-ret ${?}
    fi
    
    kerberos-create-log "Ending the Kerberos Create operation"
    kerberos-create-log-ret ${?}
    del-kerberos-tgt
    manage-appliance-unlock
}

# Main()

set-environment "${@}"
main "${@}"
