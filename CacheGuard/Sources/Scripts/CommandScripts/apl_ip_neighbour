test ! -f /var/lock/apl_ip_neighbour || exit 1
touch /var/lock/apl_ip_neighbour

CACHEGUARD_DIR=/etc/sysconfig/cacheguard
source ${CACHEGUARD_DIR}/constant
source ${APPLIANCE_DIR}/etc/role

set-environment()
{
    if test -n "${1}" ; then
	CALLER_PID=${1}
    else
	CALLER_PID=${$}
    fi

    TMP_WAITING_PROCESS=/tmp/${WAITING_PROCESS}.${CALLER_PID}

    trap "clean-exit 1" USR1 INT QUIT TERM
}

clean-exit()
{
    trap "" USR1 INT QUIT TERM
    
    local code=${1}

    rm -f \
       /var/lock/apl_ip_neighbour \
       ${TMP_WAITING_PROCESS}

    exit ${code}
}

signal-process-termination()
{
    touch ${TMP_WAITING_PROCESS}
    install -m 664 -o ${ADMIN_NAME} -g ${GROUP_NAME} ${TMP_WAITING_PROCESS} \
	    ${RUN_DIR}/${SUPERVISOR_CALLER}/${WAITING_PROCESS}.${CALLER_PID}
    rm -f ${TMP_WAITING_PROCESS}
}

main()
{
    local ip dummy dev itype mac state
    local tmp_file=/tmp/ip.neighbour.${$}

    set-environment "${@}"

    ip neighbour > ${tmp_file} 2> /dev/null

    while read ip dummy dev itype mac state
    do
	test ${itype} != FAILED || continue
	test ${itype} == lladdr || continue
	echo ${ip} ${dev} ${mac}
    done < ${tmp_file} > ${RUN_DIR}/${IP_NEIGHBOUR_FILENAME}

    rm -f ${tmp_file}

    signal-process-termination
    clean-exit 0
}

# Main()

main "${@}"
