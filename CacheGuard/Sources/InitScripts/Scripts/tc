source /lib/lsb/init-functions

CACHEGUARD_DIR=/etc/sysconfig/cacheguard
source ${CACHEGUARD_DIR}/constant

TC_CONFIG=/etc/sysconfig/tc

test -x /sbin/tc || exit
test -L ${TC_CONFIG} || exit

DEBUG=no
TC_CMD=tc
IP_CMD=ip
SERV=QoS

cd /sys/class/net
IFBS=$(ls -d ifb* 2> /dev/null)

RETVAL=0

link-ifb()
{
    local ifb

    case "${1}" in
	start)
	    for ifb in ${IFBS}
	    do
		${IP_CMD} link set up dev ${ifb} 2> /dev/null 1>&2
	    done
	    ;;
	stop)
	    for ifb in ${IFBS}
	    do
		${IP_CMD} link set down dev ${ifb} 2> /dev/null 1>&2
	    done
	    ;;
	*)
    esac
}

show-tc-status()
{
    local ret

    if test -z "${1}" ; then
	${TC_CMD} -s -d qdisc show
	ret=${?}
    else
	local dev=${1}
	if test -z "${2}" ; then
	    ${TC_CMD} -s -d qdisc show dev ${dev}
	    ret=${?}
	else
	    local in_handle=${2}
	    local dummy qdisc handle rest
	    local found=0
	    ${TC_CMD} -s -d qdisc show dev ${dev} | \
		while read dummy qdisc handle rest
		do
		    if test ${handle} == ${in_handle} ; then
			echo ${dummy} ${qdisc} ${handle} ${rest}
			found=1
		    elif test ${found} -eq 1 ; then
			echo ${dummy} ${qdisc} ${handle} ${rest}
			break
		    fi
		done
	    ret=${PIPESTATUS[0]}
	fi
    fi

    return ${ret}
}

case "${1}" in
    start)
	log_info_msg "Starting ${SERV}..."
	RETVAL=0
	I=0
	while read LINE ; do
	    ((I++))
	    test -n "${LINE}" || continue
	    test "${LINE:0:1}" != "#" || continue

	    if [ "${DEBUG}" == no ] ; then
		${TC_CMD} ${LINE} 2> /dev/null 1>&2
	    else
		${TC_CMD} ${LINE}
	    fi

	    if [ ${?} -ne 0 ] ; then
		((RETVAL++))
		[ "${DEBUG}" == no ] || echo "*** Error on LINE ${I}: ${LINE}"
	    fi
	done < ${TC_CONFIG}

	link-ifb ${1}
	[ ${?} -eq 0 ] || ((RETVAL++))
	[ "${DEBUG}" == no -o ${RETVAL} -eq 0 ] || echo "*** Number of errors ${RETVAL}"
	[ ${RETVAL} -eq 0 ]
	evaluate_retval
	exit ${RETVAL}
	;;

    stop)
	log_info_msg "Stopping ${SERV}... "
	FILES=$(ls /etc/sysconfig/ifconfig.{eth,bond}* 2>/dev/null)
	for FILE in ${FILES}
	do
	    INTERFACE=$(basename ${FILE})
	    INTERFACE=${INTERFACE/ifconfig\./}
            test ${INTERFACE/\:*} == ${INTERFACE} || continue
	    ls ${FILE}.* > /dev/null 2>&1
	    test ${?} -ne 0 || continue

	    ${TC_CMD} qdisc del dev ${INTERFACE} root 2> /dev/null 1>&2
	    ${TC_CMD} qdisc del dev ${INTERFACE} ingress 2> /dev/null 1>&2
	done

	for IFB in ${IFBS}
	do
	    ${TC_CMD} qdisc del dev ${IFB} root 2> /dev/null 1>&2
	done
	link-ifb ${1}
	RETVAL=${?}
	rm -f ${RUN_DIR}/${QOS_DIFF_TRAFFIC_FILENAME} ${RUN_DIR}/${QOS_TRAFFIC_FILENAME}{,.old}
	[ ${RETVAL} -eq 0 ]
	evaluate_retval
	exit ${RETVAL}
	;;

    restart)
	${0} stop
	${0} start
	;;

    status)
	shift ; show-tc-status "${@}"
	RETVAL=${?}
	exit ${RETVAL}
	;;
    *)
	echo "Usage: ${0} {start|stop|restart|status}"
	exit 1
	;;
esac
