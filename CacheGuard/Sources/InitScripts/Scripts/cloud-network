source /lib/lsb/init-functions

CACHEGUARD_DIR=/etc/sysconfig/cacheguard
source ${CACHEGUARD_DIR}/constant
source ${APPLIANCE_DIR}/etc/role
source ${HARD_DIR}/cloud.conf

case ${CLOUD_NAME} in
    azure)
	;;
    aws)
	;;
    *)
	exit 0
	;;
esac

get-ip-px()
{
    test -n "${1}" || return 1
    local dev=${1}

    local ip_px=$(ip --oneline -4 address show dev ${dev} 2> /dev/null)
    ip_px=${ip_px#* inet }
    ip_px=${ip_px%% *}

    echo ${ip_px}
}

check-cloud-ip()
{
    test -z "${CLOUD_VALID_IP}" || return 0

    log_info_msg "Checking valid cloud IP..."

    apl_cloud_update_ip
    local retval=${?}

    case ${retval} in
	200)
	    CLOUD_VALID_IP=yes
	    retval=0
	    ;;
	201)
	    CLOUD_VALID_IP=no
	    retval=1
	    ;;
	*)
	    ;;
    esac

    [ ${retval} -eq 0 ]
    evaluate_retval

    return ${retval}
}

start-network()
{
    local tries=0 max_tries=60 usleep=500000
    local internal_ip_px default_route
    local retval

    log_info_msg "Getting dynamic IP addresses..."

    cat << EOT > /etc/sysconfig/dhclient
RESOLV_CONF_DIR=${CLOUD_RESOLV_DIR}
CLOUD_NETWORK_MAIN_DEV=${CLOUD_NETWORK_MAIN_DEV}
EOT

    case ${APL_ROLE} in
	gateway)
	    ip link show dev ${CLOUD_NETWORK_SECOND_DEV} > /dev/null 2>&1

	    if test ${?} -eq 0 ; then
		retval=1
		dhclient -4 -q ${CLOUD_NETWORK_SECOND_DEV} ${CLOUD_NETWORK_MAIN_DEV} 2> /dev/null
		while true
		do
		    internal_ip_px=$(get-ip-px ${CLOUD_NETWORK_SECOND_DEV})
		    if test -n "${internal_ip_px}" ; then
			retval=0
			break
		    fi
		    test ${tries} -lt ${max_tries} || break
		    ((tries++))
		    usleep ${usleep}
		done
	    else
		retval=0
		dhclient -4 -q ${CLOUD_NETWORK_MAIN_DEV} 2> /dev/null
	    fi
	    ;;
	manager)
	    retval=0
	    dhclient -4 -q ${CLOUD_NETWORK_MAIN_DEV} 2> /dev/null
	    ;;
	*)
	    ;;
    esac

    if test ${retval} -ne 0 ; then
	[ ${retval} -eq 0 ]
	evaluate_retval
	return ${retval}
    fi

    local default_route

    retval=1
    tries=0
    tries=30 usleep=500000

    while true
    do
	default_route=$(ip route 2> /dev/null | grep 'default via')
	if test -n "${default_route}" ; then
	    retval=0
	    break
	fi
	test ${tries} -lt ${max_tries} || break
	((tries++))
	usleep ${usleep}
    done

    if test ${retval} -eq 0 -a -f ${CLOUD_RESOLV_DIR}/resolv.conf ; then
	cp -f ${CLOUD_RESOLV_DIR}/resolv.conf ${CONF_DIR}/resolv.conf
    fi

    [ ${retval} -eq 0 ]
    evaluate_retval
    return ${retval}
}

stop-network()
{
    log_info_msg "Releasing dynamic IP addresses..."
    dhclient -4 -q -r 2> /dev/null
    local retval=${?}

    [ ${retval} -eq 0 ]
    evaluate_retval
    return ${retval}
}

case "${1}" in
    start)
	start-network &&
	    check-cloud-ip
	;;
    stop)
	stop-network
	;;
    restart)
	${0} stop
	usleep 500000
	${0} start
	;;
    *)
	echo "Usage: ${0} {start|stop|restart}"
	exit 1
	;;
esac
