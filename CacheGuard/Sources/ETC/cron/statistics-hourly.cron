CACHEGUARD_DIR=/etc/sysconfig/cacheguard
source ${CACHEGUARD_DIR}/constant
source ${APPLIANCE_DIR}/etc/role
source ${LOCAL_DIR}/lib/apl_common

truncate-network-statistics()
{
    local stat_file tmp_file

    local record_nb=$[${STATISTICS_HISTORY} / ${STATISTICS_INTERVAL}]
    local stat_files=$(ls -1 ${RUN_DIR}/${NETWORK_STATISTICS_FILENAME}.* 2> /dev/null)

    for stat_file in ${stat_files}
    do
	tmp_file="/tmp/$(file-basename ${stat_file})-hourly.${$}"
	tail -${record_nb} ${stat_file} > ${tmp_file}
	mv -f ${tmp_file} ${stat_file}
    done
}

main()
{
    truncate-network-statistics
}

# Main()

main
