CHFN_AUTH		yes
CHFN_RESTRICT		rwh
CHSH_AUTH		yes
CONSOLE			/etc/securetty
CREATE_HOME		no
DEFAULT_HOME		no
ENCRYPT_METHOD		MD5
ENV_HZ			HZ=100
ENV_TZ			/etc/localtime
ENV_PATH		PATH=/usr/local/bin:/usr/bin:/bin
ENV_SUPATH		PATH=/usr/local/sbin:/usr/sbin:/sbin:/usr/local/bin:/usr/bin:/bin
ERASECHAR		0177
FAIL_DELAY		3
FAILLOG_ENAB		no
GID_MAX			4000
GID_MIN			3000
ISSUE_FILE		/etc/issue
KILLCHAR		025
LASTLOG_ENAB		no
LOG_OK_LOGINS		no
LOG_UNKFAIL_ENAB	no
LOGIN_RETRIES		3
LOGIN_STRING		Password:
LOGIN_TIMEOUT		90
MAIL_CHECK_ENAB		no
MAIL_DIR		/dev/null
MAX_MEMBERS_PER_GROUP	64
MD5_CRYPT_ENAB		yes
OBSCURE_CHECKS_ENAB	no
PASS_ALWAYS_WARN	yes
PASS_CHANGE_TRIES	5
PASS_MAX_DAYS		-1
PASS_MIN_DAYS		-1
PASS_WARN_AGE		-1
PASS_MIN_LEN		12
PASS_MAX_LEN		32
PORTTIME_CHECKS_ENAB	no
QUOTAS_ENAB		yes
SU_NAME			superuser
SU_WHEEL_ONLY		no
SYS_GID_MAX		4000
SYS_GID_MIN		3000
SYS_UID_MAX		4000
SYS_UID_MIN		3000
SYSLOG_SG_ENAB		yes
SYSLOG_SU_ENAB		yes
TTYGROUP		tty
TTYPERM			0600
