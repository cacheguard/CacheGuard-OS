if test ${TERM} != ${WADMIN_TERM} ; then

    update-google-authenticator

    if test "${__BATCH_MODE}" != yes ; then
	first-startup-license
	first-login-password
	first-login-2fa
	first-startup-setup
    fi
fi

unset -f first-startup-license
unset -f first-login-password
unset -f first-login-2fa
unset -f first-startup-setup
unset -f update-google-authenticator
unset WADMIN_TERM

set -o keyword
set -o nounset

enable -n set
enable -n export
enable -n enable

history -c
