get-html-bold-command()
{
    test -n "${1}" || return 1
    local cmd=${1}

    cmd="<a href='${DOC_COMMAND_DIR}/${cmd}.html' target='_blank'>${cmd}</a>"

    echo ${cmd}
}

get-magnified-command()
{
    test -n "${1}" || return 1
    local cmd=${1}

    if test ${TERM} == ${WADMIN_TERM} ; then
	cmd=$(get-html-bold-command ${cmd})
    else
	cmd=$(get-terminal-bold-text ${cmd})
    fi

    echo ${cmd}
}

get-magnified-error-text()
{
    test -n "${1}" || return 1
    local in_txt=${1}

    local out_txt wrd len

    for wrd in ${in_txt}
    do
	if test ${wrd:0:1} != '@' ; then
	    out_txt="${out_txt} ${wrd}"
	    continue
	fi

	len=${#wrd}
	((len--))

	if test ${wrd:${len}:1} != '@' ; then
	    out_txt="${out_txt} ${wrd}"
	    continue
	fi

	((len--))
	wrd=${wrd:1:${len}}
	wrd=$(get-magnified-command ${wrd})

	out_txt="${out_txt} [${wrd}]"
    done

    test ${TERM} == ${WADMIN_TERM} || out_txt="${out_txt} To do, so use the $(get-terminal-bold-text help) command followed by the command name."

    out_txt=${out_txt:1}
    echo ${out_txt}
}

display-error()
{
    test -n "${1}" || return 1
    local err=${1}
    local txt=${2}

    local txt tag com trx

    txt="${txt}${Errors[${err}]}"

    if test ${TERM} == ${WADMIN_TERM} ; then
	tag="${ERROR_TAG}"
    else
	tag='***'
	com=$(file-basename ${ARGS[0]})
	test -z "${TRANSACTION}" || trx=" ($(get-magnified-command "${com}") command)"
    fi

    if test -z "${txt}" ; then
	txt="No error description has been defined for this error."
    else
	if test ${err} -le 254 -o ${err} -ge 512 ; then
	    test ${TERM} == ${WADMIN_TERM} || txt="${txt} Refer to the invoked command manual: use the $(get-terminal-bold-text "help ${com}") command."
	else
	    txt=$(get-magnified-error-text "${txt}")
	fi
    fi

    echo -e "${tag} Error ${err}${trx} - ${txt}" >&2
}

error()
{
    local in_error_code=${1} error_code
    test -n "${in_error_code}" || in_error_code=255

    if test ${in_error_code} = 254 ; then
	error_code=${INDIRECT_ERROR_CODE}
    else
	error_code=${in_error_code}
    fi

    display-error ${error_code}

    if test -z "${TRANSACTION}" ; then
	exit ${in_error_code}
    else
	LAST_ERROR=${error_code}
    fi
}

display-warning()
{
    test -n "${1}" || return 1
    warn_code=${1}
    
    local warn_text=${Warnings[${warn_code}]}

    if test ${TERM} == ${WADMIN_TERM} ; then
	tag="${WARNING_TAG}"
    else
	tag='+++'
    fi

    echo "${tag} Warning ${warn_code} - ${warn_text}" >&2
}

warning()
{
    if test -z "${1}" ; then local warn_code=255 ; else local warn_code=${1} ; fi
    display-warning ${warn_code}
}

display-info()
{
    test -n "${1}" || return 1
    info_code=${1}

    test "${CLI_SILENT}" != yes || return 0

    local info_text=${Informations[${info_code}]}

    if test ${TERM} == ${WADMIN_TERM} ; then
	tag="${INFO_TAG}"
    else
	tag='---'
    fi

    echo "${tag} Information ${info_code} - ${info_text}" >&2
}

info()
{
    local info_code=${1}
    test -n "${info_code}" || info_code=255

    display-info ${info_code}
}
