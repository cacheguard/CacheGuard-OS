move-record-at-position-in-list()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    test -n "${3}" || return 3
    test -n "${4}" || return 4
    test -n "${5}" || return 5
    local record_len=${1}
    local key_len=${2}
    local in_key=${3}
    local in_list=${4}
    local in_position=${5}

    test ${key_len} -le ${record_len} || return 11
    test ${record_len} -gt 1 || return 0

    local record2move ; record2move=$(get-record-in-list ${record_len} ${key_len} "${in_key}" "${in_list}") || return 15

    local elt range i=0 position=1
    local key value record out_list
    local found

    local record_gap=$[${record_len} - 1]
    local key_gap=$[${key_len} - 1]

    for elt in ${in_list}
    do
	range=$[${i} % ${record_len}]

	test ${range} -ne 0 || unset value key
	test ${range} -ge ${key_len} || key="${key} ${elt}"

	if test ${range} -eq ${record_gap} ; then
	    if test ${record_gap} -ne ${key_gap} ; then
		value="${value} ${elt}"
		value=${value:1}
	    fi
	    key=${key:1}

	    if test "${key}" == "${in_key}" ; then
		((i++))
		continue
	    fi

	    if test -z "${value}" ; then
		record="${key}"
	    else
		record="${key} ${value}"
	    fi

	    if test "${position}" == "${in_position}" ; then
		found=yes
		out_list="${out_list} ${record2move} ${record}"
	    else
		out_list="${out_list} ${record}"
	    fi
	    ((position++))
	elif test ${range} -ge ${key_len} ; then
	    value="${value} ${elt}"
	fi
	((i++))
    done

    if test "${position}" == "${in_position}" ; then
	found=yes
	out_list="${out_list} ${record2move}"
    fi

    echo ${out_list:1}

    if test -n "${found}" ; then
	return 0
    else
	return 21
    fi
}

move-record-in-list()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    test -n "${3}" || return 3
    test -n "${4}" || return 4
    test -n "${5}" || return 5
    test -n "${6}" || return 6
    local record_len=${1}
    local key_len=${2}
    local in_key=${3}
    local in_list=${4}
    local in_position_key=${5}
    local in_position=${6}

    test ${key_len} -le ${record_len} || return 11
    test ${record_len} -gt 1 || return 0

    case "${in_position}" in
	before|after)
	    ;;
	*)
	    return 13
	    ;;
    esac

    local record2move ; record2move=$(get-record-in-list ${record_len} ${key_len} "${in_key}" "${in_list}") || return 15

    if test "${in_key}" == "${in_position_key}" ; then
	echo ${in_list}
	return 0
    fi

    local elt range i=0
    local key value record out_list
    local found

    local record_gap=$[${record_len} - 1]
    local key_gap=$[${key_len} - 1]

    for elt in ${in_list}
    do
	range=$[${i} % ${record_len}]

	test ${range} -ne 0 || unset value key
	test ${range} -ge ${key_len} || key="${key} ${elt}"

	if test ${range} -eq ${record_gap} ; then
	    if test ${record_gap} -ne ${key_gap} ; then
		value="${value} ${elt}"
		value=${value:1}
	    fi
	    key=${key:1}

	    if test "${key}" == "${in_key}" ; then
		((i++))
		continue
	    fi

	    if test -z "${value}" ; then
		record="${key}"
	    else
		record="${key} ${value}"
	    fi

	    if test "${key}" == "${in_position_key}" ; then
		found=yes
		case ${in_position} in
		    before)
			out_list="${out_list} ${record2move} ${record}"
			;;
		    after)
			out_list="${out_list} ${record} ${record2move}"
			;;
		    *)
			return 255
			;;
		esac
	    else
		out_list="${out_list} ${record}"
	    fi
	elif test ${range} -ge ${key_len} ; then
	    value="${value} ${elt}"
	fi
	((i++))
    done

    test -n "${in_position_key}" || out_list="${out_list} ${record2move}"

    echo ${out_list:1}

    if test -n "${found}" ; then
	return 0
    else
	return 21
    fi
}

