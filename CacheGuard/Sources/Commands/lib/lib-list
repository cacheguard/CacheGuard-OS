record-member()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 1
    test -n "${3}" || return 1

    local field_num=${1}
    local list=${2}
    local record=${3}
    
    local field_num1=$[${field_num} - 1]
    local len_record=0 elt_rec

    for elt_rec in ${record}
    do
	len_record=$[${len_record} + 1]
    done
    test -n "${len_record}" || exit 255
    
    local i=0
    local fields
    local len_fields=0 elt range
    for elt in ${list}
    do
	if test ${len_fields} -lt ${len_record} ; then
	    fields="${fields} ${elt}"
	    len_fields=$[${len_fields} + 1]
	fi
	
      range=$[${i} % ${field_num}]
      if test ${range} = ${field_num1} ; then
	  if test "+${fields}+" == "+ ${record}+" ; then return 0 ; fi
	  unset fields
	  len_fields=0
      fi
      
      ((i++))
    done

    return 1
}

record3-member()
{
    record-member 3 "${1}" "${2}"
}

remove()
{
    test -n "${1}" || return 1
    if test -z "${2}" ; then echo "${1}" ;  return 2 ; fi
    
    local in_list=${1}
    local record=${2}

    local out_list elt
    local found

    for elt in ${in_list}
    do
	if test "${elt}" != "${record}" ; then
	    out_list="${out_list} ${elt}"
	else
	    found=yes
	fi
    done

    echo ${out_list:1}
    test -n "${found}"
}

get-record-in-list()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    test -n "${3}" || return 3
    test -n "${4}" || return 4
    local record_len=${1}
    local key_len=${2}
    local in_key=${3}
    local in_list=${4}
    
    local i=0 elt range
    local key value
    local found

    local record_gap=$[${record_len} - 1]
    local key_gap=$[${key_len} - 1]

    for elt in ${in_list}
    do
	range=$[${i} % ${record_len}]
	if test ${range} -lt ${key_gap} ; then
	    key="${key} ${elt}"
	elif test ${range} -eq ${key_gap} ; then
	    key="${key} ${elt}"
	    key=${key:1}
	    if test ${key_gap} -eq ${record_gap} ; then
		if test "${key}" == "${in_key}" ; then
		    if test -z "${value}" ; then
			echo -n "${key}"
		    else
			echo -n "${key} ${value}"
		    fi
		    found=yes
		    break
		else
		    unset key
		    unset value
		fi
	    fi
	elif test ${range} -eq ${record_gap} ; then
	    value="${value} ${elt}"
	    value=${value:1}
	    if test "${key}" == "${in_key}" ; then
		echo -n "${key} ${value}"
		found=yes
		break
	    else
		unset key
		unset value
	    fi
	else
	    value="${value} ${elt}"
	fi
	((i++))
    done

    if test -n "${found}" ; then
	return 0
    else
	return 21
    fi
}

