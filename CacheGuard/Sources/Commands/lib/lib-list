insert-record-in-list()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    local record_len=${1}
    local key_len=${2}
    local in_record=${3}
    local in_list=${4}
    local in_insert_key=${5}
    local in_insert_position=${6}

    test ${key_len} -le ${record_len} || return 11
    test ${record_len} -gt 1 || return 0

    if test -z "${in_record}" ; then
	echo ${in_list}
	return 0
    fi

    if test -z "${in_list}" ; then
	echo ${in_record}
	test -z "${in_insert_key}"
	return ${?}
    fi

    if test -n "${in_insert_key}" ; then
	case "${in_insert_position}" in
	    before|after)
		;;
	    *)
		return 13
		;;
	esac
    fi

    local in_key
    local elt range i=0
    local key value out_list
    local record_gap=$[${record_len} - 1]
    local found

    for elt in ${in_record}
    do
	test ${i} -ge ${key_len} || in_key="${in_key} ${elt}"
	((i++))
    done
    in_key=${in_key:1}

    i=0
    for elt in ${in_list}
    do
	range=$[${i} % ${record_len}]
	test ${range} -ne 0 || unset value key

	if test ${range} -lt ${key_len} ; then
	    key="${key} ${elt}"
	elif test ${range} -eq ${record_gap} ; then
	    value="${value} ${elt}"
	    value=${value:1}
	    key=${key:1}

	    if test -z "${in_insert_key}" ; then
		if test "${key}" == "${in_key}" ; then
		    found=yes
		else
		    out_list="${out_list} ${key} ${value}"
		fi
	    else
		if test "${key}" == "${in_insert_key}" ; then
		    test ${in_insert_position} != before || out_list="${out_list} ${in_record}"
		    found=yes
		fi
		test "${key}" == "${in_key}" || out_list="${out_list} ${key} ${value}"
		test "${key}" != "${in_insert_key}" || test ${in_insert_position} != after || out_list="${out_list} ${in_record}"
	    fi
	else
	    value="${value} ${elt}"
	fi
	((i++))
    done

    test -n "${in_insert_key}" || out_list="${out_list} ${in_record}"

    echo ${out_list:1}

    if test -n "${found}" ; then
	return 0
    else
	return 21
    fi
}

insert-record-in-slist()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    local record_len=${1}
    local key_len=${2}
    local in_record=${3}
    local in_list=${4}

    test ${key_len} -le ${record_len} || return 11
    test ${record_len} -gt 0 || return 0

    if test -z "${in_record}" ; then
	echo ${in_list}
	return 0
    fi

    if test -z "${in_list}" ; then
	echo ${in_record}
	return 0
    fi

    local in_key
    local elt key record i=0
    local out_list rest

    for elt in ${in_record}
    do
	test ${i} -lt ${key_len} || break
	in_key="${in_key} ${elt}"
	((i++))
    done
    in_key=${in_key:1}
    
    while test -n "${in_list}"
    do
	unset record
	for ((i=1 ; i <= record_len ; i++))
	do
	    elt=${in_list/ *}
	    rest=${in_list#* }
	    record="${record} ${elt}"
	    test ${key_len} -ne ${i} || key=${record}

	    if test "${rest}" == "${in_list}" ; then
		unset in_list
		break
	    else
		in_list=${rest}
	    fi
	done

	record=${record:1}
	key=${key:1}

	if [[ "${in_key}" > "${key}" ]] ; then
	    out_list="${out_list} ${record}"
	elif [[ "${in_key}" == "${key}" ]] ; then
	    out_list="${out_list} ${in_record} ${in_list}"
	    break
	else
	    out_list="${out_list} ${in_record} ${record} ${in_list}"
	    break
	fi
    done

    if [[ "${in_key}" > "${key}" ]] ; then
	out_list="${out_list} ${in_record}"
    fi

    echo ${out_list:1}
}

get-diff-list()
{
    local list1=${1}
    local list2=${2}

    local elt

    local file1=${TMP_DIR}/list1.${$}
    local file2=${TMP_DIR}/list2.${$}

    for elt in ${list1}
    do
	echo ${elt}
    done > ${file1}


    for elt in ${list2}
    do
	echo ${elt}
    done > ${file2}

    diff --unified ${file1} ${file2} | grep '^[+-][^-+]' 2> /dev/null
    rm -f ${file1} ${file2}
}

show-diff-list()
{
    local list1=${1}
    local list2=${2}
    local col=${3}

    local elt i=0
    local diff=$(get-diff-list "${list1}" "${list2}")

    for elt in ${diff}
    do
	test ${i} -eq 0 || echo-blank-command
	echo-value ${elt} ${col}
	((i++))
    done
}

revert-list()
{
    test -n "${1}" || return 0
    local list=${1}

    local out_list

    for elt in ${list}
    do
	out_list="${elt} ${out_list}"
    done

    echo ${out_list}
}

get-last-elt-in-list()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 0
    local last=${1}
    local list=${2}

    local revert_list=$(revert-list "${list}")
    local out_list elt i=0

    for elt in ${revert_list}
    do
	test ${i} -lt ${last} || break
	out_list="${out_list} ${elt}"
	((i++))
    done
    out_list=${out_list:1}

    echo $(revert-list "${out_list}")
}

keep-ge-in-slist()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 0
    local min=${1}
    local list=${2}

    local revert_list=$(revert-list "${list}")
    local out_list elt

    for elt in ${revert_list}
    do
	test ${elt} -ge ${min} || break
	out_list="${out_list} ${elt}"
    done
    out_list=${out_list:1}

    echo $(revert-list "${out_list}")
}
