run-command-on-gateway()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 0
    local ip=${1}
    local commands=${2}
    local mode=${3}

    if test -z "${mode}" ; then
	ssh -q4at -l ${ADMIN_NAME} ${ip} "${commands}"
    else
	case ${mode} in
	    background)
		ssh -q4atnf -l ${ADMIN_NAME} ${ip} "${commands}" &
		;;
	    noinput)
		ssh -q4atn -l ${ADMIN_NAME} ${ip} "${commands}"
		;;
	    *)
		ssh -q4at -l ${ADMIN_NAME} ${ip} "${commands}"
		;;
	esac
    fi
}

run()
{
    :
}

main()
{
    local first=${1}

    if test ${APL_ROLE} == manager ; then

	if test -z "${MANAGER_CONTEXT_ENV}" ; then

	    if is-in-manager-exec-context ; then

		local command=$(file-basename ${0})

		case ${command} in
		    clear|countrylist|help|license|ping|setup|timezonelist|traceroute|transaction)
			info 2
			return 0
			;;
		    end)
			;;
		    *)
			if test -n "${first}" ; then
			    test ${first} != __noenv || shift
			    echo "${command} ${@}" >> ${HOME}/${MANAGER_EXEC_COMMANDS_FILE}
			else
			    echo "${command}" >> ${HOME}/${MANAGER_EXEC_COMMANDS_FILE}
			fi
			
			return 0
			;;
		esac
	    fi
	fi
    fi

    if test "${first}" == __noenv ; then
	shift
	run "${@}" || error ${?}
    else
	push-args "${@}"
	initialise ${MANAGER_CONTEXT_ENV}
	run || error ${?}
	test -z "${TRANSACTION}" || return 0
	commit-env
    fi
}

get-email-mx()
{
    test -n "${1}" || return 1
    local email=${1}

    local tmp_file=/tmp/email.dig.${$}
    local domainname=${email/*@}
    local mx prio len

    dig +noall \
	+short \
	+ignore \
	+timeout=3 \
	+tries=1 \
	${domainname} mx > ${tmp_file} 2> /dev/null

    while read prio mx
    do
	break
    done < ${tmp_file}

    len=${#mx}
    ((len--))
    mx=${mx:0:${len}}

    echo ${mx}

    rm -f ${tmp_file}
}

get-dynamic-dns-report()
{
    local ip

    ip=$(dig +noall \
	     +short \
	     +ignore \
	     +timeout=3 \
	     +tries=1 \
	     ${CURRENT_DYNAMIC_DNS_HOSTNAME} 2> /dev/null)

    test ${?} -eq 0 || return 11
    test -n "${ip}" || return 13
    test -s ${RUN_DIR}/${DYNAMIC_DNS_STATE_FILENAME} || return 15

    local report=$(cat ${RUN_DIR}/${DYNAMIC_DNS_STATE_FILENAME} 2>/dev/null)
    local code=${report/:*}

    if test ${code} == '0' ; then
	report=${report#*:}
	echo "${ip}:${report}"
    else
	report="internal error ${code}"
	echo "${ip}:${report}"
	return 21
    fi
}
