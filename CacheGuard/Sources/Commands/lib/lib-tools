file-size()
{
    # Compute in KB

    test -n "${1}" || return 1
    local file=${1}
    
    local size=$(ls -s --block-size=1024 ${file} 2>/dev/null)
    size=${size/ */}

    check-integer ${size}

    if test ${?} -eq 0 ; then
	echo ${size}
    else
	echo 0
    fi
}

trusted-tty()
{
    local tty=$(tty)
    tty=$(file-basename ${tty})

    member "${TRUSTED_TTY}" ${tty}
}

get-last-byte()
{
    test -n "${1}" || return 1
    local value=${1}

    value=${value:$(expr index ${value} .)}
    value=${value:$(expr index ${value} .)}
    value=${value:$(expr index ${value} .)}

    echo ${value}
}

request-confirmation()
{
    test "${TERM}" != "${WADMIN_TERM}" || exit 0
    test "${__BATCH_MODE}" != yes || error 111

    local response
    echo -n "Do you confirm this operation (Y/N) [N]? "
    read response
    test "${response:0:1}" != "Y" -a "${response:0:1}" != "y" || return 0
    exit 0
}

apl-man()
{
    test -n "{1}" || return 1
    local apl_command=${1}

    man 1 ${apl_command}
}

echo-state()
{
    test -n "{1}" || return 1
    local state=${1}

    local ext_state

    if test "${TERM}" == "${WADMIN_TERM}" ; then
	case ${state} in
	    OK)
		ext_state="[ ${state} ]"
		;;
	    KO)
		ext_state="[ ${state} ]"
		;;
	    *)
		ext_state="[ ?? ]"
	esac
    else
	case ${state} in
	    OK)
		ext_state="[ ${STATE_OK} ]"
		;;
	    KO)
		ext_state="[ ${STATE_KO} ]"
		;;
	    *)
		ext_state="[ ${STATE_OO} ]"
	esac
    fi
    echo ${ext_state}
}

update-dynamic-log-value()
{
    test -n "${1}" || return 1
    local tag=${1}

    case ${tag} in
	${LOG_TAG_AV_REGULAR})
	    update-report update-av-regular-downloaded-sz
	    ;;
	${LOG_TAG_AV_EXTENDED_CREATE})
	    update-report update-av-extended-create-downloaded-sz
	    ;;
	*)
	    ;;
    esac
}

display-log-line()
{
    test -n "${1}" || return 1
    local tag=${1}
    local date=${2}
    shift 2 ; local rest=${@}

    update-dynamic-log-value ${tag}

    test "${TERM}" != "${WADMIN_TERM}" || return 0

    local line1 message state ext_state set_col len
    
    local ok="[ OK ]"
    local columns=${COLUMNS}
    test -n "${columns}" || columns=80
    
    local len=${#ok}
    local print_col=$[${columns} - ${len}]

    set_col="\e[${columns}D\e[${print_col}C"

    line1="${rest/\[*/}"
    if test "${rest}" == "${line1}" ; then
	message=${rest}
	state="??"
    else
	message="${line1}"
	state="${rest/*\[/[}"
	state=${state:1:2}
    fi

    local ext_state=$(echo-state ${state})

    local dynamic_value=$(get-dynamic-log-value ${tag})
    echo -e "${date} ${message}${dynamic_value}${set_col}${ext_state}"
}

display-log()
{
    test -n "${1}" || return 1
    local log=${1}

    test -s ${log} || return 0

    echo-begin-show
    display-raw-log ${log}
    echo-end-show
}

local-log()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    local log_file=${1}
    local message=${2}

    local tag=0
    local date=$(date +"%Y/%m/%d-%T" 2> /dev/null)

    echo -ne "${tag} ${date} ${message}" >> ${log_file}
}

local-log-ret()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    local log_file=${1}
    local err_code=${2}

    local ok="[OK]"
    local ko="[KO]"

    if test ${err_code} -eq 0 ; then
	echo -ne "${ok}\n" >> ${log_file}
    else
	echo -ne "${ko}\n" >> ${log_file}
    fi
}

local-log-result()
{
    test -n "${1}" || return 1
    local log_file=${1}
    local code=${2}

    if test -n "${code}" ; then
	if test ${code} -eq 0 ; then
	    local-log-ret ${log_file} ${code}
	else
	    echo -ne " (${code})" >> ${log_file}
	    local-log-ret ${log_file} ${code}
	fi
    else
	code=255
	local-log-ret ${log_file} ${code}
    fi

    return ${code}
}

display-command-output-in-log()
{
    echo ${@}
}

display-raw-log()
{
    test -n "${1}" || return 1
    local log=${1}

    test -f ${log} || error 104

    while read line
    do
	test -n "${line}" || continue
	test "${line:0:1}" != "#" || continue
	display-log-line ${line}
    done < ${log}

    test -z "${line}" || display-log-line ${line}
}

