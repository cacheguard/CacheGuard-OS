internal-form()
{
    test -n "${1}" || return 1
    
    case "${1}" in
	on)
	    echo "True"
	    return 0
	    ;;
	off)
	    echo "False"
	    return 0
	    ;;
	*)
	    echo "Error"
	    return 1
	    ;;
