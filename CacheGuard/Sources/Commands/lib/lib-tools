manager-report()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    test -n "${3}" || return 3
    test -n "${4}" || return 4
    test -n "${5}" || return 5
    local log_file=${1}
    local id=${2}
    local ip=${3}
    local code=${4}
    local message=${5}

    local date=$(date +"%Y/%m/%d-%T")
    echo -n "${id} ${ip} ${code} ${date} ${message}" >> ${log_file}

