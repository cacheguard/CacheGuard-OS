get-cut-log-message()
{
    local message=${1}

    if test ${TERM} == ${WADMIN_TERM} ; then
	echo ${message}
	return 0
    fi

    local date=1111/11/11-11:11:11
    local columns=${COLUMNS}
    test -n "${columns}" || columns=80
    local max_len=$[${columns} - ${#date} - 2 - 5]
    local cut_len=$[${max_len} - 4]

    test ${#message} -le ${max_len} || message=${message:0:${cut_len}}...

    echo ${message}
}

get-run-command-on-gateway-message()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    local code_type=${1}
    local code=${2}

    local message

    case ${code_type,,} in
	error)
	    message="${code_type} ${code}: ${Errors[${code}],}"
	    message=$(get-cut-log-message "${message}")
	    ;;
	warning)
	    message="${code_type} ${code}: ${Warnings[${code}],}"
	    message=$(get-cut-log-message "${message}")
	    ;;
	information)
	    message="${code_type} ${code}: ${Informations[${code}],}"
	    message=$(get-cut-log-message "${message}")
	    ;;
	*)
	    ;;
    esac

    echo ${message}
}

display-manager-exec-report()
{
    test -n "${1}" || return 1
    local context=${1}

    local log place

    case ${context} in
	gateway)

	    test -n "${2}" || return 2
	    place=${2}

	    case ${place} in
		local)
		    log=${MANAGER_LOCAL_EXEC_OPERATION_LOG}
		    ;;
		remote)
		    log=${MANAGER_REMOTE_EXEC_OPERATION_LOG}
		    ;;
		*)
		    return 255
		    ;;
	    esac
	    ;;
	template)
	    place=local
	    local log=${MANAGER_TEMPLATE_EXEC_OPERATION_LOG}
	    ;;
	*)
	    return 255
	    ;;
    esac

    test -s ${log} || return 0

    local id ip code date message
    local stars code_type rest
    local message state date tag=0
    local line

    echo-begin-show

    while read id ip code date message
    do
	display-log-line ${tag} ${date} ${message}

	test ${place} == local || test -f ${log}.${id}.remote-batch || continue

	if test -s ${log}.${id}.err ; then
	    while read stars code_type code rest
	    do
		test -n "${code}" || continue
		check-digit ${code} || code=255

		message=$(get-run-command-on-gateway-message ${code_type} ${code})
		if test -n "${message}" ; then
		    if test ${code_type,,} == error ; then
			state='[KO]'
		    else
			state='[OK]'
		    fi

		    display-log-line ${tag} ${date} ${message}${state}
		fi

	    done < ${log}.${id}.err

	elif test -s ${log}.${id}.out ; then
	    while read line
	    do
		test -n "${line}" || continue
		display-command-output-in-log ${line}
	    done < ${log}.${id}.out
	else
	    if test ${place} == remote ; then
		fuser --silent ${log}.${id}.remote-batch > /dev/null 2>&1
		test ${?} -ne 0 || continue
		if test ! -s ${log}.${id}.remote-batch ; then
		    message="can't connect to '${id}' (IP ${ip})"
		    display-log-line ${tag} ${date} ${message}[KO]
		fi
	    fi
	fi

	display-log-line ${tag} ${date} End of execution on \'${id}\'[OK]
    done < ${log}

    echo-end-show
}

