}

external-form()
{
    test -n "${1}" || return 1
    
    case "${1}" in
	True)
	    echo -n "on"
	    return 0
	    ;;
	False)
	    echo -n "off"
	    return 0
	    ;;
	*)
	    echo -n "error"
	    return 1
	    ;;
    esac
}

external-forms()
{
    local bool value values

    for bool in ${@}
    do
	value=$(external-form ${bool})
	values="${values} ${value}"
    done
    values="${values:1}"
    echo -n ${values}
}

remove-quotes()
{
    test -n "${1}" || return 0
    local value=${1}

    local len=${#value} ; ((len--))
    local first=${value:0:1}
    local last=${value:${len}:1}

    if test ${first} == "'" -a ${last} == "'" ; then
	((len--))
	echo -n ${value:1:${len}}
    elif test ${first} == '"' -a ${last} == '"' ; then
	((len--))
	echo -n ${value:1:${len}}
    else
	echo -n ${value}
    fi
}

remove-leading-zeros()
{
    test -n "${1}" || return 0
    local value=${1}

    while test "${value:0:1}" == '0'
    do
	value=${value:1}
    done

    test -n "${value}" || value=0
    echo ${value}
}

