shift-args()
{
    local n=${1}
    test -n "${n}" || n=1

    local i j k

    for ((k=0 ; k<${n} ; k++))
    do
	for ((i=1 ; i<${ARGS_NB} ; i++))
	do
	    j=i
	    ((j++))
	    ARGS[${i}]=${ARGS[${j}]}
	done

	unset ARGS[${j}]

	((ARGS_NB--))
	ALLARGS=${ARGS[@]}
	ALLARGS=${ALLARGS/${ARGS[0]}}
    done
}

set-working-variables()
{
    local set_col="\e[1D"

    export WORKING_STOP_SIGN="${set_col} ${set_col}"
    export WORKING_STATE=0

    WORKING_SIGN[0]="${set_col}/"
    WORKING_SIGN[1]="${set_col}-"
    WORKING_SIGN[2]="${set_col}\\"
    WORKING_SIGN[3]="${set_col}|"

    export WORKING_SIGN
    export WORKING_SIGN_NB=${#WORKING_SIGN[@]}
}

working-sign()
{
    test ${TERM} != ${WADMIN_TERM} || return 0
    test "${__BATCH_MODE}" != yes || return 0

    local state=$[${WORKING_STATE} % ${WORKING_SIGN_NB}]
    >&2 echo -ne "${WORKING_SIGN[${state}]}"
    ((WORKING_STATE++))
}

stop-working()
{
    test ${TERM} != ${WADMIN_TERM} || return 0
    test "${__BATCH_MODE}" != yes || return 0

    >&2 echo -ne "${WORKING_STOP_SIGN}"
}

init-global-variables()
{
    export PRINT_COL=28

    export TXT_STATE_OK="OK"
    export TXT_STATE_KO="KO"
    export TXT_STATE_OO="??"
    export TXT_MARK_CUR="RUN"
    export TXT_MARK_NEW="NEW"
    export TXT_MARK_DEL="DEL"
    export TXT_MARK_REV="REV"
    export TXT_MARK_DIF="DIF"

    if test "${TERM}" == "${WADMIN_TERM}" ; then
	export STATE_OK="${TXT_STATE_OK}"
	export STATE_KO="${TXT_STATE_KO}"
	export STATE_OO="${TXT_STATE_OO}"
	export MARK_CUR="${TXT_MARK_CUR}"
	export MARK_NEW="${TXT_MARK_NEW}"
	export MARK_DEL="${TXT_MARK_DEL}"
	export MARK_REV="${TXT_MARK_REV}"
	export MARK_DIF="${TXT_MARK_DIF}"
    else
	local normal="\e[0m"
	local highlight="\e[1m"
	local blink="\e[5m"

	export STATE_OK="${highlight}${TXT_STATE_OK}${normal}"
	export STATE_KO="${blink}${TXT_STATE_KO}${normal}"
	export STATE_OO="${blink}${TXT_STATE_OO}${normal}"
	export MARK_CUR="${normal}${TXT_MARK_CUR}${normal}"
	export MARK_NEW="${highlight}${TXT_MARK_NEW}${normal}"
	export MARK_DEL="${highlight}${TXT_MARK_DEL}${normal}"
	export MARK_REV="${highlight}${TXT_MARK_REV}${normal}"
	export MARK_DIF="${highlight}${TXT_MARK_DIF}${normal}"
	set-working-variables
    fi
}

get-highlight-text()
{
	local normal="\e[0m"
	local blink="\e[5m"

	echo "${blink}${1}${normal}"
}

clean-command-exit()
{
    trap "" INT QUIT TERM

    clean-loaded-files
    clean-env || error 104
    clean-configuration-db || error 104
    stty echo

    exit 100
}

initialise()
{
    test -z "${TRANSACTION}" || return 0

    unset ROOT_DIR
    SAVENV=0
    NEWENV=0
    FILEENV=0
    init-global-variables
    init-env "${@}" || error ${?}
    trap "clean-command-exit" INT QUIT TERM
}

