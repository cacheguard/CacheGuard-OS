    if test "${TERM}" == "${WADMIN_TERM}" ; then
	local command=${command_form/ *} size=20
	local page=$(get-command-form-gui-page ${command_form// /_})
        echo -n "<td style='line-height:${size}px;'><a href='${DOC_COMMAND_DIR}/${command}.html' target='_blank'><img style='margin:0; margin-right:10px;' src='${IMAGE_DIR}/help.png' alt='Get Help' title='Get Help' /></a> <a href='/${GUI_DIR_NAME}/${page}.${GUI_EXT_NAME}'><img style='margin:0; margin-right:10px;' src='${IMAGE_DIR}/${page}.png' alt='' title='Go to GUI page' /></a>${command_form}</td>"
    else
        echo -n ${command_form}
    fi
}

