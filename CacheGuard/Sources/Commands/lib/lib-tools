request-object()
{
    test ${TERM} != ${WADMIN_TERM} || return 0
    test -n "${1}" || return 1
    local object=${1}

    echo -n "Enter the ${object}: "
}

termination-message()
{
    test -n "${1}" || return 1
    local action=${1}
    local wait4=${2}

    test "${TERM}" != "${WADMIN_TERM}" || return 0
    test "${__BATCH_MODE}" != yes -o -n "${wait4}" || return 0

    local lock_file=${ADMIN_LOCK_DIR}/apl_${action//-/_}
    local operation=${action//-/ }

    while true
    do
	usleep 2500000
	test -f ${lock_file} || break
    done

    test "${__BATCH_MODE}" == yes -o -n "${wait4}" || echo -e "\n\nThe '${operation}' operation has been terminated.\n"
}

supervisor-action()
{
    test -n "${1}" || return 1
    local action=${1}
    local inform=${2}
    local wait4=${3}

    test -p ${RUN_DIR}/${SUPERVISOR_FIFO} || return 11
    echo "${action} ${USER} ${$}" > ${RUN_DIR}/${SUPERVISOR_FIFO} 2> /dev/null

    test -n "${inform}" || return 0

    if test -n "${wait4}" ; then
	termination-message ${action} ${wait4}
    else
	termination-message ${action} &
    fi
}

supervisor-push-args()
{
    local arg

    for arg in "${@}"
    do
	echo "${arg}"
    done > ${RUN_DIR}/${SUPERVISOR_ARGS}/${USER} 2> /dev/null
}

supervisor-wait4-report()
{
    local loops=${1}
    local total_timeout=${2}

    if test -z ${loops} ; then
	loops=5
	total_timeout=500000
    elif test -z ${total_timeout} ; then
	total_timeout=500000
    fi

    local i=0
    local step_time=$[${total_timeout} / ${loops}]

    while true
    do
	usleep ${step_time}
	test ${i} -lt ${loops} || break
	test -f ${RUN_DIR}/${WAITING_PROCESS}.${$} || break
	((i++))
    done
}

