push-args-1()
{
    export ARGS_NB=0
    local arg

    for arg in "${@}"
    do
	ARGS[${ARGS_NB}]=${arg}
	((ARGS_NB++))
    done

    export ALLARGS=${ARGS[@]}
    ALLARGS=${ALLARGS/${ARGS[0]}}
}

push-args()
{
    test -z "${TRANSACTION}" || return 0

    unset ARGS
    export ARGS

    push-args-1 "${0}" "${@}"
}

get-percent-value()
{
