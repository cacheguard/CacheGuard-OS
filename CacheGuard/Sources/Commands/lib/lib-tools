get-null-value()
{
    if test "${TERM}" == "${WADMIN_TERM}" ; then
	echo -n "&lt;null&gt;"
    else
	echo -n "<null>"
    fi
}

echo-value-null()
{
    local value=$(get-null-value)

    if test "${TERM}" == "${WADMIN_TERM}" ; then
	echo "<td><i>${value}</i></td>"
    else
	local print_col=${1}
	local options=${2}

	test -n "${COLUMNS}" || COLUMNS=80
	test -n "${print_col}" || print_col=${PRINT_COL}
	echo -e ${options} "\e[${COLUMNS}D\e[${print_col}C${value}"
    fi
}

echo-value()
{
    test -n "{1}" || return 1
    local values=${1}
    local print_col=${2}
    local options=${3}

    if test "${TERM}" == "${WADMIN_TERM}" ; then
        echo ${options} "<td><span style='color:green;'>${values}</span></td>"
    elif test "${__BATCH_MODE}" == yes ; then
	echo " ${values}"
    else
	if test "${print_col}" == 1 ; then
	    echo ${options} "${values}"
	else
	    test -n "${COLUMNS}" || COLUMNS=80
	    test -n "${print_col}" || print_col=${PRINT_COL}
	    echo -e ${options} "\e[${COLUMNS}D\e[${print_col}C${values}"
	fi
    fi
}

echo-highlighted-value()
{
    test -n "{1}" || return 1
    local label=${1}
    local print_col=${2}

    if test "${TERM}" == "${WADMIN_TERM}" ; then
        echo "<td><span style='color:green; font-weight:bold'>${label}</span>:</td>"
    elif test "${__BATCH_MODE}" == yes ; then
	echo " ${label}"
    else
	if test "${print_col}" == 1 ; then
	    echo "${label}"
	else
	    test -n "${COLUMNS}" || COLUMNS=80
	    test -n "${print_col}" || print_col=${PRINT_COL}
	    echo -e "\e[${COLUMNS}D\e[${print_col}C\e[1m${label}\e[0m:"
	fi
    fi
}

get-command-form-gui-page()
{
    test -n "{1}" || return 1
    local in_command_form=${1}

    local command_form gui_page
    local found

    while read command_form gui_page
    do
	test -n "${gui_page}" || continue

	if test ${command_form} == ${in_command_form} ; then
	    found=yes
	    break
	fi
    done < ${APPLIANCE_DIR}/etc/gui-page-command-index

    if test -n "${found}" ; then
	echo ${gui_page}
    else
	if test ${in_command_form:0:13} == 'email_account' ; then
	    echo 'email'
	elif test ${in_command_form:0:12} == 'ip_internal.' ; then
	    echo 'ip'
	elif test ${in_command_form/_*} == 'port' ; then
	    echo 'port'
	elif test ${in_command_form} == 'qos_shape_router' ; then
	    echo ${in_command_form//_/-}
	elif test ${in_command_form:0:10} == 'qos_shape_' ; then
	    echo 'qos-shape-gateway'
	elif test ${in_command_form:0:9} == 'log_type_' ; then
	    echo 'log-type'
	elif test ${in_command_form:0:10} == 'waf_limit_' ; then
	    echo 'waf-limit'
	elif test ${in_command_form:0:13} == 'firewall_dos_' ; then
	    echo 'firewall-dos'
	elif test ${in_command_form:0:28} == 'vpnipsec_access_authenticate' ; then
	    echo 'vpnipsec-access'
	elif test ${in_command_form:0:19} == 'dynamicdns_interval' ; then
	    echo 'dynamicdns'
	else
	    case ${in_command_form} in
		mode_dhcp|mode_dns|mode_ha|mode_ftppassive|mode_qos|mode_router|mode_snat|mode_transparent|mode_tweb|mode_tnat|mode_vlan)
		    echo 'mode-network'
		    ;;
		mode_anonymous|mode_antivirus|mode_authenticate|mode_firewall|mode_forward|mode_web|mode_compress|mode_ocsp|mode_rweb|mode_reverse|mode_sslmediate|mode_log|mode_guard|mode_vpnipsec|mode_waf|mode_cache)
		    echo 'mode-feature'
		    ;;
		*)
		    echo ${in_command_form//_/-}
		    ;;
	    esac
	fi
    fi
}

