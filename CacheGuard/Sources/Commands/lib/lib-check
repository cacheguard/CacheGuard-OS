{
    local password=${1}

    [[ ${#password} -ge 16 && ${#password} -le 32 && "${password}" == *[A-Z]* && "${password}" == *[a-z]* && "${password}" == *[0-9]* && "${password}" == *[\!@#%.\$\&*-]* ]]
