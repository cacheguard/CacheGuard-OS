check-uuid()
{
    [[ "${1}" =~ ^[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12} ]]
}

check-reference()
{
    local reference=${1}

    [[ "${reference}" =~ ^[[:print:]]+$ ]] || return 11
    [[ "${reference}" =~ ^[[:print:]]+:(gateway|manager):[[:print:]]+,[[:digit:]]+:[[:digit:]]+$ ]] || return 13

    local passport=${reference/,*}
    local uuid=${passport/*:}
    check-uuid "${uuid}" || return 15

    return 0
}
