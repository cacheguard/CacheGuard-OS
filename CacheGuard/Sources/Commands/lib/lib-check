check-url()
{
    test -n "${1}" || return 1
    local url=${1}
    local app=${2}

    local e=[st]?
    case ${app} in
	file)
	    e="[st]?"
	    ;;
	web)
	    ;;
	*)
	    ;;
    esac

    test ${#url} -le ${MAX_URL_LEN} || return 2

    # URI RegExp: ([a-zA-Z0-9]|[\-._~:/?#@\!$&\(\)*+,;=]|\[|\]|%[a-fA-F0-9]{2})

    ! [[ "${url}" =~ ^(${e}ftp|https?)://[a-zA-Z0-9](/([a-zA-Z0-9]|[\-._~:/?#@\!$&\(\)*+,;=]|\[|\]|%[a-fA-F0-9]{2})*)?$ ]] || return 0
    [[ "${url}" =~ ^(${e}ftp|https?)://[a-zA-Z0-9][a-zA-Z0-9.\-]*[a-zA-Z0-9](/([a-zA-Z0-9]|[\-._~:/?#@\!$&\(\)*+,;=]|\[|\]|%[a-fA-F0-9]{2})*)?$ ]]
}

