check-email()
{
    test -n "${1}" || return 1
    local email=${1}

    test ${#email} -le ${MAX_LEN} || return 11
    [[ "${email}" =~ ^.+*@.+$ ]] || return 13

    local account=${email/@*}
    local domainname=${email/*@}

    check-domainname "${domainname}" || return 15
    check-email-account "${account}" || return 17

    return 0
}

