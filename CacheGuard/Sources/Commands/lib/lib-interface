get-urllist-serial-days()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    test -n "${3}" || return 3
    test -n "${4}" || return 4
    test -n "${5}" || return 5
    local file=${1}
    local prefix=${2}
    local ftype=${3}
    local urllist=${4}
    local suffix=${5}

    local base_file=$(file-basename ${file} .${suffix}.gz)
    local urllist_serial_days=${base_file/${prefix}\.${ftype}\.}
    local urllist_serial=${urllist_serial_days/\.DAY+*+YAD}
    local days=${urllist_serial_days/*\.DAY+/}

    days=${days/+YAD/}
    check-digit ${days} || days=0

    echo ${days}
}

