single-rweb-host()
{
    test -n "${1}" || return 0
    local list=${1}

    local i=0 elt range
    local name hosts

    for elt in ${list}
    do
	range=$[${i} % 2]
	case ${range} in
	    0)
		name=${elt}
		;;
	    1)
		hosts=$(colon2space ${elt})
		mono-elt ${hosts} || return 1
		;;
	    *)
		return 255
		;;
	esac
	((i++))
    done

    return 0
}

is-rweb-http-redirected-to-https()
