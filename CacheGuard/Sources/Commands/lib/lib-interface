}

is-basic-rweb-balancer()
{
    test -n "${1}" || return 0
    local list=${1}

    local i=0 elt range
    local algorithm sticky

    for elt in ${list}
    do
	range=$[${i} % 5]
	case ${range} in
	    0)
		;;
	    1)
		algorithm=${elt}
		;;
	    2)
		sticky=${elt}
		;;
	    3)
		;;
	    4)
		test ${algorithm} == robin || return 11
		test ${sticky} == nosticky || return 13
		;;
	    *)
		return 1
		;;
	esac
	((i++))
    done

    return 0
}

set-new-proxy2-mode()
