	return 0
    fi

    local in_context=${1}

    local rweb_site_hosts_list
    local rweb_site_balancer_list

    case ${in_context} in
	configurator)
	    rweb_site_hosts_list=${_RWEB_SITE_HOSTS_LIST}
	    rweb_site_balancer_list=${_RWEB_SITE_BALANCER_LIST}
	    ;;
	*)
	    rweb_site_hosts_list=${RWEB_SITE_HOSTS_LIST}
	    rweb_site_balancer_list=${RWEB_SITE_BALANCER_LIST}
	    ;;
    esac

    ! single-rweb-host "${rweb_site_hosts_list}" || return 0
    is-basic-rweb-balancer "${rweb_site_balancer_list}" || PROXY2_MODE=True
