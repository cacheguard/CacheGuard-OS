get-domain-controller-chain()
{
    test -n "${1}" || return 1
    local domain=${1}

    local chain dc

    while true
    do
	dc=${domain/.*}
	chain="${chain},dc=${dc}"
	rest=${domain#*.}
	test "${domain}" != "${rest}" || break
	domain=${rest}
    done
    chain=${chain:1}

