get-revoke-reason()
{
    test -n "${1}" || return 1
    local revoke_file=${1}

    local reason=$(cat ${revoke_file} 2> /dev/null)

    case "${reason}" in
	unspecified|keyCompromise|CACompromise|affiliationChanged|superseded|cessationOfOperation|certificateHold|removeFromCRL)
	    ;;
	*)
	    reason=unspecified
	    ;;
    esac

    echo ${reason}
}

get-subject-alternative-names()
{
    test -n "${1}" || return 1
    local tls_id=${1}

    local cert_file=$(get-tls-server-component-file ${tls_id} certificate)
    test -f ${cert_file} || return 11

    local line names extended
    local tmp_file=/tmp/openssl.san.${$}

    openssl x509 -in ${cert_file} -text -noout 2> /dev/null > ${tmp_file}

    while read line
    do
	test -n "${line}" || continue
	test "${line}" != "X509v3 Extended Key Usage:" || extended=yes
	    test -n "${extended}" || continue
	    test "${line:0:4}" == 'DNS:' -o "${line:0:11}" == 'IP Address:' || continue

	    names=${line}
	    break
    done < ${tmp_file}
    rm -f ${tmp_file}

    names=${names//,}
    names=${names//IP Address:}
    names=${names//DNS:}

    echo ${names}
}

get-san-certificate-title()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    local tls_type=${1}
    local names=${2}

    case ${tls_type} in
	server)
	    if test "${names// }" == "${names}" ; then
		echo ${names}
	    else
		echo "${tls_type^} SAN certificate"
	    fi
	    ;;
	client)
	    echo ${names/ *}
	    ;;
	*)
	    ;;
    esac
}

get-tls-end-date()
{
    test -n "${1}" || return 1
    local cert_file=${1}
    test -f ${cert_file} || return 11

    local end_date end_epoch state
    end_date=$(openssl x509 -in ${cert_file} -noout -nameopt multiline -enddate 2> /dev/null)
    end_date=${end_date/notAfter=}
    end_date=$(date --utc +"%y%m%d%H%M%SZ" --date="${end_date}" 2> /dev/null)
    
    echo ${end_date}
}

get-tls-validity-days()
{
    test -n "${1}" || return 1
    local file=${1}

    if test ! -f ${file} ; then
	echo 0
	return 11
    fi

    local start_date=$(openssl x509 -in ${file} -noout -nameopt multiline -startdate 2> /dev/null)
    local end_date=$(openssl x509 -in ${file} -noout -nameopt multiline -enddate 2> /dev/null)

    start_date=${start_date/notBefore=}
    end_date=${end_date/notAfter=}

    local start_epoch=$(date +"%s" --date="${start_date}" 2> /dev/null)
    local end_epoch=$(date +"%s" --date="${end_date}" 2> /dev/null)

    test -n "${start_epoch}" || start_epoch=0
    test -n "${end_epoch}" || end_epoch=0

    days=$[(${end_epoch} - ${start_epoch}) / 86400]

    echo ${days}
}

check-tls-cert-signed-by-ca()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    local cert_file=${1}
    local ca_file=${2}

    test -f ${ca_file} || return 11
    test -f ${cert_file} || return 13

    local ca_issuer issuer
    local ca_key_id key_id

    local tmp_x509_ca_file=${ADMIN_TMP_DIR}/x509.ca.${$}
    local tmp_x509_cert_file=${ADMIN_TMP_DIR}/x509.crt.${$}

    openssl x509 -in ${ca_file} -text -noout > ${tmp_x509_ca_file} 2> /dev/null
    openssl x509 -in ${cert_file} -text -noout > ${tmp_x509_cert_file} 2> /dev/null

    ca_issuer=$(grep 'Issuer: ' ${tmp_x509_ca_file} 2> /dev/null)
    issuer=$(grep 'Issuer: ' ${tmp_x509_cert_file} 2> /dev/null)

    if test "${issuer}" != "${ca_issuer}" ; then
	rm -f ${tmp_x509_ca_file} ${tmp_x509_cert_file}
	return 21
    fi

    ca_key_id=$(grep 'keyid:' ${tmp_x509_ca_file} 2> /dev/null)
    key_id=$(grep 'keyid:' ${tmp_x509_cert_file} 2> /dev/null)

    rm -f ${tmp_x509_ca_file} ${tmp_x509_cert_file}

    test "${key_id}" == "${ca_key_id}" || return 23
}

check-tls-cert-signed-by-system-ca()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    local tls_type=${1}
    local tls_id=${2}

    case ${tls_type} in
	client)
	    return 0
	    ;;
	server)
	    if test -f ${TMP_DIR}/${TLS_SERVER}.${tls_id}.2sign ; then
		return 0
	    else
		! tls-tmp-csr-exist ${tls_id} || return 0
	    fi	    
	    ;;
	*)
	    ;;
    esac

    local ca_file=$(get-tls-ca-system-component-file certificate)
    local cert_file=$(get-tls-server-component-file ${tls_id} certificate)

    check-tls-cert-signed-by-ca ${cert_file} ${ca_file}
}

check-tls-cert-self-signed()
{
    test -n "${1}" || return 1
    local cert_file=${1}

    test -f ${cert_file} || return 11

    local issuer subject

    local tmp_x509_cert_file=${ADMIN_TMP_DIR}/x509.crt.${$}

    openssl x509 -in ${cert_file} -text -noout > ${tmp_x509_cert_file} 2> /dev/null

    issuer=$(grep 'Issuer: ' ${tmp_x509_cert_file} 2> /dev/null)
    issuer=${issuer/Issuer: }

    subject=$(grep 'Subject: ' ${tmp_x509_cert_file} 2> /dev/null)
    subject=${subject/Subject: }

    rm -f ${tmp_x509_cert_file}

    test "${issuer}" == "${subject}" || return 21
}

encrypt-password()
{
    test -n "${1}" || return 0
    test -n "${2}" || return 2
    local passwd=${1}
    local file=${2}

    local salt_file=${ROOT_DIR}${PRIVATE_DIR}/.${file}
    test -f ${salt_file} || return 11

    local ret
    local key=${passwd/:*/}
    local value=${passwd##${key}:}

    case "${key}" in
	encrypted)
	    ret=0
	    ;;
	clear)
	    test -z "${value}" || value=$(echo "${value}" | openssl enc -A -pbkdf2 -aes-256-cbc -base64 -salt -pass file:${salt_file} 2>/dev/null)
	    ret=${?}
	    ;;
	*)
	    return 21
	    ;;
    esac

    echo "encrypted:${value}"
    return ${ret}
}

decrypt-password()
{
    test -n "${1}" || return 0
    test -n "${2}" || return 2
    local passwd=${1}
    local file=${2}

    local salt_file=${ROOT_DIR}${PRIVATE_DIR}/.${file}
    test -f ${salt_file} || return 11

    local key=${passwd/:*/}
    local value=${passwd##${key}:}

    case "${key}" in
	clear)
	    ;;
	encrypted)
	     test -z "${value}" || value=$(echo ${value} | openssl enc -d -A -pbkdf2 -aes-256-cbc -base64 -salt -pass file:${salt_file} 2>/dev/null)
	    ;;
	*)
	    value=${passwd}
	    ;;
    esac

    echo ${value}
    return 0
}

