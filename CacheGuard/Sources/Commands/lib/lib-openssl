clean-all-deleted-third-ca()
{
    local cur_dir=${PWD}
    cd ${SSL_LOCAL_CA_DIR}

    local ca_list ca browsing purge
    local files=$(ls -1 *.certificate 2> /dev/null) file 
    
    for file in ${files}
    do
	test ${file} != ${SYSTEM_CA_ID}.certificate || continue
	ca=${file%\.certificate}
	ca_list="${ca_list} ${ca}"
    done
    ca_list=${ca_list:1}

    for ca in ${ca_list}
    do
	browsing=$(tls-ca-object-exist ${ca})
	test ${?} -ne 0 || continue

	delete-third-ca-components ${ca} ${@}
	purge=yes
    done

    if test -z "${purge}" ; then
	cd ${cur_dir}
	return 0
    fi

    clean-all-deleted-runtime-third-ca
}

