{
    local files=$(ls -1 ${SSL_SERVER_DIR}/*.certificate 2> /dev/null) file
    local ret=0

    for file in ${files}
    do
	tls=$(file-basename ${file} .certificate)
	test ${tls} != default || continue
	member "${TLS_SERVER_LIST}" ${tls} || delete-tls-server-components ${tls} ${@} || ((ret++))
