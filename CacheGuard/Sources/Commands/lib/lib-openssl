    if test ${?} -ne 0 ; then clean-generated-tls-client ${id} ; return 19 ; fi

    openssl ca \
	    -batch \
	    -notext \
	    -extensions v3_x509 \
	    -days ${days} \
	    -cert ${SSL_CA_DIR}/${SYSTEM_CA}.certificate \
	    -keyfile ${SSL_CA_DIR}/${SYSTEM_CA}.key \
