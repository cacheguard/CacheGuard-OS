	install -m 644 -o ${ADMIN_NAME} -g ${GROUP_NAME} ${TMP_DIR}/${id}.cnf ${id}.cur/${id}.cnf &&
	install -m 644 -o ${ADMIN_NAME} -g ${GROUP_NAME} ${TMP_DIR}/${id}.certificate ${id}.cur/${id}.certificate &&
