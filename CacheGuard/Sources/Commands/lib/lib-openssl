gen-tls-client-password()
{
    local array=(a b c d e f g h i j k m n p q r s t u v w x y z A B C D E F G H J K L M N P Q R S T U V W X Y Z 2 3 4 5 6 7 8 9)
    local len_array=${#array[*]}

    local len=32
    local i=0 pos key
    while test ${i} -lt ${len}
    do
        pos=$[${RANDOM} % ${len_array}]
        key="${key}${array[${pos}]}"
	((i++))
	test $((i % 8)) -ne 0 || key="${key}-"
    done

    len=${#key}
    ((len--))
    key=${key:0:${len}}

    echo -n "${key}"
}

generate-tls-client()
{
    test -n "${1}" || return 1
    local new=${1}

    local numbits days ocsp
    local id=${new%\.new}
    local name=${id}.${DOMAIN_NAME}
    local line i=0

    if test -f ${id}.numbits ; then
	    numbits=$(cat ${id}.numbits 2> /dev/null)
	    rm -f ${id}.numbits
	else
	    numbits=2048
    fi

    if test -d ${id}.cur ; then
	days=$(get-tls-validity-days ${id}.cur/${id}.certificate)
	ocsp=$(get-tls-ocsp-uri ${id}.cur/${id}.certificate)
    else
	if test -f ${id}.days ; then
	    days=$(cat ${id}.days 2> /dev/null)
	    rm -f ${id}.days
	else
	    days=${TLS_CLIENT_DAYS}
	fi
	ocsp=$(cat ${new} 2> /dev/null)
	test -z "${ocsp}" || ocsp=http://${OCSP_HOST}:${OCSP_PORT}
    fi

    echo "numbits ${numbits}" > ${TMP_DIR}/${id}.conf
    echo "days ${days}" >> ${TMP_DIR}/${id}.conf
    echo "commonName ${name,,}" >> ${TMP_DIR}/${id}.conf

    while read line
    do
	((i++))
	test ${i} -gt 3 || continue
	echo ${line}
    done < ${SSL_CA_DIR}/${SYSTEM_CA}.conf >> ${TMP_DIR}/${id}.conf

    gen-tls-cnf ${TMP_DIR}/${id}.conf client sign ${ocsp} > ${TMP_DIR}/${id}.cnf
    if test ${?} -ne 0 ; then clean-generated-tls-client ${id} ; return 11 ; fi

    openssl genrsa \
	    ${numbits} \
	    2> /dev/null > ${TMP_DIR}/${id}.key &&
	chmod 600 ${TMP_DIR}/${id}.key
    if test ${?} -ne 0 ; then clean-generated-tls-client ${id} ; return 13 ; fi

    openssl req \
	    -batch \
	    -new \
	    -sha256 \
	    -key ${TMP_DIR}/${id}.key \
	    -config ${TMP_DIR}/${id}.cnf \
	    -out ${TMP_DIR}/${id}.csr \
