gen-cert-conf()
{
    test -n "${1}" || return 1
    local names=${1}

    local numbits=${2}
    local days=${3}
    local country=${4:0:2}
    local province=${5}
    local locality=${6}
    local organisation=${7}
    local unit=${8}

    test -n "${numbits}" || numbits="2048"
    test -n "${days}" || days="365"
    test -n "${country}" || country="${DEFAULT_COUNTRY_CODE}"
    test -n "${province}" || province="My Province"
    test -n "${locality}" || locality="My Locality"
    test -n "${organisation}" || organisation="My Organisation"
    test -n "${unit}" || unit="Security"

    echo "numbits ${numbits}"
    echo "days ${days}"
    echo "commonName ${names}"
    echo "countryName ${country}"
    echo "stateOrProvinceName ${province}"
    echo "localityName ${locality}"
    echo "organizationName ${organisation}"
    echo "organizationalUnitName ${unit}"
}

gen-tls-conf()
{
    test -n "${1}" || return 1
    local file=${1}
    local conf_type=${2}

    test -n "${conf_type}" || conf_type='certificate'
    test -f ${file} || return 11
    
    local line variable value
    local numbits days countryName stateOrProvinceName localityName organizationName organizationalUnitName commonName
    local subjectFound extensionFound altNameExtensionFound altNameExtensionLine=0

    local tmp_file=${ADMIN_TMP_DIR}/tls-multiline.${$}

    case ${conf_type} in
	certificate)
	    numbits=$(openssl x509 -in ${file} -text -noout 2> /dev/null | grep "RSA Public-Key:")
	    days=$(get-tls-validity-days ${file})
	    openssl \
		x509 \
		-in ${file} \
		-text \
		-noout \
		-nameopt multiline \
		2> /dev/null > ${tmp_file}
	    ;;
	csr)
	    numbits=$(openssl req -in ${file} -text -noout 2> /dev/null | grep "RSA Public-Key:")
	    days=365
	    openssl \
		req \
		-in ${file} \
		-text \
		-noout \
		-nameopt multiline \
		2> /dev/null > ${tmp_file}
	    ;;
	*)
	    return 13
	    ;;
    esac

    numbits=${numbits/*RSA Public-Key: \(}
    numbits=${numbits/ *}
    test -n "${numbits}" || numbits=2048

    while read line
    do
	test "${line}" != "Subject:" || subjectFound=yes
	test "${line}" != "Subject Public Key Info:" || unset subjectFound
	test "${line}" != "X509v3 extensions:" || extensionFound=yes
	test -z "${extensionFound}" || test "${line}" != "X509v3 Subject Alternative Name:" || altNameExtensionFound=yes

	if test -n "${subjectFound}" ; then
	    variable=${line/ *}
	    value=${line/*= }

	    case ${variable} in
                commonName|countryName|stateOrProvinceName|localityName|organizationName|organizationalUnitName)
		    eval ${variable}='${value}'
		    ;;
		*)
		    ;;
	    esac
	fi

	if test -n "${altNameExtensionFound}" ; then
	    ((altNameExtensionLine++))
	    test ${altNameExtensionLine} -eq 2 || continue

	    commonName=${line//DNS:}
	    commonName=${commonName//,}
	    break
	fi
    done < ${tmp_file}

    echo "numbits ${numbits}"
    echo "days ${days}"
    echo commonName ${commonName}
    echo countryName ${countryName}
    echo stateOrProvinceName ${stateOrProvinceName}
    echo localityName ${localityName}
    echo organizationName ${organizationName}
    echo organizationalUnitName ${organizationalUnitName}

    rm -f ${tmp_file}
}

gen-tls-cnf()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    local conf_file=${1}
    local tls_type=${2}
    local signed=${3}
    local ocsp=${4}
    test -f ${conf_file} || return 3

    local var val i=0

    local var_t val_t
    declare -a var_t val_t

    while read var val
    do
	var_t[${i}]=${var}
	val_t[${i}]=${val}
	((i++))
    done < ${conf_file}

    local names=${val_t[2]} san name csr

    case ${tls_type} in
	ca)
	    san=False
	    csr=False
	    ;;
	client|server)
	    san=True
	    csr=False
	    ;;
	server:csr)
	    san=True
	    csr=True
	    ;;
	*)
	    san=False
	    csr=False
	    ;;
    esac

    echo "SSLDIR = ${SSL_DIR}"

    cat ${APPLIANCE_DIR}/etc/certificate.cnf-head-constant
    echo
    echo "[ v3_req ]"
    echo "basicConstraints = CA:FALSE"
    echo "keyUsage = nonRepudiation, digitalSignature, keyEncipherment, keyCertSign"
    echo "subjectKeyIdentifier = hash"

    if test -n "${signed}" ; then
	test ${csr} == False ||echo "authorityKeyIdentifier = keyid:always, issuer:always"
	test -z "${ocsp}" || echo "authorityInfoAccess = OCSP;URI:http://${OCSP_HOST}:${OCSP_PORT}"
    fi

    gen-extended-key-usage ${tls_type}
    test ${san} == False || echo "subjectAltName = @alt_names"
    echo
    echo "[ v3_x509 ]"
    echo "basicConstraints = CA:FALSE"
    echo "keyUsage = nonRepudiation, digitalSignature, keyEncipherment, keyCertSign"
    echo "subjectKeyIdentifier = hash"

    if test -n "${signed}" ; then
	echo "authorityKeyIdentifier = keyid:always, issuer:always"
	test -z "${ocsp}" || echo "authorityInfoAccess = OCSP;URI:http://${OCSP_HOST}:${OCSP_PORT}"
    fi

    gen-extended-key-usage ${tls_type}
    test ${san} == False || echo "subjectAltName = @alt_names"
    echo
    echo "[ req ]"
    echo "default_bits = 2048"
    echo "encrypt_key = yes"
    echo "distinguished_name = req_distinguished_name"
    if test "${san}" == False ; then
	echo "x509_extensions = cert_type"
    else
        val_t[2]=$(get-san-certificate-title ${tls_type} "${names}")
	echo "req_extensions = v3_req"
	echo "x509_extensions = v3_x509"
	echo
	echo "[ alt_names ]"
	i=0
	for name in ${names}
	do
	    if check-expr-ip ${name} ; then
		echo "IP.${i} = ${name}"
	    else
		echo "DNS.${i} = ${name}"
	    fi
	    ((i++))
	done
    fi
    echo
    cat ${APPLIANCE_DIR}/etc/certificate.cnf-req-dn-constant
    for ((i=2 ; i<8 ; i++))
    do
	echo "${var_t[${i}]}_default = ${val_t[${i}]}"
    done
}

update-ssl-serial()
{
    test -f ${SSL_CTL_DIR}/serial || return 11

    local initial_serial_hex=$(cat ${SSL_CTL_DIR}/serial 2> /dev/null)
    local initial_serial_dec=$((16#${initial_serial_hex}))

    local serial_hex=${initial_serial_hex}
    local serial_dec=${initial_serial_dec}

    while test -L ${SSL_CTL_DIR}/${serial_hex}.pem
    do
	serial_dec=$((16#${serial_hex}))
	((serial_dec++))
	serial_hex=$(printf '%x' ${serial_dec})
	serial_hex=${serial_hex^^}
    done

    test ${serial_dec} -gt ${initial_serial_dec} || return 0

    mv -f ${SSL_CTL_DIR}/serial ${SSL_CTL_DIR}/serial.old
    echo ${serial_hex} > ${SSL_CTL_DIR}/serial
}

remove-tls-from-index()
{
    test -n "${1}" || return 1
    local in_id=${1}

    test -s ${SSL_CTL_DIR}/index.txt || return 0

    local state expiration serial unknown fdn
    local revoke tls_file id found

    while read state expiration serial unknown fdn
    do
	if test ${state} == R ; then
	    revoke=${serial}
	    serial=${unknown}
	    fdn=${fdn#unknown*\/}
	    fdn=/${fdn}
	fi

	tls_file=$(readlink ${SSL_CTL_DIR}/${serial}.pem 2> /dev/null)
	id=$(file-basename ${tls_file} .certificate)
	
	if test ${id} == ${in_id} ; then
	    rm -f ${SSL_CTL_DIR}/${serial}.pem
	    found=yes
	else
	    if test ${state} == R ; then
		echo -e "${state}\t${expiration}\t${revoke}\t${serial}\tunknown\t${fdn}"
	    else
		echo -e "${state}\t${expiration}\t\t${serial}\tunknown\t${fdn}"
	    fi
	fi
    done < ${SSL_CTL_DIR}/index.txt > ${SSL_CTL_DIR}/index.txt.new

    if test -z "${found}" ; then
	rm -f ${SSL_CTL_DIR}/index.txt.new
    else
	cp -f ${SSL_CTL_DIR}/index.txt ${SSL_CTL_DIR}/index.txt.old &&
            mv -f ${SSL_CTL_DIR}/index.txt.new ${SSL_CTL_DIR}/index.txt
    fi
}

update-openssl-index()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    local tls_type=${1}
    local in_id=${2}

    test -s ${SSL_CTL_DIR}/index.txt || return 0

    local ssl_dir ssl_rdir ssl_cert_dir cert_file

    case ${tls_type} in
	server)
	    ssl_dir=${SSL_SERVER_DIR}
	    ssl_cert_dir=${ssl_dir}
	    ssl_rdir=$(file-basename ${SSL_SERVER_RDIR})
	    cert_file=${TMP_DIR}/${LOADED}.${TLS_SERVER}.certificate.${in_id}
	    ;;
	client)
	    ssl_dir=${SSL_CLIENT_DIR}
	    ssl_cert_dir=${ssl_dir}/${in_id}.cur
	    ssl_rdir=$(file-basename ${SSL_CLIENT_RDIR})
	    ssl_rdir=${ssl_rdir}/${in_id}.cur
	    cert_file=${TMP_DIR}/${LOADED}.${TLS_CLIENT}.certificate.${in_id}
	    ;;
	*)
	    return 255
	    ;;
    esac

    local in_expiration=$(get-tls-end-date ${cert_file})
    local in_serial=$(get-tls-serial ${cert_file})
    local in_fdn=$(get-tls-fdn ${cert_file})

    local state expiration serial unknown fdn
    local revoke tls_file id found

    while read state expiration serial unknown fdn
    do
	if test ${state} == R ; then
	    revoke=${serial}
	    serial=${unknown}
	    fdn=${fdn#unknown*\/}
	    fdn=/${fdn}
	fi

	tls_file=$(readlink ${SSL_CTL_DIR}/${serial}.pem 2> /dev/null)
	id=$(file-basename ${tls_file} .certificate)

	if test ${id} == ${in_id} ; then
	    echo -e "V\t${in_expiration}\t\t${in_serial}\tunknown\t${in_fdn}"
	    rm -f ${SSL_CTL_DIR}/${serial}.pem
	    rm -f ${ssl_dir}/${id}.revoked
	    found=yes
	else
	    if test ${state} == R ; then
		echo -e "${state}\t${expiration}\t${revoke}\t${serial}\tunknown\t${fdn}"
	    else
		echo -e "${state}\t${expiration}\t\t${serial}\tunknown\t${fdn}"
	    fi
	fi
    done < ${SSL_CTL_DIR}/index.txt > ${SSL_CTL_DIR}/index.txt.new

    if test -z "${found}" ; then
	echo -e "V\t${in_expiration}\t\t${in_serial}\tunknown\t${in_fdn}" >> ${SSL_CTL_DIR}/index.txt.new
    fi

    ln -sf ../${ssl_rdir}/${in_id}.certificate ${SSL_CTL_DIR}/${in_serial}.pem &&
	echo ${in_serial} > ${ADMIN_TMP_DIR}/${in_id}.serial.${$} &&
	install -m 644 -o ${ADMIN_NAME} -g ${GROUP_NAME} ${ADMIN_TMP_DIR}/${in_id}.serial.${$} ${ssl_cert_dir}/${in_id}.serial &&
	rm -f ${ADMIN_TMP_DIR}/${in_id}.serial.${$}

    cp -f ${SSL_CTL_DIR}/index.txt ${SSL_CTL_DIR}/index.txt.old &&
        mv -f ${SSL_CTL_DIR}/index.txt.new ${SSL_CTL_DIR}/index.txt
}

get-tls-subject()
{
    test -n "${1}" || return 1
    local cert_file=${1}

    local fdn=$(openssl x509 -in ${cert_file} -text -noout 2> /dev/null | grep 'Subject: ')
    fdn=${fdn/*Subject: }

    echo ${fdn}
}

get-tls-fdn()
{
    test -n "${1}" || return 1
    local cert_file=${1}

    local fdn=$(get-tls-subject ${cert_file})

    fdn=${fdn//, /\/}
    fdn=/${fdn}

    echo ${fdn}
}

get-tls-canonical-name-from-dn()
{
    test -n "${1}" || return 1
    local dn=${1}

    local cn=${dn/*CN=}

    echo ${cn}
}

get-tls-canonical-name()
{
    test -n "${1}" || return 1
    local cert_file=${1}

    local tmp_x509_cert_file=${ADMIN_TMP_DIR}/x509.crt.${$}

    openssl x509 -in ${cert_file} -text -noout > ${tmp_x509_cert_file} 2> /dev/null

    local subject=$(grep 'Subject: ' ${tmp_x509_cert_file} 2> /dev/null)
    local cname=$(get-tls-canonical-name-from-dn "${subject}")

    rm -f ${tmp_x509_cert_file}

    echo ${cname}
}

get-tls-serial()
{
    test -n "${1}" || return 1
    local cert_file=${1}

    local serial=$(openssl x509 -in ${cert_file} -noout -nameopt multiline -serial 2> /dev/null)
    serial=${serial/serial=}

    echo ${serial}
}

get-numbits-days-from-conf-file()
{
    local numbits=2048
    local days=365

    if test -z "${1}" ; then
	echo ${numbits} ${days}
	return 1
    fi

    local conf_file=${1}

    if test ! -f ${conf_file} ; then
	echo ${numbits} ${days}
	return 11
    fi

    local var val i=0
    local numbits days

    while read var val
    do
	test -n "${val}" || continue

	case ${i} in
	    0)
		numbits=${val}
		;;
	    1)
		days=${val}
		;;
	    *)
		break
		;;
	esac
	((i++))
    done < ${conf_file}

    echo ${numbits} ${days}
}

generate-system-ca()
{
    gen-tls-cnf ${TMP_DIR}/${SYSTEM_CA}.conf ca > ${TMP_DIR}/${SYSTEM_CA}.cnf
    if test ${?} -ne 0 ; then clean-generated-system-ca ; return 11 ; fi

    local numbits_days=$(get-numbits-days-from-conf-file ${TMP_DIR}/${SYSTEM_CA}.conf)
    local numbits=${numbits_days/ *}
    local days=${numbits_days/* }

    openssl genrsa \
	    ${numbits} \
	    2> /dev/null > ${TMP_DIR}/${SYSTEM_CA}.key &&
	chmod 600 ${TMP_DIR}/${SYSTEM_CA}.key
    if test ${?} -ne 0 ; then clean-generated-system-ca ; return 13 ; fi

    openssl req \
	    -batch \
	    -new \
	    -x509 \
	    -extensions v3_ca \
	    -days ${days} \
	    -sha256 \
	    -key ${TMP_DIR}/${SYSTEM_CA}.key \
	    -config ${TMP_DIR}/${SYSTEM_CA}.cnf \
	    -out ${TMP_DIR}/${SYSTEM_CA}.certificate \
	    > /dev/null 2>&1
    if test ${?} -ne 0 ; then clean-generated-system-ca ; return 15 ; fi

    openssl x509 \
	    -in ${TMP_DIR}/${SYSTEM_CA}.certificate \
	    -outform DER \
	    -out ${TMP_DIR}/${SYSTEM_CA}.der
    if test ${?} -ne 0 ; then clean-generated-system-ca ; return 17 ; fi

    find ${SSL_LOCAL_CA_DIR} -lname ${SYSTEM_CA_ID}.certificate -exec rm -f {} \; > /dev/null 2>&1
    local hash_value=$(openssl x509 -noout -hash -in ${SSL_CA_DIR}/${SYSTEM_CA}.certificate 2> /dev/null)

    ln -sf ${SYSTEM_CA_ID}.certificate ${SSL_LOCAL_CA_DIR}/${hash_value}.0 2> /dev/null
    if test ${?} -ne 0 ; then clean-generated-system-ca ; return 19 ; fi

    rm -f \
       ${SSL_CLIENT_DIR}/*.revoked \
       ${SSL_SERVER_DIR}/*.revoked \
       ${SSL_CTL_DIR}/index.txt.old \
       ${SSL_CTL_DIR}/serial.old \
       ${SSL_CTL_DIR}/index.txt.attr.old \
       ${SSL_CTL_DIR}/*.pem &&
	echo 1000 > ${SSL_CTL_DIR}/serial &&
	echo -n > ${SSL_CTL_DIR}/index.txt
    if test ${?} -ne 0 ; then clean-generated-system-ca ; return 21 ; fi

    return 0
}

