delete-tls-client()
{
    test -n "${1}" || return 1
    local id=${1}
    local private=${2}

    rm -f ${id}.2del

    if test -n "${private}" ; then
	rm -f ${id}.cur/${id}.{password,key,pfx,pkcs12}
    else
	remove-tls-from-index ${id} &&
	    rm -rf ${id}.cur ${id}.revoked
    fi
}

get-md5sum()
{
    local md5=$(echo -n "${1}" | openssl dgst -md5)
    echo ${md5/*= }
}
