    local serial=$(cat ${SSL_CTL_DIR}/serial.old 2> /dev/null)
    if test -n "${serial}" ; then
        local client_ssl=$(file-basename ${SSL_CLIENT_DIR})
	ln -sf ../${client_ssl}/${id}.cur/${id}.certificate ${SSL_CTL_DIR}/${serial}.pem &&
	    install -m 644 -o ${ADMIN_NAME} -g ${GROUP_NAME} ${SSL_CTL_DIR}/serial.old ${id}.cur/${id}.serial
	if test ${?} -ne 0 ; then clean-generated-tls-client ${id} ; return 29 ; fi
    fi

    clean-generated-tls-client ${id}
}

revoke-tls-client()
{
    test -n "${1}" || return 1
    local rev_file=${1}

    local ret
    local id=$(file-basename ${rev_file} .2rev)

    id=${id/${TLS_CLIENT}\.}
    test -f ${id}.cur/${id}.certificate -a -f ${id}.cur/${id}.cnf || return 11

    local reason=$(get-revoke-reason ${rev_file})
    rm -f ${rev_file}

    openssl ca \
	    -revoke ${id}.cur/${id}.certificate \
	    -config ${id}.cur/${id}.cnf \
	    -crl_reason ${reason} > /dev/null 2>&1
    ret=${?}
	
    if test ${ret} -eq 0 ; then
	echo ${reason} > ${id}.revoked || ret=13
    fi

    return ${ret}
}

