clean-loaded-files()
{
    local file

    for file in ${TRAP_LOADED_FILES}
    do
	rm -f ${file}
    done

    test -z "${TRAP_PROGRESS_FILE}" || rm -f ${TRAP_PROGRESS_FILE}
}

echo-curl-result()
{
    test -n "${1}" || return 0

    local code=${1}
    
    test ${code} -ne 0 || return 0

    case ${code} in
	1)
	    echo "Transfer error ${code} - Unsupported protocol. This build of the program has no support for this protocol." >&2
	    ;;
	2)
	    echo "Transfer error ${code} - Failed to initialize." >&2
	    ;;
	3)
	    echo "Transfer error ${code} - URL malformed. The syntax was not correct." >&2
	    ;;
	5)
	    echo "Transfer error ${code} - Couldn't resolve proxy. The given proxy host could not be resolved." >&2
	    ;;
	6)
	    echo "Transfer error ${code} - Couldn't resolve host. The given remote host was not resolved." >&2
	    ;;
	7)
	    echo "Transfer error ${code} - Failed to connect to host." >&2
	    ;;
	8)
	    echo "Transfer error ${code} - FTP weird server reply. The server sent data the program couldn't parse." >&2
	    ;;
	9)
	    echo "Transfer error ${code} - FTP/SFTP access denied. The server denied login or denied access to the particular resource or directory you wanted to reach. Most often you tried to change to a directory that doesn't exist on the server. To save on an SFTP server always specify the full target path." >&2
	    ;;
	11)
	    echo "Transfer error ${code} - FTP weird PASS reply. The Program couldn't parse the reply sent to the PASS request." >&2
	    ;;
	13)
	    echo "Transfer error ${code} - FTP weird PASV reply, The Program couldn't parse the reply sent to the PASV request." >&2
	    ;;
	14)
	    echo "Transfer error ${code} - FTP weird 227 format. The Program couldn't parse the 227-line the server sent." >&2
	    ;;
	15)
	    echo "Transfer error ${code} - FTP can't get host. Couldn't resolve the host IP we got in the 227-line." >&2
	    ;;
	17)
	    echo "Transfer error ${code} - FTP couldn't set binary. Couldn't change transfer method to binary." >&2
	    ;;
	18)
	    echo "Transfer error ${code} - Partial file. Only a part of the file was transferred." >&2
	    ;;
	19)
	    echo "Transfer error ${code} - FTP couldn't download/access the given file, the RETR (or similar) command failed." >&2
	    ;;
	21)
	    echo "Transfer error ${code} - FTP quote error. A quote command returned error from the server." >&2
	    ;;
	22)
	    echo "Transfer error ${code} - HTTP page not retrieved. The requested url was not found or returned another error with the HTTP error code being 400 or above. This return code only appears if -f/--fail is used." >&2
	    ;;
	23)
	    echo "Transfer error ${code} - Write error. The Program couldn't write data to a local filesystem or similar." >&2
	    ;;
	25)
	    echo "Transfer error ${code} - FTP couldn't STOR file. The server denied the STOR operation, used for FTP uploading." >&2
	    ;;
	26)
	    echo "Transfer error ${code} - Read error. Various reading problems." >&2
	    ;;
	27)
	    echo "Transfer error ${code} - Out of memory. A memory allocation request failed." >&2
	    ;;
	28)
	    echo "Transfer error ${code} - Operation timeout. The specified timeout period was reached according to the conditions." >&2
	    ;;
	30)
	    echo "Transfer error ${code} - FTP PORT failed. The PORT command failed. Not all FTP servers support the PORT command, try doing a transfer using PASV instead!" >&2
