	    ;;
	70)
	    echo "Transfer error ${code} - Out of disk space on TFTP server." >&2
	    ;;
	71)
	    echo "Transfer error ${code} - Illegal TFTP operation." >&2
	    ;;
	72)
	    echo "Transfer error ${code} - Unknown TFTP transfer ID." >&2
	    ;;
	73)
	    echo "Transfer error ${code} - File already exists (TFTP)." >&2
	    ;;
	74)
	    echo "Transfer error ${code} - No such user (TFTP)." >&2
