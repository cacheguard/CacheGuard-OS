	31)
	    echo "Transfer error ${code} - FTP couldn't use REST. The REST command failed. This command is used for resumed FTP transfers." >&2
	    ;;
	33)
	    echo "Transfer error ${code} - HTTP range error. The range "command" didn't work." >&2
