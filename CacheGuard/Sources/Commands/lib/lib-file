	cat << EOT >> ${email_file}
--${boundary}
Content-Type: application/${attached_file_mime}; name="${attached_file_name}"
Content-Length: ${attached_file_len}
Content-Transfer-Encoding: base64
Content-Disposition: attachment; filename="${attached_file_name}"

EOT
	base64 ${attached_file_path} > ${attached_file_path}.base64
	cat ${attached_file_path}.base64 >> ${email_file}
	rm -f ${attached_file_path}.base64
    fi

    cat << EOT >> ${email_file}
--${boundary}
Content-Type: text/plain; charset="ISO-8859-1"
Content-Transfer-Encoding: 8bit

The content of this message is confidential. If you have received it by mistake, please inform us and then delete the message. It is forbidden to copy, forward, or in any way reveal the contents of this message to anyone. The integrity and security of this email cannot be guaranteed. Therefore, the sender will not be held liable for any damage caused by the message.
--${boundary}
EOT
    if test "${__EMAIL_OUTPUT}" != stdout ; then
	${curl_command} \
	    --no-show-error ${progress_bar} \
	    --connect-timeout 10 --max-time  20 \
	    --cacert ${SSL_VAR_DIR}/ca-bundle.crt \
	    --capath ${RUNTIME_ENV_DIR}/${SSL_LOCAL_CA_RDIR} \
	    --ssl-reqd \
	    --login-options 'AUTH=PLAIN' \
	    --user "${CURRENT_EMAIL_ACCOUNT_USERNAME}:${password}" \
	    --mail-from ${CURRENT_ADMINISTRATOR_EMAIL} \
	    --mail-rcpt ${email} \
	    --upload-file ${email_file} \
	    --url smtp://${CURRENT_EMAIL_ACCOUNT_SERVER_FQDN}:${CURRENT_EMAIL_ACCOUNT_SERVER_PORT}

	ret=${?}
	echo-curl-result ${ret}
    else
	cat ${email_file}
	ret=${?}
    fi

    rm -f ${email_file}

    if test ${ret} -ne 0 ; then
	INDIRECT_ERROR_CODE=515
	return 254
    fi

    return 0
}
