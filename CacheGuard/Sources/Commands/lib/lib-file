clean-netrc()
{
    local mode=${1}

    case ${mode} in
	soft)
	    echo -n > ${HOME}/.netrc
	    ;;
	hard)
	    rm -f ${HOME}/.netrc
	    ;;
	*)
	    rm -f ${HOME}/.netrc
	    ;;
    esac
}

delete-file()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    test -n "${3}" || return 3
    local protocol=${1}
    local ip=${2}
    local file_name=${3}

    local ret file_command
    local connect_timeout max_time=5
    local curl_command=$(get-curl-command ${protocol} ${CURRENT_FTP_PASSIVE_MODE})

    case ${protocol} in
	ftp)
	    file_command='DELE'
	    gen-netrc ${ip} ${protocol} > ${HOME}/.netrc
	    connect_timeout=7
	    ;;
	sftp)
	    file_command='rm'
	    gen-netrc ${ip} ${protocol} > ${HOME}/.netrc
	    connect_timeout=5
	    ;;
	*)
	    return 11
	    ;;
    esac

    file_command="${file_command} '${file_name}'"

    unset TRAP_LOADED_FILES
    unset TRAP_PROGRESS_FILE

    ${curl_command} \
	--no-show-error --silent \
	--connect-timeout ${connect_timeout} --max-time ${max_time} \
	--cacert ${SSL_VAR_DIR}/ca-bundle.crt --capath ${RUNTIME_ENV_DIR}/${SSL_LOCAL_CA_RDIR} \
	--quote "${file_command}" --url "${protocol}://${ip}/" --output /dev/null |& tee /dev/null 2>&1
    ret=${PIPESTATUS[0]}

    clean-netrc
    echo-curl-result ${ret}
}

get-progress-bar()
{
    local stderr_file=${1}

    local progress_bar

    case ${TERM} in
	${WADMIN_TERM})
	    if test -n "${stderr_file}" ; then
		progress_bar="--stderr ${stderr_file}"
	    else
		progress_bar="--stderr /dev/null"
	    fi
	    ;;
	${NOPROGRESS_TERM})
	    progress_bar="--stderr /dev/null"
	    ;;
	dumb)
	    # Cron
	    ;;
	'')
	    progress_bar="--silent"
	    ;;
	*)
	    if test "${NON_INTERACTIVE}" == 'yes' ; then
		progress_bar="--stderr /dev/null"
	    else
		progress_bar="--progress-bar"
	    fi
	    ;;
    esac

    echo "${progress_bar}"
}

transfer-files()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 1
    test -n "${3}" || return 1
    test -n "${4}" || return 1
    local cmd=${1}
    local protocol=${2}
    local ip=${3}
    local files=${4}
    local stderr_file=${5}
    local file_type=${6}
    local file_category=${7}

    local max_time=900
    local i=0 range  elt src_file dst_file
    local loaded_files file
    local convert2unix proxy
    local connect_timeout
    local ret

    local curl_command=$(get-curl-command ${protocol} ${CURRENT_FTP_PASSIVE_MODE})
    local curl_args

    case "${file_category}" in
	backup|patch)
	    max_time=900
	    ;;
	urllist)
	    max_time=600
	    ;;
	antiviruspack)
	    max_time=600
	    ;;
	antivirus)
	    max_time=400
	    ;;
	*)
	    ;;
    esac

    unset TRAP_FILE_BEEING_LOADED

    case ${cmd} in
	load|save)
	    ;;
	*)
	    return 1
	    ;;
    esac

    case "${file_type}" in
	ascii)
	    convert2unix=yes
	    ;;
	binary)
	    ;;
	'')
	    ;;
	*)
	    return 1
	    ;;
    esac

    case ${protocol} in
	ftp)
	    gen-netrc ${ip} ${protocol} > ${HOME}/.netrc
	    connect_timeout=7
	    ;;
	sftp)
	    gen-netrc ${ip} ${protocol} > ${HOME}/.netrc
	    connect_timeout=5
	    ;;
	http|https)
	    test ${cmd} == load || return 1
	    connect_timeout=4
	    ;;
	tftp)
	    connect_timeout=3
	    ;;
	*)
	    return 1
	    ;;
    esac

    for elt in ${files}
    do
	range=$[${i} % 2]
	case ${range} in
	    0)
		src_file=${elt}
		;;
	    1)
		dst_file=${elt}

		case ${cmd} in
		    load)
			fuser --silent ${dst_file} 2> /dev/null
			if test ${?} -eq 0 ; then
			    clean-netrc
			    return 96
			fi

			loaded_files="${loaded_files} ${dst_file}"
			test ${src_file:0:1} != '/' || src_file=${src_file:1}
			curl_args="${curl_args} --url ${protocol}://${ip}/${src_file} --output ${dst_file}"
			rm -f ${dst_file}
			;;
		    save)
			test ${dst_file:0:1} != '/' || dst_file=${dst_file:1}
			curl_args="${curl_args} --upload-file ${src_file} --url ${protocol}://${ip}/${dst_file}"
			;;
		    *)
			;;
		esac
		;;
	    *)
		return 255
		;;
	esac
	((i++))
    done

    local nb=$[(${i}+1)/2]
    local progression=0 tee_stderr="/dev/null"
    local progress_bar=$(get-progress-bar ${stderr_file})

    case ${TERM} in
	${WADMIN_TERM})
	    test -z "${stderr_file}" || progression=1
	    ;;
	*)
	    if test "${NON_INTERACTIVE}" != 'yes' ; then
		if test -n "${stderr_file}" ; then
		    progression=1
		    tee_stderr="${stderr_file}"
		fi
	    fi
	    ;;
    esac

    if test ${cmd} == load ; then
	loaded_files="${loaded_files:1}"
	TRAP_LOADED_FILES=${loaded_files}
    else
	unset TRAP_LOADED_FILES
    fi
    TRAP_PROGRESS_FILE=${stderr_file}

    ${curl_command} \
	--no-show-error ${progress_bar} \
	--connect-timeout $[${nb} * ${connect_timeout}] --max-time $[${nb} * ${max_time}] \
	--cacert ${SSL_VAR_DIR}/ca-bundle.crt --capath ${RUNTIME_ENV_DIR}/${SSL_LOCAL_CA_RDIR} \
	--globoff --max-filesize $[${BACKUP_SZ} * 1024] ${curl_args} |& tee ${tee_stderr} 2> /dev/null
    ret=${PIPESTATUS[0]}

    if test ${cmd} == load ; then

	if test -n "${convert2unix}" ; then
	    for file in ${loaded_files}
	    do
		dos2unix -q ${file}
	    done
	fi
    fi

    if test ${progression} -eq 1 ; then
	if test ${ret} -eq 0 ; then
	    echo -n 100 > ${stderr_file}
	else
	    rm -f ${stderr_file}
	fi
    fi

    clean-netrc
    echo-curl-result ${ret}
}

save-files()
{
    transfer-files save "${1}" "${2}" "${3}" "${4}" "${5}" "${6}"
}

load-files()
{
    check-lock || return 123
    transfer-files load "${1}" "${2}" "${3}" "${4}" "${5}" "${6}"
    local ret=${?}
    test ${ret} -eq 0 || clean-loaded-files
    return ${ret}
}

get-remote-file-size()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    test -n "${3}" || return 3
    local protocol=${1}
    local ip=${2}
    local file=${3}
    local ftp_passive_mode=${4}

    local file_size=0

    if test ${protocol} == tftp ; then
	echo ${file_size}
	return 0
    fi

    local connect_timeout=5
    local max_time=10

    local curl_command=$(get-curl-command ${protocol} ${ftp_passive_mode})

    local curl_args="--silent --globoff --connect-timeout ${connect_timeout} --max-time ${max_time}"
    local ret

    case ${protocol} in
	ftp)
	    curl_args="${curl_args} --head"
	    gen-netrc ${ip} ${protocol} > ${HOME}/.netrc
	    ;;
	sftp)
	    gen-netrc ${ip} ${protocol} > ${HOME}/.netrc
	    ;;
	*)
	    ;;
    esac

    curl_args=( ${curl_args} )
    test ${file:0:1} != '/' || file=${file:1}

    local tmp_file_info=${ADMIN_TMP_DIR}/curl.file.info.${$}

    case ${protocol} in
	ftp)
	    ${curl_command} \
		"${curl_args[@]}" \
		--url ${protocol}://${ip}/${file} --output ${tmp_file_info}
	    ret=${?}

	    if test ${ret} -ne 0 ; then
		clean-netrc
		rm -f ${tmp_file_info}
		echo ${file_size}
		return ${ret}
	    fi

	    local header value

	    while read header value
	    do
		test -n "${value}" || continue
		if test ${header} == 'Content-Length:' ; then
		    file_size=${value}
		    file_size=${file_size//[^[:print:]]/}
		    ret=0
		    break
		fi
	    done < ${tmp_file_info}
	    ;;

	sftp)
	    local dir=$(file-dirname ${file})
	    local base=$(file-basename ${file})

	    dir=${dir}/

	    ${curl_command} \
		"${curl_args[@]}" \
		--url ${protocol}://${ip}/${dir} --output ${tmp_file_info} 
	    ret=${?}

	    if test ${ret} -ne 0 ; then
		clean-netrc
		rm -f ${tmp_file_info}
		echo ${file_size}
		return ${ret}
	    fi

	    ret=11
	    local rights size owner group size month day time name

	    while read rights size owner group size month day time name
	    do
		test -n "${owner}" || continue
		if test ${name} == ${base} ; then
		    file_size=${size}
		    ret=0
		    break
		fi
	    done < ${tmp_file_info}
	    ;;
	*)
	    ;;
    esac

    clean-netrc
    rm -f ${tmp_file_info}
    echo ${file_size}
    return ${ret}
}

file-exist()
{
    get-remote-file-size "${@}" ${CURRENT_FTP_PASSIVE_MODE} > /dev/null 2>&1
}

load-files-header()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    test -n "${3}" || return 3
    local protocol=${1}
    local ip=${2}
    local files=${3}

    local loaded_files
    local range i=0 elt src_file dst_file

    local connect_timeout=3
    local max_time=3

    local curl_command=$(get-curl-command ${protocol} ${CURRENT_FTP_PASSIVE_MODE})
    local curl_args

    unset TRAP_FILE_BEEING_LOADED

    case ${protocol} in
	http)
	    ;;
	*)
	    return 11
	    ;;
    esac

    for elt in ${files}
    do
	range=$[${i} % 2]
	case ${range} in
	    0)
		src_file=${elt}
		;;
	    1)
		dst_file=${elt}

		loaded_files="${loaded_files} ${dst_file}"
		test ${src_file:0:1} != '/' || src_file=${src_file:1}
		curl_args="${curl_args} --url ${protocol}://${ip}/${src_file} --output ${dst_file}"
		;;
	    *)
		return 255
		;;
	esac
	((i++))
    done

    curl_args=${curl_args:1}

    loaded_files="${loaded_files:1}"
    local nb=$[(${i}+1)/2]

    TRAP_LOADED_FILES=${loaded_files}

    gen-netrc ${ip} ${protocol} > ${HOME}/.netrc

    ${curl_command} \
	--head --use-ascii --silent \
	--cacert ${SSL_VAR_DIR}/ca-bundle.crt --capath ${RUNTIME_ENV_DIR}/${SSL_LOCAL_CA_RDIR} \
	--connect-timeout $[${nb} * ${connect_timeout}] --max-time $[${nb} * ${max_time}] \
	--globoff ${curl_args}

    local ret=${?}

    clean-netrc

    return ${ret}
}

