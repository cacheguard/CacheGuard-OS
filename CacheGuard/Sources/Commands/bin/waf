source functions

check-waf-application()
{
    test -n "${1}" || return 1
    local application=${1}

    case ${application} in
	cpanel|dokuwiki|drupal|nextcloud|wordpress|xenforo)
	    return 0
	    ;;
	*)
	    return 11
	    ;;
    esac
}

show-level()
{
    echo-begin-show
    echo-command-form "waf level"
    echo-mark-cur
    echo-value "${CURRENT_WAF_LEVEL}"
    if test "${CURRENT_WAF_LEVEL}" != "${WAF_LEVEL}" ; then
	echo-command-form "waf level"
	echo-mark-new
	echo-value "${WAF_LEVEL}"
    fi
    echo-end-show

}

manage-waf-level()
{
    if test -z "${1}" ; then
	show-level
	return 0
    fi

    local level=${1}

    check-digit ${level} || return 190
    test ${level} -ge 1 -a ${level} -le 4 || return 160
    export WAF_LEVEL=${level}

    SAVENV=1
}

show-score-request()
{
    echo-command-form "waf score request"
    echo-mark-cur
    echo-value "${CURRENT_WAF_REQUEST_SCORE}"

    if test "${CURRENT_WAF_REQUEST_SCORE}" != "${WAF_REQUEST_SCORE}" ; then
	echo-command-form "waf score request"
	echo-mark-new
	echo-value "${WAF_REQUEST_SCORE}"
    fi
}

show-score-response()
{
    echo-command-form "waf score response"
    echo-mark-cur
    echo-value "${CURRENT_WAF_RESPONSE_SCORE}"

    if test "${CURRENT_WAF_RESPONSE_SCORE}" != "${WAF_RESPONSE_SCORE}" ; then
	echo-command-form "waf score response"
	echo-mark-new
	echo-value "${WAF_RESPONSE_SCORE}"
    fi
}

show-score()
{
    echo-begin-show
    case "${1}" in
	request|response)
	    show-score-${1}
	    ;;
	"")
	    show-score-request
	    show-score-response
	    ;;
	*)
	    return 255
	    ;;
    esac
    echo-end-show
}

check-waf-score()
{
    test -n "${1}" || return 1
    local limit=${1}

    case ${limit} in
	response|request)
	    return 0
	    ;;
	*)
	    return 1
	    ;;
    esac
}

manage-waf-score()
{
    if test -z "${1}" ; then
	show-score
	return 0
    fi

    local attribute=${1}
    check-waf-score ${attribute} || return 1

    if test -z "${2}" ; then
	show-score ${attribute}
	return 0
    fi

    local value=${2}

    check-digit ${value} || return 190

    case ${attribute} in
	request)
	    test ${value} -ge 1 || return 160
	    test ${value} -le ${MAX_WAF_SCORE} || return 159
	    export WAF_REQUEST_SCORE=${value}
	    ;;
	response)
	    test ${value} -ge 1 || return 160
	    test ${value} -le ${MAX_WAF_SCORE} || return 159
	    export WAF_RESPONSE_SCORE=${value}
	    ;;
	*)
	    return 255
	    ;;
    esac

    SAVENV=1
}

get-generic-pos()
{
    test -n "${1}" || return 1
    local filter=${1}

    local i len=${#WAF_GENERIC_FILTER_ID[@]}

    for ((i=0;i<len;i++))
    do
	test ${WAF_GENERIC_FILTER_ID[${i}]} != ${filter} || break
    done

    echo ${i}
}

get-generic-pos-value()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 1
    local filters=${1}
    local name=${2}

    local pos=$(get-generic-pos ${name})
    local value=${filters:${pos}:1}
    echo ${value}
}

show-all-generic()
{
    local flag1 flag2
    local i len=${#WAF_GENERIC_FILTER_ID[@]}

    echo-command-form "waf generic"
    echo-mark-cur

    for ((i=0 ; i<len ; i++))
    do
	
	flag1=${CURRENT_WAF_GENERIC:${i}:1}
	flag1=$(waf-external-form ${flag1})
	
	flag2=${WAF_GENERIC:${i}:1}
	flag2=$(waf-external-form ${flag2})

	if test ${TERM} == ${WADMIN_TERM} ; then
	    if test ${i} -ne 0 ; then
		echo -n "<td></td>"
		echo-mark-cur
	    fi
	    echo-value "${WAF_GENERIC_FILTER_ID[${i}]} ${flag1}"
	else
	    echo-value "${WAF_GENERIC_FILTER_ID[${i}]}" ${PRINT_COL} -n
	    echo-value ${flag1} ${WAF_GENERIC_COL}
	fi
		
	if test ${flag1} != ${flag2} ; then
	    if test ${TERM} == ${WADMIN_TERM} ; then
		echo -n "<td></td>"
		echo-mark-new
		echo-value "${WAF_GENERIC_FILTER_ID[${i}]} ${flag2}"
	    else
		echo-value "${WAF_GENERIC_FILTER_ID[${i}]}" ${PRINT_COL} -n
		echo-mark-new
		echo-value ${flag2} ${WAF_GENERIC_COL}
	    fi
	fi
    done
}

show-generic()
{
    echo-begin-show

    if test -z "${1}" ; then
	show-all-generic
    else
	local name=${1}

	local flag1=$(get-generic-pos-value ${CURRENT_WAF_GENERIC} ${name})
	local flag2=$(get-generic-pos-value ${WAF_GENERIC} ${name})

	flag1=$(waf-external-form ${flag1})
	flag2=$(waf-external-form ${flag2})

	echo-command-form "waf generic"
	echo-mark-cur
	echo-value "${name}" ${PRINT_COL} -n ; echo-value ${flag1} ${WAF_GENERIC_COL}

	if test ${flag1} != ${flag2} ; then
	    echo-value "${name}" ${PRINT_COL} -n
	    echo-mark-new
	    echo-value ${flag2} ${WAF_GENERIC_COL}
	fi
    fi

    echo-end-show
}

show-limit-request()
{
    echo-command-form "waf limit request"
    echo-mark-cur
    echo-value "${CURRENT_WAF_REQUEST_BODY} KB"

    if test "${CURRENT_WAF_REQUEST_BODY}" != "${WAF_REQUEST_BODY}" ; then
	echo-command-form "waf limit request"
	echo-mark-new
	echo-value "${WAF_REQUEST_BODY} KB"
    fi
}

show-limit-response()
{
    echo-command-form "waf limit response"
    echo-mark-cur
    echo-value "${CURRENT_WAF_RESPONSE_BODY} KB"

    if test "${CURRENT_WAF_RESPONSE_BODY}" != "${WAF_RESPONSE_BODY}" ; then
	echo-command-form "waf limit response"
	echo-mark-new
	echo-value "${WAF_RESPONSE_BODY} KB"
    fi
}

