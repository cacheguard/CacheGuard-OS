{
    echo-command-form "admin snmp tls"
    local val=$(external-form ${CURRENT_SNMP_TLS})
    echo-mark-cur
    echo-value "${val}"

    if test "${CURRENT_SNMP_TLS}" != "${SNMP_TLS}" ; then
	echo-command-form "admin snmp tls"
	echo-mark-new
	val=$(external-form ${SNMP_TLS})
	echo-value "${val}"
    fi
}

show-snmp-udp()
{
    echo-command-form "admin snmp udp"
    local val=$(external-form ${CURRENT_SNMP_UDP})
    echo-mark-cur
    echo-value "${val}"

    if test "${CURRENT_SNMP_UDP}" != "${SNMP_UDP}" ; then
	echo-command-form "admin snmp udp"
	echo-mark-new
	val=$(external-form ${SNMP_UDP})
	echo-value "${val}"
    fi
}

show-snmp-tcp()
{
    echo-command-form "admin snmp tcp"
    local val=$(external-form ${CURRENT_SNMP_TCP})
    echo-mark-cur
    echo-value "${val}"

    if test "${CURRENT_SNMP_TCP}" != "${SNMP_TCP}" ; then
	echo-command-form "admin snmp tcp"
	echo-mark-new
	val=$(external-form ${SNMP_TCP})
	echo-value "${val}"
    fi
}

show-snmp()
{
    echo-begin-show
    case ${1} in
	mode)
	    show-admin-snmp
	    ;;
	engine)
	    show-snmp-engine-id
	    ;;
	user)
	    show-snmp-user
	    ;;
	community)
	    show-snmp-community
	    ;;
	privacy)
	    show-snmp-privacy
	    ;;
	'trap')
	    show-snmp-trap
	    ;;
	tls)
	    show-snmp-tls
	    ;;
	udp)
	    show-snmp-udp
	    ;;
	tcp)
	    show-snmp-tcp
	    ;;
	"")
	    show-admin-snmp
	    show-snmp-engine-id
	    show-snmp-user
	    show-snmp-community
	    show-snmp-privacy
	    show-snmp-trap
	    show-snmp-tls
	    show-snmp-udp
	    show-snmp-tcp
	    ;;  
	*)
	    error 255
	    ;;
    esac
    echo-end-show
}

show-admin()
{
    echo-begin-show

    case "${1}" in
	ssh)
	    show-admin-ssh
	    ;;
	wadmin)
	    show-admin-wadmin
	    ;;
	snmp)
	    show-snmp
	    ;;
	waudit)
	    ! contextual-command-is-allowed || show-admin-waudit
	    ;;
	2fa)
	    show-admin-2fa
	    ;;
	'')
	    show-admin-ssh
	    show-admin-wadmin
	    show-admin-snmp

	    ! contextual-command-is-allowed || show-admin-waudit
	    ! is-in-top-level-context || show-admin-2fa
	    ;;
	*)
	    return 255
	    ;;
    esac

    echo-end-show
}

