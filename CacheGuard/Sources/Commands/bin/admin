source functions

exit-cb()
{
    stty echo
    exit 0
}

check-snmp-version()
{
    test -n "${1}" || return 1

    case "${1}" in
	v1|v2c|v3)
	    return 0
	    ;;
	*)
	    return 1
	    ;;
    esac
}

check-snmp-user-name()
{
    test ${#1} -le ${MAX_LEN} || return 1
    check-allowed-argument-no-space "${1}"
}

check-trap-password()
{
    test -n "${1}" || return 0
    test ${#1} -le ${MAX_LEN} || return 1
    check-allowed-argument-no-space "${1}"
}

show-admin-snmp()
{
    echo-command-form "admin snmp"
    local val=$(external-form ${CURRENT_ADMIN_SNMP})
    echo-mark-cur
    echo-value "${val}"

    if test "${CURRENT_ADMIN_SNMP}" != "${ADMIN_SNMP}" ; then
	echo-command-form "admin snmp"
	echo-mark-new
	val=$(external-form ${ADMIN_SNMP})
	echo-value "${val}"
    fi
}

show-admin-ssh()
{
    echo-command-form "admin ssh"
    local val=$(external-form ${CURRENT_ADMIN_SSH})
    echo-mark-cur
    echo-value "${val}"

    if test "${CURRENT_ADMIN_SSH}" != "${ADMIN_SSH}" ; then
	echo-command-form "admin ssh"
	echo-mark-new
	val=$(external-form ${ADMIN_SSH})
	echo-value "${val}"
    fi
}

show-admin-wadmin()
{
    echo-command-form "admin wadmin"
    local val=$(external-form ${CURRENT_ADMIN_WADMIN})
    echo-mark-cur
    echo-value "${val}"

    if test "${CURRENT_ADMIN_WADMIN}" != "${ADMIN_WADMIN}" ; then
	echo-command-form "admin wadmin"
	echo-mark-new
	val=$(external-form ${ADMIN_WADMIN})
	echo-value "${val}"
    fi
}

show-admin-2fa()
{
    local cur_2fa=$(get-admin-2fa ${USER} cur)
    local new_2fa=$(get-admin-2fa ${USER} new)

    echo-command-form "admin 2fa"
    local val=$(external-form ${cur_2fa})
    echo-mark-cur
    echo-value "${val}"

    if test ${cur_2fa} != ${new_2fa} ; then
	echo-command-form "admin 2fa"
	echo-mark-new
	val=$(external-form ${new_2fa})
	echo-value "${val}"
    fi
}

show-admin-waudit()
{
    echo-command-form "admin waudit"
    local val=$(external-form ${CURRENT_ADMIN_WAUDIT})
    echo-mark-cur
    echo-value "${val}"

    if test "${CURRENT_ADMIN_WAUDIT}" != "${ADMIN_WAUDIT}" ; then
	echo-command-form "admin waudit"
	echo-mark-new
	val=$(external-form ${ADMIN_WAUDIT})
	echo-value "${val}"
    fi
}

show-snmp-engine-id()
{
    echo-command-form "admin snmp engine"
    local engine_file=/var/run/${SNMP_ENGINE_ID}
    echo-mark-cur
    if test -s ${engine_file} ; then
	local value=$(cat ${engine_file})
	echo-value "Hex: ${value// /}"
    else
	echo-value "<not running>"
    fi
}

show-snmp-community()
{
    echo-command-form "admin snmp community"
    echo-mark-cur
    echo-value "..."

    if test "${CURRENT_SNMP_COMMUNITY}" != "${SNMP_COMMUNITY}" ; then
	echo-command-form "admin snmp community"
	echo-mark-new
	echo-value "..."
    fi
}

show-snmp-privacy()
{
    echo-command-form "admin snmp privacy"
    echo-mark-cur
    echo-value "..."

    if test "${CURRENT_SNMP_PRIVACY}" != "${SNMP_PRIVACY}" ; then
	echo-command-form "admin snmp privacy"
	echo-mark-new
	echo-value "..."
    fi
}

show-snmp-user()
{
    echo-command-form "admin snmp user"
    echo-mark-cur
    echo-value "${CURRENT_SNMP_USER}"
    if test "${CURRENT_SNMP_USER}" != "${SNMP_USER}" ; then
	echo-command-form "admin snmp user"
	echo-mark-new
	echo-value "${SNMP_USER}"
    fi
}

