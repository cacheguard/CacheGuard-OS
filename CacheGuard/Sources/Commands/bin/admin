{
    echo-command-form "admin topology internal"
    local val=$(external-form ${CURRENT_ADMIN_INTERNAL})
    echo-mark-cur
    echo-value "${val}" 32

    if test "${CURRENT_ADMIN_INTERNAL}" != "${ADMIN_INTERNAL}" ; then
	echo-command-form "admin topology internal"
	echo-mark-new
	val=$(external-form ${ADMIN_INTERNAL})
	echo-value "${val}" 32
    fi
}

