source functions

check-peer()
{
    test -n "${1}" || return 1

    case "${1}" in
	share|ha|next|previous)
	    return 0
	    ;;
	*)
	    return 1
	    ;;
    esac
}

check-peer-nb()
{
    test -n "${1}" || return 1
    local peer_type=${1}

    local peer_list record_len len

    case ${peer_type} in
	share)
	    peer_list=${PEER_SHARE_LIST}
	    record_len=2
	    ;;
	ha)
	    peer_list=${PEER_HA_LIST}
	    record_len=2
	    ;;
	previous)
	    peer_list=${PEER_PREVIOUS_LIST}
	    record_len=2
	    ;;
	next)
	    peer_list=${PEER_NEXT_LIST}
	    record_len=3
	    ;;
	*)
	    return 1
    esac

    len=$(record-length-list ${record_len} "${peer_list}")
    test ${len} -lt ${MAX_PEERS_NB}
}

show-peer-list1()
{
    local peer_type=${2}
    local peers=${3}

    echo-command-form "peer ${peer_type}"
    if test "${1}" == "new" ; then
	echo-mark-new
    else
	echo-mark-cur
    fi
    if test -z "${peers}" ; then
	echo-value-null
	return 0
    fi

    local ip qos port
    local elt range i=0 n=0

    for elt in ${peers}
    do
	range=$[${i} % 2]
	case ${range} in
	    0)
		ip=${elt}
		;;
	    1)
		test ${n} -eq 0 || echo-blank-command
		case ${peer_type} in
		    share|ha|previous)
			qos="${elt}"
			qos=" ${qos}%"
			echo-value "${ip}${qos}"
			;;
		    *)
			error 255
			;;
		esac
		((n++))
		;;
	    *)
		return 1
		;;
	esac
	((i++))
    done
}

show-next-peer-list1()
{
    local peers=${2}

    echo-command-form "peer next"
    if test "${1}" == "new" ; then
	echo-mark-new
    else
	echo-mark-cur
    fi
    if test -z "${peers}" ; then
	echo-value-null
	return 0
    fi

    local ip qos port
    local elt range i=0 n=0

    for elt in ${peers}
    do
	range=$[${i} % 3]
	case ${range} in
	    0)
		ip=${elt}
		;;
	    1)
		port=${elt}
		;;
	    2)
		qos=${elt}
		test ${n} -eq 0 || echo-blank-command
		echo-value "${ip} ${port} ${qos}%"
		((n++))
		;;
	    *)
		return 1
		;;
	esac
	((i++))
    done
}

show-peer-list()
{
    local peer_type=${1}
    local current_peer_list=${2}
    local peer_list=${3}

    show-peer-list1 'current' "${peer_type}" "${current_peer_list}"
    if test "${current_peer_list}" != "${peer_list}" ; then
	show-peer-list1 'new' "${peer_type}" "${peer_list}"
    fi
}

show-share-peers()
{
    show-peer-list share "${CURRENT_PEER_SHARE_LIST}" "${PEER_SHARE_LIST}"
}

show-ha-peers()
{
    show-peer-list ha "${CURRENT_PEER_HA_LIST}" "${PEER_HA_LIST}"
}

show-previous-peers()
{
    show-peer-list previous "${CURRENT_PEER_PREVIOUS_LIST}" "${PEER_PREVIOUS_LIST}"
}

show-next-peer-list()
{
    local current_peer_list=${1}
    local peer_list=${2}

    show-next-peer-list1 'current' "${current_peer_list}"
    if test "${current_peer_list}" != "${peer_list}" ; then
	show-next-peer-list1 'new' "${peer_list}"
    fi
}

show-next-peers()
{
    show-next-peer-list "${CURRENT_PEER_NEXT_LIST}" "${PEER_NEXT_LIST}"
}

show-peers()
{
    echo-begin-show
    case "${1}" in
	share)
	    show-share-peers
	    ;;
	ha)
	    show-ha-peers
	    ;;
	previous)
	    show-previous-peers
	    ;;
	next)
	    show-next-peers
	    ;;
	'')
	    show-share-peers
	    show-ha-peers
	    show-previous-peers
	    show-next-peers
	    ;;
	*)
	    error 255
	    ;;
    esac
    echo-end-show
}

raz-peers()
{
    test -n "${1}" || return 1
    local peer_type=${1}

    local peer_list len

    case ${peer_type} in
	share)
	    unset PEER_SHARE_LIST
	    ;;
	ha)
	    unset PEER_HA_LIST
	    ;;
	next)
	    unset PEER_NEXT_LIST
	    ;;
	previous)
	    unset PEER_PREVIOUS_LIST
	    ;;
	*)
	    error 255
    esac
}

run()
{
    contextual-command-is-allowed || return 207

    if test -z "${ARGS[1]}" ; then show-peers ; return 0 ; fi
    
    local pt=${ARGS[1]}
    check-peer "${pt}" || return 1
    
    if test -z "${ARGS[2]}" ; then show-peers ${pt} ; return 0 ; fi
    
    local act=${ARGS[2]}
    check-action ${act} || return 122

    case ${act} in
	raz)
	    raz-peers ${pt}
	    ;;
	add|del)
	    test -n "${ARGS[3]}" || return 1
	    local ip=${ARGS[3]}
	    check-ip ${ip} || return 12
	    
	    if test ${act} == add ; then
		case ${pt} in
		    next)
			if test -z "${ARGS[4]}" ; then
			    local pr=${PEER_HTTP_PORT}
			    local qos=100
			else
			    local pr=${ARGS[4]}
			    pr=$(remove-leading-zeros ${pr})
			    check-service-port-nb ${pr} || return 61
			    if test -z "${ARGS[5]}" ; then
				local qos=100
			    else
				local qos=${ARGS[5]}
				check-percentage ${qos} || return 11
			    fi
			fi
			;;
		    share|ha|previous)
			if test -z "${ARGS[4]}" ; then
			    local qos=100
			else
			    local qos=${ARGS[4]}
			    qos=$(remove-leading-zeros ${qos})
			    qos=$(get-percent-value ${qos})
			    check-percentage ${qos} || return 11
			fi
			;;
		    *)
			error 255
		esac
		
		test ${ip} != "127.0.0.1" || return 38
		check-peer-nb ${pt} || return 90
	    else
		if test ${pt} == next ; then
		    local pr=${ARGS[4]}
		    test -n "${pr}" || pr=${PROXY_PORT}
		    pr=$(remove-leading-zeros ${pr})
		    check-service-port-nb ${pr} || return 61
		fi
	    fi
	    
	    case ${pt} in
		share)
		    export PEER_SHARE_LIST=$(remove-record-from-list 2 1 "${ip}" "${PEER_SHARE_LIST}")
		    if test ${act} == add ; then
			if test -z "${PEER_SHARE_LIST}" ; then
			    export PEER_SHARE_LIST="${ip} ${qos}"
			else
			    export PEER_SHARE_LIST="${PEER_SHARE_LIST} ${ip} ${qos}"
			fi
		    fi
		    ;;
		ha)
		    export PEER_HA_LIST=$(remove-record-from-list 2 1 "${ip}" "${PEER_HA_LIST}")
		    if test ${act} == add ; then
			if test -z "${PEER_HA_LIST}" ; then
			    export PEER_HA_LIST="${ip} ${qos}"
			else
			    export PEER_HA_LIST="${PEER_HA_LIST} ${ip} ${qos}"
			fi
		    fi
		    ;;
		previous)
		    export PEER_PREVIOUS_LIST=$(remove-record-from-list 2 1 "${ip}" "${PEER_PREVIOUS_LIST}")
		    if test ${act} == add ; then
			if test -z "${PEER_PREVIOUS_LIST}" ; then
			    export PEER_PREVIOUS_LIST="${ip} ${qos}"
			else
			    export PEER_PREVIOUS_LIST="${PEER_PREVIOUS_LIST} ${ip} ${qos}"
			fi
		    fi
		    ;;
		next)
		    export PEER_NEXT_LIST=$(remove-record-from-list 3 2 "${ip} ${pr}" "${PEER_NEXT_LIST}")
		    if test ${act} == add ; then
			if test -z "${PEER_NEXT_LIST}" ; then
			    export PEER_NEXT_LIST="${ip} ${pr} ${qos}"
			else
			    export PEER_NEXT_LIST="${PEER_NEXT_LIST} ${ip} ${pr} ${qos}"
			fi
		    fi
		    ;;

		*)
		    error 255
		    ;;
	    esac
	    ;;
	*)
	    return 1
	    ;;
    esac
    
    SAVENV=1
}

main "${@}"
