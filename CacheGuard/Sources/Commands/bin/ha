source functions

show-ha()
{
    local state=$(get-ha-state)

    echo-begin-show
    echo-command-form "ha"
    echo-value "${state}"
    echo-end-show
}

run()
{
    contextual-command-is-allowed || return 207
    test -z "${TRANSACTION}" || return 106
    test "${CURRENT_HA_MODE}" == True || return 164

    if test -z "${ARGS[1]}" ; then
	show-ha
	return ${?}
    fi

    local action=${ARGS[1]}
    local confirm=${ARGS[2]}

    case ${action} in
	failover)
	    ;;
	active)
	    ;;
	*)
	    return 165
	    ;;
    esac

    test -z "${confirm}" -o "${confirm}" == "force" || return 1
    user-has-admin-rights || return 31
    check-lock || return 123
    test "${confirm}" == force || request-confirmation
    supervisor-action "ha-${action}"
    test ${?} -eq 0 || return 104
}

main "${@}"
