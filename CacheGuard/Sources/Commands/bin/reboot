source functions

run()
{
    test -z "${TRANSACTION}" || return 106

    push-args "${@}"
    init-global-variables

    if test -n "${ARGS[1]}" ; then
	case "${ARGS[1]}" in
	    force|report)
		;;
	    *)
		return 1
		;;
	esac
    fi

    user-has-admin-rights || return 31
    check-lock || return 123
    test "${ARGS[1]}" == force || request-confirmation
    test "${ARGS[1]}" != report || return 0
    supervisor-action "reboot"
    test ${?} -eq 0 || return 104
}

main __noenv "${@}"
