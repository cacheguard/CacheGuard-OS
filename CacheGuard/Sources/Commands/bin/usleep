source functions

run()
{
    init-global-variables

    test -n "${1}" || return 1
    local t=${1}

    check-digit ${t} || return 177
    local l=${#t}
    test ${l} -le 19 || return 177
    PATH=/bin usleep ${t}
    return 0
}

main __noenv "${@}"
