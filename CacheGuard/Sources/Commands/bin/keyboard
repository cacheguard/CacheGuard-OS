source functions

run()
{
    test -z "${TRANSACTION}" || return 106

    user-has-admin-rights || return 31
    check-lock || return 123

    local keyboard keyboards
    local keymap ret

    while read keyboard
    do
	keyboards="${keyboards} ${keyboard/*\/} ${keyboard}"
    done < /etc/keyboards
    keyboards=${keyboards:1}

    if test -s /etc/keymap ; then
	keymap=$(cat /etc/keymap 2> /dev/null)
	test -n "${keymap}" || keymap="us"
    else
	keymap="us"
    fi

    dialog --no-shadow --ascii-lines --colors --backtitle "${COMMERCIAL_NAME} UTM Keyboard Configuration" --title "Keyboard selection" --no-cancel --default-item "${keymap}" --menu "Please select your keyboard type:\n\n" 20 0 16 ${keyboards} 2> ${ADMIN_TMP_DIR}/keymap.${$}

    keymap=$(cat ${ADMIN_TMP_DIR}/keymap.${$} 2> /dev/null)
    rm -f ${ADMIN_TMP_DIR}/keymap.${$}

    supervisor-push-args "${keymap}"
    supervisor-action "keyboard"
    test ${?} -eq 0 || return 104
    return 0
}

main "${@}"
