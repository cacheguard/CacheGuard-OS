source functions

check-fw-rule-set-name()
{
    case "${1}" in
	external|web|rweb|antivirus|admin|mon|file|peer|auxiliary|vpnipsec)
	    return 0
	    ;;
	*)
	    return 1
	    ;;
    esac
}

check-fw-dev-name()
{
    test -n "${1}" || return 1
    local dev=${1}

    check-fw-rule-set-name ${dev}
}

check-fw-protocol()
{
    test -n "${1}" || return 1

    case "${1}" in
	any)
	    return 0
	    ;;
	icmp|igmp|udp|tcp|gre)
	    return 0
	    ;;
	ftp_passive|ftp_active|ftp_trivial|sip)
	    return 0
	    ;;
	esp|ah|tlsp|cftp|visa)
	    return 0
	    ;;
	ipv6|vrrp|"fc"|ospfigp|mtp|etherip)
	    ;;
	*)
	    return 1
	    ;;
    esac
}

check-fw-dynamic-ports-protocol()
{
    test -n "${1}" || return 1
    protocol=${1}
    
    case ${protocol} in
	ftp_active|ftp_passive|ftp_trivial|sip)
	    return 0
	    ;;
	*)
	    return 1
	    ;;
    esac

    return 255
}

check-fw-protocol-port()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    protocol=${1}
    port=${2}
    
    case ${protocol} in
	tcp|udp|ftp_active|ftp_passive|ftp_trivial|sip)
	    return 0
	    ;;
	*)
	    test ${port} == any || return 1
	    return 0
	    ;;
    esac

    return 0
}

check-fw-protocol-pat()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    protocol=${1}
    port=${2}
    
    case ${protocol} in
	tcp|udp|ftp_active|ftp_passive|ftp_trivial|sip)
	    return 0
	    ;;
	*)
	    test ${port} == nil || return 1
	    return 0
	    ;;
    esac

    return 0
}

check-fw-port-range()
{
    test -n "${1}" || return 1
    local ports=${1}

    [[ "${ports}" =~ (^[1-9][0-9]{0,4}|^0)[:]([1-9][0-9]{0,4}|0)$ ]] || return 2

    local port1=${ports/:*}
    local port2=${ports/*:}

    test ${port1} -ge 0 || return 3
    test ${port1} -le 65535 || return 4

    test ${port2} -ge 0 || return 5
    test ${port2} -le 65535 || return 6

    test ${port1} -le ${port2} || return 7

    return 0
}

check-fw-port()
{
    test -n "${1}" || return 1
    local ports=${1}

    test ${ports} != any || return 0
    check-port-nb ${ports} || check-fw-port-range ${ports} || return 1
}

show-fw-rules1()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    local mode=${1}
    local rset=${2}
    local rules=${3}

    echo-command-form "firewall ${rset}"
    if test "${mode}" == "new" ; then
	echo-mark-new
    else
	echo-mark-cur
    fi

    if test -z "${rules}" ; then
	echo-value-null
	return 0
    fi
    
    local id state action protocol src_ip dst_dev dst_ip dst_ports
    local src_nat_ip dst_nat_ip dst_pat_port

    local elt range i=0 n=0
    local rule

    for elt in ${rules}
    do
	range=$[${i} % 11]
	case ${range} in
	    0)
		id=${elt}
		;;
	    1)
		state=${elt}
		;;
	    2)
		action=${elt}
		;;
	    3)
		protocol=${elt}
		;;
	    4)
		src_ip=${elt}
		;;
	    5)
		dst_dev=${elt}
		;;
	    6)
		dst_ip=${elt}
		;;
	    7)
		dst_ports=${elt}
		;;
	    8)
		src_nat_ip=${elt}
		;;
	    9)
		dst_nat_ip=${elt}
		;;
	    10)
		dst_pat_port=${elt}

		rule="${id} [${state}] ${action} ${protocol} ${src_ip} ${dst_dev} ${dst_ip}"
		
		if test "${src_nat_ip}" != "nil" ; then
		    if test "${dst_nat_ip}" != "nil" ; then
			if test "${dst_pat_port}" != "nil" ; then
			    rule="${rule} ${dst_ports} snat:${src_nat_ip} dnat:${dst_nat_ip} dpat:${dst_pat_port}"
			else
			    rule="${rule} ${dst_ports} snat:${src_nat_ip} dnat:${dst_nat_ip}"
			fi
		    else
			rule="${rule} ${dst_ports} snat:${src_nat_ip}"
		    fi
		else
		    if test "${dst_nat_ip}" != "nil" ; then
			if test "${dst_pat_port}" != "nil" ; then
			    rule="${rule} ${dst_ports} snat:${src_nat_ip} dnat:${dst_nat_ip} dpat:${dst_pat_port}"
			else
			    rule="${rule} ${dst_ports} snat:${src_nat_ip} dnat:${dst_nat_ip}"
			fi
		    fi
		fi
		test ${n} -eq 0 || echo-blank-command
		echo-value "${rule}"
		((n++))
		;;
	    *)
		return 255
		;;
	esac
	((i++))
    done
}

show-fw-external-rules()
{
    show-fw-rules1 cur external "${CURRENT_FW_EXTERNAL_RULE_LIST}"
    if test "${CURRENT_FW_EXTERNAL_RULE_LIST}" != "${FW_EXTERNAL_RULE_LIST}" ; then
	show-fw-rules1 new external "${FW_EXTERNAL_RULE_LIST}"
    fi
}

