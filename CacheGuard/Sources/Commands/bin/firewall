show-fw-rules()
{
    local rset=${1}

    echo-begin-show
    case "${rset}" in
	external|web|rweb|antivirus|admin|mon|file|peer|auxiliary|vpnipsec)
	    show-fw-${rset}-rules
	    ;;
	"")
	    for rset in external web rweb antivirus admin mon file peer auxiliary vpnipsec
	    do
		show-fw-${rset}-rules
	    done
	    ;;
	*)
	    return 1
	    ;;
    esac
    echo-end-show
}

manage-bulk-fw-states()
{
    test -n "${1}" || return 0
    local in_rules=${1}

    local id state action protocol src_ip dst_dev dst_ip dst_ports
    local src_nat_ip dst_nat_ip dst_pat_port

    local i elt range j nb=0
    local rule id_array state_array index
    local out_rules

    declare -a id_array state_array

    for ((i=1 ; i<${ARGS_NB} ; i+=2))
    do
	state=${ARGS[${i}]}
	id=${ARGS[$[${i}+1]]}
	check-boolean "${state}" || return 18
	check-id-length "${id}" || return 127
	check-id "${id}" || return 35
	state_array[${nb}]=${state}
	id_array[${nb}]=${id}
	((nb++))
    done

    i=0
    for elt in ${in_rules}
    do
	range=$[${i} % 11]
	case ${range} in
	    0)
		id=${elt}
		;;
	    1)
		state=${elt}
		;;
	    2)
		action=${elt}
		;;
	    3)
		protocol=${elt}
		;;
	    4)
		src_ip=${elt}
		;;
	    5)
		dst_dev=${elt}
		;;
	    6)
		dst_ip=${elt}
		;;
	    7)
		dst_ports=${elt}
		;;
	    8)
		src_nat_ip=${elt}
		;;
	    9)
		dst_nat_ip=${elt}
		;;
	    10)
		dst_pat_port=${elt}

		unset index
		for ((j=0 ; j<nb ; j++))
		do
		    if test "${id}" == "${id_array[${j}]}" ; then
			index=${j}
			break
		    fi
		done
		test -z "${index}" || state=${state_array[${index}]}
		rule="${id} ${state} ${action} ${protocol} ${src_ip} ${dst_dev} ${dst_ip} ${dst_ports} ${src_nat_ip} ${dst_nat_ip} ${dst_pat_port}"
		out_rules="${out_rules} ${rule}"
		;;
	    *)
		return 255
		;;
	esac
	((i++))
    done

    out_rules="${out_rules:1}"
    echo ${out_rules}
    return 0
}

show-fw-dos-tcpflood()
{
    echo-command-form "firewall dos tcpflood"
    echo-mark-cur
    if test -z "${CURRENT_FW_DOS_TCP_FLOOD}" ; then
	echo-value "default [$(get-default-tcp-flood-limit) $(get-default-tcp-flood-burst)]"
    else
	echo-value "${CURRENT_FW_DOS_TCP_FLOOD}"
    fi

    if test "${CURRENT_FW_DOS_TCP_FLOOD}" != "${FW_DOS_TCP_FLOOD}" ; then
	echo-command-form "firewall dos tcpflood"
	echo-mark-new
	if test -z "${FW_DOS_TCP_FLOOD}" ; then
	    echo-value "default [$(get-default-tcp-flood-limit) $(get-default-tcp-flood-burst)]"
	else
	    echo-value "${FW_DOS_TCP_FLOOD}"
	fi
    fi

}

