show-fw-dos()
{
    echo-begin-show

    case "${1}" in
	tcpflood|udpflood|webflood|rwebflood|piptcp|pipweb|piprweb|pipdns|pipocsp)
	    show-fw-dos-${1}
	    ;;
	"")
	    show-fw-dos-tcpflood
	    show-fw-dos-udpflood
	    show-fw-dos-webflood
	    show-fw-dos-rwebflood
	    show-fw-dos-piptcp
	    show-fw-dos-pipweb
	    show-fw-dos-piprweb
	    show-fw-dos-pipdns
	    show-fw-dos-pipocsp
	    ;;
	*)
	    return 255
	    ;;
    esac

    echo-end-show
}

manage-fw-dos()
{
    if test -z "${1}" ; then show-fw-dos ; return 0 ; fi

    local dos=${1}

    case ${dos} in
	tcpflood|udpflood|webflood|rwebflood|piptcp|pipweb|piprweb|pipdns|pipocsp)
	    if test -z "${2}" ; then show-fw-dos-${dos} ; return 0 ; fi
	    ;;
	*)
	    return 249
	    ;;
    esac

    local act=${2}

    case ${act} in
	'set')
	    local limit=${3}
	    check-digit ${limit} || return 190

	    case ${dos} in
		tcpflood|udpflood|webflood|rwebflood)
		    test ${limit} -ge 1 -a ${limit} -le 10000 || return 250

		    local burst=${4}
		    if test -z "${burst}" ; then
			burst=${limit}
		    else
			check-digit ${burst} || return 190
		    fi

		    test ${burst} -ge 1 -a ${burst} -le 10000 || return 250
		    ;;
		piptcp|pipweb|piprweb|pipdns|pipocsp)
		    test ${limit} -ge 0 -a ${limit} -le 1000000000 || return 251
		    ;;
	    esac

	    case ${dos} in
		tcpflood)
		    if test "$(get-default-flood-limit ${dos})" == ${limit} -a "$(get-default-flood-burst ${dos})" == ${burst} ; then
			unset FW_DOS_TCP_FLOOD
		    else
			FW_DOS_TCP_FLOOD="${limit} ${burst}"
		    fi
		    ;;
		udpflood)
		    if test "$(get-default-flood-limit ${dos})" == ${limit} -a "$(get-default-flood-burst ${dos})" == ${burst} ; then
			unset FW_DOS_UDP_FLOOD
		    else
			FW_DOS_UDP_FLOOD="${limit} ${burst}"
		    fi
		    ;;
		webflood)
		    if test "$(get-default-flood-limit ${dos})" == ${limit} -a "$(get-default-flood-burst ${dos})" == ${burst} ; then
			unset FW_DOS_WEB_FLOOD
		    else
			FW_DOS_WEB_FLOOD="${limit} ${burst}"
		    fi
		    ;;
		rwebflood)
		    if test "$(get-default-flood-limit ${dos})" == ${limit} -a "$(get-default-flood-burst ${dos})" == ${burst} ; then
			unset FW_DOS_RWEB_FLOOD
		    else
			FW_DOS_RWEB_FLOOD="${limit} ${burst}"
		    fi
		    ;;
		piptcp)
		    if test "$(get-default-pip ${dos})" == ${limit} ; then
			unset FW_DOS_TCP_LIMIT
		    else
			FW_DOS_TCP_LIMIT=${limit}
		    fi
		    ;;
		pipweb)
		    if test "$(get-default-pip ${dos})" == ${limit} ; then
			unset FW_DOS_WEB_LIMIT
		    else
			FW_DOS_WEB_LIMIT=${limit}
		    fi
		    ;;
		piprweb)
		    if test "$(get-default-pip ${dos})" == ${limit} ; then
			unset FW_DOS_RWEB_LIMIT
		    else
			FW_DOS_RWEB_LIMIT=${limit}
		    fi
		    ;;
		pipdns)
		    if test "$(get-default-pip ${dos})" == ${limit} ; then
			unset FW_DOS_DNS_LIMIT
		    else
			FW_DOS_DNS_LIMIT=${limit}
		    fi
		    ;;
		pipocsp)
		    if test "$(get-default-pip ${dos})" == ${limit} ; then
			unset FW_DOS_OCSP_LIMIT
		    else
			FW_DOS_OCSP_LIMIT=${limit}
		    fi
		    ;;

		*)
		    return 255
		    ;;
	    esac
	    ;;

	default)
	    case ${dos} in
		tcpflood)
		    unset FW_DOS_TCP_FLOOD
		    ;;
		udpflood)
		    unset FW_DOS_UDP_FLOOD
		    ;;
		webflood)
		    unset FW_DOS_WEB_FLOOD
		    ;;
		rwebflood)
		    unset FW_DOS_RWEB_FLOOD
		    ;;
		piptcp)
		    unset FW_DOS_TCP_LIMIT
		    ;;
		pipweb)
		    unset FW_DOS_WEB_LIMIT
		    ;;
		piprweb)
		    unset FW_DOS_RWEB_LIMIT
		    ;;
		pipdns)
		    unset FW_DOS_DNS_LIMIT
		    ;;
		pipocsp)
		    unset FW_DOS_OCSP_LIMIT
		    ;;
		*)
		    return 255
		    ;;
	    esac
	    ;;
	*)
	    return 1
	    ;;
    esac

    SAVENV=1
}

run()
{
    contextual-command-is-allowed || return 207

    if test -z "${ARGS[1]}" ; then show-fw-rules ; return 0 ; fi
    if test "${ARGS[1]}" == dos ; then shift-args ; manage-fw-dos ${ALLARGS} ; return ${?} ; fi

    local rset=${ARGS[1]}
    
    if test -z "${ARGS[2]}" ; then show-fw-rules ${rset} ; return 0 ; fi

    case "${rset}" in
	external)
	    local rules=${FW_EXTERNAL_RULE_LIST}
	    ;;
	web)
	    local rules=${FW_WEB_RULE_LIST}
	    ;;
	rweb)
	    local rules=${FW_RWEB_RULE_LIST}
	    ;;
	antivirus)
	    local rules=${FW_AV_RULE_LIST}
	    ;;
	admin)
	    local rules=${FW_ADMIN_RULE_LIST}
	    ;;
	mon)
	    local rules=${FW_MON_RULE_LIST}
	    ;;
	file)
	    local rules=${FW_FILE_RULE_LIST}
	    ;;
	peer)
	    local rules=${FW_PEER_RULE_LIST}
	    ;;
	auxiliary)
	    local rules=${FW_AUXILIARY_RULE_LIST}
	    ;;
	vpnipsec)
	    local rules=${FW_VPN_IPSEC_RULE_LIST}
	    ;;
	*)
	    return 65
	    ;;
    esac
    
    local operation=${ARGS[2]} position_id position_nb position

    case "${operation}" in
	add|del|raz|on|off)
	    ;;
	*)
	    if test "${operation:0:7}" == "insert:" ; then
		position_id=${operation:7}
		operation=insert
		position=before
	    elif test "${operation:0:4}" == "add:" ; then
		position_id=${operation:4}
		operation=insert
		position=after
	    elif test "${operation:0:5}" == "move:" ; then
		if check-digit ${operation:5} ; then
		    position_nb=${operation:5}
		else
		    position_id=${operation:6}
		    case "${operation:5:1}" in
			+)
			    position=after
			    ;;
			-)
			    position=before
			    ;;
			*)
			    return 1
			    ;;
		    esac
		fi
		operation=move
	    else
		return 1
	    fi
	    check-id-length "${position_id}" || return 127
	    test -n "${position_nb}" || check-id "${position_id}" || return 35

	    ;;
    esac

    case "${operation}" in
	add|insert|del|move|on|off)
	    test -n "${ARGS[3]}" || return 1

	    local id=${ARGS[3]}
	    check-id-length "${id}" || return 127
	    check-id "${id}" || return 35

	    case ${operation} in
		move)
		    if test -n "${position_nb}" ; then
			rules=$(move-record-at-position-in-list 11 1 "${id}" "${rules}" ${position_nb})
		    else
			rules=$(move-record-in-list 11 1 "${id}" "${rules}" "${position_id}" ${position})
		    fi
		    test ${?} -eq 0 || return 152
		    ;;

		add|insert)
		    test -n "${ARGS[4]}" || return 1

		    local len=$(record11-length-list "${rules}")
		    test ${len} -lt ${MAX_FW_RULES_NB} || return 90

		    local action=${ARGS[4]}
		    check-rule-action ${action} || return 36
		    
		    local protocol=${ARGS[5]}
		    test -n "${protocol}" || protocol=any
		    check-fw-protocol ${protocol} || return 59

		    local src_ip=${ARGS[6]}
		    test -n "${src_ip}" || src_ip=any
		    test ${src_ip} != 0.0.0.0/0 || src_ip=any
		    check-rule-ip-address ${src_ip} || return ${?}

		    local src_dev=${rset}
		    local dst_dev=${ARGS[7]}
		    test -n "${dst_dev}" || dst_dev=any
		    if test ${dst_dev} != any ; then
			check-fw-dev-name ${dst_dev} || return 56
			test ${dst_dev} != ${src_dev} || return 56
		    fi

		    local dst_ip=${ARGS[8]}
		    test -n "${dst_ip}" || dst_ip=any
		    test ${dst_ip} != 0.0.0.0/0 || dst_ip=any
		    check-rule-ip-address ${dst_ip} || return ${?}

		    local dst_ports=${ARGS[9]}
		    test -n "${dst_ports}" || dst_ports=any
		    check-fw-port ${dst_ports} || return 60
		    check-fw-protocol-port ${protocol} ${dst_ports} || return 67

		    if test ${action} == allow ; then

			local src_nat_ip=${ARGS[10]}
			test -n "${src_nat_ip}" || src_nat_ip=nil

			if test ${src_nat_ip} != nil ; then
			    check-ip ${src_nat_ip} || return 149
			    ! check-fw-dynamic-ports-protocol ${protocol} || return 178
			fi

			local dst_nat_ip=${ARGS[11]}
			test -n "${dst_nat_ip}" || dst_nat_ip=nil
			test ${dst_nat_ip} == nil || check-ip ${dst_nat_ip} || return 150

			local dst_pat_port=${ARGS[12]}
			test -n "${dst_pat_port}" || dst_pat_port=nil
			check-fw-protocol-pat ${protocol} ${dst_pat_port} || return 67
			test ${dst_pat_port} == nil || check-port-nb ${dst_pat_port} || return 151
		    else
			src_nat_ip=nil
			dst_nat_ip=nil
			dst_pat_port=nil
		    fi

		    local rule="${id} on ${action} ${protocol} ${src_ip} ${dst_dev} ${dst_ip} ${dst_ports} ${src_nat_ip} ${dst_nat_ip} ${dst_pat_port}"
		    rules=$(insert-record-in-list 11 1 "${rule}" "${rules}" "${position_id}" ${position})
		    test ${?} -eq 0 -o ${operation} != insert || return 152
		    ;;

		del)
		    rules=$(remove-record-from-list 11 1 ${id} "${rules}")
		    test ${?} -eq 0 || return 152
		    ;;

		on|off)
		    shift-args
		    rules=$(manage-bulk-fw-states "${rules}")
		    local ret=${?}
		    test ${ret} -eq 0 || return ${ret}
		    ;;
		*)
		    return 255
		    ;;
	    esac
	    ;;
	raz)
	    unset rules
	    ;;
	*)
	    return 1
	    ;;
    esac

    case "${rset}" in
	external)
	    export FW_EXTERNAL_RULE_LIST=${rules}
	    ;;
	web)
	    export FW_WEB_RULE_LIST=${rules}
	    ;;
	rweb)
	    export FW_RWEB_RULE_LIST=${rules}
	    ;;
	antivirus)
	    export FW_AV_RULE_LIST=${rules}
	    ;;
	admin)
	    export FW_ADMIN_RULE_LIST=${rules}
	    ;;
	mon)
	    export FW_MON_RULE_LIST=${rules}
	    ;;
	file)
	    export FW_FILE_RULE_LIST=${rules}
	    ;;
	peer)
	    export FW_PEER_RULE_LIST=${rules}
	    ;;
	auxiliary)
	    export FW_AUXILIARY_RULE_LIST=${rules}
	    ;;
	vpnipsec)
	    export FW_VPN_IPSEC_RULE_LIST=${rules}
	    ;;
	*)
	    return 255
	    ;;
    esac

    SAVENV=1
}

main "${@}"
