    show-fw-rules1 cur web "${CURRENT_FW_WEB_RULE_LIST}"
    if test "${CURRENT_FW_WEB_RULE_LIST}" != "${FW_WEB_RULE_LIST}" ; then
	show-fw-rules1 new web "${FW_WEB_RULE_LIST}"
    fi
}

