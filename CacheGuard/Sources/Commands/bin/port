show-port-wadmin()
{
    echo-command-form "port wadmin"
    echo-mark-cur
    echo-value "${CURRENT_WADMIN_PORT}"
    if test "${CURRENT_WADMIN_PORT}" != "${WADMIN_PORT}" ; then
	echo-command-form "port wadmin"
	echo-mark-new
	echo-value "${WADMIN_PORT}"
    fi
}

show-port-waudit()
{
    echo-command-form "port waudit"
    echo-mark-cur
    echo-value "${CURRENT_WAUDIT_PORT}"
    if test "${CURRENT_WAUDIT_PORT}" != "${WAUDIT_PORT}" ; then
	echo-command-form "port waudit"
	echo-mark-new
	echo-value "${WAUDIT_PORT}"
    fi
}

show-port()
{
    echo-begin-show
    case "${1}" in
	proxy|thttp|thttps|ocsp|isakmp|natt|antivirus|httppeer|htcppeer|dhcp|wadmin|waudit)
	    show-port-${1}
	    ;;
	"")
	    show-port-wadmin

	    if contextual-command-is-allowed ; then
		show-port-proxy
		show-port-thttp
		show-port-thttps
		show-port-antivirus
		show-port-ocsp
		show-port-isakmp
		show-port-natt
		show-port-httppeer
		show-port-htcppeer
		show-port-dhcp
		show-port-waudit
	    fi
	    ;;
	
	*)
	    error 255
	    ;;
    esac
    echo-end-show
}

run()
{
    if test -z "${ARGS[1]}" ; then show-port ; return 0 ; fi

    local pt=${ARGS[1]}
    check-port-name ${pt} || return ${?}

    if test -z "${ARGS[2]}" ; then
	show-port ${pt}
	return 0
    fi

    local pr=${ARGS[2]}
    pr=$(remove-leading-zeros ${pr})

    case "${pt}" in
	proxy|thttp|thttps|antivirus|ocsp|natt|icppeer|httppeer|htcppeer|dhcp|wadmin|waudit)
	    check-high-port-nb ${pr} || return 20
	    check-snmp-tls-port-nb ${pr} || return 115
	    ;;
	isakmp)
	    check-snmp-tls-port-nb ${pr} || return 115
	    check-service-port-nb ${pr} || return 61
	    ;;
	*)
	    return 255
	    ;;
    esac
    
    case "${pt}" in
	proxy)
	    export PROXY_PORT=${pr}
	    ;;
	thttp)
	    export THTTP_PORT=${pr}
	    ;;
	thttps)
	    export THTTPS_PORT=${pr}
	    ;;
	antivirus)
	    export AV_PORT=${pr}
	    ;;
	ocsp)
	    export OCSP_PORT=${pr}
	    ;;
	isakmp)
	    export ISAKMP_PORT=${pr}
	    ;;
	natt)
	    export NATT_PORT=${pr}
	    ;;
	icppeer)
	    export PEER_ICP_PORT=${pr}
	    ;;
	httppeer)
	    export PEER_HTTP_PORT=${pr}
	    ;;
	htcppeer)
	    export PEER_HTCP_PORT=${pr}
	    ;;
	dhcp)
	    export DHCP_PEER_PORT=${pr}
	    ;;
	wadmin)
	    export WADMIN_PORT=${pr}
	    ;;
	waudit)
	    export WAUDIT_PORT=${pr}
	    ;;
	*)
	    error 255
	    ;;
    esac

    SAVENV=1
}

main "${@}"
