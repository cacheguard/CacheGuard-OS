source functions

check-port-name()
{
    test -n "${1}" || return 1
    
    case "${1}" in
	wadmin)
	    return 0
	    ;;
	proxy|thttp|thttps|antivirus|ocsp|isakmp|natt|icppeer|httppeer|htcppeer|dhcp|waudit)
	    contextual-command-is-allowed || return 207
	    return 0
	    ;;
	*)
	    return 84
	    ;;
    esac
}

show-port-proxy()
{
    echo-command-form "port proxy"
    echo-mark-cur
    echo-value "${CURRENT_PROXY_PORT}"
    if test "${CURRENT_PROXY_PORT}" != "${PROXY_PORT}" ; then
	echo-command-form "port proxy"
	echo-mark-new
	echo-value "${PROXY_PORT}"
    fi
}

show-port-thttp()
{
    echo-command-form "port thttp"
    echo-mark-cur
    echo-value "${CURRENT_THTTP_PORT}"
    if test "${CURRENT_THTTP_PORT}" != "${THTTP_PORT}" ; then
	echo-command-form "port thttp"
	echo-mark-new
	echo-value "${THTTP_PORT}"
    fi
}

show-port-thttps()
{
    echo-command-form "port thttps"
    echo-mark-cur
    echo-value "${CURRENT_THTTPS_PORT}"
    if test "${CURRENT_THTTPS_PORT}" != "${THTTPS_PORT}" ; then
	echo-command-form "port thttps"
	echo-mark-new
	echo-value "${THTTPS_PORT}"
    fi
}

show-port-antivirus()
{
    echo-command-form "port antivirus"
    echo-mark-cur
    echo-value "${CURRENT_AV_PORT}"
    if test "${CURRENT_AV_PORT}" != "${AV_PORT}" ; then
	echo-command-form "port antivirus"
	echo-mark-new
	echo-value "${AV_PORT}"
    fi
}

