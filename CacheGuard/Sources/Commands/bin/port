{
    echo-command-form "port dhcp"
    echo-mark-cur
    echo-value "${CURRENT_DHCP_PEER_PORT}"
    if test "${CURRENT_DHCP_PEER_PORT}" != "${DHCP_PEER_PORT}" ; then
