source functions

show-domainname() {
    echo-begin-show
    echo-command-form "domainname"
    echo-mark-cur
    echo-value "${CURRENT_DOMAIN_NAME}"
    if test "${DOMAIN_NAME}" != "${CURRENT_DOMAIN_NAME}" ; then
	echo-command-form "domainname"
	echo-mark-new
	echo-value "${DOMAIN_NAME}"
    fi
    echo-end-show
}

run()
{
    if test -z "${ARGS[1]}" ; then show-domainname ; return 0 ; fi

    local hn=${ARGS[1]}

    check-domainname ${hn} || return 16
    export DOMAIN_NAME="${hn,,}"
    
    SAVENV=1
}

main "${@}"
