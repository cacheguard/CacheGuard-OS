source functions

run()
{
    test -z "${TRANSACTION}" || return 106

    init-global-variables

    test -n "${1}" || return 1
    local hn=${1}
    local protocol=${2}
    test -n "${protocol}" || protocol=icmp

    case ${protocol} in
	udp)
	    local port=33434
	    local method="--type=${protocol} --port=${port}"
	    ;;
	icmp)
	    local method="--type=${protocol} --${protocol}"
	    ;;
	*)
	    return 1
	    ;;
    esac
	    
    check-domainname ${hn} || return 16
    PATH=/bin traceroute \
	--resolve-hostnames \
	--max-hop=96 \
	--tries=3 \
	--wait=3 \
	${method} \
	${hn}

    return 0
}

main __noenv "${@}"
