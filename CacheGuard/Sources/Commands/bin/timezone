source functions

show-timezone()
{
    echo-begin-show
    echo-command-form "timezone"
    echo-mark-cur
    echo-value "${CURRENT_TIMEZONE}"
    if test "${TIMEZONE}" != "${CURRENT_TIMEZONE}" ; then
	echo-command-form "timezone"
	echo-mark-new
	echo-value "${TIMEZONE}"
    fi
    echo-end-show
}

check-timezone-code()
{
    test -n "${1}" || return 1
    code=${1}

    load-timezones

    test ${code} -lt ${TIMEZONES_NB} || return 1

    local tz=${TIMEZONES[${code}]}
    test -n "${tz}" || return 1
    return 0
}

check-timezone()
{
    test -n "${1}" || return 1
    local tz=${1}

    test ${#tz} -le ${MAX_LEN} || return 3

    load-timezones

    local i

    for ((i=0 ; i<${TIMEZONES_NB} ; i++))
    do
	test ${TIMEZONES[${i}]} != ${tz} || return 0
    done

    return 5
}

run()
{
    if test -z "${ARGS[1]}" ; then show-timezone ; return 0 ; fi
    
    local tz=${ARGS[1]}
    
    check-integer ${tz}
    if test ${?} -eq 0 ; then
	check-timezone-code ${tz} || (echo ; return 23)
	export TIMEZONE=${TIMEZONES[${tz}]}
    else
	check-timezone ${tz} || return 52
	export TIMEZONE=${tz}
    fi
    
    SAVENV=1
}

main "${@}"
