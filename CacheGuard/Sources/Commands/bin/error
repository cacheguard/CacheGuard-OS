source functions

run()
{
    test -z "${TRANSACTION}" || return 106

    local code=${1}

    local description

    if test -n "${code}" ; then
	check-digit ${code} || return 1
	description=${Errors[${code}]}
	test -n "${description}" || return 255
	echo-begin-show
	echo Error ${code} - ${description}
	echo-end-show
	return 0
    fi

    local i n=${#Errors[@]}

    echo-begin-show

    for ((i=1 ; i<=n ; i++))
    do
	description=${Errors[${i}]}
	test -n "${description}" || continue
	echo Error ${i} - ${description}
	test ${i} == ${n} || echo
    done

    echo-end-show
}

main __noenv "${@}"
