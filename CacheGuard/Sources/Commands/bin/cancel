source functions

# Main()

clean-tmp-files()
{
    local pattern files file

    cd ${TMP_DIR}
    
    for pattern in ${TMP_CONF_FILES}
    do
	files=$(ls -1 ${pattern} 2> /dev/null)
	for file in ${files}
	do
	    test ! -f ${file}.tmp || continue
	    fuser --silent ${file} 2> /dev/null
	    test ${?} -ne 0 || continue

	    rm -f \
	       ${file} \
	       ${file}.${PROGRESS} \
	       ${file}.${SIGNATURE}
	done
    done

    cd ${HOME}
}

cancel-name-2resolve()
{
    rm -f ${TMP_DIR}/${NAME_2RESOLVE}
}

cancel-ipsec-psk()
{
    cp -f ${VPN_IPSEC_DIR}/${IPSEC_AUTHENTICATE_PSK_FILENAME}.current ${VPN_IPSEC_DIR}/${IPSEC_AUTHENTICATE_PSK_FILENAME}
}

cancel-ipsec-access-access()
{
    rm -f ${VPN_IPSEC_DIR}/whitelist.{raz,diff}
}

cancel-admin-2fa()
{
    local cur_2fa=$(get-admin-2fa ${ADMIN_NAME} cur)
    local new_2fa=$(get-admin-2fa ${ADMIN_NAME} new)

    test ${new_2fa} != ${cur_2fa} || return 0

    if test ${cur_2fa} == False ; then
	reset-admin-2fa ${ADMIN_NAME}
	rm -f /${TWO_FACTOR_GOOGLE_AUTHENTICATOR}
    else
	new_mfa_file=$(get-2fa-state-file ${ADMIN_NAME} new)
	cur_mfa_file=$(get-2fa-state-file ${ADMIN_NAME} cur)
	cp -f ${cur_mfa_file} ${new_mfa_file}
    fi
}

run()
{
    test -z "${TRANSACTION}" || return 106
    user-has-admin-rights || return 31

    set-first-startup-action
    clean-tmp-files
    clean-urllist-tmp-files
    db-waf-rule-reset
    urllist-auto-reset-new
    cancel-tls-client
    cancel-name-2resolve
    cancel-ipsec-psk
    cancel-ipsec-access-access

    NEWENV=1

    cancel-env || return 104
    cancel-configuration-db || return 104
    cancel-admin-2fa || return 104
}

main "${@}"
