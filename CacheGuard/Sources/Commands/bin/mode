show-mode()
{
    echo-begin-show
    case "${1}" in
	dhcp|dns|ha|ftppassive|qos|router|snat|transparent|tweb|tnat|vlan)
	    show-mode-${1}
	    ;;
	anonymous|antivirus|authenticate|firewall|forward|web|compress|ocsp|rweb|reverse|sslmediate|log|guard|vpnipsec|waf|cache)
	    show-mode-${1}
	    ;;
	"")
	    local role=$(get-contextual-role)

	    case ${role} in
		gateway)
		    show-mode-dhcp
		    show-mode-dns
		    show-mode-ha
		    show-mode-ftppassive
		    show-mode-qos
		    show-mode-router
		    show-mode-snat
		    show-mode-tnat
		    show-mode-tweb
		    show-mode-vlan

		    show-mode-anonymous
		    show-mode-antivirus
		    show-mode-authenticate
		    show-mode-firewall
		    show-mode-web
		    show-mode-compress
		    show-mode-ocsp
		    show-mode-rweb
		    show-mode-sslmediate
		    show-mode-log
		    show-mode-guard
		    show-mode-vpnipsec
		    show-mode-waf
		    show-mode-cache
		    ;;
		manager)
		    show-mode-ftppassive
		    ;;
		*)
		    return 255
		    ;;
	    esac
	    ;;
	*)
	    return 255
	    ;;
    esac
    echo-end-show
}

run()
{
    if test -z "${ARGS[1]}" ; then show-mode ; return 0 ; fi

    if test -z "${ARGS[2]}" ; then
	case ${ARGS[1]} in
	    ftppassive)
		show-mode ${ARGS[1]}
		return 0
		;;
	    router|snat|tweb|transparent|tnat|dns|dhcp|firewall|vlan|qos|ha)
		contextual-command-is-allowed || return 207
		show-mode ${ARGS[1]}
		return 0
		;;
	    web|rweb|forward|reverse|sslmediate|anonymous|guard|antivirus|ocsp|vpnipsec|waf|cache|compress|log|authenticate)
		contextual-command-is-allowed || return 207
		show-mode ${ARGS[1]}
		return 0
		;;
	    *)
		return 1
		;;
	esac
    fi

    local mod=${ARGS[1]}
    local val=${ARGS[2]}

    check-mode-mode ${mod} || return 1

    case "${mod}" in
	ftppassive)
	    ;;
	*)
	    contextual-command-is-allowed || return 207
	    ;;
    esac

    check-boolean ${val} || return 18

    local bool=$(internal-form ${val})

    case "${mod}" in
	web|forward)
	    export WEB_MODE=${bool}
	    ;;
	rweb|reverse)
	    export RWEB_MODE=${bool}
	    ;;
	transparent|tweb)
	    export TRANSPARENT_MODE=${bool}
	    ;;
	sslmediate)
	    export SSLMEDIATE_MODE=${bool}
	    ;;
	router)
	    export ROUTER_MODE=${bool}
	    ;;
	snat)
	    export SNAT_MODE=${bool}
	    ;;
	tnat)
	    export TNAT_MODE=${bool}
	    ;;
	firewall)
	    export FIREWALL_MODE=${bool}
	    ;;
	guard)
	    export GUARD_MODE=${bool}
	    ;;
	compress)
	    export COMPRESS_MODE=${bool}
	    ;;
	waf)
	    export WAF_MODE=${bool}
	    ;;
	dhcp)
	    export DHCP_MODE=${bool}
	    ;;
	dns)
	    export DNS_MODE=${bool}
	    ;;
	cache)
	    cli-is-in-template-context || test ${bool} == False -o ${PERSISTENT_CACHE} == True || return 167
	    export CACHE_MODE=${bool}
	    ;;
	ftppassive)
	    export FTP_PASSIVE_MODE=${bool}
	    ;;
	log)
	    export LOG_MODE=${bool}
	    ;;
	vlan)
	    export VLAN_MODE=${bool}
	    ;;
	ha)
	    export HA_MODE=${bool}
	    ;;
	qos)
	    export QOS_MODE=${bool}
	    ;;
	anonymous)
	    export ANONYMOUS_MODE=${bool}
	    ;;
	authenticate)
	    export AUTHENTICATE_MODE=${bool}
	    ;;
	antivirus)
	    export AV_MODE=${bool}
	    ;;
	ocsp)
	    export OCSP_MODE=${bool}
	    ;;
	vpnipsec)
	    export VPN_IPSEC_MODE=${bool}
	    ;;
	*)
	    error 255
	    ;;
    esac
    SAVENV=1
}

main "${@}"
