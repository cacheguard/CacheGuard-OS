source functions

check-mode-mode()
{
    test -n "${1}" || return 1
    
    case ${1} in
	dhcp|dns|ha|ftppassive|qos|router|snat|transparent|tweb|tnat|vlan)
	    return 0
	    ;;
	anonymous|antivirus|authenticate|firewall|forward|web|compress|ocsp|rweb|reverse|sslmediate|log|guard|vpnipsec|waf|cache)
	    return 0
	    ;;
	*)
	    return 1
	    ;;
    esac
}

show-mode-cache()
{
    echo-command-form "mode cache"
    local val=$(external-form ${CURRENT_CACHE_MODE})
    echo-mark-cur
    echo-value "${val}"

    if test "${CURRENT_CACHE_MODE}" != "${CACHE_MODE}" ; then
	echo-command-form "mode cache"
	val=$(external-form ${CACHE_MODE})
	echo-mark-new
	echo-value "${val}"
    fi
}

