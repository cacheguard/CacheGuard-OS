source functions

check-guard-filter()
{
    case "${1}" in
	ip|'time'|ldap)
	    return 0
	    ;;
	*)
	    return 1
	    ;;
    esac
}

check-time-slot()
{
    # w-hh:mm-hh:mm

    test -n "${1}" || return 1
    [[ "${1}" =~ ^([0-6]-)?([0-1][0-9]|[2][0-3]):[0-5][0-9]-([0-1][0-9]|[2][0-3]):[0-5][0-9]$ ]] || return 2

    return 0

}

check-time-date()
{
    # yyyy/mm/dd[-hh:mm-hh:mm]

    test -n "${1}" || return 1

    [[ "${1}" =~ ^([2][0-9]{3})?/([0][0-9]|[1][0-2])?/([0-2][0-9]|[3][0-1])?(-([0-1][0-9]|[2][0-3]):[0-5][0-9]-([0-1][0-9]|[2][0-3]):[0-5][0-9])?$ ]] || return 2

    local date=${1/-*}
    local year month day

    year=${date/\/*}
    if test -n "${year}" ; then
	date=${date:5}
    else
	date=${date:1}
    fi

    month=${date/\/*}
    if test -n "${month}" ; then
	day=${date:3}
    else
	day=${date:1}
    fi

    if test -n "${year}" -a -n "${month}" -a -n "${day}" ; then
	date --date=${month}/${day}/${year} > /dev/null 2>&1
    else
	return 0
    fi
}

check-time-frame()
{
    # yyyy/mm/dd-yyyy/mm/dd]

    test -n "${1}" || return 1

    [[ "${1}" =~ ^[2][0-9]{3}/([0][0-9]|[1][0-2])/([0-2][0-9]|[3][0-1])-[2][0-9]{3}/([0][0-9]|[1][0-2])/([0-2][0-9]|[3][0-1])$ ]] || return 2

    local date1 year1 month1 day1
    local date2 year2 month2 day2

    date1=${1/-*}
    date2=${1/*-}

    year1=${date1:0:4}
    month1=${date1:5:2}
    day1=${date1:8:2}
    date --date=${month1}/${day1}/${year1} > /dev/null 2>&1 || return 3

    year2=${date2:0:4}
    month2=${date2:5:2}
    day2=${date2:8:2}
    date --date=${month2}/${day2}/${year2} > /dev/null 2>&1 || return 4

    if test ${year1} -lt ${year2} ; then
	return 0
    elif test ${year1} -eq ${year2} ; then
	test ${month1}${day1} -le ${month2}${day2} || return 5
    else
	return 6
    fi
}

remove-policies-from-rules()
{
    local i=0 elt range
    local name action urllists
    local rules_out

    for elt in ${GUARD_RULE_LIST}
    do
      range=$[${i} % 3]
      case ${range} in
	  0)
	      name=${elt}
	      ;;
	  1)
	      action=${elt}
	      ;;
	  2)
	      urllists=${elt}
	      test ${name} != "default" || rules_out="${name} ${action} ${urllists}"
	      ;;
	  *)
	      return 1
	      ;;
      esac
      ((i++))
    done
    GUARD_RULE_LIST=${rules_out}
}

show-guard-ip()
{
    echo-begin-show
    echo-command-form "guard ip"
    local val=$(external-form ${CURRENT_GUARD_IP})
    echo-mark-cur
    echo-value "${val}"

    if test "${CURRENT_GUARD_IP}" != "${GUARD_IP}" ; then
	echo-command-form "guard ip"
	echo-mark-new
	val=$(external-form ${GUARD_IP})
	echo-value "${val}"
    fi
    echo-end-show
}

manage-ip()
{
    if test -z "${1}" ; then show-guard-ip ; return 0 ; fi

    local val=${ARGS[1]}
    check-boolean ${val}	|| return 18

    local bool=$(internal-form ${val})
    export GUARD_IP=${bool}
    SAVENV=1
}

show-guard-filters-ip1()
{
    local filters=${2}

    echo-command-form "guard filter ip"
    if test "${1}" == "new" ; then
	echo-mark-new
    else
	echo-mark-cur
    fi


    if test -z "${filters}" ; then
	echo-value-null
	return 0
    fi

    local name ip_key ip1 ip2
    local i=0 n=0 elt range

    for elt in ${filters}
    do
	range=$[${i} % 4]
	case ${range} in
	    0)
		name=${elt}
		;;
	    1)
		ip_key=${elt}
		;;
	    2)
		ip1=${elt}
		;;
	    3)
		ip2=${elt}
		test ${n} -eq 0 || echo-blank-command
		case ${ip_key} in
		    range)
			if test ${ip1} == ${ip2} ; then
			    echo-value "${name} ${ip_key} ${ip1}"
			else
			    echo-value "${name} ${ip_key} ${ip1}-${ip2}"
			fi
			;;
		    network)
			echo-value "${name} ${ip_key} ${ip1} ${ip2}"
			;;
		    *)
			;;
		esac
		((n++))
		;;
	    *)
		return 255
		;;
	esac
	((i++))
    done
}

show-guard-filters-ip()
{
    show-guard-filters-ip1 'current' "${CURRENT_GUARD_FILTER_IP_LIST}"
    test "${CURRENT_GUARD_FILTER_IP_LIST}" == "${GUARD_FILTER_IP_LIST}" || \
	show-guard-filters-ip1 'new' "${GUARD_FILTER_IP_LIST}"
}

insert-guard-filter-ip()
{
    export GUARD_FILTER_IP_LIST=$(insert-record-in-slist 4 1 "${1}" "${GUARD_FILTER_IP_LIST}")
}

remove-guard-filter-ip()
{
    export GUARD_FILTER_IP_LIST=$(remove-record-from-list 4 1 "${1}" "${GUARD_FILTER_IP_LIST}")
}

is-member-of-guard-filter-ip()
{
    local record ; record=$(get-record-in-list 4 1 "${1}" "${GUARD_FILTER_IP_LIST}")
}

show-guard-filters-time1()
{
    local filters=${2}

    echo-command-form "guard filter time"
    if test "${1}" == "new" ; then
	echo-mark-new
    else
	echo-mark-cur
    fi


    if test -z "${filters}" ; then
	echo-value-null
    else
	local name type time
	local i=0 n=0 elt range

	for elt in ${filters}
	do
	    range=$[${i} % 3]
	    case ${range} in
		0)
		    name=${elt}
		    ;;
		1)
		    type=${elt}
		    ;;
		2)
		    time=${elt}
		    test ${n} -eq 0 || echo-blank-command
		    echo-value "${name} ${type} ${time}"
		    ((n++))
		    ;;
		*)
		    return 255
		    ;;
	    esac
	    ((i++))
	done
    fi
}

