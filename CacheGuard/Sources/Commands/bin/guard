{
    local record ; record=$(get-record-in-list 3 1 "${1}" "${GUARD_FILTER_TIME_LIST}")
}

show-guard-filters-ldap1()
{
    local filters=${2}

    echo-command-form "guard filter ldap"
    if test "${1}" == "new" ; then
	echo-mark-new
    else
	echo-mark-cur
    fi


    if test -z "${filters}" ; then
	echo-value-null
	return 0
    fi

    local name group login filter
    local i=0 n=0 elt range

    for elt in ${filters}
    do
	range=$[${i} % 4]
	case ${range} in
	    0)
		name=${elt}
		;;
	    1)
		group=${elt}
		;;
	    2)
		login=${elt}
		;;
	    3)
		filter=${elt}
		test ${n} -eq 0 || echo-blank-command
		echo-value "${name}:"

		echo-blank-command
		echo-value "groupDN: ${group}"

		echo-blank-command
		echo-value "loginAttribute: ${login}"

		echo-blank-command
		echo-value "ldapFilter: ${filter}"
		((n++))
		;;
	    *)
		return 255
		;;
	esac
	((i++))
    done
}

