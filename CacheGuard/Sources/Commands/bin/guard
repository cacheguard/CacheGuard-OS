{
    export GUARD_FILTER_LDAP_LIST=$(remove-record-from-list 4 1 "${1}" "${GUARD_FILTER_LDAP_LIST}")
}

is-member-of-guard-filter-ldap()
{
    local record ; record=$(get-record-in-list 4 1 "${1}" "${GUARD_FILTER_LDAP_LIST}")
}

show-guard-filters()
{
    echo-begin-show
    case "${1}" in
	ip|'time'|ldap)
	    show-guard-filters-${1}
	    ;;
	"")
	    show-guard-filters-ip
	    show-guard-filters-time
	    show-guard-filters-ldap
	    ;;
	*)
	    ;;
    esac

    echo-end-show
}

remove-filter-from-policies()
{
    test -n "${1}" || return 1
    local in_filter_type=${1}
    local in_filter_name=${2}

    test -n "${GUARD_POLICY_LIST}" || return 0

    local name filters_col
    local elt range i=0

    local filters_lst filter filter_type filter_name
    local filters_out policies_out
    
    for elt in ${GUARD_POLICY_LIST}
    do
	range=$[${i} % 2]
	case ${range} in
	    0)
		name=${elt}
		;;
	    1)
		filters_col=${elt}

		if test "${filters_col}" == 'self_self' ; then
		    policies_out="${policies_out} ${name} self_self"
		    ((i++))
		    continue
		fi

		unset filters_out
		filters_lst=$(colon2space ${filters_col})

		for filter in ${filters_lst}
		do

		    test ${filter} != 'self_self' || continue

		    filter_type=${filter/_*}
		    filter_name=${filter#*_}

		    if test -z "${in_filter_name}" ; then
			test ${filter_type} == ${in_filter_type} || filters_out="${filters_out}:${filter}"
		    else
			if test \
			    "${filter_name}" != "${in_filter_name}" -o \
			    "${filter_type}" != "${in_filter_type}" ; then

			    filters_out="${filters_out}:${filter}"
			fi
		    fi
		done

		filters_out=self_self${filters_out}
		policies_out="${policies_out} ${name} ${filters_out}"
		;;
	    *)
		return 255
		;;
	esac
	((i++))
    done

    policies_out=${policies_out:1}
    export GUARD_POLICY_LIST=${policies_out}
}

manage-filter()
{
    local filter_type=${ARGS[1]}
    if test -z "${filter_type}" ; then show-guard-filters ; return 0 ; fi

    check-guard-filter ${filter_type} || return 58
    if test -z "${ARGS[2]}" ; then show-guard-filters ${filter_type} ; return 0 ; fi

    local act=${ARGS[2]}

    case ${act} in
	
	add|del)
	    local filter_name=${ARGS[3]}
	    check-id-length "${filter_name}" || return 127
	    check-id "${filter_name}" || return 35
	    case ${act} in
		add)
		    case ${filter_type} in
			ip)
			    local len=$(record3-length-list "${GUARD_FILTER_IP_LIST}")
			    ;;
			'time')
			    local len=$(record3-length-list "${GUARD_FILTER_TIME_LIST}")
			    ;;
			ldap)
			    local len=$(record4-length-list "${GUARD_FILTER_LDAP_LIST}")
			    ;;
			*)
			    return 255
			    ;;
		    esac
		    test ${len} -lt ${MAX_GUARD_FILTERS_NB} || return 90
		    case ${filter_type} in
			ip)
			    test -n "${ARGS[4]}" || return 1
			    local ip_key=${ARGS[4]}
			    local ip1 ip2
			    case ${ip_key} in
				range)
				    test -n "${ARGS[5]}" || return 1
				    ip1=${ARGS[5]}
				    check-ip ${ip1} || return 12
				    if test -z "${ARGS[6]}" ; then
					ip2=${ip1}
				    else
					ip2=${ARGS[6]}
					check-ip ${ip2} || return 12
					test ${ip1} == ${ip2} || ip-lt ${ip1} ${ip2} || return 68
				    fi
				    ;;
				network)
				    test -n "${ARGS[5]}" || return 1
				    ip1=${ARGS[5]}

				    local px=${ip1/*\/}

				    if test ${ip1} != ${px} ; then
					check-prefix ${px} || return 158
					ip1=${ip1/\/*}
				    else
					unset px
				    fi

				    check-ip ${ip1} || return 12

				    if test -z "${px}" ; then
					if test -z "${ARGS[6]}" ; then
					    ip2=255.255.255.0
					else
					    ip2=${ARGS[6]}
					    check-mask ${ip2} || return 13
					fi
				    else
					if test ${px} == 32 ; then
					    ip2='255.255.255.255'
					elif test ${px} == 0 ; then
					    ip2='0.0.0.0'
					else
					    ip2=$(ipcalc -s ${ip1}/${px} -m)
					    ip2=${ip2/NETMASK=/}
					fi
				    fi

				    check-net-ip-address ${ip1} ${ip2} || return 70
				    ;;
				*)
				    return 1
				    ;;
			    esac

			    insert-guard-filter-ip "${filter_name} ${ip_key} ${ip1} ${ip2}"
			    ;;
			network)
			    ;;
			'time')
			    test -n "${ARGS[4]}" || return 1
			    time_type=${ARGS[4]}

			    case ${time_type} in
				slot)
				    test -n "${ARGS[5]}" || return 1
				    local time_value=${ARGS[5]}
				    check-time-slot ${time_value} || return 128
				    ;;
				date)
				    test -n "${ARGS[5]}" || return 1
				    local time_value=${ARGS[5]}
				    check-time-date ${time_value} || return 98
				    ;;
				frame)
				    test -n "${ARGS[5]}" || return 1
				    local time_value=${ARGS[5]}
				    check-time-frame ${time_value} || return 49
				    ;;
				*)
				    return 1
				    ;;
			    esac
			    insert-guard-filter-time "${filter_name} ${time_type} ${time_value}"
			    ;;
			ldap)
			    test -n "${ARGS[4]}" || return 1
			    test -n "${ARGS[5]}" || return 1
			    test -n "${ARGS[6]}" || return 1

			    local ldap_group=${ARGS[4]}
			    local ldap_login=${ARGS[5]}
			    local ldap_filter=${ARGS[6]}

			    ldap_group=$(remove-quotes "${ldap_group}")
			    ldap_login=$(remove-quotes "${ldap_login}")
			    ldap_filter=$(remove-quotes "${ldap_filter}")

			    check-ldap-dn-no-space "${ldap_group}" || return 7
			    check-ldap-attr "${ldap_login}" || return 3
			    check-ldap-filter-no-space "${ldap_filter}" || return 5

			    insert-guard-filter-ldap "${filter_name} ${ldap_group} ${ldap_login} ${ldap_filter}"
			    ;;
			*)
			    return 255
			    ;;
		    esac
		    ;;
		del)
		    case ${filter_type} in
			ip)
			    remove-guard-filter-ip ${filter_name}
			    ;;
			'time')
			    remove-guard-filter-time ${filter_name}
			    ;;
			ldap)
			    remove-guard-filter-ldap ${filter_name}
			    ;;
			*)
			    return 255
			    ;;
		    esac

		    remove-filter-from-policies ${filter_type} ${filter_name}
		    ;;
		*)
		    return 255
		    ;;
	    esac
	    SAVENV=1
	    ;;
	raz)
	    case ${filter_type} in
		ip)
		    export GUARD_FILTER_IP_LIST=""
		    ;;
		'time')
		    export GUARD_FILTER_TIME_LIST=""
		    ;;
		ldap)
		    export GUARD_FILTER_LDAP_LIST=""
		    ;;
		*)
		    return 255
		    ;;
	    esac

	    remove-filter-from-policies ${filter_type}
	    SAVENV=1
	    ;;
	*)
	    return 1
	    ;;
    esac
}

show-guard-policies1()
{
    local policies=${2}

    echo-command-form "guard policy"
    if test "${1}" == "new" ; then
	echo-mark-new
    else
	echo-mark-cur
    fi


    if test -z "${policies}" ; then
	echo-value-null
	return 0
    fi

    local i=0 n=0 elt range
    local name filters_col
    local filters_lst filter filter_type filter_name
    
    for elt in ${policies}
    do
	range=$[${i} % 2]
	case ${range} in
	    0)
		name=${elt}
		;;
	    1)
		filters_col=${elt}
		test ${n} -eq 0 || echo-blank-command
		echo-highlighted-value "${name}"

		if test "${filters_col}" == 'self_self' ; then
		    echo-blank-command
		    echo-value-null
		else
		    filters_lst=$(colon2space ${filters_col})
		    for filter in ${filters_lst}
		    do
			test ${filter} != 'self_self' || continue
			filter_type=${filter/_*}
			filter_name=${filter#*_}
			echo-blank-command
			echo-value "${filter_type} ${filter_name}"
		    done
		fi
		((n++))
		;;
	    *)
		return 255
		;;
	esac
	((i++))
    done
}

show-guard-policies()
{
    echo-begin-show

    show-guard-policies1 'current' "${CURRENT_GUARD_POLICY_LIST}"
    test "${CURRENT_GUARD_POLICY_LIST}" == "${GUARD_POLICY_LIST}" || \
	show-guard-policies1 'new' "${GUARD_POLICY_LIST}"

    echo-end-show
}

guard-policy-exist()
{
    test -n "${1}" || return 0
    local in_policy_name=${1}

    test ${in_policy_name} != "default" || return 0

    local name
    local i=0 elt range

    for elt in ${GUARD_POLICY_LIST}
    do
	range=$[${i} % 2]
	case ${range} in
	    0)
		name=${elt}
		test ${name} != ${in_policy_name} || return 0
		;;
	    1)
		;;
	    *)
		return 255
		;;
	esac
	((i++))
    done

    return 1
}

add-guard-policy()
{
    export GUARD_POLICY_LIST=$(insert-record-in-slist 2 1 "${1}" "${GUARD_POLICY_LIST}")
}

remove-guard-policy()
{
    export GUARD_POLICY_LIST
    GUARD_POLICY_LIST=$(remove-record-from-list 2 1 "${1}" "${GUARD_POLICY_LIST}")
    return ${?}
}

manage-policy()
{
    local act=${1}
    if test -z "${act}" ; then show-guard-policies ; return 0 ; fi
    
    case ${act} in
	
	add|del)
	    local policy_name=${2}
	    check-id-length "${policy_name}" || return 127
	    check-id "${policy_name}" || return 35
	    test "${policy_name}" != "default" || return 32

	    case ${act} in
		add)
		    local len=$(record2-length-list "${GUARD_POLICY_LIST}")
		    test ${len} -lt ${MAX_GUARD_POLICIES_NB} || return 90
		    shift 2
		    local in_filters=${*} filters_out='self_self' filters_col
		    local filter_type filter_name
		    local i=0 elt range

		    for elt in ${in_filters}
		    do
			range=$[${i} % 2]
			case ${range} in
			    0)
				filter_type=${elt}
				;;
			    1)
				filter_name=${elt}
				check-id-length "${filter_name}" || return 127
				check-id "${filter_name}" || return 35

				case ${filter_type} in
				    ip)
					is-member-of-guard-filter-ip "${filter_name}" || return 129
					;;
				    'time')
					is-member-of-guard-filter-time "${filter_name}" || return 129
					;;
				    ldap)
					is-member-of-guard-filter-ldap "${filter_name}" || return 129
					;;
				    *)
					return 58
					;;
				esac
				member "${filters_out}" "${filter_type}_${filter_name}" || filters_out="${filters_out} ${filter_type}_${filter_name}"
				;;
			    *)
				return 255
				;;
			esac
			((i++))
		    done
		    filters_col=$(space2colon "${filters_out}")
		    add-guard-policy "${policy_name} ${filters_col}"
		    ;;
		del)
		    remove-guard-policy "${policy_name}" || return 131
		    remove-policy-from-rules "${policy_name}"
		    ;;
		*)
		    return 255
		    ;;
	    esac
	    SAVENV=1
	    ;;
	raz)
	    remove-policies-from-rules
	    GUARD_POLICY_LIST=""
	    SAVENV=1
	    ;;
	*)
	    return 1
	    ;;
    esac
}

show-guard-rules1()
{
    local rules=${2}

    echo-command-form "guard rule"
    if test "${1}" == "new" ; then
	echo-mark-new
    else
	echo-mark-cur
    fi

    if test -z "${rules}" ; then
	echo-value-null
	return 0
    fi
    
    local elt range i=0
    local name action urllists_col
    local urllists_lst urllist
    local n1=0 n2=0
    local null=$(get-null-value)
    
    for elt in ${rules}
    do
	range=$[${i} % 3]
	case ${range} in
	    0)
		name=${elt}
		;;
	    1)
		action=${elt}
		;;
	    2)
		urllists_col=${elt}
		urllists_lst=$(colon2space ${urllists_col})

		test ${n1} -eq 0 || echo-blank-command
		echo-highlighted-value "${name} ${action}"

		if test "${urllists_lst}" == self ; then
		    echo-blank-command
		    echo-value-null
		else
		    n2=0
		    for urllist in ${urllists_lst}
		    do
			test ${urllist} != self || continue
			echo-blank-command
			echo-value ${urllist}
			((n2++))
		    done
		fi
		((n1++))
		;;
	    *)
		return 255
		;;
	esac
	((i++))
    done
}

show-guard-rules()
{
    echo-begin-show

    show-guard-rules1 'current' "${CURRENT_GUARD_RULE_LIST}"
    test "${CURRENT_GUARD_RULE_LIST}" == "${GUARD_RULE_LIST}" || \
	show-guard-rules1 'new' "${GUARD_RULE_LIST}"

    echo-end-show
}

insert-guard-rule()
{
    export GUARD_RULE_LIST
    GUARD_RULE_LIST=$(insert-record-in-list 3 1 "${1}" "${GUARD_RULE_LIST}" "${2}" ${3})
}

remove-guard-rule()
{
    export GUARD_RULE_LIST=$(remove-record-from-list 3 1 "${1}" "${GUARD_RULE_LIST}")
}

remove-policy-from-rules()
{
    test -n "${1}" || return 0
    local in_name=${1}

    test -n "${GUARD_RULE_LIST}" || return 0

    local name action urllists
    local i=0 elt range
    local rules_out
    
    for elt in ${GUARD_RULE_LIST}
    do
	range=$[${i} % 3]
	case ${range} in
	    0)
		name=${elt}
		;;
	    1)
		action=${elt}
		;;
	    2)
		urllists=${elt}
		test ${name} == ${in_name} || rules_out="${rules_out} ${name} ${action} ${urllists}"
		;;
	    *)
		return 255
		;;
	esac
	((i++))
    done

    rules_out=${rules_out:1}
    export GUARD_RULE_LIST=${rules_out}
}

manage-rule()
{
    local operation=${1}
    if test -z "${operation}" ; then show-guard-rules ; return 0 ; fi

    local position_id position_nb position

    case "${operation}" in
	add|update|del|raz)
	    ;;
	*)
	    
	    if test "${operation:0:7}" == "insert:" ; then
		position_id=${operation:7}
		operation=insert
		position=before
	    elif test "${operation:0:4}" == "add:" ; then
		position_id=${operation:4}
		operation=insert
		position=after
	    elif test "${operation:0:5}" == "move:" ; then
		if check-digit ${operation:5} ; then
		    position_nb=${operation:5}
		else
		    position_id=${operation:6}
		    case "${operation:5:1}" in
			+)
			    position=after
			    ;;
			-)
			    position=before
			    ;;
			*)
			    return 1
			    ;;
		    esac
		fi
		operation=move
	    else
		return 1
	    fi

	    check-id-length "${position_id}" || return 127
	    test -n "${position_nb}" || check-id "${position_id}" || return 35
	    ;;
    esac

    case ${operation} in
	add|insert|move|update|del)
	    test -n "${2}" || return 1
	    local rule_name=${2}
	    check-id-length "${rule_name}" || return 127
	    check-id "${rule_name}" || return 35
	    guard-policy-exist ${rule_name} || return 131

	    case ${operation} in
		add|insert)
		    local len=$(record3-length-list "${GUARD_RULE_LIST}")
		    test ${len} -lt ${MAX_GUARD_RULES_NB} || return 90
		    ;;
		*)
		    ;;
	    esac

	    case ${operation} in
		move)
		    export GUARD_RULE_LIST
		    if test -n "${position_nb}" ; then
			GUARD_RULE_LIST=$(move-record-at-position-in-list 3 1 "${rule_name}" "${GUARD_RULE_LIST}" ${position_nb})
		    else
			GUARD_RULE_LIST=$(move-record-in-list 3 1 "${rule_name}" "${GUARD_RULE_LIST}" "${position_id}" ${position})
		    fi
		    test ${?} -eq 0 || return 152
		    ;;

		add|update|insert)
		    local action=${3}
		    check-rule-action ${action} || return 36
	    
		    shift 3
	    
		    local urllists="${@}"
		    test -n "${urllists}" || urllists=self
		    
		    urllists=$(uniq-elt ${urllists})
		    local urllists_col=$(space2colon "${urllists}")

		    case ${operation} in
			add|insert)
			    insert-guard-rule "${rule_name} ${action} ${urllists_col}" "${position_id}" ${position}
			    test ${?} -eq 0 -o ${operation} != insert || return 152
			    ;;
			update)
			    insert-guard-rule "${rule_name} ${action} ${urllists_col}" "${rule_name}" after
			    test ${?} -eq 0 || return 152
			    ;;
			*)
			    return 255
			    ;;
		    esac
		    ;;
		del)
		    remove-guard-rule "${rule_name}"
		    ;;
		*)
		    return 255
		    ;;
	    esac
	    ;;
	raz)
	    export GUARD_RULE_LIST=""
	    ;;
	*)
	    return 1
	    ;;
    esac
    SAVENV=1
}

run()
{
    contextual-command-is-allowed || return 207

    local op   

    if test -n "${ARGS[1]}" ; then
	op=${ARGS[1]}
	shift-args
    fi

    case "${op}" in
	filter)
	    manage-filter
	    ;;
	policy)
	    manage-policy ${ALLARGS}
	    ;;
	rule)
	    manage-rule ${ALLARGS}
	    ;;
	ip)
	    manage-ip ${ALLARGS}
	    ;;
	'')
	    manage-filter
	    manage-policy
	    manage-rule
	    manage-ip
	    ;;
	*)
	    return 1
	    ;;
    esac
}

main "${@}"
