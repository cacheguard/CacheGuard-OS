    show-guard-filters-ldap1 'current' "${CURRENT_GUARD_FILTER_LDAP_LIST}"
    test "${CURRENT_GUARD_FILTER_LDAP_LIST}" == "${GUARD_FILTER_LDAP_LIST}" || \
	show-guard-filters-ldap1 'new' "${GUARD_FILTER_LDAP_LIST}"
}

