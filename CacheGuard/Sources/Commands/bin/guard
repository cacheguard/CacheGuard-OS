    show-guard-filters-time1 'current' "${CURRENT_GUARD_FILTER_TIME_LIST}"
    test "${CURRENT_GUARD_FILTER_TIME_LIST}" == "${GUARD_FILTER_TIME_LIST}" || \
	show-guard-filters-time1 'new' "${GUARD_FILTER_TIME_LIST}"
