source functions

print-countries()
{
    local code name

    while read code name
    do
	test -n "${code}" || continue
	echo-value "[${code}] ${name}"
    done < ${APPLIANCE_DIR}/etc/countries
}

run()
{
    test -z "${TRANSACTION}" || return 106
    print-countries
}

main __noenv "${@}"
