source functions

display-antivirus-log()
{
    local status date_update
    local date_s=$(date +"%s")
    local date_h=$(get-date-from-epoch-seconds ${date_s})

    echo-begin-show

    case ${APL_ROLE} in
	gateway)
	    update-report health-av || return 104
	    if test -s ${AV_AUTO_UPDATE_FILE} ; then
		status=OK
		date_update=$(cat ${AV_AUTO_UPDATE_FILE} 2> /dev/null)
		date_update=$(get-date-from-epoch-seconds ${date_update})
		display-log-line 0 ${date_h} Antivirus updated at ${date_update}[${status}]
	    else
		status=KO
		display-log-line 0 ${date_h} Antivirus updating[${status}]
	    fi
	    ;;
	manager)
	    ;;
	*)
	    ;;
    esac

    if is-av-extended-enabled cur ; then
	if test -s ${AV_VAR_DIR}/${AV_EXTENDED_LAST_UPDATE_FILENAME} ; then

	    date_update=$(cat ${AV_VAR_DIR}/${AV_EXTENDED_LAST_UPDATE_FILENAME} 2> /dev/null)
	    if av-extended-is-auto-updated-in-time ${date_s} ${date_update} ; then
		status=OK
	    else
		status=KO
	    fi
	    date_update=$(get-date-from-epoch-seconds ${date_update})

	    display-log-line 0 ${date_h} Extended Antivirus updated at ${date_update}[${status}]

	    if test ${APL_ROLE} == manager ; then
		if test -s ${HOME}/${MANAGER_GATEWAY_INDEX} ; then

		    local uuid domain id ip
		    local push_status push_date error_txt

		    while read uuid domain id ip
		    do
			test -n "${ip}" || continue
			test -s ${AV_VAR_DIR}/${id}.${MPUSHED_STATUS} || continue
			read push_status push_date < ${AV_VAR_DIR}/${id}.${MPUSHED_STATUS}
			push_date=$(get-date-from-epoch-seconds ${push_date})

			if test ${push_status} -eq 0 ; then
			    status=OK
			    unset error_txt
			else
			    status=KO
			    error_txt=" (${push_status})"
			fi
			display-log-line 0 ${date_h} "Pushing Extended Antivirus to '${id}' at ${push_date}${error_txt}[${status}]"
		    done < ${HOME}/${MANAGER_GATEWAY_INDEX}
		fi
	    fi
	else
	    status=KO
	    display-log-line 0 ${date_h} Extended Antivirus updating[${status}]
	fi
    fi

    echo-end-show
}

show-antivirus-auto()
{
    local country

    echo-command-form "antivirus auto"
    echo-mark-cur
    country=$(get-country-name ${CURRENT_AV_COUNTRY_CODE})
    echo-value "${CURRENT_AV_COUNTRY_CODE^^} (${country})" ${AV_COL}
    if test "${CURRENT_AV_COUNTRY_CODE}" != "${AV_COUNTRY_CODE}" ; then
	echo-command-form "antivirus auto"
	echo-mark-new
	country=$(get-country-name ${AV_COUNTRY_CODE})
	echo-value "${AV_COUNTRY_CODE^^} (${country})" ${AV_COL}
    fi
}

show-antivirus-maxobject()
{
    local max_file=${CURRENT_AV_MAX_OBJECT_SZ}

    echo-command-form "antivirus maxobject"
    echo-mark-cur
    echo-value "${max_file}KB" ${AV_COL}
    if test "${CURRENT_AV_MAX_OBJECT_SZ}" != "${AV_MAX_OBJECT_SZ}" ; then
	max_file=${AV_MAX_OBJECT_SZ}
	echo-command-form "antivirus maxobject"
	echo-mark-new
	echo-value "${max_file}KB" ${AV_COL}
    fi
}

show-antivirus-pua()
{
    echo-command-form "antivirus pua"
    local val=$(external-form ${CURRENT_AV_PUA})
    echo-mark-cur
    echo-value "${val}" ${AV_COL}

    if test "${CURRENT_AV_PUA}" != "${AV_PUA}" ; then
	echo-command-form "antivirus pua"
	echo-mark-new
	val=$(external-form ${AV_PUA})
	echo-value "${val}" ${AV_COL}
    fi
}

show-antivirus-topology-internal()
{
    echo-command-form "antivirus topology internal"
    local val=$(external-form ${CURRENT_AV_INTERNAL})
    echo-mark-cur
    echo-value "${val}" ${AV_COL}

    if test "${CURRENT_AV_INTERNAL}" != "${AV_INTERNAL}" ; then
	echo-command-form "antivirus topology internal"
	echo-mark-new
	val=$(external-form ${AV_INTERNAL})
	echo-value "${val}" ${AV_COL}
    fi
}

