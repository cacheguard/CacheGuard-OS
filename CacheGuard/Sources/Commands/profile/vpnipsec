	    case ${COMP_WORDS[1]} in
		access)
		    case ${COMP_WORDS[2]} in
			on|off)
			    __complete-vpnipsec-access-site 0
			    ;;
			conf)
			    case ${COMP_WORDS[3]} in
				android|apple|linux|windows)
				    case ${COMP_WORDS[5]} in
					email)
					    COMPREPLY=('' '<email-address>')
					    ;;
					save)
					    case ${COMP_WORDS[6]} in
						f|ft|ftp)
						    COMPREPLY=(ftp)
						    ;;
						s|sf|sft|sftp)
						    COMPREPLY=(sftp)
						    ;;
						t|tf|tft|tftp)
