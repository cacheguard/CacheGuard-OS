	    case ${COMP_WORDS[1]} in
		access)
		    case ${COMP_WORDS[2]} in
			on|off)
			    __complete-vpnipsec-access-site 0
			    ;;
			conf)
			    case ${COMP_WORDS[3]} in
				android|apple|linux|windows)
				    case ${COMP_WORDS[5]} in
					e|em|ema|emai|email)
					    COMPREPLY=(email)
					    ;;
					s)
					    COMPREPLY=('' save show)
					    ;;
					sa|sav|save)
					    COMPREPLY=(save)
					    ;;
					sh|sho|show)
					    COMPREPLY=(show)
					    ;;
					'')
					    COMPREPLY=('' email save show)
					    ;;
					*)
