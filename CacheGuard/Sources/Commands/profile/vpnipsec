			    ;;
		    esac
		    ;;
		via)
		    case ${COMP_WORDS[2]} in
			access)
			    __complete-vpnipsec-via 0
			     ;;
			site)
			    __complete-vpnipsec-via 1
			    ;;
			*)
			    COMPREPLY=()
			    ;;
		    esac
		    ;;
		*)
		    COMPREPLY=()
		    ;;
	    esac
	    ;;
