					    ;;
				    esac
				    ;;
				*)
				    COMPREPLY=()
				    ;;
			    esac
			    ;;
			*)
			    COMPREPLY=()
			    ;;
		    esac
		    ;;
		site)
		    case ${COMP_WORDS[2]} in
			add)
			    case ${COMP_WORDS[5]} in
				psk)
				    case ${COMP_WORDS[6]} in
					'')
					    COMPREPLY=('' '<pre-shared-key>')
					    ;;
					*)
