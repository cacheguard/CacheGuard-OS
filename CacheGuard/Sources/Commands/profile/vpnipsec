		    case ${COMP_WORDS[2]} in
			add)
			    COMPREPLY=('' '<peer-vpn-address>')
			    ;;
			*)
			    COMPREPLY=()
			    ;;
		    esac
		    ;;
		network)
		    case ${COMP_WORDS[2]} in
			access)
			    __complete-vpnipsec-network 0
			     ;;
			site)
			    __complete-vpnipsec-network-via 1
			    ;;
			*)
			    COMPREPLY=()
			    ;;
		    esac
		    ;;
		via)
		    case ${COMP_WORDS[2]} in
			access)
			    __complete-vpnipsec-via 0
			     ;;
			site)
			    __complete-vpnipsec-network-via 1
			    ;;
			*)
			    COMPREPLY=()
			    ;;
		    esac
		    ;;
		to)
		    case ${COMP_WORDS[3]} in
			add|del)
			    COMPREPLY=('' '<peer-vpn-address>')
			    ;;
			*)
			    COMPREPLY=()
			    ;;
		    esac
		    ;;
		nat)
		    case ${COMP_WORDS[2]} in
			public)
			    case ${COMP_WORDS[3]} in
				add|del)
				    COMPREPLY=('' '<local-public-ip>')
				    ;;
				*)
