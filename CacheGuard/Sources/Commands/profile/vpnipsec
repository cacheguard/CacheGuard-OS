					    ;;
				    esac
				    ;;
				*)
				    COMPREPLY=()
				    ;;
			    esac
			    ;;
			*)
			    COMPREPLY=()
			    ;;
		    esac
		    ;;
		site)
		    case ${COMP_WORDS[2]} in
			add)
			    case ${COMP_WORDS[5]} in
				p|ps|psk)
				    COMPREPLY=(psk)
				    ;;
				t|tl|tls)
				    COMPREPLY=(tls)
				    ;;
				'')
				    COMPREPLY=('' psk tls)
				    ;;
				*)
				    COMPREPLY=()
				    ;;
			    esac
			    ;;
			*)
			    COMPREPLY=()
			    ;;
		    esac
		    ;;
		network)
		    case ${COMP_WORDS[2]} in
			access)
			    __complete-vpnipsec-network 0
			    ;;
			site)
			    __complete-vpnipsec-network 1
			    ;;
			*)
