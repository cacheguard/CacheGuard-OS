				    ;;
			    esac
			    ;;
			role)
			    case ${COMP_WORDS[4]} in
				a|ac|act|acti|activ|active)
				    COMPREPLY=(active)
				    ;;
				p|pa|pas|pass|passi|passiv|passive)
				    COMPREPLY=(passive)
				    ;;
				r|ra|raz)
