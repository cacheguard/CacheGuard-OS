			    ;;
			pipd|pipdn|pipdns)
			    COMPREPLY=(pipdns)
			    ;;
			pipo|pipoc|pipocs|pipocsp)
			    COMPREPLY=(pipocsp)
			    ;;
			t|tc|tcp|tcpf|tcpfl|tcpflo|tcpfloo|tcpflood)
			    COMPREPLY=(tcpflood)
			    ;;
			u|ud|udp|udpf|udpfl|udpflo|udpfloo|udpflood)
			    COMPREPLY=(udpflood)
			    ;;
			w|we|web|webf|webfl|webflo|webfloo|webflood)
			    COMPREPLY=(webflood)
			    ;;
			r|rw|rwe|rweb|rwebf|rwebfl|rwebflo|rwebfloo|rwebflood)
			    COMPREPLY=(rwebflood)
			    ;;
			'')
			    COMPREPLY=('' '<RET>' piptcp pipweb piprweb pipdns pipocsp tcpflood udpflood webflood rwebflood)
			    ;;
			*)
			    COMPREPLY=()
			    ;;
		    esac
		    ;;
		external|auxiliary|web|rweb|antivirus|file|peer|mon|admin|vpnipsec)
		    case ${COMP_WORDS[2]} in
			a|ad|add)
			    COMPREPLY=(add)
			    ;;
			d|de|del)
			    COMPREPLY=(del)
			    ;;
			r|ra|raz)
			    COMPREPLY=(raz)
			    ;;
			o)
			    COMPREPLY=('' on off)
			    ;;
			of|off)
			    COMPREPLY=(off)
			    ;;
			on)
			    COMPREPLY=(on)
			    ;;
			i|"in"|ins|inse|inser|insert|insert:)
			    COMPREPLY=(insert:)
			    ;;
			m|mo|mov|move|move:)
			    COMPREPLY=(move:)
			    ;;
			'')
			    COMPREPLY=('' '<RET>' add 'add:<rule-name>' 'insert:<rule-name>' 'move:<position>' 'move:(-|+)<rule-name>' del raz on off)
			    ;;
			*)
			    COMPREPLY=()
			    ;;
		    esac
		    ;;
		*)
		    COMPREPLY=()
		    ;;
	    esac
	    ;;
