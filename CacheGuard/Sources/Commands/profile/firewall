			    COMPREPLY=('' piptcp pipweb piprweb pipdns pipocsp)
			    ;;
			pipt|piptc|piptcp)
			    COMPREPLY=(piptcp)
			    ;;
			pipr|piprw|piprwe|piprweb)
			    COMPREPLY=(piprweb)
			    ;;
			pipw|pipwe|pipweb)
