__complete-firewall()
{
    test -n "${COMP_CWORD-1}" || return 1

    case ${COMP_CWORD} in
	1)
	    case ${COMP_WORDS[1]} in
		d|'do'|dos)
		    COMPREPLY=(dos)
		    ;;
		e|ex|ext|exte|exter|extern|externa|external)
		    COMPREPLY=(external)
		    ;;
		a)
		    COMPREPLY=('' antivirus auxiliary)
		    ;;
		an|ant|anti|antiv|antivi|antivir|antiviru|antivirus)
		    COMPREPLY=(antivirus)
		    ;;
		au|aux|auxi|auxil|auxili|auxilia|auxiliar|auxiliary)
		    COMPREPLY=(auxiliary)
		    ;;
		w|we|web)
		    COMPREPLY=(web)
		    ;;
		r|rw|rwe|rweb)
		    COMPREPLY=(rweb)
		    ;;
		f|'fi'|fil|file)
		    COMPREPLY=(file)
		    ;;
		p|pe|pee|peer)
		    COMPREPLY=(peer)
		    ;;
		a|ad|ad|adm|admi|admin)
		    COMPREPLY=(admin)
		    ;;
		m|mo|mon)
		    COMPREPLY=(mon)
		    ;;
		v|vp|vpn|vpni|vpnip|vpnips|vpnipse|vpnipsec)
		    COMPREPLY=(vpnipsec)
		    ;;
		'')
		    COMPREPLY=('' '<RET>' dos external auxiliary web rweb antivirus file peer mon admin vpnipsec)
		    ;;
		*)
		    COMPREPLY=()
		    ;;
	    esac
	    ;;
