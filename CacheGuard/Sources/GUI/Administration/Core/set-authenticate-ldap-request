set-ldap-request()
{
    local transaction=/tmp/${TRANSACTION_FILE}.wadmin.${REMOTE_USER}.${$}

    local base_dn=${VALUES[0]}
    local login_attr=${VALUES[1]}
    local password_attr=${VALUES[2]}
    local filter=${VALUES[3]}
    local group_dn=${VALUES[4]}

    base_dn=${base_dn// /}
    filter=${filter// /}
    group_dn=${group_dn// /}

    test -n "${password_attr}" || password_attr="''"

    if test -n "${group_dn}" ; then
        echo "authenticate ldap request '${base_dn}' ${login_attr} ${password_attr} '${filter}' '${group_dn}'" > ${transaction}
    else
        echo "authenticate ldap request '${base_dn}' ${login_attr} ${password_attr} '${filter}'" > ${transaction}
    fi

    if test "${ATTRIBUTES[5]}" == 'bind_required' ; then

	local bind_dn=${VALUES[6]}
	local bind_password=${VALUES[7]}

	bind_dn=${bind_dn// /}

	echo "authenticate ldap binddn '${bind_dn}' on '${bind_password}'" >> ${transaction}
    else
	local bind_dn=${VALUES[5]}
	bind_dn=${bind_dn// /}
	echo "authenticate ldap binddn '${bind_dn}' off" >> ${transaction}
    fi

    execute-transaction ${transaction}
}

set-ldap-request
