set-guard-policy()
{
    local pos=0 entry_pos del_pos
    local name_pos

    local transaction=/tmp/${TRANSACTION_FILE}.wadmin.${REMOTE_USER}.${$}
    rm -f ${transaction}

    while test ${pos} -lt ${ATTRIBUTE_NB}
    do
	entry_pos=${pos}
	name_pos=$[${pos} + 1]
	del_pos=$[${pos} + 2]
	
	if [[ "${ATTRIBUTES[${del_pos}]}" =~ ^del_[0-9]+$ ]] ; then
	    echo "guard policy del '${VALUES[${name_pos}]}'" >> ${transaction}
	    pos=$[${pos} + 3]
	else
	    if test "${VALUES[${entry_pos}]}" == anew -a \
		-n "${VALUES[${name_pos}]}" ; then
		echo "guard policy add '${VALUES[${name_pos}]}'" >> ${transaction}
	    fi
	    pos=$[${pos} + 2]
	fi
    done

    execute-transaction ${transaction}
}

set-guard-policy
