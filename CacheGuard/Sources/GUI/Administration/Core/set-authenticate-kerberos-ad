set-kerberos-dc()
{
    local transaction=/tmp/${TRANSACTION_FILE}.wadmin.${REMOTE_USER}.${$}

    local service_name=${VALUES[0]}
    local ad_state=${VALUES[1]}

    test -n "${service_name}" || service_name=${SHOSTNAME}

    echo "authenticate kerberos web ${service_name}" > ${transaction}



    case ${ad_state} in
	off)
	    echo "authenticate ad ${ad_state}" >> ${transaction}
	    execute-transaction ${transaction}
	    ;;
	on)
	    local rdn=${VALUES[2]}
	    local login=${VALUES[3]}

	    if test -n "${rdn}" ; then
		rdn=${rdn// /}
	    else
		rdn=$(get-domain-controller-chain ${DOMAIN_NAME})
	    fi

	    test -n "${login}" || login=${service_name}

	    echo "authenticate ad ${ad_state}" >> ${transaction} 
	    echo "authenticate ad rdn '${rdn}'" >> ${transaction}

	    if test "${VALUES[4]}" == "${VALUES[5]}" ; then
		echo "authenticate ad account ${login} '${VALUES[4]}'" >> ${transaction}
		execute-transaction ${transaction}
	    else
		execute-transaction ${transaction}
		gen-gui-error 4
	    fi
	    ;;
	*)
	    ;;
    esac
}

set-kerberos-dc
