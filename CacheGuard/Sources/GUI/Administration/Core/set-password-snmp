set-ldap-asswd()
{
    local transaction=/tmp/${TRANSACTION_FILE}.wadmin.${REMOTE_USER}.${$}
    rm -f ${transaction}

    if test -n "${VALUES[0]}" -a -n "${VALUES[1]}" ; then
	if test "${VALUES[0]}" == "${VALUES[1]}" ; then
	    echo "password snmp community '${VALUES[0]}'" >> ${transaction}
	else
	    gen-gui-error 28
	fi
    fi

    if test -n "${VALUES[2]}" -a -n "${VALUES[3]}" ; then
	if test "${VALUES[2]}" == "${VALUES[3]}" ; then
	    echo "password snmp privacy '${VALUES[2]}'" >> ${transaction}
	else
	    rm -f ${transaction}
	    gen-gui-error 29
	fi
    fi

    execute-transaction ${transaction}
}

set-ldap-asswd
