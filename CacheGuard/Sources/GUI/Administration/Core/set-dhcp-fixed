set-dhcp-fixed-ips()
{
    local pos=0 entry_pos del_pos
    local if_pos hostname_pos mac_pos ip_pos

    local transaction=/tmp/${TRANSACTION_FILE}.wadmin.${REMOTE_USER}.${$}
    rm -f ${transaction}

    while test ${pos} -lt ${ATTRIBUTE_NB}
    do
	entry_pos=${pos}
	hostname_pos=$[${pos} + 1]
	if_pos=$[${pos} + 2]
	mac_pos=$[${pos} + 3]
	ip_pos=$[${pos} + 4]
	del_pos=$[${pos} + 5]

	[[ "${ATTRIBUTES[${del_pos}]}" =~ ^del_[0-9]+$ ]]
	if test ${?} -ne 0 ; then
	    if test "${VALUES[${entry_pos}]}" == anew -a \
		    -n "${VALUES[${if_pos}]}" -a \
		    -n "${VALUES[${hostname_pos}]}" -a \
		    -n "${VALUES[${mac_pos}]}" -a \
		    -n "${VALUES[${ip_pos}]}" ; then
		echo "dhcp fixed add ${VALUES[${hostname_pos}]} ${VALUES[${if_pos}]} ${VALUES[${mac_pos}]} ${VALUES[${ip_pos}]}" >> ${transaction}
	    fi
	    pos=$[${pos} + 5]
	else
	    echo "dhcp fixed del ${VALUES[${hostname_pos}]}" >> ${transaction}
	    pos=$[${pos} + 6]
	fi
    done

    execute-transaction ${transaction}
}

# Main()

set-dhcp-fixed-ips
