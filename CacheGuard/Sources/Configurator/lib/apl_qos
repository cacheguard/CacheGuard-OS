    if nic-exist ${odev} -a ${interface} != vpnipsec ; then
	echo "class add dev ${odev} parent ${web_class} classid ${QOS_HANDLE_TOP_GW}:${QOS_HANDLE} htb rate ${orate}kbit ceil ${oceil}kbit ${QOS_HTB_QUANTUM}"
	echo "qdisc add dev ${odev} parent ${QOS_HANDLE_TOP_GW}:${QOS_HANDLE} handle ${handle} ${QOS_QDISC_SFQ}"

	echo "filter add dev ${odev} parent ${QOS_CLASS_TOP_GW} protocol ip priority $[${QOS_WEB_FILTER_PRIO}+3] handle $(printf 0x%x/${QOS_MARK_MASK} ${QOS_HANDLE} 2> /dev/null) fw flowid ${QOS_HANDLE_TOP_GW}:${QOS_HANDLE}"
    fi

    gen-qos-index web${title}: sfq ${interface} ${idev} ${odev} ${handle}
}

