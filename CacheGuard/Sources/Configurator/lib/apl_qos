gen-tc-all-top()
{
    local interface interfaces="internal"
    test ${APL_ROLE} == 'manager' || interfaces="${interfaces} external"
    test -z "${IF_AUXILIARY}" -o ${IP_AUXILIARY_IP} == 0.0.0.0 || interfaces="${interfaces} auxiliary"

    local idev odev admin_ip mon_ip

    for interface in ${interfaces}
    do
	case ${interface} in

	    internal)
		idev=${IF_QOS_INTERNAL_INGRESS}
		odev=${IF_QOS_INTERNAL_EGRESS}
		admin_ip=${IP_ADMIN_IP}
		mon_ip=${IP_MON_IP}
		;;

	    external)
		idev=${IF_QOS_EXTERNAL_INGRESS}
		odev=${IF_QOS_EXTERNAL_EGRESS}
		admin_ip=${IP_EXTERNAL_IP}
		mon_ip=${admin_ip}
		;;

	    auxiliary)
		idev=${IF_QOS_AUXILIARY_INGRESS}
		odev=${IF_QOS_AUXILIARY_EGRESS}
		admin_ip=${IP_AUXILIARY_IP}
		mon_ip=${admin_ip}
		;;
	    *)
		return 11
		;;
	esac

	if nic-exist ${idev} ; then
	    echo "qdisc add dev ${idev} parent ${QOS_PARENT_ADMIN} handle ${QOS_HANDLE_TOP_ADMIN}: pfifo"

	    gen-tc-ingress-admin ${idev} ${admin_ip}
	    gen-tc-ingress-snmp-trap-ip ${idev}
	    gen-tc-ingress-syslog-ip ${idev}
	    gen-tc-ingress-snmp-agent ${idev} ${mon_ip}
	    gen-tc-ingress-non-admin-dev ${idev}

	fi

	if nic-exist ${odev} -a ${interface} != vpnipsec ; then
	    echo "qdisc add dev ${odev} parent ${QOS_PARENT_ADMIN} handle ${QOS_HANDLE_TOP_ADMIN}: pfifo"
	    echo "filter add dev ${odev} parent ${QOS_HANDLE_ROOT}: protocol arp priority ${QOS_ARP_FILTER_PRIO} u32 ${QOS_FILTER_ALL} flowid ${QOS_PARENT_GW}"
	    echo "filter add dev ${odev} parent ${QOS_HANDLE_ROOT}: protocol ip priority ${QOS_ADMIN_FILTER_PRIO} handle ${QOS_ADMIN_MARK}/${QOS_MARK_MASK} fw flowid ${QOS_PARENT_ADMIN}"
	    echo "filter add dev ${odev} parent ${QOS_HANDLE_ROOT}: protocol ip priority ${QOS_NON_ADMIN_FILTER_PRIO} u32 ${QOS_FILTER_ALL} flowid ${QOS_PARENT_GW}"
	fi

	gen-qos-index admin: pfifo ${interface} ${idev} ${odev} ${QOS_HANDLE_TOP_ADMIN}:

    done
}

gen-tc-qos-gateway-top()
{
    test -n "${1}" || return 1
    local interface=${1}

    local idev=$(get-qos-dev ${interface} ingress)
    local odev=$(get-qos-dev ${interface} egress)
    local ibw=$(get-qos-bw ${interface} ingress)
    local obw=$(get-qos-bw ${interface} egress)

    if nic-exist ${idev} ; then
