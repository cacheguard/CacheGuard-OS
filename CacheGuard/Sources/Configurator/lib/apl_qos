    test ${SNMP_TCP} == False || echo "filter add dev ${dev} parent ${QOS_HANDLE_ROOT}: protocol ip priority ${QOS_ADMIN_SNMP_FILTER_PRIO} u32 ${QOS_FILTER_TCP} match ip dst ${apl_ip}/32 match ip dport ${SNMP_PORT} 0xffff flowid ${QOS_PARENT_ADMIN}"
    test ${SNMP_TLS} == False || echo "filter add dev ${dev} parent ${QOS_HANDLE_ROOT}: protocol ip priority ${QOS_ADMIN_SNMP_FILTER_PRIO} u32 ${QOS_FILTER_TCP} match ip dst ${apl_ip}/32 match ip dport ${SNMP_TLS_PORT} 0xffff flowid ${QOS_PARENT_ADMIN}"
}

gen-tc-ingress-non-admin-dev()
{
    test -n "${1}" || return 1
    local dev=${1}

    echo "filter add dev ${dev} parent ${QOS_HANDLE_ROOT}: protocol arp priority ${QOS_ARP_FILTER_PRIO} u32 ${QOS_FILTER_ALL} flowid ${QOS_PARENT_GW}"
