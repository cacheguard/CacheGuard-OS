			flow=web
			;;
		    vpnipsec)
			if test ${VPN_IPSEC_MODE} == False ; then
			    ((i++))
			    continue
			fi
			idev=${IF_QOS_EXTERNAL_INGRESS}
			odev=${IF_QOS_EXTERNAL_EGRESS}
			web_class=${QOS_CLASS_TWEB_VPN_IPSEC}
			if_name=external
			flow=vpnipsec
			title=[sec]
			;;
		    *)
			;;
		esac

		irate=$(get-qos-rate ${if_name} ingress ${flow})
		iceil=$(get-qos-ceil ${if_name} ingress ${irate})
		orate=$(get-qos-rate ${if_name} egress ${flow})
		oceil=$(get-qos-ceil ${if_name} egress ${orate})

		if nic-exist ${idev} ; then
		    rate=$(get-qos-percent ${irate} ${qos})
		    ceil=$(get-qos-ceil ${if_name} ingress ${rate})
		    echo "class add dev ${idev} parent ${web_class} classid ${QOS_HANDLE_TOP_GW}:${QOS_HANDLE} htb rate ${rate}kbit ceil ${ceil}kbit ${QOS_HTB_QUANTUM}"
		    echo "qdisc add dev ${idev} parent ${QOS_HANDLE_TOP_GW}:${QOS_HANDLE} handle ${handle} ${QOS_QDISC_SFQ}"

		    if test ${TRANSPARENT_MODE} == True ; then
			echo "filter add dev ${idev} parent ${QOS_CLASS_TOP_GW} protocol ip priority ${QOS_TWEB_FILTER_PRIO} u32 match ip src ${ip}/${px} match ip dport ${WWW_PORT} 0xffff flowid ${QOS_HANDLE_TOP_GW}:${QOS_HANDLE}"
			test ${SSLMEDIATE_TRANSPARENT_MODE} == False || echo "filter add dev ${idev} parent ${QOS_CLASS_TOP_GW} protocol ip priority ${QOS_TWEB_FILTER_PRIO} u32 match ip src ${ip}/${px} match ip dport ${HTTPS_PORT} 0xffff flowid ${QOS_HANDLE_TOP_GW}:${QOS_HANDLE}"
		    fi

		    if test ${DNS_MODE} == True ; then
			echo "filter add dev ${idev} parent ${QOS_CLASS_TOP_GW} protocol ip priority $[${QOS_TWEB_FILTER_PRIO}+1] u32 ${QOS_FILTER_UDP} match ip src ${ip}/${px} match ip dport ${DOMAIN_PORT} 0xffff flowid ${QOS_HANDLE_TOP_GW}:${QOS_HANDLE}"
			echo "filter add dev ${idev} parent ${QOS_CLASS_TOP_GW} protocol ip priority $[${QOS_TWEB_FILTER_PRIO}+1] u32 ${QOS_FILTER_TCP} match ip src ${ip}/${px} match ip dport ${DOMAIN_PORT} 0xffff flowid ${QOS_HANDLE_TOP_GW}:${QOS_HANDLE}"
		    fi
		fi

		if nic-exist ${odev} -a ${flow} != vpnipsec ; then
		    rate=$(get-qos-percent ${orate} ${qos})
		    ceil=$(get-qos-ceil ${if_name} egress ${rate})
		    echo "class add dev ${odev} parent ${web_class} classid ${QOS_HANDLE_TOP_GW}:${QOS_HANDLE} htb rate ${rate}kbit ceil ${ceil}kbit ${QOS_HTB_QUANTUM}"
		    echo "qdisc add dev ${odev} parent ${QOS_HANDLE_TOP_GW}:${QOS_HANDLE} handle ${handle} ${QOS_QDISC_SFQ}"

		    if test ${TRANSPARENT_MODE} == True ; then
			echo "filter add dev ${odev} parent ${QOS_CLASS_TOP_GW} protocol ip priority ${QOS_TWEB_FILTER_PRIO} handle $(printf 0x%x/${QOS_MARK_MASK} ${QOS_HANDLE} 2> /dev/null) fw flowid ${QOS_HANDLE_TOP_GW}:${QOS_HANDLE}"
		    fi

		    # To catch the traffic at the upper level
		    echo "filter add dev ${odev} parent ${QOS_HANDLE_TOP_GW}: protocol ip priority ${QOS_GATEWAY_TWEB_FILTER_PRIO} handle $(printf 0x%x/${QOS_MARK_MASK} ${QOS_HANDLE} 2> /dev/null) fw flowid ${QOS_HANDLE_TOP_GW}:${QOS_HANDLE}"
		fi

		gen-qos-index tweb${title}:${ip}/${px} sfq ${if_name} ${idev} ${odev} ${handle}

		((QOS_HANDLE++))
		;;
	    *)
		return 1
		;;
	esac
	((i++))
    done
}

gen-tc-tweb-top()
