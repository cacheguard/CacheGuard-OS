gen-tc-qos-nr()
{
    local interface interfaces="internal"
    test ${APL_ROLE} == 'manager' || interfaces="${interfaces} external"
    test -z "${IF_AUXILIARY}" -o ${IP_AUXILIARY_IP} == 0.0.0.0 || interfaces="${interfaces} auxiliary"
    test ${VPN_IPSEC_MODE} == False || interfaces="${interfaces} vpnipsec"

