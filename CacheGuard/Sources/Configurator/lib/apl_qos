gen-tc-ingress-syslog()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 0

    local dev=${1}
    local syslog_server_ip_list=${2}

    local elt range i=0
    local protocol ip port
    local filter

    for elt in ${syslog_server_ip_list}
    do
	range=$[${i} % 3]
	case ${range} in
	    0)
		protocol=${elt}
		;;
	    1)
		ip=${elt}
		;;
	    2)
		port=${elt}

		case ${protocol} in
		    udp)
			filter=${QOS_FILTER_UDP}
			;;
		    tcp)
			filter=${QOS_FILTER_TCP}
			;;
		    *)
			;;
		esac
	    
		echo "filter add dev ${dev} parent ${QOS_HANDLE_ROOT}: priority ${QOS_ADMIN_SYSLOG_FILTER_PRIO} protocol ip u32 ${filter} match ip src ${ip}/32 match ip sport ${port} 0xffff flowid ${QOS_CLASS_ADMIN}"

		;;
	    *)
		return 255
		;;
	esac
	((i++))
    done
}

