gen-tc-backend-rweb()
{
    test ${RWEB_MODE} == True || return 0

    local elt range i=0
    local interface ip port qos
    local idev odev rweb_class if_name flow='rweb'
    local qosid irate iceil orate oceil rate ceil
    local handle

    echo
    echo "# QoS for rweb backend web servers traffic:"

    gen-tc-backend-rweb-top internal ${IF_QOS_INTERNAL_INGRESS} ${IF_QOS_RWEB_EGRESS} ${QOS_CLASS_RWEB_BACKEND_ID}

    for elt in ${ACCESS_RWEB_LIST}
    do
	range=$[${i} % 4]
	case ${range} in
	    0)
		interface=${elt}
		;;
	    1)
		ip=${elt}
		;;
	    2)
		port=${elt}
		;;
	    3)
		qos=${elt}

		handle=$[${QOS_CHILD_QDISC_HANDLE_OFFSET} + ${QOS_HANDLE}]:

		case ${interface} in
		    rweb)
			idev=${IF_QOS_INTERNAL_INGRESS}
			odev=${IF_QOS_RWEB_EGRESS}
			rweb_class=${QOS_CLASS_RWEB_BACKEND_ID}
			if_name='internal'
			;;
		    external)
			idev=${IF_QOS_EXTERNAL_INGRESS}
			odev=${IF_QOS_EXTERNAL_EGRESS}
			rweb_class=${QOS_CLASS_RWEB_PUBLIC_ID}
			if_name='external'
			;;
