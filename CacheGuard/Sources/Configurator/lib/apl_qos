gen-tc-ingress-snmp-trap()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 0

    local dev=${1}
    local ip_ports=${2}

    local ip port
    
    for ip_port in ${ip_ports}
    do
	ip=${ip_port/:*/}
	port=${ip_port/*:/}
	echo "filter add dev ${dev} parent ${QOS_HANDLE_ROOT}: protocol ip priority ${QOS_ADMIN_SNMP_TRAP_FILTER_PRIO} u32 ${QOS_FILTER_TCP} match ip src ${ip}/32 match ip sport ${port} 0xffff flowid ${QOS_PARENT_ADMIN}"
    done
}

gen-tc-ingress-snmp-trap-ip()
{
