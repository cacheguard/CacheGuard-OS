			echo "filter add dev ${idev} parent ${QOS_CLASS_TOP_GW} protocol ip priority $[${QOS_WEB_FILTER_PRIO}+1] u32 ${QOS_FILTER_TCP} match ip src ${ip}/${px} match ip dport ${DOMAIN_PORT} 0xffff flowid ${QOS_HANDLE_TOP_GW}:${QOS_HANDLE}"
