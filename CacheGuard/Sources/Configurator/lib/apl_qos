	((QOS_HANDLE++))
	gen-tc-web-sub-nil external vpnipsec ${IF_QOS_EXTERNAL_INGRESS} ${IF_QOS_EXTERNAL_EGRESS}
    fi

    ((QOS_HANDLE++))
}

