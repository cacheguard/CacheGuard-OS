	echo "class add dev ${odev} parent ${QOS_HANDLE_TOP_GW} classid ${QOS_CLASS_IPSEC} htb rate ${orate}kbit ceil ${oceil}kbit ${QOS_HTB_QUANTUM}"
	echo "qdisc add dev ${odev} parent ${QOS_CLASS_IPSEC} handle ${handle}: pfifo"

	echo "filter add dev ${odev} parent ${QOS_CLASS_TOP_GW} protocol ip priority ${QOS_ESP_FILTER_PRIO} handle $(printf 0x%x/${QOS_MARK_MASK} ${QOS_ESP_MARK} 2> /dev/null) fw flowid ${QOS_CLASS_IPSEC}"

	echo "filter add dev ${odev} parent ${QOS_CLASS_TOP_GW} protocol ip priority ${QOS_IKE_FILTER_PRIO} u32 ${QOS_FILTER_UDP} match ip sport ${ISAKMP_PORT} 0xffff flowid ${QOS_CLASS_IPSEC}"
	echo "filter add dev ${odev} parent ${QOS_CLASS_TOP_GW} protocol ip priority ${QOS_IKE_FILTER_PRIO} u32 ${QOS_FILTER_UDP} match ip sport ${NATT_PORT} 0xffff flowid ${QOS_CLASS_IPSEC}"

    fi

    gen-qos-index vpnipsec: htb external ${idev} ${odev} ${handle}
}

