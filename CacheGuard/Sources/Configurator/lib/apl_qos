gen-tc-ingress()
{
    local interface interfaces="internal"
    test ${APL_ROLE} == 'manager' || interfaces="${interfaces} external"
    test -z "${IF_AUXILIARY}" -o ${IP_AUXILIARY_IP} == 0.0.0.0 || interfaces="${interfaces} auxiliary"

    local dev if_qos

    for interface in ${interfaces}
    do
	case ${interface} in
	    internal)
		dev=${IF_INTERNAL}
		if_qos=${IF_QOS_INTERNAL_INGRESS}
		;;
	    external)
		dev=${IF_EXTERNAL}
		if_qos=${IF_QOS_EXTERNAL_INGRESS}
		;;
	    auxiliary)
		dev=${IF_AUXILIARY}
		if_qos=${IF_QOS_AUXILIARY_INGRESS}
		;;
	    *)
		return 11
		;;
	esac

	nic-exist ${dev} || continue

	case ${interface} in
	    external|auxiliary)
		echo "qdisc add dev ${dev} ingress handle ffff:"
		echo "filter add dev ${dev} parent ffff: protocol arp priority 10 u32 ${QOS_FILTER_ALL} flowid ${QOS_HANDLE_ROOT}: action mirred egress redirect dev ${if_qos}"
		echo "filter add dev ${dev} parent ffff: protocol ip priority 11 u32 ${QOS_FILTER_ALL} flowid ${QOS_HANDLE_ROOT}: action mirred egress redirect dev ${if_qos}"
		;;
	    internal)
		if test ${VLAN_MODE} == False ; then	
		    echo "qdisc add dev ${dev} ingress handle ffff:"
		    echo "filter add dev ${dev} parent ffff: protocol arp priority 10 u32 ${QOS_FILTER_ALL} flowid ${QOS_HANDLE_ROOT}: action mirred egress redirect dev ${if_qos}"
		    echo "filter add dev ${dev} parent ffff: protocol ip priority 11 u32 ${QOS_FILTER_ALL} flowid ${QOS_HANDLE_ROOT}: action mirred egress redirect dev ${if_qos}"
		elif test ${interface} == internal ; then

		    local i=0 elt range
		    local vlan
    
		    for elt in ${VLAN_FLOW_LIST}
		    do
			range=$[${i} % 2]
			case ${range} in
			    0)
				vlan=${elt}
				;;
			    1)
				echo "qdisc add dev ${dev}.${vlan} ingress handle ffff:"
				echo "filter add dev ${dev}.${vlan} parent ffff: protocol arp priority 10 u32 ${QOS_FILTER_ALL} flowid ${QOS_HANDLE_ROOT}: action mirred egress redirect dev ${if_qos}"
				echo "filter add dev ${dev}.${vlan} parent ffff: protocol ip priority 11 u32 ${QOS_FILTER_ALL} flowid ${QOS_HANDLE_ROOT}: action mirred egress redirect dev ${if_qos}"

				echo "qdisc add dev ${dev}.${vlan} root handle ${QOS_HANDLE_ROOT}: htb default 0"
				echo "filter add dev ${dev}.${vlan} parent ${QOS_HANDLE_ROOT}: protocol arp priority 10 u32 ${QOS_FILTER_ALL} flowid ${QOS_HANDLE_ROOT}: action mirred egress redirect dev ${IF_QOS_INTERNAL_EGRESS}"
				echo "filter add dev ${dev}.${vlan} parent ${QOS_HANDLE_ROOT}: protocol ip priority 11 u32 ${QOS_FILTER_ALL} flowid ${QOS_HANDLE_ROOT}: action mirred egress redirect dev ${IF_QOS_INTERNAL_EGRESS}"
				;;
			    *)
				return 1
				;;
			esac
			((i++))
		    done
		fi
		;;
	    *)
		;;
	esac
    done
}

gen-tc-prio-top()
{
