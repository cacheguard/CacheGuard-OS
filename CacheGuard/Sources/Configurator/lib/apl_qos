gen-tc-backend-rweb()
{
    test ${RWEB_MODE} == True || return 0

    local elt range i=0
    local interface ip port qos
    local idev odev rweb_class if_name flow
    local irate iceil orate oceil rate ceil
    local handle title

    gen-tc-backend-rweb-top internal rweb ${IF_QOS_INTERNAL_INGRESS} ${IF_QOS_INTERNAL_EGRESS} ${QOS_CLASS_RWEB_LOCAL}
    test ${VPN_IPSEC_SITE_IS_ACTIVE} == False || gen-tc-backend-rweb-top external vpnipsec ${IF_QOS_EXTERNAL_INGRESS} ${IF_QOS_EXTERNAL_EGRESS} ${QOS_CLASS_RWEB_VPN_IPSEC}

    for elt in ${ACCESS_RWEB_LIST}
    do
	range=$[${i} % 4]
	case ${range} in
	    0)
		interface=${elt}
		;;
	    1)
		ip=${elt}
		;;
	    2)
		port=${elt}
		;;
	    3)
		qos=${elt}

		handle=$[1000 + ${QOS_HANDLE}]:
		unset title

		case ${interface} in
		    rweb)
			idev=${IF_QOS_INTERNAL_INGRESS}
			odev=${IF_QOS_INTERNAL_EGRESS}
			rweb_class=${QOS_CLASS_RWEB_LOCAL}
			if_name=internal
			flow=rweb
			;;
		    vpnipsec)
			if test ${VPN_IPSEC_SITE_IS_ACTIVE} == False ; then
			    ((i++))
			    continue
			fi
			idev=${IF_QOS_EXTERNAL_INGRESS}
			odev=${IF_QOS_EXTERNAL_EGRESS}
			rweb_class=${QOS_CLASS_RWEB_VPN_IPSEC}
			if_name=external
			flow=vpnipsec
			title=[sec]
			;;
		    external)
			idev=${IF_QOS_EXTERNAL_INGRESS}
			odev=${IF_QOS_EXTERNAL_EGRESS}
			rweb_class=${QOS_CLASS_RWEB_EXT}
			if_name=external
			flow=rweb
			;;
		    *)
			;;
		esac

		irate=$(get-qos-rate ${if_name} ingress ${flow})
		iceil=$(get-qos-ceil ${if_name} ingress ${irate})
		orate=$(get-qos-rate ${if_name} egress ${flow})
		oceil=$(get-qos-ceil ${if_name} egress ${orate})

		if nic-exist ${idev} ; then
		    rate=$(get-qos-percent ${irate} ${qos})
		    ceil=$(get-qos-ceil ${if_name} ingress ${rate})
		    echo "class add dev ${idev} parent ${rweb_class} classid ${QOS_HANDLE_TOP_GW}:${QOS_HANDLE} htb rate ${rate}kbit ceil ${ceil}kbit ${QOS_HTB_QUANTUM}"
		    echo "qdisc add dev ${idev} parent ${QOS_HANDLE_TOP_GW}:${QOS_HANDLE} handle ${handle} ${QOS_QDISC_SFQ}"
		    echo "filter add dev ${idev} parent ${QOS_CLASS_TOP_GW} protocol ip priority ${QOS_RWEB_FILTER_PRIO} u32 match ip src ${ip}/32 match ip sport ${port} 0xffff flowid ${QOS_HANDLE_TOP_GW}:${QOS_HANDLE}"
		fi

		if nic-exist ${odev} -a ${flow} != vpnipsec ; then
		    rate=$(get-qos-percent ${orate} ${qos})
		    ceil=$(get-qos-ceil ${if_name} egress ${rate})
		    echo "class add dev ${odev} parent ${rweb_class} classid ${QOS_HANDLE_TOP_GW}:${QOS_HANDLE} htb rate ${rate}kbit ceil ${ceil}kbit ${QOS_HTB_QUANTUM}"
		    echo "qdisc add dev ${odev} parent ${QOS_HANDLE_TOP_GW}:${QOS_HANDLE} handle ${handle} ${QOS_QDISC_SFQ}"
		    echo "filter add dev ${odev} parent ${QOS_CLASS_TOP_GW} protocol ip priority ${QOS_RWEB_FILTER_PRIO} handle $(printf 0x%x/${QOS_MARK_MASK} ${QOS_HANDLE} 2> /dev/null) fw flowid ${QOS_HANDLE_TOP_GW}:${QOS_HANDLE}"
		fi

		gen-qos-index rweb${title}:${ip}/32 sfq ${if_name} ${idev} ${odev} ${handle}
		((QOS_HANDLE++))
		;;
	    *)
		return 255
		;;
	esac
	((i++))
    done
}

