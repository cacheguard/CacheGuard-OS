    test ${ADMIN_WADMIN} == False || echo "filter add dev ${dev} parent ${QOS_HANDLE_ROOT}: protocol ip priority ${QOS_ADMIN_FILTER_PRIO} u32 ${QOS_FILTER_TCP} match ip dst ${apl_ip}/32 match ip dport ${WADMIN_PORT} 0xffff flowid ${QOS_PARENT_ADMIN}"
