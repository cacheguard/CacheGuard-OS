update-alive-date()
{
    test -n "${1}" || return 1
    local date=${1}

    echo ${date} > ${ETC_DIR}/${ALIVE_DATE}
}

update-latest-os-version()
{
    local version

    version=$(get-os-latest-version)
    test ${?} -eq 0 || return 11

    echo ${version} > ${RUN_DIR}/new-os-version
}

set-alive-check()
{
    return 0

    local call=${1}

    local msg ret
    local trial='no'
    local date=$(date +"%s" 2> /dev/null)

    verify-usage-not-trial ${date} || trial='yes'
    msg=$(alive-check ${date} ${trial} 2> /dev/null) ; ret=${?}
    test ${ret} -eq 0 || return ${ret}

    local msg_state=${msg:0:3}
    local code_value=${msg#*:}
    local code=${code_value/:*}

    case "${msg_state}" in
	"OK:")
	    ret=0
	    ;;
	"KO:")
	    ret=0
	    ;;
	*)
	    ret=151
	    ;;
    esac

    test ${ret} -eq 0 || return ${ret}
    test -n "${code}" || return 153
    check-digit ${code} || return 155

    echo "${msg}" > ${HARD_DIR}/${SN_ALIVE}

    case ${code} in
	2)
	    update-alive-date ${date}
	    return 0
	    ;;
	71)
	    return 171
	    ;;
	73)
	    update-alive-date ${date}
	    return 173
	    ;;
	99)
	    return 175
	    ;;
	75)
	    update-alive-date ${date}
	    ;;
	*)
	    return 255
	    ;;
    esac

    is-licensed || return 181
    test ${code} -eq 75 || return 183
    verify-usage-consistency passive ${date} || return 185
    test ${trial} == 'no' || return 187
    test "${call}" == 'active' || return 189

    set-unregistered-appliance
    rm -f ${HARD_DIR}/${SN_ALIVE}
    suspend-access license

    return 191
}
