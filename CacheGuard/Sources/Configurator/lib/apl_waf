save-waf-rules()
{
    local name rule rules
    local base=${USERENV_DIR}/${WAF_RDIR}

    rules=$(ls ${base}/*.rules.current 2> /dev/null)
    for rule in ${rules}
    do
	name=$(file-basename ${rule} .rules.current)
	test -f ${base}/${name}.rules || rm -f ${rule}
    done
    
    rules=$(ls ${base}/*.rules 2> /dev/null)
    for rule in ${rules}
    do
	if test -f ${rule}.current ; then
	    diff --brief ${rule} ${rule}.current > /dev/null 2>&1 || install -m 644 -o ${ACCOUNT} -g ${GROUP_NAME} ${rule} ${rule}.current
	else
	    install -m 644 -o ${ACCOUNT} -g ${GROUP_NAME} ${rule} ${rule}.current
	fi
    done
}

get-waf-rule-eol()
{
    test -n "${1}" || return 1
    local chain_nb=${1}

    if test ${chain_nb} -gt 0 ; then
	local eol="chain\""
    else
	local eol="t:none\""
    fi

    echo ${eol}
}

gen-waf-regexp2()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 1
    test -n "${3}" || return 1
    local msg=${1}
    local method=${2}
    local action=${3}
    local denyurl=${4}
    local uri_regexp=${5}
    local body_regexp=${6}
    local ip_regexp=${7}

    local severity act
    local chain_nb=0 eol
    local http_method=${method^^}
    local log="log,capture"
    local trans="t:none,t:replaceNulls,t:compressWhitespace"
    local id=${WAF_CUSTOM_RULE_ID} ; ((WAF_CUSTOM_RULE_ID++))

    test -z "${uri_regexp}" || ((chain_nb++))
    test -z "${body_regexp}" || ((chain_nb++))
    test -z "${ip_regexp}" || ((chain_nb++))

    case ${action} in
	allow)
	    act="allow"
	    severity=5
	    ;;
	deny)
	    if test -n "${denyurl}" ; then
		act="redirect:${denyurl},status:302"
	    else
		act="deny,status:403"
	    fi
	    severity=2
	    ;;
	*)
	    ;;
    esac

    echo

    eol=$(get-waf-rule-eol ${chain_nb})
    echo "SecRule REQUEST_METHOD \"^${http_method}$\" \"msg:'${msg}',id:${id},${trans},${log},severity:${severity},${act},${eol}"
    if test -n "${uri_regexp}" ; then
	((chain_nb--))
	eol=$(get-waf-rule-eol ${chain_nb})
	echo "SecRule REQUEST_URI \"${uri_regexp}\" \"${eol}"
    fi

    if test -n "${body_regexp}" ; then
	((chain_nb--))
	eol=$(get-waf-rule-eol ${chain_nb})
	test ${method} != post || echo "SecRule REQUEST_BODY \"${body_regexp}\" \"${eol}"
    fi

    if test -n "${ip_regexp}" ; then
	((chain_nb--))
	eol=$(get-waf-rule-eol ${chain_nb})
	echo "SecRule REMOTE_ADDR \"${ip_regexp}\" \"${eol}"
    fi
}

gen-waf-regexp1()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    local name=${1}
    local ifile=${2}

    local key action methods
    local uri_regexp body_regexp ip_regexp
    local arg1 arg2 arg3 arg4

    local rule_nb=1 ret=0
    local msg="This HTTP method is not allowed"
    local denyurl=$(rweb-get-denyurl "${name}" "${_RWEB_SITE_DENYURL_LIST}")
    denyurl=${denyurl//\"/\\\"}

    echo "# Custom WAF rules for \"${name}\" - Please do not edit this file."

    while read -r arg1 arg2 arg3 arg4
    do
	test -n "${arg1}" || continue
	test "${arg1:0:1}" != "#" || continue

	set -f

	case ${arg1} in
	    rule)
		if test ${rule_nb} -gt ${MAX_WAF_RULES_NB} ; then
		    ret=10
		    break
		fi
		if test -n "${key}" ; then
		    gen-waf-regexp2 "${msg}" ${methods} ${action} "${denyurl}" "${uri_regexp}" "${body_regexp}" "${ip_regexp}"
		    unset key
		fi
		key=${arg2}
		action=${arg3}
		methods=${arg4// }
		msg="Custom rule ${key}: Matched signature %{TX.0} %{REQUEST_URI}"
		unset uri_regexp
		unset body_regexp
		unset ip_regexp
		((rule_nb++))
		;;
	    uri)
		test -n "${uri_regexp}" || uri_regexp=$(format-regexp "${arg2}")
		;;
	    body)
		case ${methods} in
		    post)
			test -n "${body_regexp}" || body_regexp=$(format-regexp "${arg2}")
			;;
		    *)
			;;
		esac
		;;
	    ip)
		test -n "${ip_regexp}" || ip_regexp=$(format-regexp "${arg2}")
		;;
	    *)
		;;
	esac
	set +f
    done < ${ifile}

    test -z "${key}" || gen-waf-regexp2 "${msg}" ${methods} ${action} "${denyurl}" "${uri_regexp}" "${body_regexp}" "${ip_regexp}"

    return ${ret}
}

gen-waf-regexp()
{
    test -n "${1}" || return 1
    local name=${1}

    WAF_CUSTOM_RULE_ID=${WAF_CUSTOM_RULE_ID_INIT}
    log "Compiling custom ${name:0:24} WAF rules"
    local base=${WAF_DIR}

    safe-generate gen-waf-regexp1 ${name} ${base}/${name}.rules ${WEB_WAF_DIR}/${name}.rules
    local ret=${?}
    log-result ${ret}
}

set-custom-waf-rules()
{
    test -n "${1}" || return 1
    local mode=${1}

    local name rule rules
    local base=${WAF_DIR}

    rules=$(ls ${base}/*.rules.current 2> /dev/null)
    for rule in ${rules}
    do
	name=$(file-basename ${rule} .rules.current)
	if test ! -f ${base}/${name}.rules ; then
	    log "Removing ${name:0:24} WAF rules"
	    rm -f ${WEB_WAF_DIR}/${name}.rules*
	    log-result ${?}
	fi
    done

    local ret denyurl current_denyurl
    
    rules=$(ls ${base}/*.rules 2> /dev/null)

    for rule in ${rules}
    do
	name=$(file-basename ${rule} .rules)
	conf-lock-file ${rule}

	if test ${mode} == force ; then
	    gen-waf-regexp ${name}
	    conf-unlock-file ${rule}
	    continue
	fi

	if test -f ${rule}.current ; then
	    diff --brief ${rule} ${rule}.current > /dev/null
	    ret=${?}
	    if test ${ret} -ne 0 ; then
		gen-waf-regexp ${name}
	    else
		denyurl=$(rweb-get-denyurl "${name}" "${_RWEB_SITE_DENYURL_LIST}")
		current_denyurl=$(rweb-get-denyurl "${name}" "${CURRENT_RWEB_SITE_DENYURL_LIST}")

		if test "${denyurl}" != "${current_denyurl}" ; then
		    gen-waf-regexp ${name}
		fi
	    fi
	else
	    gen-waf-regexp ${name}
	fi

	conf-unlock-file ${rule}
    done

    return 0
}

gen-waf-rules-rweb()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    local name=${1}
    local waf_rules=${2}
    local denyurl=${3}

    local application=$(get-rweb-waf-application-type ${name} new)

    gen-waf-setup-rules ${application} "denyurl:${denyurl}" "${WAF_DOS_LIMIT}"
    gen-waf-request-rules ${waf_rules}

    gen-waf-response-rules ${waf_rules} ${#WAF_REQUEST_CONF_FILES[@]}
    echo "include ${WEB_SERVER_DIR}/etc/rules/RESPONSE-980-CORRELATION.conf"

    gen-waf-rweb-bypass-rules ${name}
    gen-waf-final-rules "${denyurl}"
}

gen-av-waf-rules()
{
    local denyurl=${1}

    test ${AV_MODE} == True || return 0
    local severity=1 action
    if test -n "${denyurl}" ; then
	action="redirect:${denyurl},status:302"
    else
	action="deny,status:403"
    fi

    local id=${WAF_RULE_ID} ; ((WAF_RULE_ID++))
    echo "SecRule FILES_TMPNAMES \"@inspectFile /bin/avscan\" \"phase:2,log,${action},severity:${severity},id:${id},capture,msg:'Malware file injection detected.',t:none,t:replaceNulls,t:compressWhitespace\""

}

gen-waf-log()
{
    test ${LOG_MODE} == True -a ${LOG_TYPE_WAF/:*} == True || return 0

    echo "LogLevel error"
    echo "ErrorLogFormat \"%{REAL_CLIENT_IP}e %M\""
    echo "ErrorLog syslog:local4"
}

gen-tranform-rule()
{
    local id=${WAF_RULE_ID} ; ((WAF_RULE_ID++))
    echo "SecRule ARGS \"^.*$\" \"id:${id},t:none,t:lowercase,t:replaceNulls,t:compressWhitespace,nolog,pass\""
}

gen-waf-custom-rweb-rules()
{
    test -n "${1}" || return 1
    local name=${1}
    
    gen-tranform-rule

    if test -f ${WEB_WAF_DIR}/${name}.rules.new -o -f ${WEB_WAF_DIR}/${name}.rules ; then
	local len=${#WEB_SERVER_DIR}
	local dir=${WEB_WAF_DIR:${len}}

	echo "include ${dir:1}/${name}.rules"
    fi
}

gen-waf-rweb-bypass-rules()
{
    test -n "${1}" || return 1
    local in_name=${1}

    local i=0 elt range
    local name ids id

    for elt in ${_WAF_RWEB_BYPASS_RULE_LIST}
    do
	range=$[${i} % 2]
	case ${range} in
	    0)
		name=${elt}
		;;
	    1)
		ids=${elt}
		if test ${name} == ${in_name} ; then
		    ! check-expr-ip ${in_name} ids="920350:${ids}"
		    echo "SecRuleRemoveById ${ids//:/ }"
		    return 0
		fi
		;;
	    *)
		return 1
		;;
	esac
	((i++))
    done
}

gen-generic-rules()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    test -n "${3}" || return 3
    local waf_num_arg=${1}
    local waf_files_size=${2}
    local waf_dos_limit=${3}
    local denyurl=${4}

    gen-waf-setup-rules ${TECHNICAL_NAME} "denyurl:${denyurl}" "${waf_dos_limit}" ${waf_num_arg} ${waf_files_size}
    gen-waf-request-rules ${WAF_GENERIC_RULE_STATES}
    gen-waf-response-rules ${WAF_GENERIC_RULE_STATES} ${#WAF_REQUEST_CONF_FILES[@]}

    echo "SecRuleRemoveById 920350"
}

gen-waf-rules()
{
    test -n "${1}" || return 1
    local in_type=${1}

    local waf_dos_limit

    case ${in_type} in
	"${WADMIN_NAME}")
	    waf_dos_limit="1000 60 300"
	    local conf_file_sz=$[64 * 1024]

	    if test ${APL_ROLE} == 'manager' ; then
		local manager_factor=$[${MANAGER_TEMPLATE_NB} + ${MANAGER_GATEWAY_NB}]
		((conf_file_sz *= manager_factor))
	    fi

	    gen-generic-rules $[32 * 256] ${conf_file_sz} "${waf_dos_limit}" "/${GUI_DIR_NAME}/${GUI_HOME_PAGE}.apl?not-found"
	    echo "SecRuleRemoveById 950109"
	    gen-tranform-rule
	    echo "include ${GUI_DIR}/etc/${in_type}.rules"
	    ;;
	"${WAUDIT_NAME}")
	    waf_dos_limit="500 60 300"
	    gen-generic-rules 16 0 "${waf_dos_limit}" "/${GUI_DIR_NAME}/${GUI_HOME_PAGE}.apl?not-found"
	    gen-tranform-rule
	    echo "include ${WEB_SERVER_DIR}/etc/${in_type}.rules"
	    ;;
	webserver)
	    waf_dos_limit="1000 60 600"
	    gen-generic-rules 8 0 "${waf_dos_limit}"
	    gen-tranform-rule
	    echo "include ${WEB_SERVER_DIR}/etc/${in_type}.rules"
	    ;;
        rweb)
	    test -n "${2}" || return 2
	    test -n "${3}" || return 3
	    local in_name=${2}
	    local in_waf_rules=${3}
	    local in_denyurl=${4}

	    gen-waf-rules-rweb ${in_name} ${in_waf_rules} "${in_denyurl}"
	    gen-av-waf-rules "${in_denyurl}"
	    gen-waf-log
	    ;;
	*)
	    ;;
    esac
}

commit-waf-rweb-rules()
{
    local new rule rweb base
    local news=$(ls ${WEB_WAF_DIR}/*.rules.new 2> /dev/null)

    for new in ${news}
    do
	base=$(file-basename ${new} .new)
	mv -f ${new} ${WEB_WAF_DIR}/${base}
    done

    local rules=$(ls ${WEB_WAF_DIR}/*.rules 2> /dev/null)
    for rule in ${rules}
    do
	rweb=$(file-basename ${rule} .rules)
	member "${RWEB_SITE_NAME_LIST}" ${rweb} || \
	    rm -f \
	       ${rule} \
	       ${WAF_DIR}/${rweb}.rules \
	       ${WAF_DIR}/${rweb}.rules.current
    done

    rm -f ${WEB_WAF_DIR}/*.rules.old
}

restore-waf-rweb-rules()
{
    local old base
    local olds=$(ls ${WEB_WAF_DIR}/*.rules.old 2> /dev/null)

    for old in ${olds}
    do
	base=$(file-basename ${old} .old)
	cp -f ${old} ${WEB_WAF_DIR}/${base}
    done
}

