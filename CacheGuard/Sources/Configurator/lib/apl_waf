gen-waf-allow-from-local()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    local name=${1}
    local ip=${2}

    local id=${WAF_RULE_ID} ; ((WAF_RULE_ID++))

    ip=${ip//./\\.}

    echo "SecRule REQUEST_METHOD \"^GET$\" \"msg:'Internal Web proxy request: Matched signature %{TX.0} %{REQUEST_URI}',id:${id},nolog,capture,severity:5,allow,chain\""
    echo "SecRule REQUEST_URI \"^/squid-internal-dynamic/netdb$\" \"chain\""
    echo "SecRule REMOTE_ADDR \"^${ip}$\" \"t:none\""
}

