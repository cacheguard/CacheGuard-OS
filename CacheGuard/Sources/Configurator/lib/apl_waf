gen-waf-setup-rules()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    test -n "${3}" || return 3
    local in_app=${1}
    local in_denyurl=${2}
    local waf_dos_limit=${3}
    local in_num_arg=${4}
    local in_files_size=${5}

    local app state anomaly req_content extension header charset rbl_value rbl value
    local ms_waf_no_scoring_level ms_scores ms_req_contents ms_assertions ms_methods ms_anomalies ms_dev_extensions ms_denied_headers ms_static_extensions ms_charsets ms_reputation_rbl ms_dos ms_collection_timeout

    ### Values to Tune ####

    local url_encoded=0
    local apps='cpanel drupal dokuwiki nextcloud wordpress xenforo'
    local anomalies='critical=5 error=4 warning=3 notice=2'

    local req_contents="application/x-www-form-urlencoded
			multipart/form-data
	    		multipart/related\
	    		text/xml
	    		application/xml
	    		application/soap+xml
	    		application/x-amf
	    		application/json
	    		application/cloudevents+json
	    		application/cloudevents-batch+json
	    		application/octet-stream
	    		application/csp-report
	    		application/xss-auditor-report
	    		text/plain"

    local httpv="HTTP/1.0 HTTP/1.1 HTTP/2 HTTP/2.0"

    local dev_extensions="asa asax ascx axd backup bak bat cdx cer cfg cmd com config conf cs csproj csr dat db dbf dll dos htr htw ida idc idq inc ini key licx lnk log mdb old pass pdb pol printer pwd rdb resources resx sql swp sys vb vbs vbproj vsdisco webinfo xsd xsx"

    local static_extensions="jpg jpeg png gif js css ico svg webp"
    local denied_headers="proxy lock-token content-range if"
    local charsets="utf-8 iso-8859-1 iso-8859-15 windows-1252"

    local dos_counter=${waf_dos_limit/ *}
    local dos_slice=${waf_dos_limit#* } ; dos_slice=${dos_slice/ *}
    local dos_timeout=${waf_dos_limit/* }
    local reputation_timeout=${dos_timeout}

    if test ${in_app} == ${TECHNICAL_NAME} ; then
	local waf_response_body=512
	local waf_request_body_files=$[128 * 1024]
	local waf_request_body_no_files=$[128 * 1024]
	local waf_num_arg=${in_num_arg}
	local waf_arg_name_length=128
	local waf_arg_length=1024
	local waf_total_arg_length=$[${waf_num_arg} + (${waf_arg_length} + ${waf_arg_name_length}) * ${waf_num_arg}]
	local waf_files_size=${in_files_size}
	local waf_combined_files_sizes=${waf_files_size}

	local denyurl=${in_denyurl/*:}

	if test -n "${denyurl}" ; then
	    echo "<If \"-U '${denyurl}'\">"
	    echo "ErrorDocument 403 ${denyurl}"
	    echo "</If>"
	fi

	echo "SecDefaultAction \"phase:1,log,auditlog,deny,status:403\""
	echo "SecDefaultAction \"phase:2,log,auditlog,deny,status:403\""
    else
	local waf_response_body=$(min-value ${WAF_RESPONSE_BODY} $[1024 * 1024])
	local waf_request_body_files=$(min-value $[${MAX_UPLOAD_FILE_SZ} + ${WAF_REQUEST_BODY}] $[1024 * 1024])
	local waf_request_body_no_files=$(min-value ${WAF_REQUEST_BODY} $[1024 * 1024])
	local waf_num_arg=${WAF_NUM_ARG}
	local waf_arg_name_length=${WAF_ARG_NAME_LENGTH}
	local waf_arg_length=${WAF_ARG_LENGTH}
	local waf_total_arg_length=${WAF_TOTAL_ARG_LENGTH}
	local waf_files_size=$[${WAF_FILES_SIZE} * 1024]
	local waf_combined_files_sizes=$[${waf_files_size} * 5]

	echo "SecDefaultAction \"phase:1,log,auditlog,pass\""
	echo "SecDefaultAction \"phase:2,log,auditlog,pass\""
    fi

    local sampling_pct=100
    local utf8_encoding=0
    local reputation_block=1

    ### Automatic Values ####

    ms_waf_no_scoring_level=$(max-value ${WAF_NO_SCORING_LEVEL} ${WAF_LEVEL})

    for app in ${apps}
    do
	if test ${app} == "${in_app}" ; then
	    state=1
	else
	    state=0
	fi
	ms_assertions="${ms_assertions},setvar:tx.crs_exclusions_${app}=${state}"
    done

    if test ${WAF_IMETHODS} == deny ; then
	ms_methods="GET HEAD POST OPTIONS"
    else
	ms_methods="GET HEAD POST OPTIONS PUT PATCH DELETE CONNECT TRACE"
    fi

    ms_scores="setvar:tx.inbound_anomaly_score_threshold=${WAF_REQUEST_SCORE},setvar:tx.outbound_anomaly_score_threshold=${WAF_RESPONSE_SCORE}"

    for anomaly in ${anomalies}	
    do
	ms_anomalies="${ms_anomalies},setvar:tx.${anomaly/=*}_anomaly_score=${anomaly/*=}"
    done
    ms_anomalies=${ms_anomalies:1}

    for req_content in ${req_contents}
    do
	ms_req_contents="${ms_req_contents} |${req_content}|"
    done
    ms_req_contents=${ms_req_contents:1}


    for extension in ${dev_extensions}
    do
	ms_dev_extensions="${ms_dev_extensions} .${extension}/"
    done
    dev_extensions=${dev_extensions:1}

    for header in ${denied_headers}
    do
	ms_denied_headers="${ms_denied_headers} /${header}/"
    done
    ms_denied_headers=${ms_denied_headers:1}

    for extension in ${static_extensions}
    do
	ms_static_extensions="${ms_static_extensions} /.${extension}/"
    done
    ms_static_extensions=${ms_static_extensions:1}

    for charset in ${charsets}
    do
	ms_charsets="${ms_charsets}|${charset}"
    done
    ms_charsets=${ms_charsets:1}

    for rbl_value in ${WAF_REPUTATION_RBL}
    do
	rbl=${rbl_value/:*}
	value=${rbl_value/*:}
	ms_reputation_rbl="${ms_reputation_rbl},setvar:tx.block_${rbl}_ip=${value}"
    done
    ms_reputation_rbl=${ms_reputation_rbl:1}

    ms_dos="tx.dos_burst_time_slice=${dos_slice}',setvar:'tx.dos_counter_threshold=${dos_counter}',setvar:'tx.dos_block_timeout=${dos_timeout}"
    ms_collection_timeout=$(max-value ${reputation_timeout} ${dos_timeout})

    ### Automatic Generation ####

    echo "SecResponseBodyLimit $[${waf_response_body} * 1024]"
    echo "SecRequestBodyLimit $[${waf_request_body_files} * 1024]"
    echo "SecRequestBodyNoFilesLimit $[${waf_request_body_no_files} * 1024]"

    echo "SecAction \"id:900000,phase:1,nolog,pass,t:none,setvar:tx.paranoia_level=${WAF_LEVEL}\""
    echo "SecAction \"id:900001,phase:1,nolog,pass,t:none,setvar:tx.executing_paranoia_level=${ms_waf_no_scoring_level}\""
    echo "SecAction \"id:900010,phase:1,nolog,pass,t:none,setvar:tx.enforce_bodyproc_urlencoded=${url_encoded}\""
    echo "SecAction \"id:900100,phase:1,nolog,pass,t:none,${ms_anomalies}\""
    echo "SecAction \"id:900110,phase:1,nolog,pass,t:none,${ms_scores}\""
    echo "SecAction \"id:900130,phase:1,nolog,pass,t:none${ms_assertions}\""
    echo "SecAction \"id:900200,phase:1,nolog,pass,t:none,setvar:'tx.allowed_methods=${ms_methods}'\""
    echo "SecAction \"id:900220,phase:1,nolog,pass,t:none,setvar:'tx.allowed_request_content_type=${ms_req_contents}'\""
    echo "SecAction \"id:900230,phase:1,nolog,pass,t:none,setvar:'tx.allowed_http_versions=${httpv}'\""
    echo "SecAction \"id:900240,phase:1,nolog,pass,t:none,setvar:'tx.restricted_extensions=${ms_dev_extensions}'\""
    echo "SecAction \"id:900250,phase:1,nolog,pass,t:none,setvar:'tx.restricted_denied_headers=${ms_denied_headers}'\""
    echo "SecAction \"id:900260,phase:1,nolog,pass,t:none,setvar:'tx.static_extensions=${ms_static_extensions}'\""
    echo "SecAction \"id:900280,phase:1,nolog,pass,t:none,setvar:'tx.allowed_request_content_type_charset=${ms_charsets}'"

    echo "SecAction \"id:900300,phase:1,nolog,pass,t:none,setvar:tx.max_num_args=${waf_num_arg}\""
    echo "SecAction \"id:900310,phase:1,nolog,pass,t:none,setvar:tx.arg_name_length=${waf_arg_name_length}\""
    echo "SecAction \"id:900320,phase:1,nolog,pass,t:none,setvar:tx.arg_length=${waf_arg_length}\""
    echo "SecAction \"id:900330,phase:1,nolog,pass,t:none,setvar:tx.total_arg_length=${waf_total_arg_length}\""
    echo "SecAction \"id:900340,phase:1,nolog,pass,t:none,setvar:tx.max_file_size=${waf_files_size}\""
    echo "SecAction \"id:900350,phase:1,nolog,pass,t:none,setvar:tx.combined_file_sizes=${waf_combined_files_sizes}\""

    echo "SecAction \"id:900400,phase:1,pass,nolog,setvar:tx.sampling_percentage=${sampling_pct}\""

    local rbl_key=$(decrypt-password "${WAF_REPUTATION_RBL_KEY}" "${WAF_REPUTATION_RBL_PASSWD}")

    if test -n "${rbl_key}" ; then
	echo "SecHttpBlKey ${rbl_key}"
	echo "SecAction \"id:900500,phase:1,nolog,pass,t:none,${ms_reputation_rbl}\""
    fi

    local waf_reputation_countries=$(sqlite3 ${USERENV_DIR}/${CONFIGURATION_DB_NAME} \
					     "SELECT country FROM waf_reputation_country WHERE reputation = TRUE;")
    echo "SecAction \"id:900600,phase:1,nolog,pass,t:none,setvar:'tx.high_risk_country_codes=$(echo ${waf_reputation_countries^^})'\""

    echo "SecAction \"id:900700,phase:1,nolog,pass,t:none,setvar:'${ms_dos}'\""
    echo "SecAction \"id:900950,phase:1,nolog,pass,t:none,setvar:tx.crs_validate_utf8_encoding=${utf8_encoding}\""
    echo "SecAction \"id:900960,phase:1,nolog,pass,t:none,setvar:tx.do_reput_block=${reputation_block}\""
    echo "SecAction \"id:900970,phase:1,nolog,pass,t:none,setvar:tx.reput_block_duration=${reputation_timeout}\""

    echo "SecCollectionTimeout ${ms_collection_timeout}"

    echo "SecAction \"id:900990,phase:1,nolog,pass,t:none,setvar:tx.crs_setup_version=332\""

    echo "include ${WEB_SERVER_DIR}/etc/modsecurity-common.rules"

    echo "include ${WEB_SERVER_DIR}/etc/rules/REQUEST-901-INITIALIZATION.conf"
    echo "include ${WEB_SERVER_DIR}/etc/rules/REQUEST-903.9001-DRUPAL-EXCLUSION-RULES.conf"
    echo "include ${WEB_SERVER_DIR}/etc/rules/REQUEST-903.9002-WORDPRESS-EXCLUSION-RULES.conf"
    echo "include ${WEB_SERVER_DIR}/etc/rules/REQUEST-903.9003-NEXTCLOUD-EXCLUSION-RULES.conf"
    echo "include ${WEB_SERVER_DIR}/etc/rules/REQUEST-903.9004-DOKUWIKI-EXCLUSION-RULES.conf"
    echo "include ${WEB_SERVER_DIR}/etc/rules/REQUEST-903.9005-CPANEL-EXCLUSION-RULES.conf"
    echo "include ${WEB_SERVER_DIR}/etc/rules/REQUEST-903.9006-XENFORO-EXCLUSION-RULES.conf"
    echo "include ${WEB_SERVER_DIR}/etc/rules/REQUEST-905-COMMON-EXCEPTIONS.conf"
    echo "include ${WEB_SERVER_DIR}/etc/rules/REQUEST-910-IP-REPUTATION.conf"
    echo "include ${WEB_SERVER_DIR}/etc/rules/REQUEST-911-METHOD-ENFORCEMENT.conf"
    echo "include ${WEB_SERVER_DIR}/etc/rules/REQUEST-912-DOS-PROTECTION.conf"
    echo "include ${WEB_SERVER_DIR}/etc/rules/REQUEST-913-SCANNER-DETECTION.conf"
    echo "include ${WEB_SERVER_DIR}/etc/rules/REQUEST-920-PROTOCOL-ENFORCEMENT.conf"
    echo "include ${WEB_SERVER_DIR}/etc/rules/REQUEST-921-PROTOCOL-ATTACK.conf"
    echo "include ${WEB_SERVER_DIR}/etc/rules/REQUEST-922-MULTIPART-ATTACK.conf"
}

gen-waf-request-rules()
{
    test -n "${1}" || return 1
    local flags=${1}

    local len_req=${#WAF_REQUEST_CONF_FILES[@]}
    for ((i=0; i<len_req; i++))
    do
	flag=${flags:${i}:1}
	test ${flag} -eq 0 || echo "include ${WEB_SERVER_DIR}/etc/rules/${WAF_REQUEST_CONF_FILES[${i}]}.conf"
    done

    echo "include ${WEB_SERVER_DIR}/etc/rules/REQUEST-949-BLOCKING-EVALUATION.conf"
}

gen-waf-response-rules()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    local flags=${1}
    local len_req=${2}

    echo "include ${WEB_SERVER_DIR}/etc/rules/RESPONSE-950-DATA-LEAKAGES.conf"

    local i j flag
    local len_rsp=${#WAF_RESPONSE_CONF_FILES[@]}
    for ((i=0; i<len_rsp; i++))
    do
	((j = i + len_req))
	flag=${flags:${j}:1}
	test ${flag} -eq 0 || echo "include ${WEB_SERVER_DIR}/etc/rules/${WAF_RESPONSE_CONF_FILES[${i}]}.conf"
    done

    echo "include ${WEB_SERVER_DIR}/etc/rules/RESPONSE-959-BLOCKING-EVALUATION.conf"
}

gen-waf-final-rules()
{
    local denyurl=${1}

    local rule action rules="949110 959100"

    if test -n "${denyurl}" ; then
	action="t:none,redirect:'${denyurl}'"
    else
	action="t:none,deny,status:403"
    fi

    for rule in ${rules}
    do
	echo "SecRuleUpdateActionById ${rule} \"${action}\""
    done
}

get-generic-waf-rules()
{
    test -n "${1}" || return 1
    local in_name=${1}

    local i=0 elt range
    local name waf_rules

    for elt in ${_WAF_RWEB_GENERIC}
    do
	range=$[${i} % 2]
	case ${range} in
	    0)
		name=${elt}
		;;
	    1)
		waf_rules=${elt}
		if test ${name} == ${in_name} ; then
		    echo ${waf_rules}
		    return 0
		fi
		;;
	    *)
		echo
		return 1
		;;
	esac
	((i++))
    done
    
    echo ${WAF_GENERIC}
}

