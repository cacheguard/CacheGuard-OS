echo-firewall-destination-ip-mask()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    local ip=${1}
    local mk=${2}

    test ${ip} != 0.0.0.0 -o ${mk} != 0.0.0.0 || return 0

    echo " -d ${ip}/${mk}"
}

echo-firewall-source-ip-mask()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    local ip=${1}
    local mk=${2}

    test ${ip} != 0.0.0.0 -o ${mk} != 0.0.0.0 || return 0

    echo " -s ${ip}/${mk}"
}

echo-firewall-destination-ip()
{
    test -n "${1}" || return 1
    local ip=${1}

    test ${ip} != 0.0.0.0 || return 0

    echo " -d ${ip}"
}

echo-firewall-source-ip()
{
    test -n "${1}" || return 1
    local ip=${1}

    test ${ip} != 0.0.0.0 || return 0

    echo " -s ${ip}"
}

