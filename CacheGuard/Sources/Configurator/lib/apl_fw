    fi

    if test ${ADMIN_SNMP} == True ; then
	if test ${ADMIN_INTERNAL} == True ; then
	    test ${SNMP_TCP} == False || gen-iptables-filter-input-flood-dev ${IF_ADMIN} ${IP_ADMIN_IP} ${SNMP_PORT} FLOODMGT
	    test ${SNMP_TLS} == False || gen-iptables-filter-input-flood-dev ${IF_ADMIN} ${IP_ADMIN_IP} ${SNMP_TLS_PORT} FLOODMGT
