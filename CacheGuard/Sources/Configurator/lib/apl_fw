	gen-iptables-filter-input-output-multicast-vrrp-1 ${IF_LOGICAL_EXTERNAL} ${IP_EXTERNAL_IP} ${IP_EXTERNAL_NET} ${IP_EXTERNAL_MASK}

    test -z "${AUXILIARY_IS_ACTIVE}" -o -z "${VRRP_AUXILIARY_IP_LIST}" || \
	gen-iptables-filter-input-output-multicast-vrrp-1 ${IF_AUXILIARY} ${IP_AUXILIARY_IP} ${IP_AUXILIARY_NET} ${IP_AUXILIARY_MASK}

    if test ${VLAN_MODE} == False ; then
