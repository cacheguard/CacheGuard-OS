	    gen-iptables-filter-input-output-multicast-vrrp-1 ${IF_INTERNAL} ${IP_INTERNAL_IP} ${IP_INTERNAL_NET} ${IP_INTERNAL_MASK}
    else
	local interfaces

	if test ${WEB_MODE} == True ; then
	    test -z "${VRRP_WEB_LIST}" || \
		gen-iptables-filter-input-output-multicast-vrrp-1 ${IF_WEB} ${IP_WEB_IP} ${IP_WEB_NET} ${IP_WEB_MASK}
	    interfaces="${IF_WEB}"
