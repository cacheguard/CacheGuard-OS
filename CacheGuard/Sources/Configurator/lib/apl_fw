    echo "[0:0] -A POSTROUTING ${FW_IPSEC_POLICY_OUT} -p tcp -m tcp --tcp-flags SYN,RST SYN -m tcpmss --mss ${mss_range_min_sz}:${mss_range_max_sz} -j TCPMSS --set-mss ${mss_max_sz}"
}

