	    echo "[0:0] -A OUTPUT -o ${IF_LOGICAL_EXTERNAL} -p tcp -m state --state ESTABLISHED -s ${ip} --sport ${WWW_PORT} -j ACCEPT"
	done
	
	for ip in ${RWEB_HTTPS_IP_LIST}
	do
	    echo
	    echo "# Incoming HTTPS rweb access to ${IF_LOGICAL_EXTERNAL}:${ip}:"
	    echo "[0:0] -A INPUT -i ${IF_LOGICAL_EXTERNAL} -p tcp -m state --state NEW,ESTABLISHED -d ${ip} --dport ${HTTPS_PORT} -j ACCEPT"
	    echo "[0:0] -A OUTPUT -o ${IF_LOGICAL_EXTERNAL} -p tcp -m state --state ESTABLISHED -s ${ip} --sport ${HTTPS_PORT} -j ACCEPT"
	done
    fi

    if test ${WEB_MODE} == True -o ${TRANSPARENT_MODE} == True ; then
	gen-iptables-filter-input-output-ftp any
	test ${VPN_IPSEC_MODE} == False || gen-iptables-filter-input-output-ftp ipsec

	echo
	echo "# Outgoing TCP access from the appliance to safe ports ${SAFE_PORTS}:"
	echo "[0:0] -A OUTPUT -p tcp -m state --state NEW,ESTABLISHED --sport 1024:65535 -m multiport --dports ${SAFE_PORTS} -j ACCEPT"
	echo "[0:0] -A INPUT -p tcp -m state --state ESTABLISHED --dport 1024:65535 -m multiport --sports ${SAFE_PORTS} -j ACCEPT"

	if test ${VPN_IPSEC_MODE} == True ; then
	    echo "[0:0] -A OUTPUT ${FW_IPSEC_POLICY_OUT} -p tcp -m state --state NEW,ESTABLISHED --sport 1024:65535 -m multiport --dports ${SAFE_PORTS} -j ACCEPT"
	    echo "[0:0] -A INPUT ${FW_IPSEC_POLICY_IN} -p tcp -m state --state ESTABLISHED --dport 1024:65535 -m multiport --sports ${SAFE_PORTS} -j ACCEPT"
	fi
    fi

    for elt in ${PEER_NEXT_LIST}
    do
	range=$[${i} % 3]
	case ${range} in
	    0)
		ip=${elt}
		;;
	    1)
		port=${elt}
		;;
	    2)
		echo
		echo "# Outgoing access from ${IF_LOGICAL_EXTERNAL}:${IP_EXTERNAL_IP} to next peer ${ip}:${port}:"
		echo "[0:0] -A OUTPUT -o ${IF_LOGICAL_EXTERNAL} -p tcp -m state --state NEW,ESTABLISHED -s ${IP_EXTERNAL_IP} --sport 1024:65535 -d ${ip} --dport ${port} -j ACCEPT"
		echo "[0:0] -A INPUT -i ${IF_LOGICAL_EXTERNAL} -p tcp -m state --state ESTABLISHED -s ${ip} --sport ${port} -d ${IP_EXTERNAL_IP} --dport 1024:65535 -j ACCEPT"
		qos=${elt}
		;;
	    *)
		;;
	esac
	((i++))
    done
}

