    local out_list out_vias

    for elt in ${CURRENT_VPN_IPSEC_VIA_LIST}
    do
	range=$[${i} % 3]
	case ${range} in
	    0)
		ipsec_type=${elt}
		;;
	    1)
		vpn_id=${elt}
		;;
	    2)
		vias=$(colon2space ${elt})
		unset out_vias
		for via in ${vias}
