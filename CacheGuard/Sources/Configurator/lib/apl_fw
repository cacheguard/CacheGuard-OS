	return 0
    fi

    local elt range i=0
    local ip port

    echo "[0:0] -A OUTPUT -p tcp -m state --state NEW,ESTABLISHED --sport 1024:65535 -m multiport --dports ${WEB_PORTS} -j ACCEPT"
    echo "[0:0] -A INPUT -p tcp -m state --state ESTABLISHED --dport 1024:65535 -m multiport --sports ${WEB_PORTS} -j ACCEPT"

    if test ${VPN_IPSEC_MODE} == True ; then
	echo "[0:0] -A OUTPUT ${FW_IPSEC_POLICY_OUT} -p tcp -m state --state NEW,ESTABLISHED --sport 1024:65535 -m multiport --dports ${WEB_PORTS} -j ACCEPT"
	echo "[0:0] -A INPUT ${FW_IPSEC_POLICY_IN} -p tcp -m state --state ESTABLISHED --dport 1024:65535 -m multiport --sports ${WEB_PORTS} -j ACCEPT"
    fi

    if test ${RWEB_MODE} == True ; then
