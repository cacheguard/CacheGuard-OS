	echo "[0:0] -A TPROXY_SNAT -o ${IF_LOGICAL_EXTERNAL} -j SNAT --to-source ${IP_EXTERNAL_IP}"
	echo "[0:0] -A POSTROUTING -o ${IF_LOGICAL_EXTERNAL} -j TPROXY_SNAT"
    fi
}

