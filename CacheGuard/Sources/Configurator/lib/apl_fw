    test -n "${4}" || return 4
    local dev=${1}
    local ip=${2}
    local port=${3}
    local chain=${4}

    gen-iptables-filter-input-flood-1 "${dev}" ${ip} ${port} ${chain}
}

gen-iptables-filter-input-flood-ip()
