    test ${VPN_IPSEC_MODE} == True || return 0
    test ${VPN_IPSEC_ACCESS_MODE} == False || return 0

    test -n "${1}" || return 0
    local vpn_ipsec_site_ip_list=${1}

    local elt range i=0
    local id ips
    local src_ip dst_ip

    for elt in ${vpn_ipsec_site_ip_list}
    do
	range=$[${i} % 4]
	case ${range} in
	    0)
		id=${elt}
		;;
	    1)
		ips=${elt}
		;;
	    2)
		;;
	    3)
		ips=${ips//,/ }

		for ip in ${ips}
		do
		    src_ip=$(echo-firewall-source-ip ${ip})
		    dst_ip=$(echo-firewall-destination-ip ${ip})

		    echo
		    echo "# UDP encapsulatd IPsec traffic for the '${id}' VPN site on the the ${IF_LOGICAL_EXTERNAL}:"
		    echo "[0:0] -A INPUT -i ${IF_LOGICAL_EXTERNAL} -p udp${src_ip} -m multiport --dports ${ISAKMP_PORT},${NATT_PORT} -m conntrack --ctstate NEW,ESTABLISHED -j ACCEPT"
		    echo "[0:0] -A OUTPUT -o ${IF_LOGICAL_EXTERNAL} -p udp${dst_ip} -m multiport --sports ${ISAKMP_PORT},${NATT_PORT} -m conntrack --ctstate NEW,ESTABLISHED -j ACCEPT"
		done
		;;
	    *)
		;;
	esac
	((i++))
    done
}

