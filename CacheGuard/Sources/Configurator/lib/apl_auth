	echo "TLS_CACERT ${LDAP_DIR}/${LDAP_CA}"
    else
	echo "TLS_REQCERT never"
	echo "TLS_REQSAN never"
    fi
}

set-file-server-passwd()
{
    test "${FILE_SERVER_PASSWORD_LIST}" != "${CURRENT_FILE_SERVER_PASSWORD_LIST}" || return 0

    local base=${BASE_DIR}/${ACCOUNT}

    log "Updating file servers password list"

    if test -z "${FILE_SERVER_PASSWORD_LIST}" ; then
	rm -f ${base}/.netrc.ftp
	rm -f ${base}/.netrc.sftp
	log-result 0
	return 0
    fi

    local protocol server login password
    local elt i=0 range

    local tmp_ftp_file=/tmp/.netrc.ftp.${$}
    local tmp_sftp_file=/tmp/.netrc.sftp.${$}
    rm -f ${tmp_ftp_file} ${tmp_sftp_file}

    for elt in ${FILE_SERVER_PASSWORD_LIST}
    do
	range=$[${i} % 4]
	case ${range} in
	    0)
		protocol=${elt}
		;;
	    1)
		server=${elt}
		;;
	    2)
		login=${elt}
		;;
	    3)
		password=${elt}

		case ${protocol} in
		    ftp)
			echo "machine ${server} login ${login} password ${password}" >> ${tmp_ftp_file}
			;;
		    sftp)
			echo "machine ${server} login ${login} password ${password}" >> ${tmp_sftp_file}
			;;
		    *)
			;;
		esac
		;;
	    *)
		log-result 11
		return 11
		;;
	esac
	((i++))
    done

    local ret=0

    if test -f ${tmp_ftp_file} ; then
	install -m 640 -o ${ACCOUNT} -g ${GROUP_NAME} ${tmp_ftp_file} ${base}/.netrc.ftp &&
	rm -f ${tmp_ftp_file}
	ret=$[${ret} + ${?}]
    fi

    if test -f ${tmp_sftp_file} ; then
	install -m 640 -o ${ACCOUNT} -g ${GROUP_NAME} ${tmp_sftp_file} ${base}/.netrc.sftp
	rm -f ${tmp_sftp_file}
    fi

    log-result ${ret}
    return ${ret}
}

get-file-server-credentials()
{
    test -n "${1}" || return 11
    test -n "${2}" || return 12
    test -n "${3}" || return 13
    local state=${1}
    local in_protocol=${2}
    local in_server=${3}

    case ${state} in
	new)
	    local file_server_password_list=${FILE_SERVER_PASSWORD_LIST}
	    ;;
	cur)
	    local file_server_password_list=${CURRENT_FILE_SERVER_PASSWORD_LIST}
	    ;;
	*)
	    return 4
	    ;;
    esac

    local protocol server login password
    local elt i=0 range

    for elt in ${file_server_password_list}
    do
	range=$[${i} % 4]
	case ${range} in
	    0)
		protocol=${elt}
		;;
	    1)
		server=${elt}
		;;
	    2)
		login=${elt}
		;;
	    3)
		password=${elt}

		if test ${protocol} == ${in_protocol} -a ${server} == ${in_server} ; then
		    echo -n "${login} ${password}"
		    break
		fi
		;;
	    *)
		return 15
		;;
	esac
	((i++))
    done

    test "${protocol}" == ${in_protocol} -a "${server}" == ${in_server}
}

gen-kerberos-conf()
{
    test -n "${1}" || return 1
    local location=${1}

    local keytab_file dc
    local realm=${DOMAIN_NAME^^}

    case ${location} in
	global)
	    keytab_file=${PROXY_DIR}${KERBEROS_KEYTAB_FILE_PROXY1}
	    ;;
	proxy)
	    keytab_file=${KERBEROS_KEYTAB_FILE_PROXY1}
	    ;;
	web)
	    keytab_file=${KERBEROS_KEYTAB_FILE_PROXY2}
	    ;;
	*)
	    return 11
	    ;;
    esac

    echo "[libdefaults]"
    echo "default_realm = ${realm}"
    echo "dns_lookup_kdc = no"
    echo "dns_lookup_realm = no"
    echo "rdns = no"
    echo "ticket_lifetime = 24h"
    echo "default_keytab_name = ${keytab_file}"

    case ${KERBEROS_ENCRYPT_TYPE} in
	des)
	    echo "default_tgs_enctypes = rc4-hmac des-cbc-crc des-cbc-md5"
	    echo "default_tkt_enctypes = rc4-hmac des-cbc-crc des-cbc-md5"
	    echo "permitted_enctypes = rc4-hmac des-cbc-crc des-cbc-md5"
	    ;;
	aes)
	    echo "default_tgs_enctypes = aes256-cts-hmac-sha1-96 rc4-hmac des-cbc-crc des-cbc-md5"
	    echo "default_tkt_enctypes = aes256-cts-hmac-sha1-96 rc4-hmac des-cbc-crc des-cbc-md5"
	    echo "permitted_enctypes = aes256-cts-hmac-sha1-96 rc4-hmac des-cbc-crc des-cbc-md5"
	    ;;
	*)
	    ;;
    esac

    echo

    echo "[realms]"
    echo "${realm} = {"

    for dc in ${KERBEROS_SERVER_LIST}
    do
	echo "kdc = ${dc}"
    done

    echo "admin_server = ${KERBEROS_SERVER_LIST/ *}"
    echo "default_domain = ${DOMAIN_NAME}"
    echo "}"

    echo

    echo "[domain_realm]"
    echo ".${DOMAIN_NAME} = ${realm}"
    echo "${DOMAIN_NAME} = ${realm}"
}

LIB_APL_AUTH=Yes
