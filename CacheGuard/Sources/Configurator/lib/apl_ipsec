set-ipsec-parameters-site()
{
    test -n "${1}" || return 1
    local state=${1}

    case ${state} in
	new)
	    test ${VPN_IPSEC_MODE} == True -a ${VPN_IPSEC_ACCESS_MODE} == False || return 0
	    local vpn_ipsec_site_list=${VPN_IPSEC_SITE_LIST}
	    ;;
	cur)
	    test ${CURRENT_VPN_IPSEC_MODE} == True -a ${CURRENT_VPN_IPSEC_ACCESS_MODE} == False || return 0
	    local vpn_ipsec_site_list=${CURRENT_VPN_IPSEC_SITE_LIST}
	    ;;
	*)
	    return 255
	    ;;
    esac

    local vpn_ipsec_site_ip_list vpn_ipsec_site_dn_list

    local elt range i=0
    local vpn_id remote_address remote_isakmp_port remote_natt_port
    local to_remote_addresses ips fqdns
    local host_ip address

    for elt in ${vpn_ipsec_site_list}
    do
	range=$[${i} % 12]
	case ${range} in
	    0)
 		vpn_id=${elt}
		;;
	    1)
		remote_address=${elt}
		;;

	    2|3|4|5|6|7|8|9)
		;;
	    10)
		remote_isakmp_port=${elt}
		;;
	    11)
		remote_natt_port=${elt}
		to_remote_addresses=$(get-vpn-ipsec-tos ${vpn_id} ${state})
		unset ips fqdns

		for address in ${remote_address} ${to_remote_addresses}
		do
		    if check-expr-ip ${address} ; then
			ips="${ips},${address}"
		    else
			host_ip=$(get-ip-from-ip-name-list ${address})
			if test ${?} -eq 0 ; then
			    ips="${ips},${host_ip}"
			else
			    fqdns="${fqdns},${address}"
			fi
		    fi
		done

		ips=${ips:1}
		fqdns=${fqdns:1}

		test -z "${ips}" || vpn_ipsec_site_ip_list="${vpn_ipsec_site_ip_list} ${vpn_id} ${ips} ${remote_isakmp_port} ${remote_natt_port}"
		test -z "${fqdns}" || vpn_ipsec_site_dn_list="${vpn_ipsec_site_dn_list} ${vpn_id} ${fqdns} ${remote_isakmp_port} ${remote_natt_port}"
		;;
	    *)
		return 255
		;;
	esac
	((i++))
    done

    VPN_IPSEC_SITE_IP_LIST=${vpn_ipsec_site_ip_list:1}
    VPN_IPSEC_SITE_DN_LIST=${vpn_ipsec_site_dn_list:1}
}

set-ipsec-parameters()
{
    local state=${1}
    test -n "${state}" || state=new

    local access_mode
    unset IKE_IS_ACTIVE CURRENT_IKE_IS_ACTIVE

    VPNIPSEC_ACCESS_DB_RESET=False

    access_mode=${VPN_IPSEC_ACCESS/ *}
    if test "${access_mode}" == 'on' ; then
	export VPN_IPSEC_ACCESS_MODE=True
    else
	export VPN_IPSEC_ACCESS_MODE=False
    fi

    access_mode=${CURRENT_VPN_IPSEC_ACCESS/ *}
    if test "${access_mode}" == 'on' ; then
	export CURRENT_VPN_IPSEC_ACCESS_MODE=True
    else
	export CURRENT_VPN_IPSEC_ACCESS_MODE=False
    fi

    if test ${VPN_IPSEC_MODE} == True -a ${VPN_IPSEC_ACCESS_MODE} == False ; then
	VPN_IPSEC_SITE_IS_ACTIVE=True
    else
	VPN_IPSEC_SITE_IS_ACTIVE=False
    fi

    if test ${CURRENT_VPN_IPSEC_MODE} == True -a ${CURRENT_VPN_IPSEC_ACCESS_MODE} == False ; then
	CURRENT_VPN_IPSEC_SITE_IS_ACTIVE=True
    else
	CURRENT_VPN_IPSEC_SITE_IS_ACTIVE=False
    fi

    if test ${VPN_IPSEC_MODE} == False -o ${ROUTER_MODE} == False ; then
	IKE_IS_ACTIVE=False
    else
	if test ${IP_EXTERNAL_IP} != "0.0.0.0" -a ${IP_WEB_IP} != "0.0.0.0" ; then
	    if test ${VPN_IPSEC_ACCESS_MODE} == True ; then
		export IKE_IS_ACTIVE=True
	    else
		if test -z "${VPN_IPSEC_SITE_LIST}" ; then
		    export IKE_IS_ACTIVE=False
		else
		    export IKE_IS_ACTIVE=True
		fi
	    fi
	else
	    export IKE_IS_ACTIVE=False
	fi
    fi

    if test ${CURRENT_VPN_IPSEC_MODE} == False -o ${CURRENT_ROUTER_MODE} == False ; then
	CURRENT_IKE_IS_ACTIVE=False
    else
	if test ${CURRENT_IP_EXTERNAL_IP} != "0.0.0.0" -a ${CURRENT_IP_WEB_IP} != "0.0.0.0" ; then
	    if test ${CURRENT_VPN_IPSEC_ACCESS_MODE} == True ; then
		export CURRENT_IKE_IS_ACTIVE=True
	    else
		if test -z "${CURRENT_VPN_IPSEC_SITE_LIST}" ; then
		    export CURRENT_IKE_IS_ACTIVE=False
		else
		    export CURRENT_IKE_IS_ACTIVE=True
		fi
	    fi
	else
	    export CURRENT_IKE_IS_ACTIVE=False
	fi
    fi

    if test "${VPN_IPSEC_MODE}" != "${CURRENT_VPN_IPSEC_MODE}" -o \
	    "${VPN_IPSEC_ACCESS_MODE}" != "${CURRENT_VPN_IPSEC_ACCESS_MODE}" ; then
	test "${VPN_IPSEC_MODE}" == False -o ${VPN_IPSEC_ACCESS_MODE} == False || \
	    VPNIPSEC_ACCESS_DB_RESET=True
    fi

    set-ipsec-parameters-site ${state}
}

tls-is-used-by-ipsec()
{
    test -n "${1}" || return 1
    local in_tls=${1}

    local tls

    if test ${VPN_IPSEC_AUTHENTICATE:0:3} != 'psk' ; then
	if test ${VPN_IPSEC_AUTHENTICATE:0:3} == 'tls' ; then
	    tls=${VPN_IPSEC_AUTHENTICATE:4}

	elif test ${VPN_IPSEC_AUTHENTICATE:0:6} == 'eaptls' ; then
	    tls=${VPN_IPSEC_AUTHENTICATE:7}
	fi
	tls=${tls/:*}
	test ${tls} != ${in_tls} || return 0
    fi

    local elt range i=0
    local auth_type auth_key1 auth_key2
    local subject
    
    local in_cert_file=$(get-tls-server-component-file ${in_tls} certificate)
    local in_subject=$(openssl x509 -in ${in_cert_file} -text -noout 2> /dev/null | grep 'Subject: ' 2> /dev/null) ; in_subject=${in_subject/*Subject: }

    for elt in ${VPN_IPSEC_SITE_LIST}
    do
	range=$[${i} % 12]
	case ${range} in
	    0|1|5|6|7|8|9|10)
	        ;;
	    2)
		auth_type=${elt}
		;;
	    3)	
		auth_key1=${elt}
		;;
	    4)
		auth_key2=${elt}
		;;
	    11)
		case ${auth_type} in
		    tls|eaptls)
			case ${auth_key1} in
			    certificate)
				tls=${auth_key2}
				test ${tls} != ${in_tls} || return 0
				;;
			    *)
				;;
			esac
			;;
		    *)
			;;
		esac
		;;
	    *)
		return 1
		;;
	esac
	((i++))
    done

    return 1
}

