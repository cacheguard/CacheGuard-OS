{
    echo "VERSION=3"
    echo "format=print"
    echo "type=btree"
    echo "db_pagesize=4096"
    echo "HEADER=END"
}

gen-db-dump-footer()
{
    echo "DATA=END"
}

sslmediate-exception-domainname-list-2dump()
{
    test -n "${1}" || return 1
    local env=${1}

    local sslmediate_exception_domainname_list name

    case ${env} in
	new)
	    sslmediate_exception_domainname_list=${SSLMEDIATE_EXCEPTION_DOMAINNAME_LIST}
	    ;;
	cur)
	    sslmediate_exception_domainname_list=${CURRENT_SSLMEDIATE_EXCEPTION_DOMAINNAME_LIST}
	    ;;
	*)
	    ;;
    esac

    gen-db-dump-header

    for name in ${sslmediate_exception_domainname_list}
    do
	echo " .${name}"
	echo " \00"
    done

    gen-db-dump-footer
}

update-sslmediation-exceptions()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    local env=${1}
    local context=${2}
    local in_period=${3}

    local name

    case ${context} in
	apply)
	    test ${FLAG_SSLMEDIATE_EXCEPTIONS} -eq 1 || return 0
	    ;;
	auto)
	    test ${CURRENT_SSLMEDIATE_MODE} == True || return 0

	    local bool load op period protocol ip fn
	    local doit

	    for name in ${CURRENT_SSLMEDIATE_EXCEPTION_URLLIST_LIST}
	    do
		if test -f ${URLLIST_DIR}/${name}.${URLLIST_AUTO}.current ; then

		    read bool load op period protocol ip fn < ${URLLIST_DIR}/${name}.${URLLIST_AUTO}.current

		    if test -z "${in_period}" -o "${in_period}" == ${period} ; then
			doit=yes
			break
		    fi
		fi
	    done
	    test -n "${doit}" || return 0
	    ;;
	*)
	    ;;
    esac

    case ${env} in
	new)
	    local proxy2_mode=${PROXY2_MODE}
	    local rweb_site_name_list=${RWEB_SITE_NAME_LIST}
	    local sslmediate_exception_domainname_list=${SSLMEDIATE_EXCEPTION_DOMAINNAME_LIST}
	    local sslmediate_exception_urllist_list=${SSLMEDIATE_EXCEPTION_URLLIST_LIST}
	    ;;
	cur)
	    local proxy2_mode=${CURRENT_PROXY2_MODE}
	    local rweb_site_name_list=${CURRENT_RWEB_SITE_NAME_LIST}
	    local sslmediate_exception_domainname_list=${CURRENT_SSLMEDIATE_EXCEPTION_DOMAINNAME_LIST}
	    local sslmediate_exception_urllist_list=${CURRENT_SSLMEDIATE_EXCEPTION_URLLIST_LIST}
	    ;;
	*)
	    return 1
	    ;;
    esac

    local exceptions_file=${PROXY_DOMAIN_LIST_DIR}/${SSLMEDIATE_EXCEPTIONS_FILENAME}
    local exceptions_compiled=${RUN_DIR}/${SSLMEDIATE_EXCEPTIONS_FILENAME}

    local reset

    if test ${proxy2_mode} == True ; then
	test -n "${sslmediate_exception_urllist_list}" -o \
	     -n "${sslmediate_exception_domainname_list}" || reset=yes
    else
	test -n "${rweb_site_name_list}" -o \
	     -n "${sslmediate_exception_urllist_list}" -o \
	     -n "${sslmediate_exception_domainname_list}" || reset=yes
    fi

    if test -n "${reset}" ; then
	log "Resetting the SSL mediation exceptions"
	echo -n > ${exceptions_file}
	log-result 0
	return 0
    fi

    local ret len i=1

    log "Compiling SSL mediation exceptions (1/2)"

    rm -f ${exceptions_file}.{dump1,dump2,db}

    if test ${proxy2_mode} == False ; then

	gen-db-dump-header > ${exceptions_file}.dump1

	for name in ${rweb_site_name_list}
	do
	    echo " ${name}"
	    echo " \00"
	done >> ${exceptions_file}.dump1

	gen-db-dump-footer >> ${exceptions_file}.dump1

	db_load -f ${exceptions_file}.dump1 ${exceptions_file}.db 2> /dev/null
	ret=${?}

	if test ${ret} -ne 0 ; then
	    rm -f ${exceptions_file}.{dump1,db}
	    ret=11
	    log-result ${ret}
	    return ${ret}
	fi
    fi

    if test -n "${sslmediate_exception_domainname_list}" ; then

	sslmediate-exception-domainname-list-2dump ${env} > ${exceptions_file}.dump1 2> /dev/null
	ret=${?}

	if test ${ret} -ne 0 ; then
	    rm -f ${exceptions_file}.dump1
	    ret=21
	    log-result ${ret}
	    return ${ret}
	fi

	db_load -f ${exceptions_file}.dump1 ${exceptions_file}.db 2> /dev/null
	ret=${?}

	if test ${ret} -ne 0 ; then
	    rm -f ${exceptions_file}.{dump1,db}
	    ret=23
	    log-result ${ret}
	    return ${ret}
	fi
    fi

    for name in ${sslmediate_exception_urllist_list}
    do
	test -f ${PROXY_GUARD_DIR}/${name}/domains.db || continue
	db_dump ${PROXY_GUARD_DIR}/${name}/domains.db > ${exceptions_file}.dump1 2> /dev/null
	ret=${?}

	if test ${ret} -ne 0 ; then
	    rm -f ${exceptions_file}.{dump1,db}
	    ret=31
	    log-result ${ret}
	    return ${ret}
	fi

	db_load -f ${exceptions_file}.dump1 ${exceptions_file}.db 2> /dev/null
	ret=${?}

	if test ${ret} -ne 0 ; then
	    rm -f ${exceptions_file}.{dump1,db}
	    ret=33
	    log-result ${ret}
	    return ${ret}
	fi
    done

    if test ! -f ${exceptions_file}.db ; then
	log-result 0
	log "Compiling SSL mediation exceptions (2/2)"
	log-result 0
	return 0
    fi

    db_dump -p ${exceptions_file}.db 2> /dev/null | \
	sed -e '/^ \\00$/d' -e 's/^ //' | \
	tail --lines=+6 | \
	head --lines=-1 > ${exceptions_file}.dump1
    ret=${?}

    rm -f ${exceptions_file}.db

    if test ${ret} -ne 0 ; then
	rm -f ${exceptions_file}.dump1
	ret=41
	log-result ${ret}
	return ${ret}
    fi

    local lines=$(wc -l ${exceptions_file}.dump1 2> /dev/null)
    lines=${lines/ *}

    echo $[${lines} * 2] > ${exceptions_compiled}.total
    echo 0 > ${exceptions_compiled}.cursor

    log-result 0

    log "Compiling SSL mediation exceptions (2/2)" ${LOG_TAG_SSLMEDIATE}

    while read name
    do
	echo ${#name} ${name}
	echo ${i} > ${exceptions_compiled}.cursor
	((i++))
    done < ${exceptions_file}.dump1 > ${exceptions_file}.dump2 2> /dev/null

    sort --numeric-sort ${exceptions_file}.dump2 > ${exceptions_file}.dump1
    rm -f ${exceptions_file}.dump2

    while read len name
    do
	echo ${name}
	echo ${i} > ${exceptions_compiled}.cursor
	((i++))
    done < ${exceptions_file}.dump1 > ${exceptions_file} 2> /dev/null
    rm -f ${exceptions_file}.dump1

    log-result 0
}

clear-urllists()
{
    cd ${TMP_DIR}

    local files=$(ls -1 ${URLLIST_CLEAR}.*.* 2> /dev/null)
    test -n "${files}" || return 0

    local file urllist urllists suffix
    local len=${#URLLIST_CLEAR} ; ((len++))

    for file in ${files}
    do
	urllist=${file:${len}}
	suffix=${urllist/*\.}
	urllist=${urllist%\.*}

	log "Clearing the '${urllist}(${suffix})' URL list"

	case ${APL_ROLE} in
	    gateway)
		rm -f \
		   ${PROXY_GUARD_DIR}/${urllist}/${suffix}.db \
		   ${URLLIST_VAR_DIR}//${urllist}.${suffix}.${URLLIST_UPDATE} \
		   ${file} &&
		    touch-urllist ${PROXY_GUARD_DIR}/${urllist}/${suffix} &&
		log-result ${?}

		member "${urllists}" "${urllist}" || urllists="${urllists} ${urllist}"
		;;
	    manager)
		rm -f \
		   ${URLLIST_VAR_DIR}/${MPUSHED}.${URLLIST}.*.${urllist}.*.${suffix}.gz* \
		   ${URLLIST_VAR_DIR}/${urllist}.${suffix}.${URLLIST_UPDATE} \
		   ${file}
		log-result ${?}
		;;
	    *)
		return 255
		;;
	esac
    done

    test ${APL_ROLE} == gateway || return 0

    urllists=${urllists:1}

    for urllist in ${urllists}
    do
	if urllist-is-used-by-sslmediate ${urllist} user ; then
	    FLAG_SSLMEDIATE_EXCEPTIONS=1
	    break
	fi
    done
}

manager-build-urllist()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    test -n "${3}" || return 3
    test -n "${4}" || return 4
    test -n "${5}" || return 5
    test -n "${6}" || return 6
    local file=${1}
    local prefix=${2}
    local ftype=${3}
    local urllist=${4}
    local suffix=${5}
    local serial=${6}

    local days=$(get-urllist-serial-days ${file} ${prefix} ${ftype} ${urllist} ${suffix})
    local base

    base=$(file-basename ${file})
    base=${base/${prefix}\./${MPUSHED}\.}

    log "Committing (${serial}) the '${urllist}(${suffix})' URL list"
    check-vloaded-signature ${file}
    if test ${?} -ne 0 ; then
	rm -f ${file} ${file}.${SIGNATURE}
	log-result 7
	return 7
    fi

    local ret=0

    cp -f ${file} ${URLLIST_VAR_DIR}/${base} || ((ret++))
    test ! -f ${file}.${SIGNATURE} || cp -f ${file}.${SIGNATURE} ${URLLIST_VAR_DIR}/${base}.${SIGNATURE} || ((ret++))
    echo ${days} > ${URLLIST_VAR_DIR}/${urllist}.${suffix}.${URLLIST_UPDATE}  || ((ret++))

    log-result ${ret}
}

gateway-build-urllist()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    test -n "${3}" || return 3
    test -n "${4}" || return 4
    test -n "${5}" || return 5
    test -n "${6}" || return 6
    local file=${1}
    local prefix=${2}
    local ftype=${3}
    local urllist=${4}
    local suffix=${5}
    local message=${6}

    local days=$(get-urllist-serial-days ${file} ${prefix} ${ftype} ${urllist} ${suffix})

    log "${message} the '${urllist}(${suffix})' URL list"

    check-vloaded-signature ${file}
    if test ${?} -ne 0 ; then
	rm -f ${file} ${file}.${SIGNATURE}
	log-result 7
	return 7
    fi

    check-gzip-file ${file}
    if test ${?} -ne 0 ; then
	log-result 9
	return 9
    fi
    
    if test ! -d ${PROXY_GUARD_DIR}/${urllist} ; then
	log-result 11
	return 11
    fi

    case ${ftype} in

	${URLLIST_CREATE})

	    local file_sz=$(get-file-length ${file})
	    local fs_free_sz=$(get-fs-available-sz ${PROXY_GUARD_DIR})

	    ((file_sz *= 24))

	    if test ${file_sz} -gt ${fs_free_sz} ; then
		rm -f ${file} ${file}.${SIGNATURE}
		log-result 13
		return 13
	    fi
	    ;;
	*)
	    ;;
    esac

    rm -f ${PROXY_GUARD_DIR}/${urllist}/${suffix}.tmp
    gunzip --quiet --to-stdout ${file} > ${PROXY_GUARD_DIR}/${urllist}/${suffix}.tmp 2> /dev/null

    if test ${?} -ne 0 ; then
	rm -f \
	    ${PROXY_GUARD_DIR}/${urllist}/${suffix}.gz \
	    ${PROXY_GUARD_DIR}/${urllist}/${suffix}.tmp \
	    ${file} ${file}.${SIGNATURE}
	log-result 15
	return 15
    fi

    if check-empty-file ${PROXY_GUARD_DIR}/${urllist}/${suffix}.tmp ; then

	case ${ftype} in
	    ${URLLIST_CREATE})
		if test ! -f ${PROXY_GUARD_DIR}/${urllist}/${suffix}.db ; then
		    rm -f ${PROXY_GUARD_DIR}/${urllist}/${suffix}.tmp
		    echo ${days} > ${URLLIST_VAR_DIR}/${urllist}.${suffix}.${URLLIST_UPDATE}
		    touch-urllist ${PROXY_GUARD_DIR}/${urllist}/${suffix}
		    log-result 0
		    return 0
		fi
		;;
	    ${URLLIST_UPDATE})
		rm -f ${PROXY_GUARD_DIR}/${urllist}/${suffix}.tmp
		echo ${days} > ${URLLIST_VAR_DIR}/${urllist}.${suffix}.${URLLIST_UPDATE}
		rm -f ${file} ${file}.${SIGNATURE}
		log-result 0
		return 0
		;;
	    *)
		;;
	esac
    fi

    if ! check-ascii-file ${PROXY_GUARD_DIR}/${urllist}/${suffix}.tmp ; then
	rm -f \
	   ${PROXY_GUARD_DIR}/${urllist}/${suffix}.tmp \
	   ${file} ${file}.${SIGNATURE}
	touch-urllist ${PROXY_GUARD_DIR}/${urllist}/${suffix}
	log-result 17
	return 17
    fi

    if test ${suffix} == expressions ; then
	mv -f ${PROXY_GUARD_DIR}/${urllist}/${suffix}.tmp ${PROXY_GUARD_DIR}/${urllist}/${suffix}
	log-result 0
	return 0
    fi

    gen-tmp-guard-conf ${ftype} ${urllist} ${suffix} > ${PROXY_DIR}/tmp/squidGuard.conf

    case ${ftype} in

	${URLLIST_CREATE})
	    chroot ${PROXY_DIR} /bin/squidGuard -C ${urllist}/${suffix}.tmp -c /tmp/squidGuard.conf -P
	    if test ${?} -ne 0 ; then
		clean-urllist ${ftype} ${urllist} ${suffix} &&
		    rm -f ${file} ${file}.${SIGNATURE}
		log-result 19
		return 19
	    fi

	    chown ${SQUID_UID}:${SQUID_GID} ${PROXY_GUARD_DIR}/${urllist}/${suffix}.tmp.db
	    chmod 600 ${PROXY_GUARD_DIR}/${urllist}/${suffix}.tmp.db
	    mv -f ${PROXY_GUARD_DIR}/${urllist}/${suffix}.tmp.db ${PROXY_GUARD_DIR}/${urllist}/${suffix}.db
	    rm -f ${PROXY_GUARD_DIR}/${urllist}/${suffix}
	    rm -f ${PROXY_GUARD_DIR}/${urllist}/${suffix}.tmp

	    echo ${days} > ${URLLIST_VAR_DIR}/${urllist}.${suffix}.${URLLIST_UPDATE}
	    ;;

	${URLLIST_UPDATE})
	    if test ! -f ${PROXY_GUARD_DIR}/${urllist}/${suffix}.db ; then
		clean-urllist ${ftype} ${urllist} ${suffix} &&
		    rm -f ${file} ${file}.${SIGNATURE}
		log-result 21
		return 21
	    fi

	    mv -f ${PROXY_GUARD_DIR}/${urllist}/${suffix}.tmp ${PROXY_GUARD_DIR}/${urllist}/${suffix}.diff
	    echo >> ${PROXY_GUARD_DIR}/${urllist}/${suffix}.diff
	    chroot ${PROXY_DIR} /bin/squidGuard -u ${urllist}/${suffix}.diff -c /tmp/squidGuard.conf -P

	    if test ${?} -ne 0 ; then
		clean-urllist ${ftype} ${urllist} ${suffix} &&
		    rm -f ${file} ${file}.${SIGNATURE}
		log-result 23
		return 23
	    fi

	    rm -f ${PROXY_GUARD_DIR}/${urllist}/${suffix}.diff
	    echo ${days} > ${URLLIST_VAR_DIR}/${urllist}.${suffix}.${URLLIST_UPDATE}
	    ;;
	*)
	    ;;
    esac

    log-result 0
}

build-urllist()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    test -n "${3}" || return 3
    test -n "${4}" || return 4
    local prefix=${1}
    local ftype=${2}
    local urllist=${3}
    local suffix=${4}

    local i=0 ret
    local message

    case ${ftype} in
	"${URLLIST_CREATE}")
	    message=Building
	    ;;
	"${URLLIST_UPDATE}")
	    message=Updating
	    ;;
	*)
	    ;;
    esac

    files=$(ls -1 ${prefix}.${ftype}.${urllist}.*.${suffix}.gz 2> /dev/null)
    for file in ${files}
    do
	test ${ftype} == ${URLLIST_CREATE} || ((i++))
	test -s ${file} || continue

	case ${APL_ROLE} in
	    gateway)
		gateway-build-urllist ${file} ${prefix} ${ftype} ${urllist} ${suffix} "${message} (${i})"
		;;
	    manager)
		manager-build-urllist ${file} ${prefix} ${ftype} ${urllist} ${suffix} ${i}
		;;
	    *)
		;;
	esac

	ret=${?}
	test ${ret} -eq 0 || test ${ftype} == ${URLLIST_CREATE} || break
    done

    return ${ret}
}

build-all-urllists()
{
    test -n "${1}" || return 1
    local actor=${1}

    local prefix ftype
    local file files
    local suffix suffixes
    local urllist urllists

    cd ${TMP_DIR}

    case ${actor} in
	user)
	    prefix=${LOADED}
	    ;;
	system)
	    prefix=${ILOADED}
	    ;;
	manager)
	    commit-mpushed-urllists system
	    prefix=${ILOADED}
	    ;;
	*)
	    return 1
	    ;;
    esac

    files=$(ls -1 ${prefix}.${URLLIST_CREATE}.*.gz 2> /dev/null)
    for file in ${files}
    do
	urllist=${file/${prefix}.${URLLIST_CREATE}\.}
	urllist=${urllist/\.*/}
	member "${urllists}" "${urllist}" || urllists="${urllists} ${urllist}"
    done

    files=$(ls -1 ${prefix}.${URLLIST_UPDATE}.*.gz 2> /dev/null)
    for file in ${files}
    do
	urllist=${file/${prefix}.${URLLIST_UPDATE}\.}
	urllist=${urllist/\.*}
	member "${urllists}" "${urllist}" || urllists="${urllists} ${urllist}"
    done

    urllists=${urllists:1}

    if test ${APL_ROLE} == manager ; then
	for urllist in ${urllists}
	do
	    for ftype in ${URLLIST_CREATE} ${URLLIST_UPDATE}
	    do
		case ${ftype} in
		    "${URLLIST_CREATE}")
			suffixes="domains urls expressions"
			;;
		    "${URLLIST_UPDATE}")
			suffixes="domains urls"
			;;
		    *)
			;;
		esac

		for suffix in ${suffixes}
		do
		    files=$(ls -1 ${prefix}.${URLLIST_CREATE}.${urllist}.*.${suffix}.gz ${prefix}.${URLLIST_UPDATE}.${urllist}.*.${suffix}.gz 2> /dev/null)
		    test -z "${files}" || \
			rm -f \
			   ${URLLIST_VAR_DIR}/${MPUSHED}.${URLLIST_CREATE}.${urllist}.*.${suffix}.gz* \
			   ${URLLIST_VAR_DIR}/${MPUSHED}.${URLLIST_UPDATE}.${urllist}.*.${suffix}.gz*
		done
	    done
	done
    fi

    for urllist in ${urllists}
    do
	for ftype in ${URLLIST_CREATE} ${URLLIST_UPDATE}
	do
	    case ${ftype} in
		"${URLLIST_CREATE}")
		    suffixes="domains urls expressions"
		    ;;
		"${URLLIST_UPDATE}")
		    suffixes="domains urls"
		    ;;
		*)
		    ;;
	    esac

	    for suffix in ${suffixes}
	    do
		build-urllist ${prefix} ${ftype} ${urllist} ${suffix}
	    done
	done
    done

    case ${APL_ROLE} in
	gateway)
	    for urllist in ${urllists}
	    do
		if urllist-is-used-by-sslmediate ${urllist} ${actor} ; then
		    FLAG_SSLMEDIATE_EXCEPTIONS=1
		    break
		fi
	    done
	    ;;
	manager)
	    ;;
	*)
	    ;;
    esac

    clean-loaded-urllist ${actor}
}

