}

gen-guard-conf()
{
    local default_urllists negative_urllists positive_urllists
    local nb=1 i=0 j=0 k=0 elt1 elt2 elt3 range1 range2 range3
    local rule_name policy_name action
    local urllist urllists_col urllists_lst all_urllists
    local filters_col filters_lst filter filter_type filter_name name
    local ip_key ip1 ip2 time_type time_value ldap_group ldap_login ldap_filter ldap_used=0
    local week slot date1 year1 month1 day1 date2 year2 month2 day2
    local time_filters ip_filters ldap_filters

    local timeRule
    declare -a timeRule
    timeRule[0]=0

    gen-guard-dir chroot
    echo "ldapcachetime ${AUTHENTICATE_LDAP_TTL}"
    cat squidGuard.conf-constant

    for elt1 in ${GUARD_RULE_LIST}
    do
	range1=$[${i} % 3]
	case ${range1} in
	    0)
		rule_name=${elt1}
		;;
	    1)
		action=${elt1}
		;;
	    2)
		urllists_col=${elt1}
		urllists_lst=$(colon2space ${urllists_col})
		
		if test "${rule_name}" == "default" ; then
		    if test "${action}" == "deny" ; then
			test ${GUARD_IP} == False || default_urllists=" !in-addr"
			for urllist in ${urllists_lst}
			do
			    test ${urllist} != self || continue
			    default_urllists="${default_urllists} !${urllist}"
			done
			default_urllists="${default_urllists:1} all"
		    else
			for urllist in ${urllists_lst}
			do
			    test ${urllist} != self || continue
			    default_urllists="${default_urllists} ${urllist}"
			done
			default_urllists="${default_urllists:1} self none"
		    fi
		else
		    j=0
		    unset ip_filters time_filters ldap_filters

		    for elt2 in ${GUARD_POLICY_LIST}
		    do
			range2=$[${j} % 2]
			case ${range2} in
			    0)
				policy_name=${elt2}
				;;
			    1)
				if test ${policy_name} == ${rule_name} ; then
				    filters_col=${elt2}
				    filters_lst=$(colon2space ${filters_col})

				    for filter in ${filters_lst}
				    do
					test ${filter} != "self_self" || continue
					filter_type=${filter/_*}
					filter_name=${filter#*_}
					k=0
					case ${filter_type} in
					    ip)
						for elt3 in ${GUARD_FILTER_IP_LIST}
						do
						    range3=$[${k} % 4]
						    case ${range3} in
							0)
							    name=${elt3}
							    ;;
							1)
							    ip_key=${elt3}
							    ;;
							2)
							    ip1=${elt3}
							    ;;
							3)
							    ip2=${elt3}
							    if test ${name} == ${filter_name} ; then
								case ${ip_key} in
								    range)
									ip_filters="${ip_filters}\n\tip ${ip1}-${ip2}"
									;;
								    network)
									ip_filters="${ip_filters}\n\tip ${ip1}/${ip2}"
									;;
								    *)
									;;
								esac
							    fi
							    ;;
							*)
							    ;;
						    esac
						    ((k++))
						done
						;;
					    'time')
						for elt3 in ${GUARD_FILTER_TIME_LIST}
						do
						    range3=$[${k} % 3]
						    case ${range3} in
							0)
							    name=${elt3}
							    ;;
							1)
							    time_type=${elt3}
							    ;;
							2)
							    time_value=${elt3}
							    test ${name} != ${filter_name} || time_filters="${time_filters} ${time_type} ${time_value}"
							    ;;
							*)
							    ;;
						    esac
						    ((k++))
						done
						;;
					    ldap)
						for elt3 in ${GUARD_FILTER_LDAP_LIST}
						do
						    range3=$[${k} % 4]
						    case ${range3} in
							0)
							    name=${elt3}
							    ;;
							1)
							    ldap_group=${elt3}
							    ;;
							2)
							    ldap_login=${elt3}
							    ;;
							3)
							    ldap_filter=${elt3}
							    if test ${name} == ${filter_name} ; then
								if test-ldap-auth-state ; then
								    ldap_filters="${ldap_filters}\n\tldapusersearch ldap://127.0.0.1:389/${ldap_group}?${ldap_login}?sub?(&(${ldap_filter})(${ldap_login}=%s))"
								fi
							    fi
							    ;;
							*)
							    ;;
						    esac
						    ((k++))
						done
						;;
					    *)
						;;
					esac
				    done

				    #######################
				    echo
				    echo "src src-${nb} {"
				    #######################

				    if test -n "${ip_filters}" ; then
					echo -e "${ip_filters:2}"
					if test -n "${ldap_filters}" ; then
					    echo -e "${ldap_filters:2}"
					    ldap_used=1
					fi
				    elif test -n "${ldap_filters}" ; then
					echo -e "${ldap_filters:2}"
					ldap_used=1
				    else
					echo -e "\tip 127.0.0.255/255.255.255.255"
				    fi

				    ########
				    echo "}"
				    ########
				fi
				;;
			    *)
				;;
			esac
			((j++))
		    done

		    if test -n "${time_filters}" ; then

			########################
			echo
			echo "time time-${nb} {"
			########################
			
			j=0
			for elt2 in ${time_filters}
			do
			    range2=$[${j} % 2]
			    case ${range2} in
				0)
				    time_type=${elt2}
				    ;;
				1)
				    time_value=${elt2}
				    case ${time_type} in
					slot)
					    week=${time_value:0:2}
					    if test ${week:1:1} == "-" ; then
						slot=${time_value:2}
						case ${week:0:1} in
						    0)
							week="sundays"
							;;
						    1)
							week="mondays"
							;;
						    2)
							week="tuesdays"
							;;
						    3)
							week="wednesdays"
							;;
						    4)
							week="thursdays"
							;;
						    5)
							week="fridays"
							;;
						    6)
							week="saturdays"
							;;
						    *)
							week='*'
							;;
						esac
					    else
						week='*'
						slot=${time_value}
					    fi
					    echo -e "\tweekly ${week} ${slot}"
					    ;;
					date)
					    date1=${time_value/-*}
					    slot=${time_value#*-}

					    year1=${date1/\/*}
					    if test -n "${year1}" ; then
						date2=${date1:5}
					    else
						date2=${date1:1}
					    fi

					    month1=${date2/\/*}
					    if test -n "${month1}" ; then
						day1=${date2:3}
					    else
						day1=${date2:1}
					    fi

					    test -n "${year1}" || year1='*'
					    test -n "${month1}" || month1='*'
					    test -n "${day1}" || day1='*'

					    if test ${date1} == ${slot} ; then
						echo "date ${year1}.${month1}.${day1}"
					    else
						echo -e "\tdate ${year1}.${month1}.${day1} ${slot}"
					    fi
					    ;;
					frame)
					    date1=${time_value/-*}
					    date2=${time_value/*-}

					    year1=${date1:0:4}
					    month1=${date1:5:2}
					    day1=${date1:8:2}

					    year2=${date2:0:4}
					    month2=${date2:5:2}
					    day2=${date2:8:2}

					    echo -e "\tdate ${year1}.${month1}.${day1}-${year2}.${month2}.${day2}"
					    ;;
					*)
					    ;;
				    esac
				    ;;
				*)
				    ;;
			    esac
			    ((j++))
			done
			
			########
			echo "}"
			########

			timeRule[${nb}]=1
		    else
			timeRule[${nb}]=0
		    fi
		    ((nb++))
		fi

		for urllist in ${urllists_lst}
		do
		    test ${urllist} != self || continue
		    member "${all_urllists}" "${urllist}" || all_urllists="${all_urllists} ${urllist}"
		done
		;;
	    *)
		return 1
		;;
	esac
	((i++))
    done

    if test ${ldap_used} -eq 1 ; then
	if test "${LDAP_BIND_MODE}" == True -a -s ${PROXY_DIR}${LDAP_DIR}/${LDAP_PASSWD} ; then
	    local password=$(cat ${PROXY_DIR}${LDAP_DIR}/${LDAP_PASSWD})
	    echo "ldapbinddn ${LDAP_BIND_DN}"
	    echo "ldapbindpass ${password}"
	fi
    fi

    test -z "${all_urllists}" || echo
    
    for urllist in ${all_urllists}
    do
	echo "dest ${urllist} {"
	echo -e "\tdomainlist ${urllist}/domains"
	echo -e "\turllist ${urllist}/urls"
	echo -e "\texpressionlist ${urllist}/expressions"
	test ${GUARD_LOG_MODE} == False || echo -e "\tlog ${ACCESS_GUARD_LOG}"
	echo "}"
	echo
    done

    ############
    echo "acl {"
    ############
    
    i=0 nb=1

    for elt1 in ${GUARD_RULE_LIST}
    do
	range1=$[${i} % 3]
	case ${range1} in
	    0)
		rule_name=${elt1}
		;;
	    1)
		action=${elt1}
		;;
	    2)
		urllists_col=${elt1}

		if test "${rule_name}" != "default" ; then
		    urllists_lst=$(colon2space ${urllists_col})
		    if test "${action}" = "deny" ; then
			unset negative_urllists
			for urllist in ${urllists_lst}
			do
			    test ${urllist} != self || continue
			    negative_urllists="${negative_urllists} !${urllist}"
			done
			negative_urllists="${negative_urllists:1}"

			if test ${GUARD_IP} == True ; then
			    if test -z "${negative_urllists}" ; then
				negative_urllists="!in-addr"
			    else
				negative_urllists="!in-addr ${negative_urllists}"
			    fi
			fi
		    else
			unset positive_urllists
			for urllist in ${urllists_lst}
			do
			    test ${urllist} != self || continue
			    positive_urllists="${positive_urllists} ${urllist}"
			done
			positive_urllists="${positive_urllists:1}"
		    fi

		    if test ${timeRule[${nb}]} -eq 0  ; then
			echo -e "\tsrc-${nb} {"
		    else
			echo -e "\tsrc-${nb} within time-${nb} {"
		    fi

		    if test "${action}" = "deny" ; then
			echo -e "\t\tpass ${negative_urllists} all"
			echo -e "\t\tredirect ${GUARD_REDIRECT_WEB_SERVER}/${URL_DENIED_URI}"
		    else
			echo -e "\t\tpass ${positive_urllists} self none"
			echo -e "\t\tredirect ${GUARD_REDIRECT_WEB_SERVER}/${URL_DENIED_URI}"
		    fi
		    echo -e "\t}"
		    echo -e ""
		    ((nb++))
		fi
		;;
	    
	    *)
		return 1
		;;
	esac
	((i++))
    done
    
    if test -n "${default_urllists}" ; then
	echo -e "\tdefault {"
	echo -e "\t\tpass ${default_urllists}"
	echo -e "\t\tredirect ${GUARD_REDIRECT_WEB_SERVER}/${URL_DENIED_URI}"
	test ${GUARD_LOG_MODE} == False || echo -e "\t\tlog ${ACCESS_GUARD_LOG}"
	echo -e "\t}"
    else
	echo -e "\tdefault {"
	echo -e "\t\tpass self none"
	echo -e "\t\tredirect ${GUARD_REDIRECT_WEB_SERVER}/${URL_DENIED_URI}"
	test ${GUARD_LOG_MODE} == False || echo -e "\t\tlog ${ACCESS_GUARD_LOG}"
	echo -e "\t}"
    fi
    
    ########
    echo "}"
    ########
}

gen-suspend-squidGuard-conf()
{
    local contact=$(get-guard-contact)
    local uri="${ACCESS_WARNING_URI}?email=${contact}&ip=%a"

    gen-guard-dir chroot

    echo "ldapcachetime 300"
    cat ${CONF_DIR}/squidGuard.conf-constant

    echo "acl {"
    echo "    local {"
    echo "          pass all"
    echo "    }"
    echo
    echo "    default {"
    echo "            pass self none"
    echo "            redirect ${GUARD_REDIRECT_WEB_SERVER}/${uri}"
    echo "    }"
    echo "}"
}

commit-guards()
{
    cd ${PROXY_GUARD_DIR}
    local todel todels=$(ls -d *.2del 2> /dev/null)
    local urllist

    for todel in ${todels}
    do
	urllist=$(file-basename ${todel} .2del)
	rm -rf ${todel} 2> /dev/null
	rm -f ${URLLIST_VAR_DIR}/${urllist}.*.${URLLIST_UPDATE}
    done

    local guard_dir=${URLLIST_DIR}
    rm -f ${guard_dir}/*.${URLLIST_AUTO}.2del
    rm -f ${guard_dir}/*.${URLLIST_AUTO}.current.2del

    local file files
    files=$(ls -1 ${guard_dir}/*.${URLLIST_AUTO} 2> /dev/null)
    for file in ${files}
    do
	mv -f ${file} ${file}.current
    done

    cd ${PROXY_DOMAIN_LIST_DIR}
    rm -f *.2del
}

restore-guards()
{
    cd ${PROXY_GUARD_DIR}
    local todel todels=$(ls -d *.2del 2> /dev/null)
    for todel in ${todels}
    do
	mv -f ${todel} ${todel/\.2del/} 2> /dev/null
    done

    local file file1 files
    files=$(ls -1 ${URLLIST_DIR}/*.${URLLIST_AUTO}*.2del 2> /dev/null)
    for file in ${files}
    do
	file1=${file/\.2del/}
	mv -f ${file} ${file1}
    done

    cd ${PROXY_DOMAIN_LIST_DIR}
    todels=$(ls -1 *.2del 2> /dev/null)
    for todel in ${todels}
    do
	mv -f ${todel} ${todel/\.2del/} 2> /dev/null
    done
}

