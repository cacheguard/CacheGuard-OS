get-guard-contact()
{
    local email=${ADMINISTRATOR_EMAIL}
    test -n "${email}" || email="admin@example.com"
    email=${email/@/(at)}

    local name=${ADMINISTRATOR_NAME}
    test -n "${name}" || name="Your Administrator"
    name=${name// /%20}

    local contact="${name}%20%3C${email}%3E"

    echo ${contact}
}

set-warning-parameters()
{
    local contact=$(get-guard-contact)

    URL_DENIED_URI="${URL_DENIED_URI/@EMAIL@/${contact}}"
}

set-guard-parameters()
{
    if test ${SSLMEDIATE_MODE} == True ; then
	export GUARD_REDIRECT_WEB_SERVER="http://${IP_WEB_IP}"
    else
	export GUARD_REDIRECT_WEB_SERVER="http://${WEB_SERVER_DENY_NAME}"
    fi

    if test ${GUARD_MODE} == True -a ${LOG_MODE} == True -a ${LOG_TYPE_GUARD/:*} == True ; then
	GUARD_LOG_MODE=True
    else
	GUARD_LOG_MODE=False
    fi

    if test ${WEB_MODE} == True -a ${GUARD_MODE} == True -a ${AUTHENTICATE_MODE} == True && test-new-guard-rules-use-ldap ; then
	LDAP_PROXY_IS_ACTIVE=True
    else
	LDAP_PROXY_IS_ACTIVE=False
    fi

    if test ${CURRENT_GUARD_MODE} == True -a ${CURRENT_LOG_MODE} == True -a ${CURRENT_LOG_TYPE_GUARD/:*} == True ; then
	CURRENT_GUARD_LOG_MODE=True
    else
	CURRENT_GUARD_LOG_MODE=False
    fi

    if test ${CURRENT_WEB_MODE} == True -a ${CURRENT_GUARD_MODE} == True -a ${CURRENT_AUTHENTICATE_MODE} == True && test-cur-guard-rules-use-ldap ; then
	CURRENT_LDAP_PROXY_IS_ACTIVE=True
    else
	CURRENT_LDAP_PROXY_IS_ACTIVE=False
    fi

    set-warning-parameters
}

touch-urllist()
{
    test -n "${1}" || return 1
    local file=${1}

    touch ${file} 2> /dev/null || return 11
    chmod 400 ${file} 2> /dev/null || return 13
    chown ${SQUID_UID}:${SQUID_GID} ${file} 2> /dev/null || return 15
}

clean-urllist()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    test -n "${3}" || return 3
    local ftype=${1}
    local urllist=${2}
    local suffix=${3}

    rm -f \
       ${PROXY_GUARD_DIR}/${urllist}/${suffix}.tmp \
       ${PROXY_GUARD_DIR}/${urllist}/${suffix}.gz

    if test -f ${PROXY_GUARD_DIR}/${urllist}/${suffix}.db ; then
	rm -f ${PROXY_GUARD_DIR}/${urllist}/${suffix}
    else
	touch-urllist ${PROXY_GUARD_DIR}/${urllist}/${suffix}
    fi

    case ${ftype} in
	${URLLIST_CREATE})
	    rm -f ${URLLIST_VAR_DIR}/${urllist}.${suffix}.${URLLIST_UPDATE}
	    ;;

	${URLLIST_UPDATE})
	    rm -f ${PROXY_GUARD_DIR}/${urllist}/${suffix}.diff
	    ;;
	*)
	    ;;
    esac
}

set-urllist-auto-load()
{
    local file files urllist
    local bool load op period protocol ip fn

    files=$(ls -1 ${URLLIST_DIR}/*.${URLLIST_AUTO} 2> /dev/null)
    for file in ${files}
    do
	urllist=$(file-basename ${file} .${URLLIST_AUTO})
	read bool load op period protocol ip fn < ${file}
	case "${bool}" in
	    off)
		log "Turning off '${urllist}' URL list auto load"
		mv -f ${file} ${file}.2del
		test ! -f ${file}.current || mv -f ${file}.current ${file}.current.2del
		log-result 0
		;;
	    on)
		log "Turning on '${urllist}' URL list auto load"
		log-result 0
		;;
	    *)
		;;
	esac
    done
}

clean-loaded-urllist()
{
    test -n "${1}" || return 1
    local actor=${1}

    local prefixes prefix

    case ${actor} in
	user)
	    prefixes="${LOADED}"
	    rm -f ${TMP_DIR}/${LOADED}.${URLLIST}.*.${PROGRESS}
	    ;;
	system)
	    prefixes="${ILOADED}"
	    ;;
	manager)
	    prefixes="${ILOADED} ${MPUSHED}"
	    ;;
	*)
	    return 1
	    ;;
    esac

    for prefix in ${prefixes}
    do
	rm -f \
	   ${TMP_DIR}/${prefix}.${URLLIST}.*.domains.gz* \
	   ${TMP_DIR}/${prefix}.${URLLIST}.*.urls.gz* \
	   ${TMP_DIR}/${prefix}.${URLLIST}.*.expressions.gz*
    done

    rm -f ${PROXY_DIR}/tmp/squidGuard.conf
}

add-urllists()
{
    test -n "${1}" || return 1
    local log_mode=${1}
    shift
    local urllists2add=${*}

    local urllist ret
    
    cd ${PROXY_GUARD_DIR}

    for urllist in ${urllists2add}
    do
	test ${log_mode} == "nolog" || log "Adding the '${urllist}' URL list"
	if test ${APL_ROLE} == manager ; then
	    log-result 0
	    continue
	fi

	mkdir -p ${urllist}

	if test ${?} -eq 0 ; then
	    chown ${SQUID_UID}:${SQUID_GID} ${urllist}
	    touch ${urllist}/{domains,urls,expressions}
	    if test ${?} -eq 0 ; then
		chown -R cache:cache ${urllist} && \
		    chmod 500 ${urllist} && \
		    chmod 400 ${urllist}/{domains,urls,expressions}
		ret=${?}
		test ${log_mode} == "nolog" || log-result ${ret}
	    else
		test ${log_mode} == "nolog" || log-result 4
	    fi
	else
	    test ${log_mode} == "nolog" || log-result 5
	fi
    done
}

del-urllists()
{
    local urllists2del=${*}

    local urllist file
    local ret1=0 ret2=0 ret3=0 ret
    
    cd ${PROXY_GUARD_DIR}

    for urllist in ${urllists2del}
    do
	log "Deleting the '${urllist}' URL list"

	if test ${APL_ROLE} == manager ; then
	    rm -f ${URLLIST_VAR_DIR}/${urllist}.*.*.gz
	    log-result 0
	    continue
	fi

	file=${URLLIST_DIR}/${urllist}.${URLLIST_AUTO}

	test ! -f ${file} || mv -f ${file} ${file}.2del || ret1=1
	test ! -f ${file}.current || mv -f ${file}.current ${file}.current.2del	|| ret2=2
	test ! -d ${urllist} || mv -f ${urllist} ${urllist}.2del || ret3=4

	ret=$[${ret1} + ${ret2} + ${ret3}]
	log-result ${ret}
    done
}

add-del-urllists()
{
    test "${URLLIST_LIST}" != "${CURRENT_URLLIST_LIST}" || return 0

    local urllists2add
    local urllists2del

    local urllist current_urllist member suffix

    for urllist in ${URLLIST_LIST}
    do
	member=0
	for current_urllist in ${CURRENT_URLLIST_LIST}
	do
	    if test ${urllist} == ${current_urllist} ; then
		member=1
		break
	    fi
	done
	test ${member} -eq 1 || urllists2add="${urllist} ${urllists2add}"
    done

    for current_urllist in ${CURRENT_URLLIST_LIST}
    do
	member=0
	for urllist in ${URLLIST_LIST}
	do
	    if test ${urllist} == ${current_urllist} ; then
		member=1
		break
	    fi
	done
	test ${member} -eq 1 || urllists2del="${current_urllist} ${urllists2del}"
    done

    add-urllists log ${urllists2add}
    del-urllists ${urllists2del}
}

prebuild-urllist()
{
    add-del-urllists
    clear-urllists
    set-urllist-auto-load
}

gen-slapd-conf()
{
    local cpu_nb=$(grep '^processor' /proc/cpuinfo | wc -l)

    cat slapd.conf-constant
    echo
    cat slapd.conf-tuned
    echo "threadqueues $((cpu_nb/5 + 1))"
    echo

    local i=0 elt range
    local proto name ip port
    local uri uris ldap_uris ldaps_uris sldap_uris
    local tls_conf

    for elt in ${LDAP_SERVER_LIST}
    do
	range=$[${i} % 4]
	case ${range} in
	    0)
		proto=${elt}
		;;
	    1)
		name=${elt}
		;;
	    2)
		ip=${elt}
		;;
	    3)
		port=${elt}
		case ${proto} in
		    ldap)
			uri="ldap://${ip}:${port}"
			ldap_uris="${ldap_uris} ${uri}"
			;;
		    sldap)
			uri="ldap://${name}:${port}"
			sldap_uris="${sldap_uris} ${uri}"
			;;
		    ldaps)
			uri="ldaps://${name}:${port}"
			ldaps_uris="${ldaps_uris} ${uri}"
			;;
		    *)
			;;
		esac
		uris="${uris} ${uri}"
		;;
	    *)
		;;
	esac
	((i++))
    done

    ldap_uris=${ldap_uris:1}
    sldap_uris=${sldap_uris:1}
    ldaps_uris=${ldaps_uris:1}
    uris=${uris:1}

    cat <<EOF
database ldap
protocol-version 3
timeout bind=3 search=30
cancel abandon
lastmod off
chase-referrals yes
readonly yes
rebind-as-user yes
suffix "${DOMAIN_NAME_DN}"
uri "${uris}"
EOF

    if test -s ${LDAP_DIR}/${LDAP_CA} ; then
	if test -n "${LDAPS_CA}" ; then
	    tls_conf="tls_reqcert=demand tls_cacert=${LDAP_DIR}/${LDAP_CA}"
	else
	    tls_conf="tls_reqcert=never tls_cacert=${LDAP_DIR}/${LDAP_CA}"
	fi
    else
	tls_conf="tls_reqcert==never"
    fi

    if test -n "${sldap_uris}" ; then
	echo "tls start ${tls_conf}"
    else
	if test -z "${ldaps_uris}" ; then
	    echo "tls none"
	else
	    echo "tls ldaps ${tls_conf}"
	fi
    fi

    if test ${LDAP_BIND_MODE} == False ; then
	echo "idassert-bind bindmethod=none"
    else
	echo "idassert-bind bindmethod=simple"
	echo -e "\tbinddn=\"${LDAP_BIND_DN}\""
	echo -e "\tcredentials=\"${LDAP_BIND_PASSWORD}\""
    fi
}

gen-guard-dir()
{
    local chroot=${1}
    
    if test -n "${chroot}" ; then
	local len=${#PROXY_DIR}
	local log_dir=${PROXY_LOG_DIR:${len}}
	local guard_dir=${PROXY_GUARD_DIR:${len}}
    else
	local log_dir=${PROXY_LOG_DIR}
	local guard_dir=${PROXY_GUARD_DIR}
    fi

    echo "logdir ${log_dir}"
    echo "dbhome ${guard_dir}"
}

gen-tmp-guard-conf()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    test -n "${3}" || return 3
    local ftype=${1}
    local urllist=${2}
    local suffix=${3}

    gen-guard-dir chroot
    echo "ldapcachetime 300"
    cat ${CONF_DIR}/squidGuard.conf-constant

    local len=${#suffix}
    local tag=${suffix:0:$[${len}-1]}
    local extension

    case ${ftype} in
	${URLLIST_CREATE})
	    extension='.tmp'
	    ;;
	${URLLIST_UPDATE})
	    ;;
	*)
	    ;;
    esac

    echo "dest ${urllist} {"
    echo -e "\t${tag}list ${urllist}/${suffix}${extension}"
    echo "}"
    echo "acl {"
    echo -e "\tdefault {"
    echo -e "\t\tpass all"
    echo -e "\t}"
    echo "}"
}

urllist-is-used-by-sslmediate()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    local in_name=${1}
    local in_mode=${2}

    local name

    case ${in_mode} in
	user)
	    local sslmediate_exception_urllist_list=${SSLMEDIATE_EXCEPTION_URLLIST_LIST}
	    ;;
	system)
	    local sslmediate_exception_urllist_list=${CURRENT_SSLMEDIATE_EXCEPTION_URLLIST_LIST}
	    ;;
	*)
	    return 1
	    ;;
    esac


    for name in ${sslmediate_exception_urllist_list}
    do
	test ${name} != ${in_name} || return 0
    done

    return 11
}

