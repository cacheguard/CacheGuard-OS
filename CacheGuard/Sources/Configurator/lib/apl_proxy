gen-squid-general-rweb()
{
    test ${RWEB_MODE} == True || return 0

    local elt range i=0
    local options="originserver no-query connect-timeout=3 weighted-round-robin login=PASS"
    
    if test ${PROXY2_MODE} == True ; then
	if test ${TRANSPARENT_MODE} == True ; then

	    test ${GUARD_MODE} == False || \
		echo "cache_peer ${IP_WEB_IP} parent ${WWW_PORT} 0 originserver no-query connect-timeout=3 name=self-server"

	    local nb=1

	    for elt in ${RWEB_HTTP_NAME_IP_LIST}
	    do
		range=$[${i} % 2]
		case ${range} in
		    0)
			;;
		    1)
			ip=${elt}
			echo "cache_peer ${ip} parent ${WWW_PORT} 0 ${options} weight=50 name=backend-${nb}"
			((nb++))
			;;
		    *)
			return 1
			;;
		esac
		((i++))
	    done
	fi

	return 0
    fi

    local host_nb=1 nb=1
    local protocol ip port weight name tls url ip_tls tls_id
    local host names name_name

    test ${GUARD_MODE} == False || \
	echo "cache_peer ${IP_WEB_IP} parent ${WWW_PORT} 0 originserver no-query connect-timeout=3 name=self-server"

    i=0
    for elt in ${RWEB_HOST_SITES_LIST}
    do
	range=$[${i} % 2]
	case ${range} in
	    0)
		host=${elt//_/ }
		;;
	    1)
		names=$(colon2space ${elt})
		
		protocol=$(get-nth-arg 1 ${host})
		ip=$(get-nth-arg 2 ${host})
		port=$(get-nth-arg 3 ${host})
		weight=$(get-nth-arg 4 ${host})

		case ${protocol} in
		    http)
			echo "cache_peer ${ip} parent ${port} 0 ${options} weight=${weight} name=backend-${host_nb}"
			;;
		    https)
			name=$(get-nth-arg 1 ${names})
			name_name=${name/,*}
			echo "cache_peer ${ip} parent ${port} 0 ${options} weight=${weight} name=backend-${host_nb} tls tls-cafile=${PROXY_SSL_CA_RDIR}/ca-bundle.crt sslcapath=${PROXY_SSL_LOCAL_CA_RDIR} ssldomain=${name_name}"
			;;
		    *)
			;;
		esac
		((host_nb++))
		;;
	    *)
		return 255
		;;
	esac
	((i++))
    done

    local http_options="accel vport"
    local https_options="${http_options} ${PROXY_SSL_OPTIONS}"

    for ip in ${RWEB_HTTP_IP_LIST}
    do
	echo "http_port ${ip}:${WWW_PORT} ${http_options}"
    done

    for ip_tls in ${RWEB_HTTPS_IP_TLS_LIST}
    do
	ip=${ip_tls/:*}
	tls=${ip_tls#*:}
	tls_id=${tls/:*}

	if test -s ${PROXY_SSL_SERVER_DIR}/${tls_id}.key ; then
	    if test -s ${PROXY_SSL_SERVER_DIR}/${tls_id}.certificate+chain ; then
		echo "https_port ${ip}:${HTTPS_PORT} tls-cert=${PROXY_SSL_RDIR}/${tls_id}.certificate+chain tls-key=${PROXY_SSL_RDIR}/${tls_id}.key ${https_options}"
	    elif test -s ${PROXY_SSL_SERVER_DIR}/${tls_id}.certificate ; then
		echo "https_port ${ip}:${HTTPS_PORT} tls-cert=${PROXY_SSL_RDIR}/${tls_id}.certificate tls-key=${PROXY_SSL_RDIR}/${tls_id}.key ${https_options}"
	    fi
	fi
    done
    
    i=0 nb=1
    for elt in ${RWEB_SITE_STANDBY_LIST}
    do
	range=$[${i} % 3]
	case ${range} in
	    0)
		name=${elt}
		;;
	    1)
		protocol=${elt}
		;;
	    2)
		url=${elt}
		echo "http_reply_access deny standby-${nb}"
		case ${protocol} in
		    none)
			echo "deny_info INF_STANDBY_WEBSITE standby-${nb}"
			;;
		    *)
			echo "deny_info ${protocol}://${url} standby-${nb}"
			;;
		esac
		((nb++))
		;;
	    *)
		return 1
		;;
	esac
	((i++))
    done
}

gen-squid-general-peer()
{
    local options
    local ip port
    local i=0 elt range

    if test -n "${PEER_HA_LIST}" -o -n "${PEER_SHARE_LIST}" ; then
	echo "http_port ${IP_PEER_IP}:${PEER_HTTP_PORT}"
	echo "htcp_port ${PEER_HTCP_PORT}"
    fi

    options="connect-timeout=3 htcp"

    for elt in ${PEER_SHARE_LIST}
    do
	range=$[${i} % 2]
	case ${range} in
	    0)
		ip=${elt}
		;;
	    1)
		echo "cache_peer ${ip} sibling ${PEER_HTTP_PORT} ${PEER_HTCP_PORT} proxy-only ${options}"
		;;
	    *)
		return 1
		;;
	esac
	((i++))
    done
    
    i=0

    for elt in ${PEER_HA_LIST}
    do
	range=$[${i} % 2]
	case ${range} in
	    0)
		ip=${elt}
		;;
	    1)
		echo "cache_peer ${ip} sibling ${PEER_HTTP_PORT} ${PEER_HTCP_PORT} ${options}"
		;;
	    *)
		return 1
		;;
	esac
	((i++))
    done

    for elt in ${PEER_NEXT_LIST}
    do
	range=$[${i} % 2]
	case ${range} in
	    0)
		ip=${elt}
		;;
	    1)
		if test "${elt}" == nil ; then
		    port=${PROXY_PORT}
		else
		    port=${elt}
		fi
		echo "cache_peer ${ip} parent ${port} 0 connect-timeout=5 no-query sourcehash weight=50"
		;;
	    *)
		return 1
		;;
	esac
	((i++))
    done
    test -z "${PEER_NEXT_LIST}" || echo "never_direct allow all"
    echo
}

gen-squid-general-av-compress()
{
    local HACK=yes

    test ${WEB_MODE} == True -o ${TRANSPARENT_MODE} == True || return 0

    if test ${AV_MODE} == True ; then
	if test ${AV_RESTRICT} == True ; then
	    local bypass=off
	else
	    local bypass=on
	fi
	local users=$[${USERS_NB} + ${RUSERS_NB}]
	local icap_options="ipv6=off routing=off on-overload=wait bypass=${bypass} max-conn=${users}"

	echo "icap_enable on"
        echo "icap_service antivirus_request reqmod_precache icap://${ICAP_LOCAL_IP}:${ICAP_PORT}/avscan ${icap_options}"
        echo "icap_service antivirus_response respmod_precache icap://${ICAP_LOCAL_IP}:${ICAP_PORT}/avscan ${icap_options}"
    fi

    if test ${COMPRESS_MODE} == True ; then
	local ecap_options="bypass=off routing=off"
	echo "ecap_enable on"
	echo "loadable_modules /lib/ecap_adapter_gzip.so"
	echo "ecap_service compress_response respmod_precache ecap://localhost/compress ${ecap_options}"
    fi

    if test ${COMPRESS_MODE} == True -o ${AV_MODE} == True ; then

	test ${COMPRESS_MODE} == False -o ${AV_MODE} == False || echo "adaptation_service_chain antivirus_compress_response antivirus_response compress_response"

	local ip
	local i=0 nb=1 elt range

	for elt in ${PEER_SHARE_LIST} ${PEER_HA_LIST}
	do
	    range=$[${i} % 2]
	    case ${range} in
		0)
		    ip=${elt}
		    ;;
		1)
		    if test ${AV_MODE} == True ; then
			echo "adaptation_access antivirus_request deny to-peer-ip-${nb}"
			if test ${COMPRESS_MODE} == True ; then
			    if test -z "${HACK}" ; then
				echo "adaptation_access antivirus_compress_response deny to-peer-ip-${nb}"
			    else
				echo "adaptation_access antivirus_response deny to-peer-ip-${nb}"
			    fi
			else
			    echo "adaptation_access antivirus_response deny to-peer-ip-${nb}"
			fi
		    else
			test ${COMPRESS_MODE} == False || echo "adaptation_access compress_response deny to-peer-ip-${nb}"
		    fi
		    ((nb++))
		    ;;
		*)
		    return 1
		    ;;
	    esac
	    ((i++))
	done

	if test ${AV_MODE} == True ; then
	    if test -s ${PROXY_DOMAIN_LIST_DIR}/${AV_WHITELIST_DOMAIN_FILENAME} ; then
		echo "acl av-whitelist-domains dstdomain \"${PROXY_DOMAIN_LIST_DIR/${PROXY_DIR}}/${AV_WHITELIST_DOMAIN_FILENAME}\""
		echo "adaptation_access antivirus_request deny av-whitelist-domains"
	    fi
	    echo "adaptation_access antivirus_request deny connect"
	    echo "adaptation_access antivirus_request allow all"

	    if test ${COMPRESS_MODE} == True ; then
		if test -z "${HACK}" ; then
