		test -z "${ACL_NOT_PEERS}" || options="${options} ${ACL_NOT_PEERS}"
		test -z "${ACL_NOT_RWEB_SITES}" || options="${options} ${ACL_NOT_RWEB_SITES}"

		if test -n "${syslog}" ; then
		    echo "access_log syslog:local5.info logformat=forward-syslog ${options}"
		else
		    echo "access_log daemon:/var/log/${WEB_LOG} logformat=forward ${options}"
		fi
	    else

		test -z "${ACL_NOT_PEERS}" || options="${options} ${ACL_NOT_PEERS}"
		if test -n "${syslog}" ; then
		    echo "access_log syslog:local5.info logformat=forward-syslog ${options}"
		else
		    echo "access_log daemon:/var/log/${WEB_LOG} logformat=forward ${options}"
		fi
	    fi
	fi
    fi

    if test ${PERSISTENT_RWEB_LOG} == True -a ${LOG_TYPE_RWEB/:*} == True ; then
	if test ${RWEB_MODE} == True -a ${PROXY2_MODE} == False ; then
	    local acl options="!squid-internal !from-ext-ip"
	    for acl in ${ACL_RWEB_SITES}
