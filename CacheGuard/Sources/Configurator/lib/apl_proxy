}

gen-squid-acl-web()
{
    local range i=0 nb=1 elt
    local interface ip px

    test ${WEB_MODE} == True || return 0

    echo "acl proxy_port localport ${PROXY_PORT}"

    for elt in ${ACCESS_IF_IP_PX_WEB_LIST}
    do
	range=$[${i} % 4]
	case ${range} in
	    0)
		interface=${elt}
		;;
	    1)
		ip=${elt}
		;;
	    2)
		px=${elt}
		;;
	    3)
		echo "acl from-client-ip-${nb} src ${ip}/${px}"
		((nb++))
		;;
	    *)
		return 1
		;;
	esac
	((i++))
    done
}

gen-squid-acl-tweb()
{
    local range i=0 nb=1 elt
    local ip px

    test ${TRANSPARENT_MODE} == True || return 0

    echo "acl thttp_port localport ${WWW_PORT}"
    test ${SSLMEDIATE_TRANSPARENT_MODE} == False || echo "acl thttps_port localport ${HTTPS_PORT}"

    for elt in ${TRANSPARENT_IF_IP_PX_LIST}
    do
	range=$[${i} % 4]
