gen-squid-general-guard()
{
    # Respect the order in compliance with the suspension mode

    test ${AV_MODE} == False || echo "url_rewrite_access deny localhost"
    if test ${RWEB_MODE} == True ; then
	local acl
	for acl in ${ACL_RWEB_SITES}
	do
	    echo "url_rewrite_access deny ${acl}"
	done
	echo "url_rewrite_access allow all"
    fi
    test ${GUARD_MODE} == True || return 0
    echo "url_rewrite_program /bin/squidGuard -c /etc/squidGuard.conf -P"
}

