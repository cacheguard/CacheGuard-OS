set-proxy2-parameters-new()
{
    set-new-proxy2-mode configurator
}

set-proxy2-parameters-cur()
{
    export CURRENT_PROXY2_MODE=False
    test ${CURRENT_RWEB_MODE} == True || return 0

    if test "${CURRENT_WAF_MODE}" == True ; then
	CURRENT_PROXY2_MODE=True
	return 0
    fi

    ! single-rweb-host "${CURRENT_RWEB_SITE_HOSTS_LIST}" || return 0
    is-basic-rweb-balancer "${CURRENT_RWEB_SITE_BALANCER_LIST}" || CURRENT_PROXY2_MODE=True
}

get-proxy-proxy2-ratio-pct()
{
    test -n "${1}" || return 1
    local proxy2_mode=${1}

    local ratio

    if test ${proxy2_mode} == False ; then
	((ratio = 100))
    else
	((ratio = SIMULTANEOUS_USERS_NB * 100 / (SIMULTANEOUS_USERS_NB + RUSERS_NB)))
    fi

    echo -n ${ratio}
}

set-proxy2-parameters-ratio()
{
    local ratio=$(get-proxy-proxy2-ratio-pct ${PROXY2_MODE})
    export PROXY_PROXY2_RATIO_PCT=${ratio}
}

get-proxy1-cache-buffer-sz()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    local free_memory_sz=${1}
    local proxy_proxy2_pct=${2}

    local cache_buffer_sz
    local margin margin_pct=10

    cache_buffer_sz=$[${free_memory_sz} * ${proxy_proxy2_pct} / 100]
    margin=$[${cache_buffer_sz} * ${margin_pct} / 100]
    cache_buffer_sz=$[${cache_buffer_sz} - ${margin}]

    echo -n ${cache_buffer_sz}
}

set-proxy1-parameters-new()
{    
    if test ${SSLMEDIATE_MODE} == True ; then
	if test ${SSLMEDIATE_TRANSPARENT} == True ; then
	    export SSLMEDIATE_TRANSPARENT_MODE=True
	else
	    export SSLMEDIATE_TRANSPARENT_MODE=False
	fi
    else
	export SSLMEDIATE_TRANSPARENT_MODE=False
    fi

    if test ${TRANSPARENT_MODE} == False ; then
	TPROXY_MODE=False
    else
	if test ${TNAT_MODE} == True ; then
	    TPROXY_MODE=False
	else
	    TPROXY_MODE=True
	fi
    fi

    if test ${WEB_MODE} == True -o ${TRANSPARENT_MODE} == True ; then
	SQUID_IS_ACTIVE=True
    elif test ${RWEB_MODE} == True -a ${PROXY2_MODE} == False ; then
	SQUID_IS_ACTIVE=True
    else
	SQUID_IS_ACTIVE=False
    fi
}

set-proxy1-parameters-cur()
{
    if test ${CURRENT_TRANSPARENT_MODE} == False ; then
	CURRENT_TPROXY_MODE=False
    else
	if test ${CURRENT_TNAT_MODE} == True ; then
	    CURRENT_TPROXY_MODE=False
	else
	    CURRENT_TPROXY_MODE=True
	fi
    fi

    if test ${CURRENT_WEB_MODE} == True -o ${CURRENT_TRANSPARENT_MODE} == True ; then
	CURRENT_SQUID_IS_ACTIVE=True
    elif test ${CURRENT_RWEB_MODE} == True -a ${CURRENT_PROXY2_MODE} == False ; then
	CURRENT_SQUID_IS_ACTIVE=True
    else
	CURRENT_SQUID_IS_ACTIVE=False
    fi
}

