clean-current-network-devices()
{
    local net nets len cur

    cd ${CONF_DIR}
    
    nets=$(ls -1 ifconfig.* 2> /dev/null)

    for net in ${nets}
    do
	len=${#net}
	test ${net:$[${len} - 4]:4} == ".old" || continue
