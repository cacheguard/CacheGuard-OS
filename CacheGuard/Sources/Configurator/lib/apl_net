    local ip=${1}

    if ip-is-included ${ip} ${IP_EXTERNAL_NET} ${IP_EXTERNAL_BRD} ${IP_EXTERNAL_MASK} ; then
	echo ${IF_EXTERNAL}
    elif ip-is-included ${ip} ${IP_AUXILIARY_NET} ${IP_AUXILIARY_BRD} ${IP_AUXILIARY_MASK} ; then
	echo ${IF_AUXILIARY}
    else
	
	if test ${VLAN_MODE} == False ; then
