get-broadcast-address()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    local ip=${1}
    local mk=${2}

    if test ${ip} == '0.0.0.0' -a ${mk} == '0.0.0.0' ; then
	echo '0.0.0.0'
    else
	local bd=$(ipcalc -s ${ip} ${mk} -b)
	bd=${bd/BROADCAST=}
	echo ${bd}
    fi
}

