    local val ; if test "${HA_MODE}" == "True" ; then val=1 ; else val=0 ; fi

    set-arp-ignore-1 ${IF_EXTERNAL} ${IP_EXTERNAL_IP} ${IP_EXTERNAL_MASK} ${val}
    set-arp-ignore-1 ${IF_WEB} ${IP_WEB_IP} ${IP_WEB_MASK} ${val}
