CACHEGUARD_DIR=/etc/sysconfig/cacheguard
source ${CACHEGUARD_DIR}/constant

change-vpnsubscr-password()
{
    test -n "${1}" || return 1
    local username=${1}
    local password=${2}
    test ${username} == ${ADMIN_NAME} || return 0

    test -f ${EMBEDDED_VPNSUBSCR_DB_FILE} || return 11

    password=$(echo -n ${password} | openssl dgst -sha1)
    password=${password#* }

    sqlite3 ${EMBEDDED_VPNSUBSCR_DB_FILE} << EOFSQL
UPDATE administrator SET password = '${password}' WHERE username = '${username}';
EOFSQL
}

main()
{
    change-vpnsubscr-password "${@}"
}

# Main()

main "${@}"
