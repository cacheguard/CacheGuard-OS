VPNSUBSCR_PRIVATE_KEY_LENGTH=2048
VPNSUBSCR_CERTIFICATE_DAYS=5555
VPNSUBSCR_CERTIFICATE_COUNTRY='@DEFAULT_COUNTRY_CODE@'
VPNSUBSCR_CERTIFICATE_PROVINCE='Security'
VPNSUBSCR_CERTIFICATE_LOCALITY='Free'
VPNSUBSCR_CERTIFICATE_ORGANISATION='Private'
VPNSUBSCR_CERTIFICATE_UNIT='VPN'

VPNSUBSCR_IKE_ENCRYPTION=aes256
VPNSUBSCR_IKE_INTEGRITY=sha256
VPNSUBSCR_IKE_DIFFIE_HELLMAN=modp2048
VPNSUBSCR_ESP_ENCRYPTION=aes256
VPNSUBSCR_ESP_INTEGRITY=sha256

VPNSUBSCR_NETWORK=172.23.0.0/16
