dialog-raid-config()
{
    test ${DISK_NB} -ge 2 || return 0
    test "${APL_MODEL}" != 'test' || return 0

    ${DIALOG} --backtitle "${INSTALL_BACKTITLE} Installation" --title "RAID Configuration" --yesno "\nMore than one disk has been detected. We highly recommend that you configure them as a RAID (Redundant Array of Independent Disks). Note that to install the OS in Test mode you should say \"No\" here.\n\nDo you want to install your disks as a RAID?" 0 0

    if test ${?} -ne ${DIALOG_OK} ; then
	export RAID_STATE=0
	export RAID_SPARE_NB=0
	export RAID_SZ=0
	export RAID_DISK_SZ=0
	return 0
    fi

    export RAID_STATE=1

    local level spare levels="0 1"
    local state label hint i=0

    if test ${DISK_NB} -gt 2 ; then
	levels="${levels} 5"	
	if test ${DISK_NB} -gt 3 ; then
	    levels="${levels} 6 10"
	fi
    fi

    rm -f /tmp/${RAID_MENU_FILE}

    for level in ${levels}
    do
	if test ${level} == ${RAID_LEVEL} ; then
	    state=on
	else
	    state=off
	fi
	
	case ${level} in
	    0)
		label="Striping across ${DISK_NB} disks"
		hint="Immproves performances but is not fault tolerant - Size = sum of all disk sizes"
		;;
	    1)
		if test ${DISK_NB} -eq 2 ; then
		    label="Mirroring 2 disks"
		else
		    spare=$[${DISK_NB} - 2]
		    if test ${spare} -eq 1 ; then
			label="Mirroring 2 disks (1 Hot Spare disk)"
		    else
			label="Mirroring 2 disks (${spare} Hot Spare disks)"
		    fi
		fi
		hint="Improves availability and performances - Size = 50% of a single disk size"
		;;
	    5)
		if test ${DISK_NB} -eq 3 ; then
		    label="Striping and Checksum"
		else
		    label="Striping and Checksum (1 mandatory Hot Spare disk)"
		fi
		hint="Improves availability and performances - Size = size of a single disk x (number of disks - 1)"
		;;
	    6)
		if test ${DISK_NB} -eq 4 ; then
		    label="Striping and 2 x Checksum"
		else
		    label="Striping and 2 x Checksum (1 optional Hot Spare disk)"
		fi
		hint="Improves availability and performances - Size = size of a single disk x (number of disks - 2)"
		;;
	    10)
		if test ${DISK_NB} -eq 4 ; then
		    label="Mirroring and Striping"
		else
		    label="Mirroring and Striping (1 mandatory Hot Spare disk)"
		fi
		hint="Improves availability and performances - Size = (sum of all disk sizes) / 2"
		;;
	esac
	echo "\"RAID ${level}\" \"${label}\" ${state} \"${hint}\"" >> /tmp/${RAID_MENU_FILE}
    done

    ${DIALOG} --backtitle "${INSTALL_BACKTITLE} Installation" --title "RAID Level" --item-help --radiolist "\nThe software RAID manager integrated into this system uses around  3% of the CPU resources with no additional cost of a hardware RAID. This RAID system could be fully monitored using SNMP. ${DISK_NB} disks have been detected on this machine. The current RAID size is $[${RAID_SZ} / 1024] MB. \n\nPlease select the required RAID level (press the Space Bar to select):" 0 0 5 --file /tmp/${RAID_MENU_FILE} 2> /tmp/${RAID_LEVEL_FILE}

    level=$(cat /tmp/${RAID_LEVEL_FILE})

    if test "${level}" == "RAID 0" ; then
	export RAID_LEVEL=0
	export RAID_SPARE_NB=0
	calculate-raid-size
	return 0
    elif test "${level}" == "RAID 1" ; then
	export RAID_LEVEL=1
	export RAID_SPARE_NB=$[${DISK_NB} - 2]
	calculate-raid-size
	dialog-raid-available
	return 0
    elif test "${level}" == "RAID 5" ; then
	export RAID_LEVEL=5
	if test ${DISK_NB} -eq 3 ; then
	    export RAID_SPARE_NB=0
	else
	    export RAID_SPARE_NB=1
	fi
	calculate-raid-size
	dialog-raid-available
	return 0
    elif test "${level}" == "RAID 6" ; then
	export RAID_LEVEL=6
	if test ${DISK_NB} -eq 4 ; then
	    export RAID_SPARE_NB=0
	    calculate-raid-size
	    dialog-raid-available
	    return 0
	fi
    elif test "${level}" == "RAID 10" ; then
	export RAID_LEVEL=10
	if test ${DISK_NB} -eq 4 ; then
	    export RAID_SPARE_NB=0
	else
	    export RAID_SPARE_NB=1
	fi
	calculate-raid-size
	dialog-raid-available
	return 0
    else
	return 255
    fi

    ${DIALOG} --backtitle "${INSTALL_BACKTITLE} Installation" --title "RAID Hot Spare Disk" --yesno "\nThe RAID level (RAID ${RAID_LEVEL}) you've selected and the number of disks (${DISK_NB}) on this machine allow you to use a disk as a Hot Spare.\n\nDo you want to use a disk as a Hot Spare for your RAID configuration?" 11 50

    if test ${?} -eq ${DIALOG_OK} ; then
	export RAID_SPARE_NB=1
    else
	export RAID_SPARE_NB=0
    fi
    
    calculate-raid-size
}

dialog-read-gateway-persistency()
{
    local statuses status ret
    local check_cache check_log check_rlog

    while true
    do
	${DIALOG} --backtitle "${INSTALL_BACKTITLE} ${APL_ROLE^} Installation" --title "Persistency Features" --no-cancel --help-button --checklist "\nPlease select persistent data to activate:\n(press the Space Bar to tick/untick)" 12 50 3 \
	    cache "Web Caching" ${PERSISTENT_CACHE} \
	    log "Web access Logging" ${PERSISTENT_WEB_LOG} \
	    rlog "Reverse Web access Logging" ${PERSISTENT_RWEB_LOG} \
	    2> /tmp/${PERSISTENCY_FILE}

	ret=${?}
	if test ${ret} -eq ${DIALOG_HELP} ; then
	    ${DIALOG} --backtitle "${INSTALL_BACKTITLE} Installation" --title "Persistency Features" --colors --msgbox "\nIf your disk(s) is (are) not large enough you can deactivate some features that require substantial storage space on your disk(s). The deactivation of those features allows you to install the OS on machines with low disk storage capacity. Please note that if you deactivate those features during the installation, you won't be able to activate them afterwards on a running OS. Below is a brief description of persistent data that you can deactivate:\n\n\Z4Web Caching:\Zn Web Caching allows you to persistently store Web contents on disk in order to reduce bandwidth usage and Web servers load (in reverse mode).\n\n\Z4Web access Logging:\Zn this mechanism allows you to persistently store on disk Web browsing activities.\n\n\Z4Reverse Web access Logging:\Zn this mechanism is similar to the previous one with the difference being that it stores traffic on cloaked (protected) Web servers managed by the reverse Web proxy." 0 0
	    continue
	fi

	unset check_cache
	unset check_log
	unset check_rlog

	read statuses < /tmp/${PERSISTENCY_FILE}

	for status in ${statuses}
	do
	    case ${status} in
		cache)
		    check_cache=on
		    ;;
		log)
		    check_log=on
		    ;;
		rlog)
		    check_rlog=on
		    ;;
		*)
		    ;;
	    esac
	done
	break
    done

    set-persistency-cache ${check_cache}
    set-persistency-web-log ${check_log}
    set-persistency-rweb-log ${check_rlog}
}

dialog-read-gateway-capacities()
{
    local line i=0 ret level
    local check_users check_urllists
    local check_rusers check_rweb
    local check_logrotate
    local check_uploaded
    local check_limit_disk

    while true
    do
	${DIALOG} --backtitle "${INSTALL_BACKTITLE} ${APL_ROLE^} Installation" --title "Capacity Settings" --no-cancel --help-button --form "\nPlease enter required capacity to support:\n(use arrow keys)" 0 0 7 \
	    "Number of users in forwarding mode:" 1 1 "${USERS_NB}" 1 ${DIALOG_CAPACITY_TITLE_LEN} 6 0 \
	    "Number of URLs in blacklists:" 2 1 "${URLLIST_RECORDS_NB}" 2 ${DIALOG_CAPACITY_TITLE_LEN} 10 0 \
	    "Number of simultaneous users in reverse mode:" 3 1 "${RUSERS_NB}" 3 ${DIALOG_CAPACITY_TITLE_LEN} 6 0 \
	    "Number of websites in reverse mode:" 4 1 "${RWEB_NB}" 4 ${DIALOG_CAPACITY_TITLE_LEN} 4 0 \
	    "Cache size per reverse website (MB):"  5 1  "${RWEB_CACHE_SZ}" 5 ${DIALOG_CAPACITY_TITLE_LEN} 7 0 \
	    "Logs retention period:" 6 1 "${LOGROTATE_NB}" 6 ${DIALOG_CAPACITY_TITLE_LEN} 4 0 \
	    "Uploaded file maximum size (MB):" 7 1 "${MAX_UPLOAD_FILE_SZ}" 7 ${DIALOG_CAPACITY_TITLE_LEN} 5 0 \
	    2> /tmp/${CAPACITY_FILE}

	ret=${?}
	if test ${ret} -eq ${DIALOG_HELP} ; then
	    ${DIALOG} --backtitle "${INSTALL_BACKTITLE} ${APL_ROLE^} Installation" --title "Input values" --colors --msgbox "\nInput values here allow you to tune the installed appliance for a given capacity to support. Theses values should be compatible with your machine resource capacity so all entered values are verified during the installation for acceptance. Please note that entered values may be subject to usage allowance according to the licensing in force for this version during the installation. Below is a brief description of input values:\n\n\Z4Number of users in forwarding mode:\Zn the total number of end-users (not simultaneous) in forwarding or transparent mode to access the internet via this appliance. The simultaneous number of managed end-users in forwarding mode will be 20% of the total number of end-users given here. \Z1Caution: if you run CacheGuard beyond its installed users capacity, your network traffic can be slowed down or be blocked.\Zn\n\n\Z4Number of URLs in blacklists:\Zn the total number of domain names and URLs in blacklists.\n\n\Z4Number of simultaneous users in reverse mode:\Zn simultaneous number of users accessing your Web servers cloaked by the appliance in reverse mode. Please note that the simultaneous number of end-users are distinguished from concurrent end-users. We call simultaneous end-users, users that have an active connection with the appliance while concurrent users may be connected without producing any significant traffic. \Z1Caution: if you run CacheGuard beyond its installed users capacity, your network traffic can be slowed down or be blocked.\Zn\n\n\Z4Number of websites in reverse mode:\Zn the total number of protected/cloaked websites identified by their names.\n\n\Z4Cache size per reverse website (MB):\Zn reserved cache size (on disk) in Mega Bytes for each reverse website (rWeb). The rWeb cache is only used in particular configurations (WAF mode, sticky load balancing...). Otherwise reverse websites share the same cache as for end-users in forwarding mode. If your machine contains more the one disk, the rWeb cache is created on the largest one.\n\n\Z4Logs retention period:\Zn number of days for log reports retention in the system. This value should be greater than or equal to 1 and less than or equal to 31.\n\n\Z4Uploaded file maximum size (MB):\Zn because uploaded files to protected Web servers (in reverse mode) are streamed to disk, the maximum allowed size for uploaded files (Content-Type: multipart/form-data) should be specified here to reserve the required temporary space on disk. The reserved space is calculated according to the value given here and the simultaneous users capacity for reverse websites. This value should be greater than or equal to 1 MB and less than or equal to 1024 MB." 0 0
	    continue
	fi

	i=0
	unset check_users
	unset check_urllists
	unset check_rusers
	unset check_rweb
	unset check_rcache
	unset check_logrotate
	unset check_uploaded
	unset check_limit_disk

	while read line
	do
	    case ${i} in
		0)
		    set-users "${line}" || check_users=false
		    ;;
		1)
		    set-guards "${line}" || check_urllists=false
		    ;;
		2)
		    set-rusers "${line}" || check_rusers=false
		    ;;
		3)
		    set-rwebs "${line}" || check_rweb=false
		    ;;
		4)
		    set-rcache "${line}" || check_rcache=false
		    ;;
		5)
		    set-logrotates "${line}" || check_logrotate=false
		    ;;
		6)
		    set-uploaded-files "${line}" || check_uploaded=false
		    ;;
		*)
		    ;;
	    esac
	    ((i++))
	done < /tmp/${CAPACITY_FILE}

	if test \
	       -z "${check_users}" -a \
	       -z "${check_urllists}" -a \
	       -z "${check_rusers}" -a \
	       -z "${check_rweb}" -a \
	       -z "${check_logrotate}" -a \
	       -z "${check_rcache}" -a \
	       -z "${check_uploaded}" -a \
	       -z "${check_limit_disk}" ; then
	    level=$(get-usage-level)

	    break

	    test ${level} -ne 0 || break

	    ${DIALOG} --backtitle "${INSTALL_BACKTITLE} ${APL_ROLE^} Installation" --title "Commercial Configuration" --colors --yesno "\n\Z5Warning:\Zn the configuration you are about to install is not free (forward users > \Z4${LIC_USERS_NB_0}\Zn and/or reverse simultaneous users > \Z4${LIC_RUSERS_NB_0}\Zn).\n\nIf you choose to install this configuration, you will have the opportunity to evaluate the installed system for a trial period. Once this trial period has been exceeded, you should purchase a subscription in order to continue to use the installed system. \Z5Please note that underestimating the number of users would slowdown your network traffic\Zn.\n\nDo you want to install this configuration?" 18 60

	    test ${?} -ne ${DIALOG_OK} || break
	else
	    ${DIALOG} --backtitle "${INSTALL_BACKTITLE} ${APL_ROLE^} Installation" --title "${COMMERCIAL_NAME}-OS Installation" --msgbox "\nThese data fields accept numeric values only. All values are mandatory." 0 0
	fi
    done
}

