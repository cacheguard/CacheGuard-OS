find-cpus()
{
    local info_file=/proc/cpuinfo

    local cpu_nb=$(grep '^processor' ${info_file} | wc -l)
    local model_name=$(grep '^model name' ${info_file} | head -1) ; model_name=${model_name/model name*: /}
    local cache_size=$(grep '^cache size' ${info_file} | head -1) ; cache_size=${cache_size/cache size*: /}

    echo "${model_name}, ${cache_size} Cache" > /tmp/${CPU_FILE}

    export CPU_NB=${cpu_nb} ; echo ${cpu_nb} > /tmp/VARIABLE_CPU_NB
}

do-ordered-disk-info()
{
    if test ${RAID_STATE} -eq 1 ; then
	export DISK_INFOS_ORDERED="raid${RAID_LEVEL} x:1 ${RAID_SZ}"
	return 0
    elif test ${OS_DISK_ID} == x:1 -o ${OS_DISK_ID} == 0:1 ; then
	export DISK_INFOS_ORDERED=${DISK_INFOS}
	return 0
    fi

    local disk_infos_ordered os_info disk
    local elt i=0 range
    local type disk_id disk_size

    for elt in ${DISK_INFOS}
    do
	range=$[${i} % 3]
	case ${range} in
	    0)
		type=${elt}
		;;
	    1)
		disk_id=${elt}
		;;
	    2)
		disk_size=${elt}
		disk=$[${i} / 3 + 1]

		if test "x:${disk}" == "${OS_DISK_ID}" -o "0:${disk}" == "${OS_DISK_ID}" ; then
		    os_info="${type} ${disk_id} ${disk_size}"
		else
		    disk_infos_ordered="${disk_infos_ordered} ${type} ${disk_id} ${disk_size}"
		fi
		;;
	    *)
		return 255
		;;
	esac
	((i++))
    done
    disk_infos_ordered="${os_info}${disk_infos_ordered}"

    export DISK_INFOS_ORDERED=${disk_infos_ordered}
}

display-disks()
{
    local elt
    local i=0 range
    local type size disk

    for elt in ${DISK_INFOS}
    do
	range=$[${i} % 3]
	case ${range} in
	    0)
		type=${elt}
		;;
	    1)
		;;
	    2)
		size=${elt}
		disk=$[${i}/3 + 1]
		echo -n "DK [${disk}]: ($[${size} / 1024 / 1024 ] GB) "
		;;
	    *)
		return 255
		;;
	esac
	((i++))
    done
}

display-disks-info()
{
    if test ${DISK_NB} == 0 ; then
	echo "\Z1${TAB_BULLET}${Errors[3]}\Zn"
	return 0
    else
	echo "\Z4${BULLET}Disk(s):\Zn"
	echo -n "${TAB_BULLET}"
	display-disks
    fi
}

gen-hw-drive-file()
{
    display-disks
}

find-disks()
{
    local usb_disk

    if test "${INSTALL}" == iso -a "${MEDIA_TYPE}" == usb ; then
	usb_disk=${MEDIA_DEVICE/[0-9]*}
    else
	usb_disk=null
    fi

    sfdisk -s 2> /dev/null | grep --invert-match \
  				  --regexp="/dev/${usb_disk}" \
				  --regexp='/dev/ram' \
				  --regexp='/dev/mapper' \
				  --regexp='/dev/md' | head -n -1 > /tmp/${DISK_FILE}
    
    local dev size info
    local ide=1 scsi=1 nvme=1 virt=1 i=0
    local disk_infos disk_devices
    local name
    local nvme_ctrl_dk_ref nvme_ctrl_ref nvme_dk_ref
    local disk_id os_disk_id

    while read dev size
    do
	dev=${dev/:}
	name=${dev:5}

	test ${size} -gt $((FIRST_PARTITION_BEGINING_SECTOR + EFI_SZ + LVM_MD_SZ)) || return 5
	
	case ${name:0:2} in
	    hd)
		disk_id=x:${ide}
		info="ide ${disk_id} ${size}"
		((ide++))
		;;
	    sd)
		disk_id=x:${scsi}
		info="scsi ${disk_id} ${size}"
		((scsi++))
		;;
	    nv)
		nvme_ctrl_dk_ref=${name/nvme}
		nvme_ctrl_ref=${nvme_ctrl_dk_ref/n*}
		nvme_dk_ref=${nvme_ctrl_dk_ref/*n}
		disk_id=${nvme_ctrl_ref}:${nvme_dk_ref}
		info="nvme ${disk_id} ${size}"
		((nvme++))
		;;
	    vd)
		disk_id=x:${virt}
		info="virt ${disk_id} ${size}"
		((virt++))
		;;
	    *)
		unset info
		unset dev
		;;
	esac

	test ${i} -ne 0 || os_disk_id=${disk_id}
	test -z "${info}" || disk_infos="${disk_infos} ${info}"
	test -z "${dev}" || disk_devices="${disk_devices} ${dev}"
	((i++))
    done < /tmp/${DISK_FILE}

    disk_devices=${disk_devices:1}
    disk_infos=${disk_infos:1}

    ((ide--))
    ((scsi--))
    ((nvme--))
    ((virt--))

    if test ${ide} -gt 20 -o ${scsi} -gt 104 -o ${nvme} -gt 1024 -o ${virt} -gt 104 ; then
	return 6
    fi

    export DISK_DEVICES=${disk_devices} ; echo ${disk_devices} > /tmp/VARIABLE_DISK_DEVICES
    export DISK_INFOS=${disk_infos} ; echo ${disk_infos} > /tmp/VARIABLE_DISK_INFOS
    export DISK_NB=${i} ; echo ${i} > /tmp/VARIABLE_DISK_NB
    export OS_DISK_ID=${os_disk_id} ; echo ${os_disk_id} > /tmp/VARIABLE_OS_DISK_ID

    gen-hw-drive-file 2>> /tmp/${LOG_FILE} > ${GENERATED_DIR}/hw-drive
}

calculate-raid-size()
{
    test ${RAID_STATE} -eq 1 || return 0

    local elt i=0 range
    local size nb
    local raid_sz raid_disk_sz total_sz=0

    for elt in ${DISK_INFOS}
    do
	range=$[${i} % 3]
	case ${range} in
	    0|1)
		;;
	    2)
		size=$[${elt} - ${FIRST_PARTITION_BEGINING_SECTOR} - ${EFI_SZ}]
		size=$[${size} * ${RAID_SECURITY_PCT} / 100]
		total_sz=$[${total_sz} + ${size}]
		if test -z "${raid_disk_sz}" ; then
		    raid_disk_sz=${size}
		elif test ${size} -lt ${raid_disk_sz} ; then
		    raid_disk_sz=${size}
		fi
		;;
	    *)
		return 255
		;;
	esac
	((i++))
    done

    test -n "${raid_disk_sz}" || raid_disk_sz=0

    case ${RAID_LEVEL} in
	0)
	    if test ${DISK_NB} -lt 2 ; then
		return 30
	    fi

	    if test ${RAID_SPARE_NB} -ne 0 ; then
		return 31
	    fi
	    raid_sz=${total_sz}
	    ;;
	1)
	    nb=$[${DISK_NB} - ${RAID_SPARE_NB}]
	    if test ${nb} -lt 2 ; then
		return 32
	    fi
	    raid_sz=${raid_disk_sz}
	    ;;
	5)
	    nb=$[${DISK_NB}-${RAID_SPARE_NB}-1]
	    if test ${nb} -lt 2 ; then
		return 33
	    fi
	    raid_sz=$[${nb}*${raid_disk_sz}]
	    ;;
	6)
	    nb=$[${DISK_NB}-${RAID_SPARE_NB}-2]
	    if test ${nb} -lt 2 ; then
		return 34
	    fi
	    raid_sz=$[${nb}*${raid_disk_sz}]
	    ;;
	10)
	    nb=$[${DISK_NB}-${RAID_SPARE_NB}]
	    if test ${nb} -lt 4 ; then
		return 35
	    fi
	    raid_sz=$[(${nb}*${raid_disk_sz}) / 2]
	    ;;
	*)
	    ;;
    esac

    raid_disk_sz=$[${raid_disk_sz} / ${RAID_CHUNK_SZ}]
    raid_disk_sz=$[${raid_disk_sz} * ${RAID_CHUNK_SZ}]

    raid_sz=$[${raid_sz} / ${RAID_CHUNK_SZ}]
    raid_sz=$[${raid_sz} * ${RAID_CHUNK_SZ}]

    export RAID_SZ=${raid_sz}
    export RAID_DISK_SZ=${raid_disk_sz}

    echo "/dev/md${RAID_MD_NB}: ${RAID_SZ}" > /tmp/${MD_FILE}
}

set-default-raid()
{
    if test "${APL_MODEL}" == 'test' ; then
	export RAID_STATE=0
	unset RAID_LEVEL
	unset RAID_SPARE_NB
    else
	case ${DISK_NB} in
	    0|1)
		export RAID_STATE=0
		unset RAID_LEVEL
		unset RAID_SPARE_NB
		;;
	    2)
		export RAID_STATE=1
		export RAID_LEVEL=1
		export RAID_SPARE_NB=0
		;;
	    3)
		export RAID_STATE=1
		export RAID_LEVEL=1
		export RAID_SPARE_NB=1
		;;
	    *)
		export RAID_STATE=1
		export RAID_LEVEL=5
		export RAID_SPARE_NB=1
		;;
	esac
    fi

    echo ${RAID_STATE} > /tmp/VARIABLE_RAID_STATE
    echo ${RAID_LEVEL} > /tmp/VARIABLE_RAID_LEVEL
    echo ${RAID_SPARE_NB} > /tmp/VARIABLE_RAID_SPARE_NB

    calculate-raid-size
}

get-disk-type()
{
    test -n "${1}" || return 1
    local in_disk_id=${1}

    if test ${RAID_STATE} -eq 1 ; then
	echo raid
	return 0
    fi

    local elt
    local i=0 range
    local disk_type disk_id

    for elt in ${DISK_INFOS}
    do
	range=$[${i} % 3]
	case ${range} in
	    0)
		disk_type=${elt}
		;;
	    1)
		disk_id=${elt}
		;;
	    2)
		if test ${disk_id} == ${in_disk_id} ; then
		    echo ${disk_type}
		    return 0
		fi
		;;
	    *)
		return 255
		;;
	esac
	((i++))
    done

    echo xxx
    return 1
}

