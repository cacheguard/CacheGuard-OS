set-nic-names-table()
{
    unset INSTALL_NIC_NAMES
    INSTALL_NIC_NAMES_NB=0

    local nb name rest
    local links_file=/tmp/links.file.${$}
    local range i=0 j=0

    ip link > ${links_file}

    while read nb name rest
    do
	test -n "${rest}" || continue

	range=$[${i} % 2]
	case ${range} in
	    0)
		if test ${name} != lo: ; then
		    INSTALL_NIC_NAMES[${j}]=${name%:}
		    ((j++))
		fi
		;;
	    1)
		;;
	    *)
		return 255
		;;
	esac
	((i++))
    done < ${links_file}

    INSTALL_NIC_NAMES_NB=${j}
    rm -f ${links_file}
}

get-nic-name()
{
    test -n "${1}" || return 1
    local nic=${1}

    set-nic-names-table
    echo ${INSTALL_NIC_NAMES[${nic}]}
}

set-install-ip()
{
    local nic=${1}

    local nic_name used_nic_name
    local f1 f2 f3 ret

    touch /tmp/{VARIABLE_DHCP_SERVER_IP,VARIABLE_APL_IP,VARIABLE_TFTP_SERVER_IP}

    cat << EOF > ${INSTALL_DIR}/dhclient.conf
timeout 10;
retry 2;
select-timeout 0;
reboot 5;
backoff-cutoff 10;
initial-interval 5;
initial-delay 0;
script "/sbin/dhclient-script";
EOF
    echo "script \"/sbin/dhclient-script\";" >> ${INSTALL_DIR}/dhclient.conf

    if test -n "${nic}" ; then
	nic_name=$(get-nic-name ${nic})
	dhclient -1 -4 -v -lf ${INSTALL_DIR}/dhclient.leases -cf ${INSTALL_DIR}/dhclient.conf --no-pid ${nic_name} 2> /tmp/dhcp.info
	ret=${?}
	test ${ret} -ne 0 || used_nic_name=${nic_name}
    else
	set-nic-names-table
	local i

	for ((i=0 ; i<INSTALL_NIC_NAMES_NB ; i++))
	do
	    nic_name=${INSTALL_NIC_NAMES[${i}]}
	    dhclient -1 -4 -v -lf ${INSTALL_DIR}/dhclient.leases -cf ${INSTALL_DIR}/dhclient.conf --no-pid ${nic_name} 2> /tmp/dhcp.inf
	    ret=${?}
	    if test ${ret} -eq 0 ; then
		used_nic_name=${nic_name}
		break
	    fi
	done
    fi

    echo ${used_nic_name} > /tmp/VARIABLE_USED_NIC_NAME

    if test -n "${used_nic_name}" -a -f ${INSTALL_DIR}/dhclient.leases ; then
	while read f1 f2 f3
	do
	    test "${f1}" != option -o "${f2}" != dhcp-server-identifier || echo ${f3/;} > /tmp/VARIABLE_DHCP_SERVER_IP
	    test "${f1}" != fixed-address || echo ${f2/;} > /tmp/VARIABLE_APL_IP
	done < ${INSTALL_DIR}/dhclient.leases 2>> /tmp/${LOG_FILE}
    fi

    cp -f /tmp/VARIABLE_DHCP_SERVER_IP /tmp/VARIABLE_TFTP_SERVER_IP

    dhcp_server_ip=$(cat /tmp/VARIABLE_DHCP_SERVER_IP)
    apl_ip=$(cat /tmp/VARIABLE_APL_IP)
    tftp_server_ip=$(cat /tmp/VARIABLE_TFTP_SERVER_IP)

    echo

    if test -n "${dhcp_server_ip}" ; then

	echo "Used NIC: ${used_nic_name}"
	echo "DHCP server IP: ${dhcp_server_ip}"

	if test -n "${apl_ip}" ; then
	    echo "Assigned IP address: ${apl_ip}"
	else
	    echo "No IP address has been assigned"
	fi

	if test -n "${tftp_server_ip}" ; then
	    echo "Used TFTP server: ${tftp_server_ip}"
	else
	    echo "No TFTP server has been detected"
	fi
    else
	echo "No DHCP server has been detected"
    fi

    echo

    usleep 3000000
    return ${ret}
}

