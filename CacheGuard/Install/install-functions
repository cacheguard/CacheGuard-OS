gen-smartd-conf()
{
    local common_options="-d auto -T permissive -o off -S on -l selftest -n standby -F none -P use"
    local monitor_options="-H -s S/../.././04 -U 198 -C 197 -f -p -u -W 3,40,45"
    local exec_option="-m <nomailer> -M once -M exec ${LOCAL_DIR}/bin/apl_smart_monitor"

    local disk type_option i=0

    smartctl --scan-open > /tmp/${SMART_FILE}

    while read disk type_option
    do
	type_option=${type_option/\#*/}
	smartctl -i ${disk} > /tmp/${SMARTCTL_FILE}.${i} 2>> /tmp/${LOG_FILE}
	grep "SMART support is: Available" /tmp/${SMARTCTL_FILE}.${i} >> /tmp/${LOG_FILE} 2>&1
	test ${?} -eq 0 || continue

	echo -e "${disk} \\"
	echo -e "\t${common_options} \\"
	echo -e "\t${monitor_options} \\"
	echo -e "\t${exec_option}"

	((i++))
    done < /tmp/${SMART_FILE}
}

