mount-cdrom()
{
    test -b /dev/cdrom || return 11
    local cdrom1=$(readlink -e /dev/cdrom 2> /dev/null)
    test -n "${cdrom1}" || return 13

    local cdrom2=$(cat /proc/sys/dev/cdrom/info 2> /dev/null | grep "drive name:" 2> /dev/null | cut -f3)
    test -n "${cdrom2}" || return 15

    test ${cdrom1} == /dev/${cdrom2} || return 17

    mount /dev/cdrom ${MEDIA_DIR} >> /tmp/${LOG_FILE} 2>&1 || return 13

    export MEDIA_DEVICE=${cdrom2}
    echo ${MEDIA_DEVICE} > /tmp/VARIABLE_MEDIA_DEVICE
}

mount-usb()
{
    load-usb-modules
    modprobe --quiet usb_storage >> /tmp/${LOG_FILE} 2>&1

    local retries=10 i usb_disks

    for ((i=0 ; i<retries ; i++))
    do
	usb_disks=$(ls -d1 /dev/disk/by-id/usb-* 2> /dev/null)
	test -z "${usb_disks}" || break
	usleep 250000
    done
    test ${i} -lt ${retries} || return 11

    local first_usb_disk=${usb_disks/ *}

    local usb=$(readlink -e ${first_usb_disk} 2> /dev/null)

    wait4-file ${usb} b 10 250000 || return 13
    mount ${usb} ${MEDIA_DIR} 2>> /tmp/${LOG_FILE} || return 15

    export MEDIA_DEVICE=${usb:5}
    echo ${MEDIA_DEVICE} > /tmp/VARIABLE_MEDIA_DEVICE
}

mount-media()
{
    test "${INSTALL}" == iso || return 0

    mkdir -p ${MEDIA_DIR}
    umount ${MEDIA_DIR} 2>> /tmp/${LOG_FILE}

    if mount-cdrom ; then
	export MEDIA_TYPE=cdrom
    elif mount-usb ; then
	export MEDIA_TYPE=usb
    else
	unset MEDIA_TYPE
	return 1
    fi

    echo ${MEDIA_TYPE} > /tmp/VARIABLE_MEDIA_TYPE
    return 0
}

