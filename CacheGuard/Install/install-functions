debug()
{
    local variable
    echo -n "Press any key to continue..." ; read variable
}

reset-install-log()
{
    rm -f /tmp/${LOG_FILE}
}

dialog-debug()
{
    local message=${1}
    ${DIALOG} --backtitle "${INSTALL_BACKTITLE} Installation" --title "Debugging" --colors --msgbox "\n\Z5${message}\Zn" 0 0
}

log-install()
{
    test -n "${1}" || return 1
    local message=${1}

    local date=$(date)
    echo "+++ ${date}: ${message}" >> /tmp/${LOG_FILE} 2>&1
}

print-error()
{
    test -n "${1}" || return 1
    local code=${1}

    local text=${Errors[${code}]}
    echo ${text}
}

dialog-error()
{
    test -n "${1}" || return 1
    local code=${1}

    local text=${Errors[${code}]}

    ${DIALOG} --backtitle "${INSTALL_BACKTITLE} Installation" --title "Error $[${code} + 1000]" --colors --msgbox "\n\Z1${text}\Zn" 0 0
}

error()
{
    if test -z "${1}" ; then local code=255 ; else local code=${1} ; fi
    test ${code} -ne 0 || return 0

    dialog-error ${code}

    return ${code}
}

dialog-warning()
{
    test -n "${1}" || return 1
    local code=${1}

    local text=${Warnings[${code}]}

    ${DIALOG} --backtitle "${INSTALL_BACKTITLE} Installation" --title "Warning $[${code} + 1000]" --colors --msgbox "\n\Z5${text}\Zn" 0 0
}

dialog-report()
{
    test -n "${1}" || return 1
    local file=${1}
    test -f ${file} || return 11

    local line

    echo

    while read line
    do
	echo "${line}" | fmt --width=65
    done < ${file} 2>> /tmp/${LOG_FILE}
}

dialog-progress()
{
    test -n "${1}" || return 1
    local progress=${1}
    local message=${2}
    local tempo=${3}

    test -n "${tempo}" || tempo=300000
    test ${tempo} -eq 0 || usleep ${tempo}
    echo ${progress}

    if test -n "${message}" ; then
	cat << EOF
XXX
${message}...
XXX
EOF
	log-install "${message}"
    fi
}

dialog-end-progress()
{
    usleep 300000
    echo 100
    usleep 300000
}

warning()
{
    if test -z "$1" ; then local code=255 ; else local code=${1} ; fi
    test ${code} -ne 0 || return 0

    dialog-warning ${code}

    return ${code}
}

load-clock()
{
    source /etc/sysconfig/clock

    case "${UTC}" in
	yes|true|1)
	    export CLOCK_OPTIONS="${CLOCKPARAMS} --utc"
	    ;;
	
	no|false|0)
	    export CLOCK_OPTIONS="${CLOCKPARAMS} --localtime"
	    ;;
	
    esac

    hwclock --hctosys ${CLOCK_OPTIONS}
    echo ${CLOCK_OPTIONS} > /tmp/VARIABLE_CLOCK_OPTIONS
}

save-clock()
{
    hwclock --systohc ${CLOCK_OPTIONS}
}

check-nb()
{
    test -n "${1}" || return 1
    local nb=${1}

    local len=${#nb}
    test ${len} -le 18 || return 1
    [[ "${nb}" =~ ^[0-9]+$ ]] || return 2

    return 0
}

setenv-variable-from-file()
{
    local file variable value
    local files=$(ls /tmp/VARIABLE_* 2> /dev/null)
    
    for file in ${files}
    do
	variable=${file/\/tmp\/VARIABLE_}
	value="$(cat ${file})"
	export ${variable}="${value}"
	rm -f ${file}
    done
}

triple-beep()
{
    local i
    for ((i=0 ; i<2 ; i++))
    do
	printf "\007"; usleep 700000 ;
    done
    printf "\007"
}

get-system-architecture()
{
    uname -r 2>> /tmp/${LOG_FILE}
}

get-memory-type()
{
    local memory_type

    if test ${SYSTEM} == ${SYS_VERSION}-${SYS_64_NAME} ; then
	memory_type=64mem
    elif test ${SYSTEM} == ${SYS_VERSION}-${SYS_HM_NAME} ; then
	memory_type=highmem
    elif test ${system} == ${SYS_VERSION}-${SYS_UML_64_NAME} ; then
	memory_type=highmem
    elif test ${system} == ${SYS_VERSION}-${SYS_UML_NAME} ; then
	memory_type=lowmem
    else
	memory_type=unknown
    fi
    echo "${memory_type}"
}

get-architecture()
{
    uname -m 2>> /tmp/${LOG_FILE}
}

get-model()
{
    get-cmdline-attribute model
}

get-install()
{
    get-cmdline-attribute install
}

get-partition-uuid()
{
    test -n "${1}" || return 1
    local dev=${1}

    local uuid=$(blkid ${dev} 2> /dev/null)

    uuid=${uuid/* UUID=\"}
    uuid=${uuid/\" *}

    echo ${uuid}
}

read-license()
{
    test -z "${APL_MODEL}" || return 0

    local response

    clear
    man -r 'Press <SPACE> to continue or <Q> to Quit' ${LICENSE}
    echo
    echo -n "Do you accept the terms of the ${COMMERCIAL_NAME}-OS License (Y|N) [Y]? "
    read response
    test -z "${response}" -o "${response}" == y -o "${response}" == Y || return 1
