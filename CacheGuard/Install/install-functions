dialog-read-passwords()
{
    if test -n "${APL_MODEL}" ; then
	if test ${APL_MODEL} == 'test' ; then
	    export APASSWORD=""
	else
	    export APASSWORD='admin'
	fi
	return 0
    elif test -n "${CLOUD_NAME}" ; then
	export APASSWORD=""
	return 0
    fi

    local line i ret
    local password1 password2

    while true
    do
	${DIALOG} --backtitle "${INSTALL_BACKTITLE} ${APL_ROLE^} Installation" --title "Administrator password" --help-button ${@} --insecure --passwordform "\nPlease enter the administrator (user admin) password \n(use Up/Down arrow keys):" 0 0 2 \
	    "Password:"  1 1  "" 1 24 32 0 \
	    "Retype password:"  2 1  "" 2 24 32 0 2> /tmp/${ADMIN_PASSWORD_FILE}
	ret=${?}
	if test ${ret} -eq ${DIALOG_HELP} ; then
	    ${DIALOG} --backtitle "${INSTALL_BACKTITLE} Installation" --title "Administrator Password" --msgbox "\nThere are 3 levels of administration with the present OS. The first level is the appliance administration level. This level is bound to the user \"${ADMIN_NAME}\" and is the only recommended level to use to administrate your appliance. The two other levels are Linux administration levels bound to the users \"${SUPERADMIN_NAME}\" and \"root\". These levels are there for maintenance purpose and should never be used unless you know exactly what you do.\n\n The \"${SUPERADMIN_NAME}\" default password is the same as the one configured for the user \"${ADMIN_NAME}\". The \"root\" default password is the same as for the user \"${ADMIN_NAME}\" followed by the configured Users Capacity (${USERS_NB} here). It is highly recommended to change these default passwords once the OS is installed on your machine." 0 0
	elif test ${ret} -eq ${DIALOG_CANCEL} ; then
	    if test -n "${APASSWORD}" ; then
		break
	    else
		${DIALOG} --backtitle "${INSTALL_BACKTITLE} Installation" --title "Administrator password" --msgbox "\nEmpty password is not allowed! Please input a valid password." 0 0
	    fi
	else
	    i=0
	    while read line
	    do
		case ${i} in
		    0)
			password1="${line}"
			;;
		    1)
			password2="${line}"
			;;
		    *)
			;;
		esac
		((i++))
	    done < /tmp/${ADMIN_PASSWORD_FILE}
	    
	    if test -z "${password1}" -o -z "${password2}" ; then
		${DIALOG} --backtitle "${INSTALL_BACKTITLE} Installation" --title "Administrator password" --msgbox "\nEmpty password is not allowed! Please input a valid password." 0 0
	    elif test "${password1}" != "${password2}" ; then
		${DIALOG} --backtitle "${INSTALL_BACKTITLE} Installation" --title "Administrator password" --msgbox "\nEntered passwords do not match! Please retype again." 0 0
	    else
		export APASSWORD=${password1}
		break
	    fi
	fi
    done
}

