dialog-make-initrd-1()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    test -n "${3}" || return 3
    test -n "${4}" || return 4
    local sys_version=${1}
    local root_device=${2}
    local min=${3}
    local max=${4}

    local progress=${min} steps=5
    local step=$[(${max}-${min}) / ${steps}]

    local loopdev=/dev/loop5
    local initrd_dir=/mnt/initrd
    local image_file=${WORKING_DIR}/initrd
    local applet basename keymap

    local azure_modules=$(get-azure-storage-modules ${ARCHITECTURE} ${SYSTEM} /tmp/${LOG_FILE})
    local aws_modules=$(get-aws-storage-modules ${ARCHITECTURE} ${SYSTEM} /tmp/${LOG_FILE})
    local modules="${STORAGE_MODULES} ${RAID_MODULES} ${HID_MODULES}"
    test -z "${azure_modules}" || modules="${modules} ${azure_modules}"
    test -z "${aws_modules}" || modules="${modules} ${aws_modules}"

    modules=$(uniq-elt ${modules})

    local binkeymap_files=$(find /usr/share/${BINKEYMAP_DIR_NAME} -type f 2>/dev/null)
    local all_files="/usr/bin/busybox ${modules} ${binkeymap_files}"

    test ${RAID_STATE} -eq 0 || all_files="${all_files} /usr/sbin/mdadm.static"
    local ramdisk_sz=$(get-files-size ${all_files})
    ((ramdisk_sz += 1024))

    log-install "Initial RAM Disk size = ${ramdisk_sz}"

    cd ${INSTALL_DIR}

    rm -f ${image_file}
    mkdir -p ${initrd_dir}

    dd if=/dev/zero of=${image_file} bs=1k count=${ramdisk_sz} 2>> /tmp/${LOG_FILE}
    dialog-progress ${progress} ; progress=$[${progress} + ${step}]

    losetup ${loopdev} ${image_file}
    mke2fs -b 1024 -q ${loopdev} ${ramdisk_sz} >> /tmp/${LOG_FILE} 2>&1
    tune2fs -i0 -c0 ${loopdev} >> /tmp/${LOG_FILE} 2>&1
    mount -t ext2 ${loopdev} ${initrd_dir}
    rm -rf ${initrd_dir}/lost+found
    dialog-progress ${progress} ; progress=$[${progress} + ${step}]

    mkdir -p ${initrd_dir}/proc
    mkdir -p ${initrd_dir}/sys
    mkdir -p ${initrd_dir}/dev
    mkdir -p ${initrd_dir}/etc
    mkdir -p ${initrd_dir}/lib/modules
    mkdir -p ${initrd_dir}/bin
    mkdir -p ${initrd_dir}/newroot

    mknod ${initrd_dir}/dev/console -m 600 c 5 1
    mknod ${initrd_dir}/dev/null -m 666 c 1 3

    install -d -m 755 -o root -g root ${initrd_dir}/etc/${BINKEYMAP_DIR_NAME}
    for keymap in /usr/share/${BINKEYMAP_DIR_NAME}/*
    do
	install -m 644 -o root -g root ${keymap} ${initrd_dir}/etc/${BINKEYMAP_DIR_NAME}
    done

    for applet in ash blkid blockdev cat chattr chmod chown chroot cp ed eject fdisk find fsck grep gunzip gzip insmod ip ln loadkmap ls lsmod mdev mkdir mknod mount mv ping pivot_root ps pwd raidautorun rm rmdir rmmod sed setsid tftp umount uname unxz vi xz
    do
	ln -sf busybox ${initrd_dir}/bin/${applet}
    done

    cp -a /usr/bin/busybox ${initrd_dir}/bin
    dialog-progress ${progress} ; progress=$[${progress} + ${step}]

    gen-initrd-load-modules-script ${APL}/ ${initrd_dir} "${modules}" > /tmp/loadmodules
    gen-initrd-unload-modules-script ${APL}/ ${initrd_dir} "${modules}" > /tmp/unloadmodules

    install -m 744 -o root -g root /tmp/loadmodules ${initrd_dir}/bin/loadmodules
    install -m 744 -o root -g root /tmp/unloadmodules ${initrd_dir}/bin/unloadmodules

    rm -f \
       /tmp/loadmodules \
       /tmp/unloadmodules

    install -m 744 -o root -g root ${INSTALL_DIR}/raidfail ${initrd_dir}/bin/raidfail

    gen-linuxrc ${root_device} > ${initrd_dir}/linuxrc
    chmod u+x ${initrd_dir}/linuxrc
    dialog-progress ${progress} ; progress=$[${progress} + ${step}]

    if test ${RAID_STATE} -eq 1 ; then
	cp -a /usr/sbin/mdadm.static ${initrd_dir}/bin/mdadm
	cp -a /etc/mdadm.conf ${initrd_dir}/etc/mdadm.conf
	echo "root:x:0:0:root:/root:/bin/ash" > ${initrd_dir}/etc/passwd
	echo "root::12000:0:1000000:30:::" > ${initrd_dir}/etc/shadow
	cp -a /etc/group ${initrd_dir}/etc/group
	cp -a /etc/nsswitch.conf ${initrd_dir}/etc/nsswitch.conf
	mkdir ${initrd_dir}/root
    fi
    dialog-progress ${progress} ; progress=$[${progress} + ${step}]

    # Saving the initrd image on the local disk
    local cpu_nb=$(get-max-working-cpu)
    umount ${initrd_dir}
    losetup -d ${loopdev} &&
    rm -f ${image_file}.xz &&
    xz --threads=${cpu_nb} --quiet --check=crc32 ${image_file} &&
    install -m 644 -o root -g root ${image_file}.xz ${APL}/boot/initrd-${sys_version}.img &&
    rm -f ${image_file}.xz
}

# Take a disk type and disk id (controller:disk) and output the disk name: (scsi x:1 -> sda), (ide x:2 -> hdb)...
disk-name()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    local disk_type=${1}
    local disk_id=${2}

    if test ${RAID_STATE} -eq 1 ; then
	echo md${RAID_MD_NB}${disk_num}
	return 0
    fi

    local disk_num=${disk_id/*:}

    local octal disk_name

    case ${disk_type} in
	ide)
	    # [a-t]: 20 max
	    test ${disk_num} -ge 1 -a ${disk_num} -le 20 || return 11
	    disk_num=$[${disk_num}+96]
	    octal=$(octal ${disk_num})
	    disk_name="hd\0${octal}"
	    ;;
	scsi|virt)
	    # [a-z], [a-c][a-z]: 104 max
	    test ${disk_num} -ge 1 -a ${disk_num} -le 104 || return 12
	    if test ${disk_num} -le 26 ; then
		disk_num=$[${disk_num}+96]
		octal=$(octal ${disk_num})
		disk_name="\0${octal}"
	    elif test ${disk_num} -le 52 ; then
		disk_num=$[${disk_num}-26+96]
		octal=$(octal ${disk_num})
		disk_name="a\0${octal}"
	    elif test ${disk_num} -le 78 ; then
		disk_num=$[${disk_num}-52+96]
		octal=$(octal ${disk_num})
		disk_name="b\0${octal}"
	    else
		disk_num=$[${disk_num}-78+96]
		octal=$(octal ${disk_num})
		disk_name="c\0${octal}"
	    fi

	    case ${disk_type} in
		scsi)
		    disk_name="sd${disk_name}"
		    ;;
		virt)
		    disk_name="vd${disk_name}"
		    ;;
		*)
		    ;;
	    esac
	    ;;
	nvme)
	    # n1, n2... nn
	    local ctrl_num=${disk_id/:*}
	    disk_name=nvme${ctrl_num}n${disk_num}
	    ;;

	raid)
	    disk_name=md${RAID_MD_NB}${disk_num}
	    ;;
	*)
	    return 13
	    ;;
    esac

    echo -e ${disk_name}
    return 0
}

