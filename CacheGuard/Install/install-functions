    local elt
    local i=0 range

    for elt in ${PARTITIONS}
    do
	range=$[${i} % 2]
	case ${range} in
	    0)
		test ${elt} != ${part} || return 0
		;;
	    1)
		;;
	    *)
		return 255
		;;
	esac
	((i++))
    done
    
    return 1
}

