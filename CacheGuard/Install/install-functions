dialog-finish-install()
{
    chattr -iR ${APL}/boot # as protection on /boot may exist from a previous installation!

    local grub_options="--recheck --root-directory=${APL} --boot-directory=${APL}/boot --efi-directory=${APL}/boot/efi --modules=part_gpt"

    local efi pp

    is-efi-system
    efi=${?}

    if test ${RAID_STATE} -eq 0 ; then

	dialog-progress 10 "Installing GRUB"
	local disk_name=$(get-os-disk-name)
	pp=$(get-partition-prefix ${disk_name})

	# Remove grub from the MBR
	dd if=/dev/zero of=/dev/${disk_name} bs=446 count=1 >> /tmp/${LOG_FILE} 2>&1

	test ${efi} -ne 0 || mount -t vfat /dev/${disk_name}${pp}${EFI_PARTITION_NB} ${APL}/boot/efi
	grub-install ${grub_options} /dev/${disk_name} >> /tmp/${LOG_FILE} 2>&1
	test ${efi} -ne 0 || umount ${APL}/boot/efi
    else
	local min=0 max=40 steps=${DISK_NB}
	local step=$[(${max}-${min}) * 100 / ${steps}] # (* 100) because the precision
	local progress=${min}
	
	local disk disks dev i=1

	if test ${RAID_LEVEL} -eq 0 ; then
	    disks=${DISK_DEVICES/ *}
	else
	    disks=${DISK_DEVICES}
	fi

	for disk in ${disks}
	do
	    progress=$[${progress} + ${step} / 100]
	    dialog-progress ${progress} "Installing GRUB ${i}/${DISK_NB}" 10000
	    dd if=/dev/zero of=${disk} bs=446 count=1 >> /tmp/${LOG_FILE} 2>&1

	    pp=$(get-partition-prefix ${disk})

	    if test ${efi} -eq 0 ; then
		dev=${disk}${pp}${EFI_PARTITION_NB}
		mkfs -t vfat -n EFI -F 32 ${dev} >> /tmp/${LOG_FILE} 2>&1
		mount -t vfat ${dev} ${APL}/boot/efi
	    fi

	    grub-install ${grub_options} ${disk} >> /tmp/${LOG_FILE} 2>&1

	    test ${efi} -ne 0 || umount ${APL}/boot/efi

	    ((i++))
	done
    fi

    purge-role-files

    dialog-progress 50 "Locking OS components"
    lock-os ${ARCHITECTURE} ${APL}
    dialog-progress 60 "Unmounting File systems"
    sync
    umount-fs
    dialog-progress 65 "Stopping Logical Volume Manager"
    lvm-stop
    if test ${RAID_STATE} -eq 1 ; then
	dialog-progress 70 "Stopping the RAID"
	raid-stop
	dialog-progress 90
    else
	dialog-progress 90
    fi
    dialog-end-progress
}

