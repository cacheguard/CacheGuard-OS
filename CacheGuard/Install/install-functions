# Take a decimal number and output it's octal
octal()
{
    test -n "${1}" || return 1
    local quotient=${1}

    local remainder octal

    while [ ${quotient} -ne 0 ]
      do
      remainder=$[$quotient % 8]
      octal=${remainder}${octal}
      quotient=$[${quotient} / 8]
    done
    echo ${octal}
}

