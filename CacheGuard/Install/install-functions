gen-uuid-fstab()
{
    test -f ${GENERATED_DIR}/etc.fstab || return 11

    if test ${RAID_STATE} -eq 1 ; then
	cp -f ${GENERATED_DIR}/etc.fstab ${GENERATED_DIR}/etc.fstab.uuid
	return 0
    fi

    local dev mp fs_type rest
    local line uuid

    while read dev mp fs_type rest
    do
	line="${dev} ${mp} ${fs_type} ${rest}"
	if test -z "${dev}" -o "${dev:0:1}" == "#" ; then
	    echo ${line}
	    continue
	fi

	if test ${dev:0:10} == /dev/${LVM_VG_NAME}/ ; then
	    echo ${line}
	    continue
	fi	    
	    
	case ${fs_type} in

	    ext4|vfat)
		uuid=$(get-partition-uuid ${dev})
		echo UUID=${uuid} ${mp} ${fs_type} ${rest}
		;;
	    *)
		echo ${line}
		;;
	esac

    done < ${GENERATED_DIR}/etc.fstab > ${GENERATED_DIR}/etc.fstab.uuid
}

