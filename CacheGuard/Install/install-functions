	    cp -af ${APL}${SAVE_DIR}/${CONFIGURATION_CURRENT_FACTORY_DB_NAME}.gateway ${APL}${SAVE_DIR}/${CONFIGURATION_CURRENT_FACTORY_DB_NAME}.manager

