switch-install-log()
{
    test ! -f /tmp/${LOG_FILE} || diff -q /tmp/${LOG_FILE} /tmp/${LOG_FILE_1} || cp -f /tmp/${LOG_FILE} /tmp/${LOG_FILE_1}
    LOG_FILE=${LOG_FILE_2}
    reset-install-log
}

set-device-drivers()
{
    local module

    set-network-drivers ${INSTALL_PX} /tmp/${LOG_FILE}
    set-storage-drivers ${INSTALL_PX} /tmp/${LOG_FILE}
    set-hid-drivers

    echo ${NETWORK_MODULES} > /tmp/VARIABLE_NETWORK_MODULES
    echo ${STORAGE_MODULES} > /tmp/VARIABLE_STORAGE_MODULES
    echo ${HID_MODULES} > /tmp/VARIABLE_HID_MODULES

    local network_modules=$(get-base-module-names "${NETWORK_MODULES}")
    for module in ${network_modules}
    do
	echo ${module}
    done > /tmp/${NETWORK_MODULES_FILE}

    local storage_modules=$(get-base-module-names "${STORAGE_MODULES}")
    for module in ${storage_modules}
    do
	echo ${module}
    done > /tmp/${STORAGE_MODULES_FILE}

    local hid_modules=$(get-base-module-names "${HID_MODULES}")
    for module in ${hid_modules}
    do
	echo ${module}
    done > /tmp/${HID_MODULES_FILE}
}

dialog-appliance-install()
{
    find-load-modules
    load-hid-modules
    set-device-drivers

    dialog-setenv
    dialog-welcome
    dialog-set-keyboard
    read-license || quit-install

    if dialog-hardware-config ; then
	dialog-set-timezone-date-time
	dialog-raid-config
	dialog-set-appliance-role
	dialog-read-settings
	dialog-read-passwords
	switch-install-log
    fi

    dialog-main-menu
}

install-keyboard()
{
    test -n "${1}" || return 1
    keyboard=${1}

    loadkeys --quiet ${keyboard} > /tmp/${LOG_FILE} 2>&1
}

appliance-install()
{
    test -z "${APL_MODEL}" -o "${APL_MODEL}" == 'test' || export MACHINE=HW
    install-keyboard ${KEYBOARD}
    dialog-appliance-install
}

quit-install()
{
    clear

    case "${INSTALL}" in
	iso)
	    umount ${MEDIA_DIR} 2>> /tmp/${LOG_FILE}
	    ;;
	pxe)
	    unset-install-ip
	    ;;
	*)
	    ;;
    esac

    if test -z "${APL_MODEL}" ; then
	shutdown -nfr now > /dev/null 2>&1
    else
	shutdown -nfhP now > /dev/null 2>&1
    fi
}

mount-install-sysfs()
{
    mount /proc
    mount /sys

    ! is-efi-system || mount -t efivarfs efivarfs /sys/firmware/efi/efivars

    klogd -c 1
}

set-environment()
{
    cd /install && mkdir -p ${GENERATED_DIR}

    export WORKING_DIR=${APL}${TMP_DIR}
    export ARCHITECTURE=$(get-architecture)
    export INSTALL=$(get-install)
    export TERMINAL=$(get-console)
    export SYSTEM=$(get-system-architecture)
    export CONSOLE=$(tty)

    if test -z "${APL_MODEL}" ; then
	export APL_MODEL=$(get-model)
    elif test "${APL_MODEL}" == 'test' ; then
	KEYBOARD=${DEV_KEYBOARD}
    fi
}

if-debug-mode()
{
    test "${REMOTE_DEBUG_MODE}" == yes || return 0
    echo "Entering the development mode..."

    echo "Setting the appropriate keyboard..."
    install-keyboard ${DEV_KEYBOARD}

    echo "Loading required modules..."
    find-load-modules
    load-hid-modules

    echo "Starting the device manager..."
    start-device-manager
    local date1=$(date +"%s")

    echo "Generating the SSH daemon configuration..."
    rm -f \
       ${INSTALL_DIR}/install.ssh_host_rsa_key \
       ${INSTALL_DIR}/install.ssh_host_dsa_key
    ssh-keygen -q -t rsa -f ${INSTALL_DIR}/install.ssh_host_rsa_key -C '' -N ''
    ssh-keygen -q -t dsa -f ${INSTALL_DIR}/install.ssh_host_dsa_key -C '' -N ''
    chmod 400 ${INSTALL_DIR}/install.ssh_host_rsa_key ${INSTALL_DIR}/install.ssh_host_dsa_key
    chmod 444 ${INSTALL_DIR}/install.ssh_host_rsa_key.pub ${INSTALL_DIR}/install.ssh_host_dsa_key.pub

    local sshd_config_file="${INSTALL_DIR}/install.sshd_config"
    echo "PermitRootLogin yes" > ${sshd_config_file}
    echo "PermitEmptyPasswords yes" >> ${sshd_config_file}
    echo "HostKey ${INSTALL_DIR}/install.ssh_host_rsa_key" >> ${sshd_config_file}
    echo "HostKey ${INSTALL_DIR}/install.ssh_host_dsa_key" >> ${sshd_config_file}

    mkdir -p /dev/pts
    mount devpts /dev/pts -t devpts

    echo "Starting the SSH daemon..."
    /sbin/sshd -f ${sshd_config_file} -u0

    echo "Stopping the device manager..."
    stop-device-manager
    local date2=$(date +"%s")
    test $[${date2} - ${date1}] -gt 1 || usleep 1000000

    echo "Getting an IP address..."
    set-install-ip ${DEBUG_NETWORK_DEV}
    setenv-variable-from-file

    sulogin
    return 11

    # from the remote machine: ssh root@<appliance-ip>
    cd /install
    source functions
    set-environment
    # debug from dialog-appliance-install() and then dialog-install-os()
}
