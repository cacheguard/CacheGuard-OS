dialog-download-os()
{
    cd ${WORKING_DIR}

    local curl_global_options="-qsf --globoff"
    local curl_options="${curl_global_options} --connect-timeout 5 --max-time 240 --tftp-blksize 20480"

    mv -f /tmp/os.xx os.xx || return 10
    curl -qsf --globoff --connect-timeout 5 --max-time 10 --url tftp://${TFTP_SERVER_IP}/${TECHNICAL_NAME}/os.sg -o os.sg || return 17

    curl -qsf --globoff --connect-timeout 5 --max-time 10 --url tftp://${TFTP_SERVER_IP}/${TECHNICAL_NAME}/os.dv -o os.dv

    dialog-progress 1 "" 500000

    local nb=$(cat os.xx)
    check-nb ${nb} || return 10

    local progress_pieces=85

    local step=$[${nb} * 100 / ${progress_pieces}]

    local i index

    for ((i=0 ; i<nb ; i++))
    do
	if test ${#i} -eq 1 ; then
	    index="0${i}"
	else
	    index="${i}"
	fi
	curl ${curl_options} --url tftp://${TFTP_SERVER_IP}/${TECHNICAL_NAME}/os.${index} -o os.${index} || return 10
	dialog-progress $[(${i} * 100 / ${step}) +2] "Downloading OS piece $[${i}+1]/${nb} from tftp://${TFTP_SERVER_IP}" 0
    done

    dialog-progress ${progress_pieces} "Checking the integrity of downloaded OS pieces." 0

    local src_sig dst_sig os
    while read src_sig os
    do
	test -n "${os}" || return 13

	dst_sig=$(openssl dgst -sha1 ${os} 2> /dev/null)
	dst_sig=${dst_sig/*= }

	test "${dst_sig}" == ${src_sig} || return 13
    done < os.sg

    mkdir -p ${APL}/boot

    case ${ARCHITECTURE} in
	x86_64)
	    dialog-progress $((progress_pieces + 5)) "Downloading the 64 bits Linux kernel from ${TFTP_SERVER_IP}" 0
	    curl ${curl_options} --url tftp://${TFTP_SERVER_IP}/${TECHNICAL_NAME}-boot/${CG_KERNEL_64} -o ${APL}/boot/kernel-${SYS_VERSION}-${SYS_64_NAME} || return 14
	    ;;
	*)
	    dialog-progress $((progress_pieces + 5)) "Downloading the 32 bits Linux kernel from ${TFTP_SERVER_IP}" 0
	    curl ${curl_options} --url tftp://${TFTP_SERVER_IP}/${TECHNICAL_NAME}-boot/${CG_KERNEL_HM} -o ${APL}/boot/kernel-${SYS_VERSION}-${SYS_HM_NAME} || return 14
	    ;;
    esac

    cd ${INSTALL_DIR}
    dialog-end-progress
}

