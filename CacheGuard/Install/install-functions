dialog-select-disk()
{
    test -n "${1}" || return 11

    local description=${1}
    local selected=${2}
    local widget=${3}

    test -n "${widget}" || widget=radiolist

    local elt i=0 range
    local disk_type disk_id disk_size
    local disk disk_name
    local ctrl_num disk_num
    local state display

    rm -f /tmp/${DISK_MENU}

    for elt in ${DISK_INFOS}
    do
	range=$[${i} % 3]
	case ${range} in
	    0)
		disk_type=${elt}
		;;
	    1)
		disk_id=${elt}
		;;
	    2)
		disk_size=${elt}

		if test ${widget} == radiolist ; then
		    if test -n "${selected}" -a ${disk_id} -eq ${selected} ; then
			state=on
		    else
			state=off
		    fi
		fi

		#################################################################################################
		# Release note: only disks attached to the fist NVMe controller can be selected as the OS disk. #
		# Otherwise the gen-grub-menuentry() function in apl_model_configure should be reviewed.        #
		#################################################################################################

		disk_num=${disk_id/*:}
		unset display

		case ${disk_type} in
		    nvme)
			ctrl_num=${disk_id/:*}
			test ${ctrl_num} != 0 || display=yes
			;;
		    *)
			display=yes
			;;
		esac

		test -z "${display}" || echo "\"Disk ${disk_num}/${disk_type}\" \"${disk_type} Disk ($[${disk_size}/1024] MB)\" ${state}" >> /tmp/${DISK_MENU}
		;;
	    *)
		return 255
		;;
	esac
	((i++))
    done

    if test ! -s /tmp/${DISK_MENU} ; then
	${DIALOG} --backtitle "${INSTALL_BACKTITLE} Installation" --title "Disk Selection" --msgbox "\nNo disk is present on this machine." 0 0
	return 12
    fi

    ${DIALOG} --backtitle "${INSTALL_BACKTITLE} Installation" --title "Disk Selection" --${widget} "${description}" 0 0 4 --file /tmp/${DISK_MENU} 2> /tmp/VARIABLE_SELECTED_DISK

    local ret=${?}

    disk=$(cat /tmp/VARIABLE_SELECTED_DISK)
    rm -f /tmp/VARIABLE_SELECTED_DISK

    test -n "${disk}" || return ${DIALOG_CANCEL}

    disk=${disk/* }
    disk_num=${disk/\/*}
    disk_type=${disk/*\/}

    case ${disk_type} in
	nvme)
	    ctrl_num=0
	    disk_id=${ctrl_num}:${disk_num}
	    ;;
	*)
	    disk_id=x:${disk_num}
	    ;;
    esac


    disk_name=$(disk-name ${disk_type} ${disk_id})

    export SELECTED_DISK_ID=${disk_id}
    export SELECTED_DISK_NAME=${disk_name}

    return ${ret}
}

