lvm-reset()
{
    local vg_info vg_uuid

    vgdisplay --colon 2> /dev/null > /tmp/${VGS_FILE}
    while read vg_info
    do
	vg_uuid=${vg_info/*:}
	vgremove --force --yes --quiet --quiet --select vg_uuid=${vg_uuid} > /dev/null 2>&1
    done < /tmp/${VGS_FILE}
}

lvm-create()
{
    test -n "${1}" || return 1
    local devs=${@}

    vgcreate --force --yes --quiet --quiet --physicalextentsize ${LVM_PE_SZ}KB ${LVM_VG_NAME} ${devs}  > /dev/null 2>&1
}

make-lvm()
{
    local s1=${1}
    local s2=${2}
    test -n "${s1}" || s1=5
    test -n "${s2}" || s2=95

    local devs disk_nb
    local fs_name fs_dir fs_type fs_size

    local step=$(get-fs-step ${s1} ${s2})
    local progress=${s1}
    (( step /= 2))

    dialog-progress ${progress} "Partitioning Disk(s)" 20000

    lvm-stop
    lvm-reset

    if test ${RAID_STATE} -eq 1 ; then
	dev="/dev/md${RAID_MD_NB}p${RAID_LVM_PARTITION_NB}"
	pvcreate --force --force --yes --quiet --quiet ${dev} > /dev/null 2>&1
	devs=${dev}
	disk_nb=1
    else
	local dev part
	local root_dev=/dev/$(get-os-disk-name)

	for dev in ${DISK_DEVICES}
	do
	    if test ${dev} == ${root_dev} ; then
		part=${OS_DISK_LVM_PARTITION_NB}
	    else
		part=${NOS_DISK_LVM_PARTITION_NB}
	    fi

	    test "${dev:5:4}" != nvme || part=p${part}
	    pvcreate --force --yes --quiet --quiet ${dev}${part} > /dev/null 2>&1
	    devs="${devs} ${dev}${part}"
	done
	devs=${devs:1}
	disk_nb=${DISK_NB}
    fi

    lvm-create ${devs}

    while read fs_name fs_dir fs_type fs_size
    do
	progress=$[${progress} + ${step} / 100]
	dialog-progress ${progress} "Partitioning Disk(s)" 30000

	test -n "${fs_name}" || continue
	test ${fs_name:0:1} != '#' || continue
	test ${fs_name} != Root || continue

	lvremove --force --yes --quiet --quiet /dev/${LVM_VG_NAME}/${fs_name} 2> /dev/null
    done < ${GENERATED_DIR}/fs-info

    while read fs_name fs_dir fs_type fs_size
    do
	test -n "${fs_name}" || continue
	test ${fs_name:0:1} != '#' || continue
	test ${fs_name} != Root || continue

	progress=$[${progress} + ${step} / 100]
	dialog-progress ${progress} "Partitioning Disk(s)" 20000

	lvcreate --yes --quiet --quiet --type striped --stripes ${disk_nb} --stripesize ${LVM_PE_SZ}KB --alloc normal --name ${fs_name} --size ${fs_size}KB ${LVM_VG_NAME} 2> /dev/null
	test ${?} -eq 0 || lvcreate --yes --quiet --quiet --type striped --stripes ${disk_nb} --stripesize ${LVM_PE_SZ}KB --alloc anywhere --name ${fs_name} --size ${fs_size}KB ${LVM_VG_NAME} 2> /dev/null
    done < ${GENERATED_DIR}/fs-info

    lvm-start
}

get-common-parted-commands()
{
    echo "mklabel ${PARTITION_LABEL_TYPE} unit s"
}

make-system-partitions()
{
    local dev disk_sz dev_name
    local commands
    local beginning_sz sector_sz sectors_per_kb
    local sectors blank_count count
    local disks_file ret

    local root_dev_name=$(get-os-disk-name)

    if test ${RAID_STATE} -eq 0 ; then
	disks_file="/tmp/${DISK_FILE}"
    else
	disks_file="/tmp/${MD_FILE}"
    fi

    local root_fs_name root_fs_mp root_fs_type root_fs_sz
    read root_fs_name root_fs_mp root_fs_type root_fs_sz < ${GENERATED_DIR}/fs-info

    while read dev disk_sz
    do
	dev=${dev/:}
	dev_name=${dev:5}

	test ${disk_sz} -gt 0 || return 11

	if test "${INSTALL}" == iso -a "${MEDIA_TYPE}" == usb ; then
	    test "${MEDIA_DEVICE}" != ${dev_name} || continue
	fi

	sector_sz=$(get-disk-sector-sz ${dev_name})
	sectors_per_kb=$((1024 / sector_sz))

	commands=$(get-common-parted-commands)

	if test ${RAID_STATE} -eq 1 ; then

	    beginning_sz=${FIRST_PARTITION_BEGINING_SECTOR}

	    ((end_sector = (root_fs_sz * sectors_per_kb) - 1))
	    commands="${commands} mkpart primary ${root_fs_type} ${FIRST_PARTITION_BEGINING_SECTOR} ${end_sector}"
	    commands="${commands} name ${RAID_ROOT_PARTITION_NB} ${root_fs_name}"

	    ((begin_sector = end_sector + 1))
	    commands="${commands} mkpart primary ext2 ${begin_sector} 100%"
	    commands="${commands} set ${RAID_LVM_PARTITION_NB} lvm on"
	    commands="${commands} name ${RAID_LVM_PARTITION_NB} Data"
	    commands="${commands} quit"

	else

	    if test ${dev_name} == ${root_dev_name} ; then

		beginning_sz=$((FIRST_PARTITION_BEGINING_SECTOR + EFI_SZ))

		((begin_sector = FIRST_PARTITION_BEGINING_SECTOR * sectors_per_kb))
		((end_sector = begin_sector + (FIRST_PARTITION_BEGINING_SECTOR * sectors_per_kb) - 1))
		commands="${commands} mkpart primary ext2 ${begin_sector} ${end_sector}"
		commands="${commands} name ${GRUB_PARTITION_NB} GRUB"
		commands="${commands} set ${GRUB_PARTITION_NB} bios_grub on"

		((begin_sector = end_sector + 1))
		((end_sector = begin_sector + (EFI_SZ * sectors_per_kb) - 1))
		commands="${commands} mkpart primary fat32 ${begin_sector} ${end_sector}"
		commands="${commands} name ${EFI_PARTITION_NB} EFI"
		commands="${commands} set ${EFI_PARTITION_NB} esp on"

		((begin_sector = end_sector + 1))
		((end_sector = begin_sector + (root_fs_sz * sectors_per_kb) - 1))
		commands="${commands} mkpart primary ${root_fs_type} ${begin_sector} ${end_sector}"
		commands="${commands} name ${ROOT_PARTITION_NB} ${root_fs_name}"

		((begin_sector = end_sector + 1))
		commands="${commands} mkpart primary ext2 ${begin_sector} 100%"
		commands="${commands} name ${OS_DISK_LVM_PARTITION_NB} Data"
		commands="${commands} set ${OS_DISK_LVM_PARTITION_NB} lvm on"

		commands="${commands} quit"

	    else

		beginning_sz=${FIRST_PARTITION_BEGINING_SECTOR}

		commands="${commands} mkpart primary ext2 2048 100%"
		commands="${commands} name ${NOS_DISK_LVM_PARTITION_NB} Data"
		commands="${commands} set ${NOS_DISK_LVM_PARTITION_NB} lvm on"

		commands="${commands} quit"
	    fi
	fi

	((sectors = beginning_sz * sectors_per_kb))
	((blank_count = sectors / sector_sz))
	dd if=/dev/zero of=${dev} bs=${sector_sz} count=${blank_count} conv=notrunc

	partprobe /dev/${dev_name}
	blockdev -q --rereadpt /dev/${dev_name}

	parted /dev/${dev_name} --align cylinder --script -- ${commands}
	ret=${?}

	partprobe /dev/${dev_name}
	blockdev -q --rereadpt /dev/${dev_name}
	test ${ret} -eq 0 || break
    done < ${disks_file}

    return ${ret}
}

get-fs-step()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    local s1=${1}
    local s2=${2}

    local steps=$(egrep "ext2|ext3|ext4|reiserfs|swap" ${GENERATED_DIR}/etc.fstab | wc -l 2>> /tmp/${LOG_FILE})
    local step=$[(${s2}-${s1}) * 100 / ${steps}] # (* 100) because the precision

    echo ${step}
}

dialog-do-make-fs()
{
    test -n "${1}" || return 1
    test -n "${2}" || return 2
    local s1=${1}
    local s2=${2}

    local step=$(get-fs-step ${s1} ${s2})
    local progress=${s1}

    local dev mp fs_type rest
    local label
    local n=0

    dialog-progress ${progress} "Making File Systems" 50000

    while read dev mp fs_type rest
    do
	test -n "${dev}" || continue
	test "${dev:0:1}" != "#" || continue
	
	case ${fs_type} in
	    
	    proc|sysfs|devpts|tmpfs)
		;;

	    swap)
		mkswap -L swap ${dev} >> /tmp/${LOG_FILE} 2>&1

		progress=$[${progress} + ${step} / 100]
		dialog-progress ${progress} "Making File Systems" 50000
		;;

	    vfat)
		label=EFI
		umount ${APL}${mp} >> /tmp/${LOG_FILE} 2>&1
		mkfs -t vfat -n ${label} -F 32 ${dev} >> /tmp/${LOG_FILE} 2>&1
		;;

	    ext2|ext3|ext4)
		label=${dev/\/dev\/${LVM_VG_NAME}\/}
		umount ${APL}${mp} >> /tmp/${LOG_FILE} 2>&1
		mkfs -t ${fs_type} -q -L ${label} ${dev} >> /tmp/${LOG_FILE} 2>&1
		tune2fs -i0 -C ${n} -c ${MAX_MOUNT} ${dev} >> /tmp/${LOG_FILE} 2>&1
		((n++))
		n=$[${n} % ${MAX_MOUNT}]

		progress=$[(${progress} + ${step} / 100)]
		dialog-progress ${progress} "Making File Systems" 50000
		;;
	    
	    reiserfs)
		label=${dev/\/dev\/${LVM_VG_NAME}\/}
		umount ${APL}${mp} >> /tmp/${LOG_FILE} 2>&1
		mkfs -t ${fs_type} -q -l ${label} ${dev} >> /tmp/${LOG_FILE} 2>&1
		reiserfstune -M ${n} -m ${MAX_MOUNT} ${dev} >> /tmp/${LOG_FILE} 2>&1
		((n++))
		n=$[${n} % ${MAX_MOUNT}]

		progress=$[(${progress} + ${step} / 100)]
		dialog-progress ${progress} "Making File Systems" 50000
		;;
	    *)
		;;
	esac

    done < ${GENERATED_DIR}/etc.fstab
}

get-swap-fs()
{
    local swap_info=$(cat /proc/swaps | tail -n +2)
    local swap_fs=${swap_info/ *}

    echo ${swap_fs}
}

do-mount-fs()
{
    test -n "${1}" || return 1
    local action=${1}
    
    local umount_list
    local fs mp fs_type rest

    local swap_fs=$(get-swap-fs)

    cd ${INSTALL_DIR}
    
    while read fs mp fs_type rest
    do
	test -n "${fs}" || continue
	test "${fs:0:1}" != "#" || continue

	case ${mp} in
	    /proc|/sys|/dev/pts|/run|/dev|${ADMIN_DIR}/proc|${ADMIN_DIR}/dev/pts|${PROXY_DIR}/dev/shm)
		;;
	    swap)
		case ${action} in
		    on)
			test -n "${swap_fs}" || swapon ${fs}
			;;
		    *)
			;;
		esac
		;;

	    /boot/efi)
		;;
	    *)
		test -b ${fs} || continue

		case ${action} in
		    on)
			mkdir -p ${APL}${mp}
			mount -t ${fs_type} ${fs} ${APL}${mp}
			;;
		    off)
			umount_list="${mp} ${umount_list}"
			;;
		    *)
			;;
		esac
		;;
	esac
    done < ${GENERATED_DIR}/etc.fstab

    if test ${action} == on ; then

	install -d -m 555 -o root -g root ${APL}/proc
	install -d -m 555 -o root -g root ${APL}/sys

	mount -t proc proc ${APL}/proc
	mount -t sysfs sysfs ${APL}/sys

	! is-efi-system || mount -t efivarfs efivarfs ${APL}/sys/firmware/efi/efivars

	return 0
    fi

    ! is-efi-system || umount ${APL}/sys/firmware/efi/efivars
    umount ${APL}/proc
    umount ${APL}/sys

    for mp in ${umount_list}
    do
	umount ${APL}${mp}
    done

    test -z "${swap_fs}" || swapoff ${swap_fs}
}

mount-fs()
{
    do-mount-fs on
}

umount-fs()
{
    cd ${INSTALL_DIR}
    do-mount-fs off
}

