}

raid-stop()
{
    test -b /dev/md${RAID_MD_NB} || return 0
    mdadm --quiet --stop /dev/md${RAID_MD_NB} >> /tmp/${LOG_FILE} 2>&1
}

raid-start()
{
    mdadm --quiet --assemble --freeze-reshape /dev/md${RAID_MD_NB}
    mdadm --quiet --run /dev/md${RAID_MD_NB}
    blockdev --rereadpt /dev/md${RAID_MD_NB}
}

raid-auto-stop()
{
    test -f /proc/mdstat || return 0

    local md rest

    while read md rest
    do
	test ${md:0:2} == "md" || continue
	mdadm --quiet --stop /dev/${md} >> /tmp/${LOG_FILE} 2>&1
    done < /proc/mdstat
}

make-raid-partitions()
{
    local ret
    local disk disk_name pp
    local commands
    local sector_sz count sectors_per_kb sectors
    local begin_sector end_sector

    for disk in ${DISK_DEVICES}
    do
	echo "Formatting ${disk} for RAID usage..."

	commands=$(get-common-parted-commands)

	disk_name=${disk:5}
	pp=$(get-partition-prefix ${disk_name})
	sector_sz=$(get-disk-sector-sz ${disk_name})
	sectors_per_kb=$((1024 / sector_sz))

	((begin_sector = FIRST_PARTITION_BEGINING_SECTOR * sectors_per_kb))
	((end_sector = begin_sector + (FIRST_PARTITION_BEGINING_SECTOR * sectors_per_kb) - 1))
	commands="${commands} mkpart primary ext2 ${begin_sector} ${end_sector}"
	commands="${commands} name ${GRUB_PARTITION_NB} GRUB"

	((begin_sector = end_sector + 1))
	((end_sector = begin_sector + (EFI_SZ * sectors_per_kb) - 1))
	commands="${commands} mkpart primary fat32 ${begin_sector} ${end_sector}"
	commands="${commands} name ${EFI_PARTITION_NB} EFI"

	((begin_sector = end_sector + 1))

	case ${RAID_LEVEL} in
	    0|5|6|10)
		end_sector="100%"
		;;
	    1)
		((end_sector = begin_sector + (RAID_SZ * sectors_per_kb) - 1))
		;;
	    *)
		return 255
		;;
	esac

	commands="${commands} mkpart primary ext2 ${begin_sector} ${end_sector}"
	commands="${commands} name ${RAID_PARTITION_NB} RAID"
	commands="${commands} quit"

	((sectors = (EFI_SZ + FIRST_PARTITION_BEGINING_SECTOR) * sectors_per_kb))
	((blank_count = sectors / sector_sz))
	dd if=/dev/zero of=${disk} bs=${sector_sz} count=${blank_count} conv=notrunc

	partprobe ${disk}
	blockdev -q --rereadpt ${disk}
	rm -f ${disk}${RAID_PARTITION_NB}

	parted ${disk} --align cylinder --script -- ${commands}
	ret=${?}

	if test ${ret} -eq 0 ; then
	    partprobe ${disk}
	    blockdev -q --rereadpt ${disk}
	    commands="set ${GRUB_PARTITION_NB} bios_grub on set ${EFI_PARTITION_NB} esp on set ${RAID_PARTITION_NB} raid on quit"
	    parted ${disk} --align cylinder --script -- ${commands}
	    ret=$[${ret}*10 + ${?}]
	fi

	mdadm --zero-superblock --metadata=1.2 ${disk}${pp}${RAID_PARTITION_NB}
	test ${ret} -eq 0 || break
    done

    return ${ret}
}

raid-create()
{
    if test ${RAID_STATE} -eq 0 ; then
	unset RAID_MODULES
	unset RAID_DEVICES
	return 0
    fi

    make-raid-partitions  > /dev/null 2>&1 || return 1

    local layout chunk raid_devices
    local num_devices device disk_name pp
    local raid_modules base_modules module
    local i=0

    case ${RAID_LEVEL} in
	0)
	    chunk="--chunk=${RAID_CHUNK_SZ}"
	    num_devices=${DISK_NB}
	    raid_modules="raid0"
	    ;;
	1)
	    num_devices=2
	    raid_modules="raid1"
	    ;;
	5|6)
	    layout="--layout=left-symmetric"
	    chunk="--chunk=${RAID_CHUNK_SZ}"
	    num_devices=$[${DISK_NB} - ${RAID_SPARE_NB}]
	    raid_modules="raid456"
	    ;;
	10)
	    layout="--layout=o2"
	    chunk="--chunk=${RAID_CHUNK_SZ}"
	    num_devices=$[${DISK_NB} - ${RAID_SPARE_NB}]
	    raid_modules="raid10"
	    ;;
	*)
	    ;;
    esac

    for device in ${DISK_DEVICES}
    do
	disk_name=${device:5}
	pp=$(get-partition-prefix ${disk_name})
	raid_devices="${raid_devices} ${device}${pp}${RAID_PARTITION_NB}"
	((i++))
    done
    raid_devices=${raid_devices:1}

    raid_modules=$(find-raid-modules ${SYSTEM} ${RAID_LEVEL})
    base_modules=$(get-base-module-names "${raid_modules}")

    modprobe --quiet md-mod
    modprobe --quiet ${base_modules}

    gen-mdadm-conf ${num_devices} "${raid_devices}" > /etc/mdadm.conf

    mdadm --create /dev/md${RAID_MD_NB} --quiet --run --config=/etc/mdadm.conf --metadata=1.2 --spare-devices=${RAID_SPARE_NB} --raid-devices=${num_devices} ${chunk} --level=${RAID_LEVEL} ${layout} --name=${TECHNICAL_NAME} ${raid_devices} || return 3

    RAID_MODULES=${raid_modules} ; echo ${raid_modules} > /tmp/VARIABLE_RAID_MODULES
    RAID_DEVICES=${raid_devices} ; echo ${raid_devices} > /tmp/VARIABLE_RAID_DEVICES

    raid_modules=$(get-base-module-names "${raid_modules}")
    for module in ${raid_modules}
    do
	echo ${module}
    done > /tmp/${RAID_MODULES_FILE}
}

lvm-stop()
{
    vgchange --quiet --quiet --activate n > /dev/null 2>&1
}

lvm-start()
{
    vgchange --quiet --quiet --activate y > /dev/null 2>&1
