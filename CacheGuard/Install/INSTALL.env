export PROGRESSION=0
export MACHINE=OS

export APL_ROLE=gateway
export USERS_NB=10
export RUSERS_NB=5
export RWEB_NB=10
export URLLIST_RECORDS_NB=5000000
export LOGROTATE_NB=31
export PERSISTENT_CACHE=on
export PERSISTENT_WEB_LOG=on
export PERSISTENT_RWEB_LOG=on
export RWEB_CACHE_SZ=30
export MANAGER_GATEWAY_NB=2
export MANAGER_TEMPLATE_NB=10
export MANAGER_TOTAL_USERS_NB=$[${USERS_NB} * ${MANAGER_GATEWAY_NB}]
export MANAGER_TOTAL_RWEB_NB=$[${RWEB_NB} * ${MANAGER_GATEWAY_NB}]

export KEYBOARD=us
export TIMEZONE=Europe/Paris

unset  APASSWORD
unset  SPASSWORD

unset  HYPERVISOR_NAME
unset  CLOUD_CONSOLE
unset  CLOUD_NAME

export CLOUD_NETWORK_MAIN_DEV=eth0
export CLOUD_NETWORK_SECOND_DEV=eth1

unset  CLOUD_NETWORK_MAIN_IP
unset  CLOUD_NETWORK_MAIN_MASK
unset  CLOUD_NETWORK_MAIN_GATEWAY

unset  CLOUD_NETWORK_SECOND_IP
unset  CLOUD_NETWORK_SECOND_MASK

export SERIAL_CONF=n81
export MAX_MOUNT=16

export GENERATED_DIR=Generated
export INSTALL_DIR=/install
export MEDIA_DIR=/mnt/media
unset  MEDIA_TYPE
unset  MEDIA_DEVICE
unset  WORKING_DIR

export CONSOLE=null
export INSTALL=null
export SYSTEM=null

export MEMORY_SZ=0
export CPU_NB=0

unset  DISK_INFOS_ORDERED
unset  DISK_INFOS
unset  DISK_DEVICES
export DISK_NB=0
export RAID_STATE=0
export RAID_LEVEL=1

unset  RAID_MODULES
unset  RAID_DEVICES
export RAID_SZ=0
export RAID_DISK_SZ=0
export RAID_SPARE_NB=0
export RAID_CHUNK_SZ=512
export RAID_SECURITY_PCT=99

export PARTITIONS_NB=0
unset  PARTITIONS

export STORAGE_NB=0

export NETWORK_NB=0
unset  NETWORKS

unset  NETWORK_MODULES
unset  STORAGE_MODULES
unset  FS_MODULES

unset  TFTP_SERVER_IP
unset  APL_IP

export BULLET="* "
export TAB_BULLET="\Z2  o \Zn"

export DEBUG_NETWORK_DEV=0
export INSTALL_MODEL_NETWORK_DEV=0
unset  INSTALL_NIC_NAMES
export INSTALL_NIC_NAMES_NB=0

export INSTALL_PX=installation
export DISK_FILE=${INSTALL_PX}.disk
export SMART_FILE=${INSTALL_PX}.smart.disk
export SMARTCTL_FILE=${INSTALL_PX}.smartctl
export MD_FILE=${INSTALL_PX}.md
export VGS_FILE=${INSTALL_PX}.vgs
export NETWORK_FILE=${INSTALL_PX}.network
export STORAGE_FILE=${INSTALL_PX}.storage
export CPU_FILE=${INSTALL_PX}.cpu
export WARNING_FILE=${INSTALL_PX}.warning
export ERROR_FILE=${INSTALL_PX}.error
export RAID_LEVEL_FILE=${INSTALL_PX}.raid
export HARDWARE_FILE=${INSTALL_PX}.hardware
export ADMIN_PASSWORD_FILE=${INSTALL_PX}.admin.password
export ADMIN_PASSWORD_SHA1_FILE=${INSTALL_PX}.admin.password.sha1
export PERSISTENCY_FILE=${INSTALL_PX}.persistency
export CAPACITY_FILE=${INSTALL_PX}.capacity
export PASSWORD_FILE=${INSTALL_PX}.password
export MENU_ITEM_FILE=${INSTALL_PX}.menu.item
export RAID_MENU_FILE=${INSTALL_PX}.raid.menu
export DISK_MENU=${INSTALL_PX}.disk.menu
export NIC_MENU=${INSTALL_PX}.nic.menu
export PARTITION_MENU_FILE=${INSTALL_PX}.partition.menu
export MAIN_MENU_FILE=${INSTALL_PX}.main.menu
export CONFIGURE_FILE=${INSTALL_PX}.configure
export STORAGE_MODULES_FILE=${INSTALL_PX}.modules.storage
export NETWORK_MODULES_FILE=${INSTALL_PX}.modules.network
export HID_MODULES_FILE=${INSTALL_PX}.modules.hid
export RAID_MODULES_FILE=${INSTALL_PX}.modules.raid

export LOG_FILE_1=install-pass-1.log
export LOG_FILE_2=install-pass-2.log
export LOG_FILE=${LOG_FILE_1}

export CG_KERNEL_HM=cg_kernel_hm
export CG_KERNEL_LM=cg_kernel_lm
export CG_KERNEL_64=cg_kernel_64
export CG_INITRD_HM=cg_initrd_hm
export CG_INITRD_LM=cg_initrd_lm
export CG_INITRD_64=cg_initrd_64

export DIALOG_CAPACITY_TITLE_LEN=47

unset  Errors
Errors[1]=""
Errors[2]=""
Errors[3]="No disk drive has been detected on this machine."
Errors[4]="At least two Network Interfaces Cards are required to install a Gateway."
Errors[5]="This machine has a unsupported disk size. Please check your Hardware installation and start the installation again."
Errors[6]="This machine has an unsupported number of disks. Please check your Hardware installation and start the installation again."
Errors[7]="RAID capabilities are not supported in Test mode. Please deactivate the RAID usage or choose the full installation."
Errors[8]="The OS cannot be installed because the machine resources do not match mandatory requirements."
Errors[9]="Can't format disk(s) because they probably need(s) some maintenance operations."
Errors[10]="OS files not found on the TFTP server."
Errors[11]="Can't mount the media device."
Errors[12]="OS pieces missing on the media."
Errors[13]="OS piece(s) has (have) been corrupted during the TFTP download."
Errors[14]="Can't transfer a kernel file."
Errors[15]="Can't copy an Initial RAM Disk."
Errors[16]="Can't copy a kernel file."
Errors[17]="OS signatures not found on the TFTP server."
Errors[18]="No Network Interface Card has been found."
Errors[19]="The Installation failed. Please note all error messages before contacting the support service."
Errors[20]="Can't merging OS pieces."
Errors[21]="Can't unpack the OS."
Errors[22]="Can't copy kernels and images."
Errors[23]="The DHCP client did not get an IP address. Please review your network configuration."
Errors[24]="The TFTP server IP address is not set. Please review your network configuration."
Errors[25]="At least one Network Interface Card is required to install a Manager."
Errors[26]=""
Errors[27]=""
Errors[28]=""
Errors[29]=""
Errors[30]="RAID level 0 (striping) requires at leat 2 active disks."
Errors[31]="RAID level 0 (striping) cannot manage a hot spare disk."
Errors[32]="RAID level 1 (mirroring) requires 2 active disks."
Errors[33]="RAID level 5 requires at leat 3 active disks."
Errors[34]="RAID level 6 requires at leat 4 active disks."
Errors[35]="RAID level 10 requires at leat 4 active disks."
export ERROR_NB=${#Errors[@]}
Errors[255]="Unknown error."

unset  Warnings
Warnings[1]="Can't manage more than 32 CPU."
Warnings[2]="The Storage Controller is unknown."
export WARNING_NB=${#Warnings[@]}
Warnings[255]="Unknown warning."

unset  Informations
Informations[1]="The checking program successfully completed. Now you can proceed\nwith the installation."
Informations[2]="The checking program completed with some warnings. However you\ncan proceed with the installation."
export INFORMATION_NB=${#Informations[@]}
Informations[255]="Unknown information."
