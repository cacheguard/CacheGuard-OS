export SSHD_UID="40"
export SSHD_GID="40"

export NTP_UID="41"
export NTP_GID="41"

export NAMED_UID="42"
export NAMED_GID="42"

# The Proxy Cache
export SQUID_UID="43"
export SQUID_GID="43"
export SQUID_USER="cache"
export SQUID_GROUP="cache"

# The WAF Proxy 
export HTTPD_UID="44"
export HTTPD_GID="44"
export HTTPD_USER="filter"
export HTTPD_GROUP="filter"

# Proxy Cache
export PROXY_UID="45"
export PROXY_GID="45"

# SNMP Agent
export SNMP_UID="46"
export SNMP_GID="46"

# Antivirus
export AV_UID="47"
export AV_GID="47"
export AV_USER="av"
export AV_GROUP="av"

# IPSec VPN
export IPSEC_UID="48"
export IPSEC_GID="48"
export IPSEC_USER="ipsec"
export IPSEC_GROUP="ipsec"

export ROOT_DIR="/root"
export SSHD_DIR="/var/empty/sshd"
export NAMED_DIR=${LOCAL_DIR}/var/named
export NTP_DIR="${LOCAL_DIR}/etc/ntp"
export PROXY_DIR="${LOCAL_DIR}/proxy"
export WEB_SERVER_DIR="${LOCAL_DIR}/web"
export AV_DIR="${LOCAL_DIR}/${AV_USER}"
export IPSEC_DIR="${LOCAL_DIR}/${IPSEC_USER}"

export CGI_MESSAGE_FILE="/var/run/cgi-message"
export APP_NAME="cg"
export APP_VERSION="2.0"
