export SOURCE_DIRECTORY=/usr/src
export SYS_ARCHITECTURE=$(uname -m 2> /dev/null)
export SYS_VERSION=6.6.100
export SYS_RAMDISK_SIZE=$[3 * 1024]
export SYS_SWAP_DEVICE=sda5
export SYS_DEVICE=sdb
export SYS_DEVICE_HD=2
export SYS_DEVICE_PART=1
export SYS_ROOT_FS=ext4

export TTY_GID="5"
export DAEMON_UID="6"
export DAEMON_GID="6"
export DIALOUT_GID="10"
export USERS_GID=999
export GROUP_NAME=users

export SYS_RELEASE_NAME=cg
export SYS_RELEASE_VERSION=3.2
export SYS_HOST_NAME=appliance
export SYS_64_NAME=${SYS_RELEASE_NAME}-64-${SYS_RELEASE_VERSION}
export SYS_HM_NAME=${SYS_RELEASE_NAME}-hm-${SYS_RELEASE_VERSION}
export SYS_NAME=${SYS_RELEASE_NAME}-${SYS_RELEASE_VERSION}
export SYS_UML_64_NAME=${SYS_RELEASE_NAME}-uml-64-${SYS_RELEASE_VERSION}
export SYS_UML_NAME=${SYS_RELEASE_NAME}-uml-${SYS_RELEASE_VERSION}

export SYS_KEYMAP="fr-latin9"
export SYS_FONT="lat9-16 -u iso01"
export SYS_LANG="en"
export SYS_COUNTRY="GB"
export SYS_CHARMAP="UTF-8"
export SYS_TIME_ZONE="Europe/Paris"

export SYS_HOSTNAME="appliance"
export SYS_IP="192.168.22.11"
export SYS_GATEWAY="192.168.22.254"
export SYS_PREFIX="24"
export SYS_BROADCAST="192.168.22.255"
export SYS_DOMAIN="cacheguard.intranet"
export SYS_NAMESERVER="192.168.22.254"

export LOCAL_DIR=/usr/local
export COMPILE_LOG_DIR=CompileLog
export PROJECT_DIR=${HOME}/TajFlow
export PROJECT_LOCAL_DIR=${PROJECT_DIR}Local
export GENERATED_DIR=Generated

export BASE_GENERATED_DIR=${PROJECT_LOCAL_DIR}${PWD/${PROJECT_DIR}}
export FULL_GENERATED_DIR=${BASE_GENERATED_DIR}/${GENERATED_DIR}
